*.log
.DS_Store

# Claude Code's own per-machine state. Shared project settings, if any are ever
# added, live in .claude/settings.json and ARE committed.
.claude/settings.local.json
.claude/.cc-writes/
specs/*/.pipeline/
.specify/roadmaps/*.state.json
.specify/feature.json

# `ccwatch verify-ui --shots` writes rendered pages here. Local artefacts, not
# committed: the repo deliberately ships no binary assets, and a screenshot's
# value is in being looked at now, not in being diffed later.
.screens/

# Built by app/build.sh. A compiler output, not a source.
app/build/

# `patch` leaves these behind. A stale copy of a page beside the real one is
# a file somebody will read by mistake.
*.orig
*.rej

# Zero-byte files bash drops in the cwd when it crashes. Eighteen appeared
# during a night when the host ran out of swap and bash segfaulted repeatedly.
sh-thd-*
