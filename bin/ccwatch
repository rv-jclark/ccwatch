#!/usr/bin/env bash
#
# ccwatch — every Claude Code session on this machine, and which one is stuck.
#
# Three questions this answers, in the order they cost you time:
#
#   1. Which session is blocked on me right now, and for how long?
#   2. Which session says it is working but has gone quiet — the silent hang?
#   3. After a reboot, which sessions was I in the middle of?
#
# The design point is that a session must never be able to fail QUIETLY. Claude
# Code's own registry reports `busy` from UI state alone (`isLoading ||
# delegatedActive`), so a session wedged on a network stall or a hung tool call
# reports `busy` forever and nothing ever re-checks it. So every status here is
# corroborated against a second, independent signal — whether the session's
# transcript is still growing — and a `busy` that has stopped writing is called
# out as suspect rather than trusted. Silence is a reading, not an absence.
#
# This is deliberately self-contained: no lib/common.sh, no state file, nothing
# spec-kit specific required. It ships with the plugin because the pipeline
# overlay (which phase, on what model, for how much) is the most useful column
# it draws — but it works the same in a repo that has never seen spec-run.
#
# SOURCES, and how much each is trusted
#   ~/.claude/sessions/<pid>.json   the live registry. One file per process.
#                                   Richer than `claude agents --json`, which
#                                   drops `entrypoint` and `waitingFor` — the
#                                   two fields that matter most here. Internal
#                                   format, so `ccwatch doctor` cross-checks it
#                                   against the supported CLI and complains
#                                   loudly if a Claude Code upgrade moves it.
#   ~/.claude/projects/*/<sid>.jsonl  the transcript. Append-only, survives
#                                   reboots, and its mtime is the one honest
#                                   answer to "is this thing still moving".
#                                   This is also the ONLY resume authority: the
#                                   registry is pid-keyed and evaporates on
#                                   restart, exactly when you need it.
#   <repo>/specs/*/.pipeline/state.json  the spec-run pipeline overlay, when
#                                   present. Already distinguishes ok from
#                                   interrupted, which the registry cannot.

set -uo pipefail

# ⚠️ The trailing marker is load-bearing: release-please rewrites the version on
# any line carrying it, and this is the only copy of the number in the repo that
# the tool itself reads. Do not bump it by hand — the release PR does that, and
# a hand-edit makes the tag and the script disagree about what shipped.
CCWATCH_VERSION=1.1.0 # x-release-please-version

# ---------------------------------------------------------------- output ------
# A dumb terminal, a pipe, or a CI log gets plain text. Colour is decoration and
# must never be the only thing carrying a meaning — every severity here also has
# a distinct word, so `ccwatch | grep HUNG` works.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
  _c_red=$'\033[31m';    _c_yellow=$'\033[33m'; _c_green=$'\033[32m'
  _c_cyan=$'\033[36m';   _c_dim=$'\033[2m';     _c_bold=$'\033[1m'
  _c_reset=$'\033[0m';   _c_magenta=$'\033[35m'
else
  _c_red=; _c_yellow=; _c_green=; _c_cyan=; _c_dim=; _c_bold=; _c_reset=
  _c_magenta=
fi

say()  { printf '%s\n' "$*"; }
warn() { printf '%s!%s %s\n' "$_c_yellow" "$_c_reset" "$*" >&2; }
err()  { printf '%sx%s %s\n' "$_c_red" "$_c_reset" "$*" >&2; }
die()  { err "$1"; [ -n "${2:-}" ] && printf '  %s\n' "$2" >&2; exit 1; }

# ------------------------------------------------------------ where things ----
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SESS_DIR="$CLAUDE_HOME/sessions"
PROJ_DIR="$CLAUDE_HOME/projects"
CCWATCH_HOME="${CCWATCH_HOME:-$CLAUDE_HOME/ccwatch}"
EVENTS="$CCWATCH_HOME/events.jsonl"
# Account-wide usage, written by `ccwatch statusline`. One file, last writer
# wins — the numbers are per-account, not per-session, so any session that
# reports is as good as any other.
USAGE_FILE="$CCWATCH_HOME/usage.json"
# ⚠️ And one file PER REPORTER beside it. `usage.json` is written by whichever
# statusline repainted last, and the comment above it used to say the numbers
# are account-wide "so any session that reports is as good as any other". That
# is false, and was measured false: within one minute four sessions wrote 12%,
# 14%, 15% and a payload with `five_hour: null`, and the menu bar was reported
# cycling 101% / 88% / 62%. Whatever the cause — sessions signed in to
# different accounts is the obvious candidate and nothing recorded here can
# confirm it — ccwatch cannot tell which of two disagreeing readings is right,
# so it must stop picking one. Keeping them apart is what makes the
# disagreement visible instead of a flicker.
USAGE_DIR="$CCWATCH_HOME/usage"
# Context-window fill, which IS per-session, so one file each.
CTX_DIR="$CCWATCH_HOME/context"

# Thresholds. A `busy` session that has not appended to its transcript in this
# long is reported as suspect. It is not proof of a hang — one `Bash` call
# running a long test suite is legitimately silent — which is why the table
# always prints the actual silence next to the verdict, and why crossing 3x the
# threshold escalates rather than the first crossing being final. Judgement
# stays with you; the tool's job is to make the silence impossible to miss.
CCWATCH_BUSY_STALE="${CCWATCH_BUSY_STALE:-600}"
CCWATCH_SDK_STALE="${CCWATCH_SDK_STALE:-900}"
CCWATCH_REFRESH="${CCWATCH_REFRESH:-2}"
CCWATCH_RESUME_DAYS="${CCWATCH_RESUME_DAYS:-14}"
# How recent an unfinished run has to be to earn a place in the live table. The
# first version had no window and listed 24 runs going back a fortnight, which
# buried the two from the last hour that actually mattered. Older wreckage is
# still reachable, just through `ccwatch resume` rather than in your face.
CCWATCH_UNFINISHED_HOURS="${CCWATCH_UNFINISHED_HOURS:-24}"
# How old a statusline report can be before its context reading is dropped.
# Generous relative to a 10s refreshInterval, because a session sitting idle
# still repaints; a reading older than this means the session is gone from the
# status line entirely, and a frozen gauge that looks live is worse than none.
CCWATCH_CTX_STALE="${CCWATCH_CTX_STALE:-120}"
# How old a usage reading may be before its NUMBERS are withheld.
#
# ⚠️ Generous next to a 10s statusline refresh, and deliberately not unlimited.
# An hour-old rate-limit percentage is not a slightly-stale fact, it is a wrong
# one: the five-hour window has moved and possibly reset underneath it. The
# first version rendered any reading with an "[1h old]" note beside it, and a
# test fixture from an earlier session sat on the dashboard reading 52% while
# the real figure was 7% — a monitoring tool showing a confidently wrong number
# is worse than one showing none.
CCWATCH_USAGE_STALE="${CCWATCH_USAGE_STALE:-600}"
# How close together two usage readings must be before disagreeing about the
# same window means anything, and how far apart they may then be. Usage climbs
# while you work, so a reading from ten minutes ago being lower is not a
# conflict; two taken seconds apart differing by tens of points is.
CCWATCH_USAGE_AGREE_WINDOW="${CCWATCH_USAGE_AGREE_WINDOW:-120}"
CCWATCH_USAGE_TOLERANCE="${CCWATCH_USAGE_TOLERANCE:-5}"
# How long `ccwatch send` waits to OBSERVE its message in the target's
# transcript before reporting it as merely queued. Writing to the socket is not
# evidence of delivery — that was proven the hard way, see cmd_send.
CCWATCH_SEND_VERIFY="${CCWATCH_SEND_VERIFY:-10}"
# How injected messages identify themselves in the receiver's transcript. Left
# as "ccwatch" so that "who told that agent to do that" is answerable from the
# receiving side alone, not only from this machine's event log.
CCWATCH_SEND_AS="${CCWATCH_SEND_AS:-ccwatch}"
# Deploy watching. `gh` is a network call, so it is cached — polling it on every
# 2s repaint would rate-limit you and make the table stutter.
CCWATCH_DEPLOY_TTL="${CCWATCH_DEPLOY_TTL:-60}"
# Which workflows count as a deploy. A CI run on every push is noise; a
# production deploy is not. Matched case-insensitively against the workflow name.
CCWATCH_DEPLOY_PATTERN="${CCWATCH_DEPLOY_PATTERN:-deploy|release|rollback|publish|promote}"
CCWATCH_DEPLOY_LIMIT="${CCWATCH_DEPLOY_LIMIT:-20}"

need() { command -v "$1" >/dev/null 2>&1 || die "ccwatch needs '$1' on PATH" "${2:-}"; }

# CCWATCH_PROFILE=1 prints per-stage timings to stderr. Added because the first
# round of "optimisation" here was guesswork: the fork overhead that looked
# obvious turned out to be a fraction of the cost, and the real expense was
# filesystem traversal of a 1.7GB transcript tree. Measure, then change.
_prof_t0=0
prof() { # prof <stage-label>
  [ -n "${CCWATCH_PROFILE:-}" ] || return 0
  local now
  now=$(perl -MTime::HiRes -e 'print int(Time::HiRes::time()*1000)' 2>/dev/null) || now=0
  [ "$_prof_t0" -ne 0 ] && printf '  %-22s %6sms\n' "$1" "$((now - _prof_t0))" >&2
  _prof_t0=$now
}

# The one testing seam. Liveness and CPU both come from `ps`, and a fabricated
# pid is never live, so without a way to substitute that output every fixture
# row would be filtered out before it reached the classification — which is the
# part most worth testing. Set CCWATCH_FAKE_PS to a file holding what
# `ps -o pid=,lstart=,time=` would have printed.
ps_out() {
  if [ -n "${CCWATCH_FAKE_PS:-}" ]; then
    cat "$CCWATCH_FAKE_PS" 2>/dev/null
  else
    ps -o pid=,lstart=,time=,rss= -p "$1" 2>/dev/null
  fi
}

# resolved_self — this script's real path, with symlinks followed.
#
# ⚠️ Load-bearing for `serve`, which finds web/ relative to bin/. The documented
# install is a SYMLINK into /usr/local/bin so that `git pull` upgrades the tool,
# and `${BASH_SOURCE[0]}` is then the symlink — so the naive dirname put the web
# root at /usr/local and `serve` died for everyone who followed the README.
#
# A loop rather than `readlink -f`: the BSD readlink macOS shipped for years has
# no -f, and a chain of symlinks (Homebrew, a dotfiles repo, /usr/local itself)
# is the normal case, not an exotic one.
resolved_self() {
  local p=${BASH_SOURCE[0]} d n=0
  while [ -L "$p" ]; do
    n=$((n + 1)); [ "$n" -gt 40 ] && break     # a symlink cycle must not hang
    d=$(cd -- "$(dirname -- "$p")" && pwd)
    p=$(readlink -- "$p")
    case "$p" in /*) ;; *) p="$d/$p";; esac    # a link target may be relative
  done
  printf '%s/%s\n' "$(cd -- "$(dirname -- "$p")" && pwd)" "$(basename -- "$p")"
}

TMP=""
cleanup() {
  [ -n "$TMP" ] && rm -rf "$TMP"
  [ -n "${_CCWATCH_PROBE_REPORT:-}" ] && rm -f "$_CCWATCH_PROBE_REPORT"
}
trap cleanup EXIT

# ============================================================== platform ====
#  platform_detect / probe_report / probe_note
#  probe_proc / probe_mtimes / probe_clock / probe_host
#  probe_native_path / probe_posix_path
#
# The only section permitted to invoke `ps`, `stat -f`/`stat -c`,
# `date -r`/`date -d`, `vm_stat`, `sysctl`, PowerShell, `cygpath` or `uname`
# (FR-001, contracts/probe-layer.md "Where it lives"). Everything else in
# this script asks a probe, never a program directly — the point of this
# section is that a caller stops knowing what platform it is on.

CCWATCH_PLATFORM="${CCWATCH_PLATFORM:-}"
CCWATCH_UNAME=""
CCWATCH_PY="${CCWATCH_PY:-}"
CCWATCH_BASH="${CCWATCH_BASH:-}"
_ccwatch_platform_detected=0

# platform_detect — sets CCWATCH_PLATFORM/CCWATCH_UNAME/CCWATCH_PY (and
# CCWATCH_BASH on Windows) once per run. Idempotent: called from the top of
# the script and safe to call again from anywhere that needs it early.
#
# A pre-set CCWATCH_PLATFORM overrides detection outright rather than being
# re-detected — the seam the hermetic suite uses to assert probe selection
# for both platforms from either host (FR-029, D2).
platform_detect() {
  [ "$_ccwatch_platform_detected" -eq 1 ] && return 0
  _ccwatch_platform_detected=1

  CCWATCH_UNAME=$(uname -s 2>/dev/null) || CCWATCH_UNAME=""

  if [ -z "$CCWATCH_PLATFORM" ]; then
    case "$CCWATCH_UNAME" in
      Darwin) CCWATCH_PLATFORM=macos ;;
      MINGW*|MSYS*|CYGWIN*) CCWATCH_PLATFORM=windows ;;
      # unsupported is a first-class value, not an error: every probe below
      # returns `failed` with the platform named in the reason, and the run
      # continues rather than guessing at a shape it has never seen (D3).
      *) CCWATCH_PLATFORM=unsupported ;;
    esac
  fi

  _ccwatch_resolve_py
  [ "$CCWATCH_PLATFORM" = windows ] && _ccwatch_resolve_bash
  return 0
}

# CCWATCH_PY resolution (D4): try python3, then python (accepted only if it
# actually answers as Python 3 — some hosts still put a Python 2 `python` on
# PATH), then the Windows launcher's `py -3`. Empty when none answer; nothing
# here guesses at a fallback.
_ccwatch_resolve_py() {
  [ -n "$CCWATCH_PY" ] && return 0
  if command -v python3 >/dev/null 2>&1; then
    CCWATCH_PY=python3
    return 0
  fi
  if command -v python >/dev/null 2>&1 \
     && python -c 'import sys; sys.exit(0 if sys.version_info.major == 3 else 1)' \
        >/dev/null 2>&1; then
    CCWATCH_PY=python
    return 0
  fi
  if command -v py >/dev/null 2>&1 && py -3 -c 'import sys' >/dev/null 2>&1; then
    CCWATCH_PY="py -3"
    return 0
  fi
  CCWATCH_PY=""
}

# CCWATCH_BASH resolution (D1, D18) — Windows only, so a macOS run never pays
# for it. Candidate order: a build-time recorded path (none yet — this
# script has no build step of its own), HKLM\SOFTWARE\GitForWindows's
# InstallPath, %ProgramFiles%\Git\bin\bash.exe, C:\msys64\usr\bin\bash.exe,
# then whatever `bash` resolves to on PATH.
#
# %SystemRoot%\System32\bash.exe (the WSL launcher) is excluded by path
# outright, and every remaining candidate is verified by actually running
# it: `uname -s` must answer MINGW*/MSYS*/CYGWIN*, because a `bash` on PATH
# that silently opens a WSL shell instead would run every probe against the
# wrong kernel with no error to show for it.
_ccwatch_resolve_bash() {
  [ -n "$CCWATCH_BASH" ] && return 0
  local candidates c reg_path on_path
  candidates=""

  reg_path=$(reg query 'HKLM\SOFTWARE\GitForWindows' -v InstallPath 2>/dev/null \
    | awk '/InstallPath/{print $NF}')
  [ -n "$reg_path" ] && candidates="$candidates ${reg_path}\\bin\\bash.exe"
  candidates="$candidates ${ProgramFiles:-C:\\Program Files}\\Git\\bin\\bash.exe"
  candidates="$candidates C:\\msys64\\usr\\bin\\bash.exe"
  on_path=$(command -v bash 2>/dev/null) && candidates="$candidates $on_path"

  for c in $candidates; do
    case "$c" in *[Ss]ystem32*bash.exe) continue ;; esac
    command -v "$c" >/dev/null 2>&1 || [ -x "$c" ] || continue
    case "$("$c" -c 'uname -s' 2>/dev/null)" in
      MINGW*|MSYS*|CYGWIN*) CCWATCH_BASH="$c"; return 0 ;;
    esac
  done
  CCWATCH_BASH=""
}

# probe_note <name> <impl> <outcome> <reason> [detail] — appends one row to
# the run-scoped report; probe_report prints it back for `doctor` (FR-014).
#
# The file is created lazily with a TEMPLATE, never a bare `mktemp` — bare
# `mktemp -d` resolved against confstr(_CS_DARWIN_USER_TEMP_DIR) rather than
# $TMPDIR and was refused outright in a sandbox granting one and not the
# other, which cost cmd_resume and cmd_peers a silent empty output before
# their own fix (D8). A global rather than a variable set inside `$(...)`:
# that assignment never survives the subshell back to the caller.
_ccwatch_probe_report=""
probe_note() {
  local name="$1" impl="$2" outcome="$3" reason="${4:-}" detail="${5:-}"
  if [ -z "$_ccwatch_probe_report" ]; then
    _ccwatch_probe_report=$(mktemp "${TMPDIR:-/tmp}/ccwatch-probes.XXXXXX") || return 0
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$impl" "$outcome" "$reason" "$detail" \
    >>"$_ccwatch_probe_report"
}

# probe_report — the TSV rows collected this run, one per probe_note call, in
# call order. Nothing printed if no probe has run yet.
probe_report() {
  [ -n "$_ccwatch_probe_report" ] && [ -f "$_ccwatch_probe_report" ] \
    && cat "$_ccwatch_probe_report"
  return 0
}

# probe_proc <comma-separated-pids> — {pid, start, cpu, rss_mb?} per pid,
# JSON array on stdout, nothing on failure (contracts/probe-layer.md).
#
# CCWATCH_FAKE_PS is honoured FIRST, on every platform (D10): the fixtures are
# always BSD `ps` text, so under a fake the BSD parser runs regardless of
# CCWATCH_PLATFORM, and the control query is skipped outright. That is the only
# way probe selection is assertable from one host for both platforms — a real
# Windows probe never runs where there is no Windows to run it on.
probe_proc() { # probe_proc <comma-separated-pids>
  local pids="$1" impl
  case "$CCWATCH_PLATFORM" in
    macos) impl="ps(BSD)" ;;
    windows) if [ -n "$CCWATCH_PY" ]; then impl="win32-ctypes"; else impl="powershell-cim"; fi ;;
    *) probe_note proc none failed "no implementation for this platform (uname: $CCWATCH_UNAME)"
       return 1 ;;
  esac

  if [ -n "${CCWATCH_FAKE_PS:-}" ]; then
    _probe_proc_bsd_parse "$pids" "$impl"
    return $?
  fi

  case "$CCWATCH_PLATFORM" in
    macos) _probe_proc_macos "$pids" "$impl" ;;
    windows) _probe_proc_windows "$pids" "$impl" ;;
  esac
}

# The BSD `ps -o pid=,lstart=,time=,rss=` text parser, shared by the real
# macOS probe and every fixture (CCWATCH_FAKE_PS), on either platform.
_probe_proc_bsd_parse() { # _probe_proc_bsd_parse <pids> <impl-label>
  local pids="$1" impl="$2" out
  out=$(ps_out "$pids" | $CCWATCH_PY -c '
import json, sys, time

MONTHS = {m: i + 1 for i, m in enumerate(
    ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"])}

def epoch(dow, mon, day, clock, year):
    # `ps -o lstart=` prints LOCAL time. The registry stores procStart in UTC,
    # which is why these are compared as epochs and never as strings — doing
    # the latter marks every session a pid-reuse impostor.
    h, m, sec = (int(x) for x in clock.split(":"))
    st = (int(year), MONTHS[mon], int(day), h, m, sec, 0, 0, -1)
    return int(time.mktime(st))

def cpu(clock):
    # macOS prints MM:SS.ss and lets the minutes run past 60; HH:MM:SS also
    # occurs. Handle both rather than mis-scaling a long-lived session.
    parts = clock.split(":")
    try:
        if len(parts) == 3:
            return float(parts[0]) * 3600 + float(parts[1]) * 60 + float(parts[2])
        if len(parts) == 2:
            return float(parts[0]) * 60 + float(parts[1])
    except ValueError:
        pass
    return 0.0

out = []
for line in sys.stdin:
    f = line.split()
    if len(f) < 7:
        continue
    try:
        rec = {"pid": int(f[0]),
               "start": epoch(f[1], f[2], f[3], f[4], f[5]),
               "cpu": cpu(f[6])}
        # Resident size, when ps was asked for it. Absent in the test fixtures,
        # which supply only the columns they care about, so it is optional
        # rather than required — a missing figure must not drop the row.
        if len(f) >= 8:
            rec["rss_mb"] = round(int(f[7]) / 1024)
        out.append(rec)
    except (ValueError, KeyError, OverflowError):
        # A row we cannot parse is skipped, not guessed at: a wrong start time
        # would make the pid-reuse guard reject a live session.
        continue
print(json.dumps(out))
' 2>/dev/null)
  # ⚠️ An empty answer is only believable if `ps` could run at all (or, under
  # a fixture, if the fixture itself is honoured — the control query is
  # skipped there because a fake ps proves nothing about the real one).
  # Measured here: `ps` refused, 18 sessions live, 0 reported.
  if [ "$out" = "[]" ] && [ -z "${CCWATCH_FAKE_PS:-}" ] \
     && [ -z "$(ps -o pid= -p $$ 2>/dev/null)" ]; then
    probe_note proc "$impl" failed "control query ps -o pid= -p \$\$ returned nothing"
    return 1
  fi
  if [ -z "$out" ]; then
    probe_note proc "$impl" failed "ps produced no usable output"
    return 1
  fi
  if [ "$out" = "[]" ]; then
    probe_note proc "$impl" absent "no matching processes"
  else
    probe_note proc "$impl" ok
  fi
  printf '%s' "$out"
}

_probe_proc_macos() { _probe_proc_bsd_parse "$1" "$2"; }

# Windows process facts via win32-ctypes (D12): one $CCWATCH_PY -c program
# using OpenProcess/GetProcessTimes/GetProcessMemoryInfo for the whole pid
# list at once. ERROR_INVALID_PARAMETER (87) is a measured absence for that
# pid ("not running"); ERROR_ACCESS_DENIED (5) is a failure to measure for
# that pid, counted and reasoned rather than folded into "not running" (D12).
# The control query uses the Windows pid procfs reports for THIS shell, read
# as /proc/$$/winpid — never $$ itself, which is an MSYS pid OpenProcess would
# always reject (D11), and never /proc/self/winpid, which is the pid of the
# forked `cat` doing the reading: a process already reaped by the time python
# runs, so OpenProcess answered ERROR_INVALID_PARAMETER every time and the
# whole Windows read path refused on every host (D11a).
_probe_proc_windows() { # _probe_proc_windows <pids> <impl-label>
  local pids="$1" impl="$2" winpid ctl out denied

  if [ "$impl" = "powershell-cim" ]; then
    _probe_proc_windows_powershell "$pids"
    return $?
  fi

  if [ -r "/proc/$$/winpid" ]; then
    winpid=$(cat "/proc/$$/winpid" 2>/dev/null)
  fi
  if [ -z "$winpid" ]; then
    probe_note proc "$impl" failed "refused: no control pid for this shell at /proc/\$\$/winpid"
    return 1
  fi
  # Prints ok, or err:<code>, so the refusal below can name the reason rather
  # than reporting the pid list as a measured absence (FR-004).
  ctl=$($CCWATCH_PY -c '
import ctypes, sys
k32 = ctypes.WinDLL("kernel32", use_last_error=True)
k32.OpenProcess.restype = ctypes.c_void_p
h = k32.OpenProcess(0x1000, False, int(sys.argv[1]))
if not h:
    print("err:%d" % ctypes.get_last_error())
else:
    k32.CloseHandle(ctypes.c_void_p(h))
    print("ok")
' "$winpid" 2>/dev/null)
  if [ "$ctl" != "ok" ]; then
    probe_note proc "$impl" failed "refused: could not verify the control pid $winpid via /proc/\$\$/winpid${ctl:+ ($ctl)}"
    return 1
  fi

  out=$($CCWATCH_PY -c '
import ctypes, json, sys
from ctypes import wintypes

PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
ERROR_INVALID_PARAMETER = 87
ERROR_ACCESS_DENIED = 5

class FILETIME(ctypes.Structure):
    _fields_ = [("dwLowDateTime", wintypes.DWORD), ("dwHighDateTime", wintypes.DWORD)]

class PROCESS_MEMORY_COUNTERS(ctypes.Structure):
    _fields_ = [("cb", wintypes.DWORD), ("PageFaultCount", wintypes.DWORD),
                ("PeakWorkingSetSize", ctypes.c_size_t), ("WorkingSetSize", ctypes.c_size_t),
                ("QuotaPeakPagedPoolUsage", ctypes.c_size_t), ("QuotaPagedPoolUsage", ctypes.c_size_t),
                ("QuotaPeakNonPagedPoolUsage", ctypes.c_size_t), ("QuotaNonPagedPoolUsage", ctypes.c_size_t),
                ("PagefileUsage", ctypes.c_size_t), ("PeakPagefileUsage", ctypes.c_size_t)]

def filetime_to_epoch(ft):
    val = (ft.dwHighDateTime << 32) | ft.dwLowDateTime
    return int(val / 10000000 - 11644473600)

def filetime_to_seconds(ft):
    return ((ft.dwHighDateTime << 32) | ft.dwLowDateTime) / 10000000.0

k32 = ctypes.WinDLL("kernel32", use_last_error=True)
psapi = ctypes.WinDLL("psapi", use_last_error=True)
# Declared, not inferred: the default restype is c_int, which would truncate a
# HANDLE, and an undeclared argtype passes one back as 32 bits.
k32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
k32.OpenProcess.restype = ctypes.c_void_p
k32.CloseHandle.argtypes = [ctypes.c_void_p]
k32.GetProcessTimes.argtypes = [ctypes.c_void_p] + [ctypes.POINTER(FILETIME)] * 4
psapi.GetProcessMemoryInfo.argtypes = [ctypes.c_void_p,
                                       ctypes.POINTER(PROCESS_MEMORY_COUNTERS),
                                       wintypes.DWORD]
records, denied = [], 0
for pid in [int(p) for p in sys.argv[1].split(",") if p]:
    h = k32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
    if not h:
        err = ctypes.get_last_error()
        if err == ERROR_ACCESS_DENIED:
            denied += 1
        # ERROR_INVALID_PARAMETER (not running) and anything else: no record,
        # no count — a measured absence rather than a failure.
        continue
    try:
        creation, exit_t, kernel, user = FILETIME(), FILETIME(), FILETIME(), FILETIME()
        if not k32.GetProcessTimes(h, ctypes.byref(creation), ctypes.byref(exit_t),
                                    ctypes.byref(kernel), ctypes.byref(user)):
            continue
        rec = {"pid": pid, "start": filetime_to_epoch(creation),
               "cpu": round(filetime_to_seconds(kernel) + filetime_to_seconds(user), 2)}
        counters = PROCESS_MEMORY_COUNTERS()
        counters.cb = ctypes.sizeof(counters)
        if psapi.GetProcessMemoryInfo(h, ctypes.byref(counters), counters.cb):
            rec["rss_mb"] = round(counters.WorkingSetSize / 1048576)
        records.append(rec)
    finally:
        k32.CloseHandle(ctypes.c_void_p(h))
print(json.dumps({"records": records, "denied": denied}))
' "$pids" 2>/dev/null)

  if [ -z "$out" ]; then
    probe_note proc "$impl" failed "win32-ctypes produced no usable output"
    return 1
  fi
  denied=$(printf '%s' "$out" | jq -r '.denied // 0')
  if [ "${denied:-0}" -gt 0 ]; then
    probe_note proc "$impl" failed "access denied on $denied of $(printf '%s' "$pids" | tr ',' '\n' | grep -c .) pids"
  fi
  printf '%s' "$out" | jq -c '.records'
  if [ "${denied:-0}" -eq 0 ]; then
    if [ "$(printf '%s' "$out" | jq '.records | length')" -eq 0 ]; then
      probe_note proc "$impl" absent "no matching processes"
    else
      probe_note proc "$impl" ok
    fi
  fi
}

# powershell-cim fallback, selected only when CCWATCH_PY is empty (D12).
_probe_proc_windows_powershell() { # _probe_proc_windows_powershell <pids>
  local pids="$1" out
  out=$(powershell -NoProfile -Command "
    \$ids = '$pids'.Split(',') | Where-Object { \$_ } | ForEach-Object { [int]\$_ }
    Get-CimInstance Win32_Process | Where-Object { \$ids -contains \$_.ProcessId } |
      ForEach-Object {
        [pscustomobject]@{
          pid = \$_.ProcessId
          start = ([datetime]::Parse(\$_.CreationDate.ToString())).ToUniversalTime()
          cpu = \$_.KernelModeTime / 10000000.0 + \$_.UserModeTime / 10000000.0
          rss_mb = [math]::Round(\$_.WorkingSetSize / 1MB)
        }
      } | ConvertTo-Json -AsArray
  " 2>/dev/null | tr -d '\r')
  if [ -z "$out" ]; then
    probe_note proc powershell-cim failed "Get-CimInstance Win32_Process produced no usable output"
    return 1
  fi
  probe_note proc powershell-cim ok
  printf '%s' "$out"
}

# probe_mtimes <root> [find-args...] — "<epoch> <path>" lines, newest first
# (contracts/probe-layer.md). The control query is the mtime of <root> itself:
# an unreadable root is `failed`, not `absent` — otherwise every session's
# silence measurement becomes "unknown" without saying so.
probe_mtimes() { # probe_mtimes <root> [find-args...]
  local root="$1" impl out control
  shift
  case "$CCWATCH_PLATFORM" in
    macos) impl="stat-f(BSD)" ;;
    windows) impl="stat-c(GNU)" ;;
    *) probe_note mtimes none failed "no implementation for this platform (uname: $CCWATCH_UNAME)"
       return 1 ;;
  esac

  case "$CCWATCH_PLATFORM" in
    macos) control=$(stat -f '%m' "$root" 2>/dev/null) ;;
    windows) control=$(stat -c '%Y' "$root" 2>/dev/null) ;;
  esac
  if [ -z "$control" ]; then
    probe_note mtimes "$impl" failed "root is unreadable: $root"
    return 1
  fi

  case "$CCWATCH_PLATFORM" in
    macos)
      out=$(find "$root" -name '*.jsonl' -type f "$@" -print0 2>/dev/null \
        | xargs -0 stat -f '%m %N' 2>/dev/null | sort -rn) ;;
    windows)
      out=$(find "$root" -name '*.jsonl' -type f "$@" -print0 2>/dev/null \
        | xargs -0 stat -c '%Y %n' 2>/dev/null | sort -rn | tr -d '\r') ;;
  esac
  probe_note mtimes "$impl" ok
  [ -n "$out" ] && printf '%s\n' "$out"
  return 0
}

# probe_clock <epoch-seconds> — one "3:45 PM EDT"-shaped line, empty when
# withheld. Selected by VALIDATION (D14): each candidate is asked for two
# fixed instants (one EDT, one EST) once per run, and used only if it answers
# both correctly. Never jq — see reset_clock's own comment for the measured
# reason.
_ccwatch_clock_impl=""
probe_clock() { # probe_clock <epoch-seconds>
  case "${1:-}" in
    ''|null|*[!0-9]*) return 0;;
  esac
  [ -n "$_ccwatch_clock_impl" ] || _ccwatch_clock_select
  case "$_ccwatch_clock_impl" in
    "date-r(BSD)") TZ=America/New_York date -r "$1" '+%I:%M %p %Z' 2>/dev/null | sed 's/^0//' ;;
    "date-d(GNU)") TZ=America/New_York date -d "@$1" '+%I:%M %p %Z' 2>/dev/null | sed 's/^0//' | tr -d '\r' ;;
    powershell-tz) _ccwatch_clock_powershell "$1" ;;
    *) return 0 ;;
  esac
  return 0
}

# Two fixed instants that straddle a DST boundary, with hard-coded correct
# answers, so validation never depends on today's date.
_CCWATCH_CLOCK_EDT_EPOCH=1725209100   # 2024-09-01 16:45:00 UTC -> 12:45 PM EDT
_CCWATCH_CLOCK_EDT_WANT="12:45 PM EDT"
_CCWATCH_CLOCK_EST_EPOCH=1704141000   # 2024-01-01 20:30:00 UTC -> 3:30 PM EST
_CCWATCH_CLOCK_EST_WANT="3:30 PM EST"

_ccwatch_clock_select() {
  local candidates c a1 a2
  case "$CCWATCH_PLATFORM" in
    macos) candidates="date-r(BSD)" ;;
    windows) candidates="date-d(GNU) powershell-tz" ;;
    *) candidates="" ;;
  esac
  for c in $candidates; do
    case "$c" in
      "date-r(BSD)")
        a1=$(TZ=America/New_York date -r "$_CCWATCH_CLOCK_EDT_EPOCH" '+%I:%M %p %Z' 2>/dev/null | sed 's/^0//')
        a2=$(TZ=America/New_York date -r "$_CCWATCH_CLOCK_EST_EPOCH" '+%I:%M %p %Z' 2>/dev/null | sed 's/^0//') ;;
      "date-d(GNU)")
        a1=$(TZ=America/New_York date -d "@$_CCWATCH_CLOCK_EDT_EPOCH" '+%I:%M %p %Z' 2>/dev/null | sed 's/^0//' | tr -d '\r')
        a2=$(TZ=America/New_York date -d "@$_CCWATCH_CLOCK_EST_EPOCH" '+%I:%M %p %Z' 2>/dev/null | sed 's/^0//' | tr -d '\r') ;;
      powershell-tz)
        a1=$(_ccwatch_clock_powershell "$_CCWATCH_CLOCK_EDT_EPOCH")
        a2=$(_ccwatch_clock_powershell "$_CCWATCH_CLOCK_EST_EPOCH") ;;
    esac
    _ccwatch_clock_candidate_answers="$_ccwatch_clock_candidate_answers$c: '$a1'/'$a2'; "
    if [ "$a1" = "$_CCWATCH_CLOCK_EDT_WANT" ] && [ "$a2" = "$_CCWATCH_CLOCK_EST_WANT" ]; then
      _ccwatch_clock_impl="$c"
      probe_note clock "$c" ok
      return 0
    fi
  done
  _ccwatch_clock_impl="none"
  probe_note clock none failed "no candidate validated against the two fixed instants" \
    "$_ccwatch_clock_candidate_answers"
}
_ccwatch_clock_candidate_answers=""

_ccwatch_clock_powershell() { # _ccwatch_clock_powershell <epoch-seconds>
  powershell -NoProfile -Command "
    \$dt = [DateTimeOffset]::FromUnixTimeSeconds($1).UtcDateTime
    \$tz = [TimeZoneInfo]::FindSystemTimeZoneById('Eastern Standard Time')
    \$local = [TimeZoneInfo]::ConvertTimeFromUtc(\$dt, \$tz)
    \$abbr = if (\$tz.IsDaylightSavingTime(\$local)) { 'EDT' } else { 'EST' }
    Write-Output (\$local.ToString('h:mm tt') + ' ' + \$abbr)
  " 2>/dev/null | tr -d '\r'
}

# probe_host — one JSON object (ram/swap/load), or `null`, or nothing on
# failure. A figure the platform cannot supply is `null` with an entry in
# `unavailable` — never `0`, which would claim a measurement that was never
# taken (D15).
probe_host() {
  case "$CCWATCH_PLATFORM" in
    macos) _probe_host_macos ;;
    windows) _probe_host_windows ;;
    *) probe_note host none failed "no implementation for this platform (uname: $CCWATCH_UNAME)"
       return 1 ;;
  esac
}

_probe_host_macos() {
  local out
  out=$($CCWATCH_PY -c '
import json, re, subprocess

def sh(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""

out = {}

vm = sh("vm_stat")
m = re.search(r"page size of (\d+)", vm)
page = int(m.group(1)) if m else 4096
def pages(label):
    mm = re.search(label + r":\s+(\d+)", vm)
    return int(mm.group(1)) if mm else 0
if vm:
    out["ram_free_mb"] = round(pages("Pages free") * page / 1048576)
    out["compressed_mb"] = round(pages("Pages occupied by compressor") * page / 1048576)

sw = sh("sysctl", "-n", "vm.swapusage")
m = re.search(r"total = ([\d.]+)M\s+used = ([\d.]+)M", sw)
if m:
    total, used = float(m.group(1)), float(m.group(2))
    out["swap_total_mb"] = round(total)
    out["swap_used_mb"] = round(used)
    out["swap_used_pct"] = round(used / total * 100) if total else None

la = sh("sysctl", "-n", "vm.loadavg")
m = re.search(r"([\d.]+)", la)
if m:
    out["load1"] = float(m.group(1))

print(json.dumps(out) if out else "null")
' 2>/dev/null)
  if [ -z "$out" ]; then
    probe_note host "vm_stat+sysctl" failed "vm_stat/sysctl produced no usable output"
    return 1
  fi
  probe_note host "vm_stat+sysctl" ok
  printf '%s' "$out"
}

# Cache for the Windows host probe: withheld (not annotated) past 30s, per
# D15/principle III. Keyed under CCWATCH_HOME because $TMPDIR is not carried
# between the tray app and a terminal invocation.
_probe_host_windows() {
  local cache="$CCWATCH_HOME/host-probe-cache.json" age now out

  if [ -f "$cache" ]; then
    now=$(date '+%s')
    age=$(( now - $(stat -c '%Y' "$cache" 2>/dev/null || printf '0') ))
    if [ "$age" -le 30 ]; then
      probe_note host powershell-cim ok "cached ${age}s ago"
      cat "$cache"
      return 0
    fi
  fi

  out=$(powershell -NoProfile -Command "
    \$os = Get-CimInstance Win32_OperatingSystem
    \$pf = Get-CimInstance Win32_PageFileUsage
    \$result = [ordered]@{ ram_free_mb = [math]::Round(\$os.FreePhysicalMemory / 1KB) }
    if (\$pf) {
      \$total = (\$pf | Measure-Object -Property AllocatedBaseSize -Sum).Sum
      \$used = (\$pf | Measure-Object -Property CurrentUsage -Sum).Sum
      \$result.swap_total_mb = \$total
      \$result.swap_used_mb = \$used
      \$result.swap_used_pct = if (\$total) { [math]::Round(\$used / \$total * 100) } else { \$null }
    } else {
      \$result.swap_total_mb = \$null
      \$result.swap_used_mb = \$null
      \$result.swap_used_pct = \$null
    }
    \$result.load1 = \$null
    \$result | ConvertTo-Json
  " 2>/dev/null | tr -d '\r')

  if [ -z "$out" ]; then
    probe_note host powershell-cim failed "powershell produced no usable output"
    return 1
  fi

  out=$(printf '%s' "$out" | jq -c '
    { ram_free_mb, swap_total_mb, swap_used_mb, swap_used_pct, load1: null,
      unavailable: (
        (if .swap_total_mb == null then [{field: "swap_used_pct", reason: "this host has no pagefile"}] else [] end)
        + [{field: "load1", reason: "Windows has no load average"}]
      ) }')

  mkdir -p "$CCWATCH_HOME" 2>/dev/null
  printf '%s' "$out" >"$cache" 2>/dev/null

  probe_note host powershell-cim ok
  printf '%s' "$out"
}

# probe_native_path / probe_posix_path — identity on macOS, cygpath on
# Windows (D5). Applied at bash<->native boundaries only.
probe_native_path() { # probe_native_path <path>
  case "$CCWATCH_PLATFORM" in
    windows) cygpath -w "$1" 2>/dev/null || printf '%s' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}
probe_posix_path() { # probe_posix_path <path>
  case "$CCWATCH_PLATFORM" in
    windows) cygpath -u "$1" 2>/dev/null || printf '%s' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

# probe_runners — which of the given session pids has a spec-run or
# spec-roadmap process somewhere beneath it. Prints a JSON array of those
# pids, or fails (non-zero, nothing printed) when the process table cannot be
# read.
#
# Only `revive` asks this, and it asks so it can tell an agent that went quiet
# because it is waiting on its runner from one that went quiet and forgot. The
# runner's own pid is not enough on its own: `spec-roadmap` records none, and
# it is the process an agent launches and then waits on.
#
# ⚠️ Fails rather than printing `[]` on an unreadable table. `[]` means "no
# runner under anything", and `revive` would read that as license to prod an
# agent whose runner is in fact still working — the empty-machine shape this
# section exists to prevent. Only a pid and a yes/no leave this function; the
# command lines themselves can carry arguments nobody asked to have copied.
#
# CCWATCH_FAKE_PSTREE substitutes `pid ppid command` lines, as CCWATCH_FAKE_PS
# does for liveness.
probe_runners() { # probe_runners <pid>...
  local table
  if [ -n "${CCWATCH_FAKE_PSTREE:-}" ]; then
    table=$(cat "$CCWATCH_FAKE_PSTREE" 2>/dev/null) || return 1
  else
    case "$CCWATCH_PLATFORM" in
      macos) table=$(ps -axo pid=,ppid=,command= 2>/dev/null) || return 1 ;;
      *) return 1 ;;
    esac
    # The same cross-check collect_live makes: a table this shell is not in
    # was refused, not empty.
    printf '%s\n' "$table" | awk -v me="$$" '$1 == me { found = 1 } END { exit !found }' || return 1
  fi
  printf '%s\n' "$table" | $CCWATCH_PY -c '
import json, re, sys
want = set(int(p) for p in sys.argv[1:] if p.isdigit())
parent, runner = {}, set()
rx = re.compile(r"(^|/)spec-(run|roadmap)(\s|$)")
for line in sys.stdin:
    parts = line.split(None, 2)
    if len(parts) < 2 or not parts[0].isdigit() or not parts[1].isdigit():
        continue
    pid, ppid = int(parts[0]), int(parts[1])
    parent[pid] = ppid
    # The executable or the script a shell is running, never an argument: a
    # `grep spec-run` must not count as a runner.
    words = (parts[2] if len(parts) > 2 else "").split()
    if any(rx.search(w) for w in words[:2]):
        runner.add(pid)
hit = set()
for pid in runner:
    seen, p = set(), parent.get(pid)
    while p and p not in seen:
        if p in want:
            hit.add(p)
        seen.add(p)
        p = parent.get(p)
print(json.dumps(sorted(hit)))
' "$@"
}

# ============================================================== collection ===

# collect_sessions — the live registry, one JSON object on stdout:
# {"rows": [...], "parse_failed": N}.
#
# Each file is parsed on its own rather than with a single `jq -s`, because a
# session that is mid-write would otherwise take the whole table down with it.
# One unreadable file costs one row, and parse_failed records how many so that
# `ccwatch doctor` can report it instead of quietly showing a short list.
# The count travels inside the returned object rather than a global, because a
# global written from inside `$(...)` never survives the subshell back to the
# caller — see research.md D6 for the entry this fixed.
collect_sessions() {
  local f n=0 fast count
  [ -d "$SESS_DIR" ] || { printf '{"rows":[],"parse_failed":0}'; return 0; }
  n=$(find "$SESS_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | wc -l | tr -d ' ')
  [ "${n:-0}" -gt 0 ] || { printf '{"rows":[],"parse_failed":0}'; return 0; }

  # Fast path: ONE jq over every file at once. Registry files are single-line
  # JSON, so `fromjson? // empty` per line both parses them and tolerates a
  # file caught mid-write. This replaced a jq process per file, which cost
  # ~1.1s of pure fork overhead on 19 sessions — the single largest slice of a
  # snapshot that needs to complete inside a 2s repaint.
  fast=$(cat "$SESS_DIR"/*.json 2>/dev/null \
         | jq -c -R 'fromjson? // empty | select(type == "object")' 2>/dev/null | jq -s '.')
  count=$(printf '%s' "$fast" | jq 'length' 2>/dev/null) || count=0

  if [ "${count:-0}" -eq "$n" ]; then
    jq -cn --argjson rows "$fast" --argjson win "$([ "$CCWATCH_PLATFORM" = windows ] && printf true || printf false)" \
      '{rows: ($rows | map(if $win and (.cwd // null) != null then .cwd |= gsub("\\\\";"/") else . end)), parse_failed: 0}'
    return 0
  fi

  # Slow path, taken only when the fast one came up short. Parsing each file on
  # its own is how the count gets accurate — and an accurate count is the
  # point, because `ccwatch doctor` reports it. Guessing "n - count" would also
  # be wrong for a pretty-printed file, which the fast path splits across lines
  # and drops entirely. The loop runs in the function's own shell (no pipeline
  # stage, no subshell) so the accumulated rows and the failure count both
  # reach the return value.
  local -a rows_arr=()
  local pf=0 line
  for f in "$SESS_DIR"/*.json; do
    [ -f "$f" ] || continue
    line=$(jq -c '. as $o | if ($o|type) == "object" then $o else empty end' "$f" 2>/dev/null)
    if [ -n "$line" ]; then
      rows_arr+=("$line")
    else
      pf=$((pf + 1))
    fi
  done
  local win
  win=$([ "$CCWATCH_PLATFORM" = windows ] && printf true || printf false)
  if [ ${#rows_arr[@]} -gt 0 ]; then
    printf '%s\n' "${rows_arr[@]}" | jq -cs --argjson pf "$pf" --argjson win "$win" \
      '{rows: (map(if $win and (.cwd // null) != null then .cwd |= gsub("\\\\";"/") else . end)), parse_failed: $pf}'
  else
    jq -cn --argjson pf "$pf" '{rows: [], parse_failed: $pf}'
  fi
}

# collect_live — {pid, start, cpu} for every registry pid still running.
#
# `kill -0` alone is not enough: PIDs are recycled, and a stale registry file
# whose number now belongs to an unrelated process would show as a live Claude
# session. So the process's real start time is compared against the session's
# own `startedAt`. A mismatch means the file outlived its process and the number
# was reused — that session is gone, whatever the file says.
#
# Note the trap for anyone extending this: the registry's `procStart` string is
# UTC while `ps -o lstart=` prints local time, so comparing those two strings
# directly marks every session an impostor. Comparing epochs sidesteps it.
#
# `cpu` is cumulative CPU seconds, and it is the second independent progress
# signal. It matters because it is the only one that works for EVERY session:
# an embedded-SDK session writes no transcript and publishes no status, so
# without this there would be a whole class of session about which ccwatch could
# say nothing at all. Between two frames, CPU that moved means the process is
# doing work; CPU that did not, alongside a transcript that did not grow, is
# what turns a guess about a hang into two agreeing measurements.
collect_live() {
  local pids out sessions="$1"
  pids=$(printf '%s' "$sessions" | jq -r '[.[].pid // empty] | join(",")')
  [ -n "$pids" ] || { printf '[]'; return 0; }
  # The process-facts probe (bin/ccwatch's `platform` section) does the
  # per-platform work; this call site only asks for it. Nothing printed at
  # all means the probe failed outright, which require_json names as a
  # failure rather than an empty machine — see probe_proc's own comment for
  # the measured reason this distinction exists.
  out=$(probe_proc "$pids")
  [ -n "$out" ] && printf '%s' "$out"
  return 0
}

# CPU is only meaningful as a delta, which needs a previous sample.
#
# ⚠️ Three things this has to get right, all learned the hard way.
#
# 1. It is keyed by the config directory being observed. The first version used
#    one global path, so a `ccwatch serve` polling the real registry every two
#    seconds silently overwrote the samples belonging to a run against a
#    different CLAUDE_CONFIG_DIR. Both processes then reported no CPU movement
#    and flagged healthy sessions as hung.
# 2. Samples carry their own timestamp, so the delta is measured over the
#    interval that actually elapsed rather than over an assumed "last frame".
#    Two watchers on the same machine then cooperate — either one's sample is a
#    valid baseline for the other — instead of fighting.
# 3. A sample less than CCWATCH_CPU_MIN_GAP old yields null, not zero. Sub-second
#    gaps measure nothing, and "measured no progress" is the claim that escalates
#    a quiet session to HUNG. Getting this wrong invents hangs.
#
# In $TMPDIR rather than CCWATCH_HOME because it is worthless across a reboot —
# the very event that invalidates every pid in it.
CPU_CACHE="${TMPDIR:-/tmp}/ccwatch-cpu-$(id -u)-$(printf '%s' "$CLAUDE_HOME" | cksum | cut -d' ' -f1).json"
CCWATCH_CPU_MIN_GAP="${CCWATCH_CPU_MIN_GAP:-1.5}"

# collect_transcripts — {sid, mtime} for the given session ids.
#
# Globbed by session id rather than by reconstructing the escaped-cwd directory
# name, because that escaping is lossy (both `/` and `.` collapse to `-`) and
# guessing it wrong would silently report "no transcript" for a healthy session
# — precisely the class of quiet mistake this tool exists to prevent.
collect_transcripts() { # collect_transcripts <sid>...
  local out
  [ -d "$PROJ_DIR" ] || { printf '[]'; return 0; }
  [ $# -gt 0 ] || { printf '[]'; return 0; }
  # ONE traversal of the transcript tree, filtered afterwards, rather than a
  # glob per session id. The previous version expanded
  # "$PROJ_DIR"/*/<sid>.jsonl once per live session — 17 globs across 94
  # project directories over a 1.7GB tree — and the directory walking, not the
  # process count, was where the seconds went.
  #
  # Session transcripts sit at depth 2. Subagent sidechains live deeper and are
  # deliberately out of scope: they are not sessions and have no registry entry.
  out=$(printf '%s\n' "$@" | $CCWATCH_PY -c '
import json, os, sys

proj = sys.argv[1]
wanted = {line.strip() for line in sys.stdin if line.strip()}
out = []
try:
    for project in os.scandir(proj):
        if not project.is_dir():
            continue
        try:
            entries = os.scandir(project.path)
        except OSError:
            continue
        with entries:
            for e in entries:
                if not e.name.endswith(".jsonl"):
                    continue
                sid = e.name[:-6]
                if sid not in wanted:
                    continue
                try:
                    out.append({"sid": sid, "mtime": int(e.stat().st_mtime)})
                except OSError:
                    continue
except OSError:
    pass
print(json.dumps(out))
' "$(probe_native_path "$PROJ_DIR")" 2>/dev/null)
  [ -n "$out" ] && printf '%s' "$out"
  return 0
}

# collect_pipelines — spec-run's own record, for each distinct working directory.
#
# Emits every phase, not a pre-chosen one, because the choice of which phase
# matters depends on WHICH SESSION is asking: a phase records the session id of
# the `claude -p` process that ran it, so a phase can be attached to the exact
# session that owns it rather than to every session that happens to share a
# directory. Attaching by directory was the first thing tried here and it lied —
# four sessions in one repo all claimed the same run.
collect_pipelines() {
  local cwd
  local -a states=()
  for cwd in "$@"; do
    # Every state file in the repo, not just the newest: an abandoned run in an
    # older feature is exactly the debris worth reporting.
    for state in "$cwd"/specs/*/.pipeline/state.json; do
      [ -f "$state" ] && states+=("$state")
    done
  done
  [ ${#states[@]} -gt 0 ] || { printf '[]'; return 0; }

  # ONE jq for all of them. The previous version forked a jq per state file;
  # with ~70 files across six repos that was ~5 seconds — measured with
  # CCWATCH_PROFILE=1, and by far the largest slice of the snapshot.
  #
  # `input_filename` is what makes this possible: it identifies which file the
  # current input came from, so the repo path can still be derived per state
  # file without passing it in as an argument.
  jq -c '
    ( input_filename | sub("/specs/[^/]+/\\.pipeline/state\\.json$"; "") ) as $cwd
    | { cwd: $cwd,
        feature: ((.feature_dir // "") | split("/") | last),
        branch:  (.branch // ""),
        cost:    ([ (.phases // {}) | .[].cost_usd // 0 ] | add // 0),
        phases: [ ( .phases // {} ) | to_entries[]
                  | { name: .key,
                      status: (.value.status // ""),
                      model:  (.value.model // ""),
                      cost:   (.value.cost_usd // 0),
                      # The runner pid is the whole game for a `running` phase:
                      # spec-run records it, and a `running` phase whose runner
                      # is gone is a crash — not an opinion, a fact. spec-run
                      # reconciles that to `interrupted` on its next
                      # invocation, but that could be days away, and until then
                      # this is the only place it shows.
                      runner_pid: (.value.runner_pid // null),
                      started_at: (.value.started_at // null),
                      # Both keys: older runs recorded a single session_id,
                      # chunked phases record a list. Missing either way would
                      # silently break the attach.
                      sids: ( [ .value.session_id // empty ]
                              + ( .value.sessions // [] ) | unique ) } ] }
  ' "${states[@]}" 2>/dev/null | jq -s '.'
}

# ============================================================== statusline ===
#
# Where the usage numbers come from, and why this route rather than the API.
#
# Claude Code hands its statusline command a JSON payload on stdin, and that
# payload already contains `rate_limits` (five_hour / seven_day / spend_limit,
# each with a used percentage and a reset time) and `context_window` (per
# session). So the numbers are available WITHOUT touching a credential.
#
# The alternative is `GET /api/oauth/usage`, which is where `/usage` gets the
# same figures — but that needs the OAuth token out of the keychain, and a
# monitoring tool that handles your credential in order to display a percentage
# is a bad trade. This route reads a feed Claude Code is already pushing.
#
# Two consequences worth knowing:
#   - Only sessions with a statusline contribute, which means only interactive
#     ones. Fine for rate limits (account-wide — one reporter is enough), and
#     the reason the context column is blank for headless rows.
#   - The figures are as fresh as your statusline refreshInterval, so the file
#     records when it was written and the table ages it out rather than
#     presenting a stale number as current.

cmd_statusline() {
  local dsid=""
  # This runs on every statusline repaint, in the critical path of the user's
  # prompt. It must never fail, never be slow, and never print anything to
  # stdout that is not statusline text.
  local exec_cmd=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --exec) exec_cmd="${2:-}"; shift 2 || break;;
      *) shift;;
    esac
  done

  local payload
  payload=$(cat 2>/dev/null) || payload=""

  # ⚠️ A diagnostic for exactly one question: when two sessions report
  # different rate-limit figures for the same instant, which of them is
  # describing something else? Nothing else records the WHOLE payload, so that
  # question was unanswerable, and it got answered with "we cannot know" —
  # which was not good enough.
  #
  # Opt-in by flag file rather than env var, because a statusline command is
  # configured once in settings.json and inherits no environment you can vary
  # per session:
  #     touch ~/.claude/ccwatch/debug-payloads    # start
  #     rm    ~/.claude/ccwatch/debug-payloads    # stop
  # One file per session, overwritten, so it cannot grow without bound.
  if [ -f "$CCWATCH_HOME/debug-payloads" ] && [ -n "$payload" ]; then
    {
      mkdir -p "$CCWATCH_HOME/payloads" 2>/dev/null
      dsid=$(printf '%s' "$payload" | jq -r '.session_id // "unknown"' 2>/dev/null)
      printf '%s' "$payload" | jq -c . >"$CCWATCH_HOME/payloads/${dsid}.json" 2>/dev/null
    } >/dev/null 2>&1
  fi

  # Everything in this block is best-effort. A failure here would otherwise
  # break the status line of whichever session happened to be running.
  {
    mkdir -p "$CCWATCH_HOME" "$CTX_DIR" "$USAGE_DIR" 2>/dev/null

    printf '%s' "$payload" | jq -c --arg at "$(date '+%s')" '
      select(.rate_limits != null)
      | { at: ($at|tonumber),
          session: (.session_id // null),
          five_hour: .rate_limits.five_hour,
          seven_day: .rate_limits.seven_day,
          seven_day_opus: .rate_limits.seven_day_opus,
          spend_limit: .rate_limits.spend_limit }' 2>/dev/null \
      >"$USAGE_FILE.tmp" && [ -s "$USAGE_FILE.tmp" ] && mv "$USAGE_FILE.tmp" "$USAGE_FILE"
    rm -f "$USAGE_FILE.tmp"

    # The same reading, kept under the session that reported it. `usage.json`
    # above stays for a mixed install: an older statusline still writing only
    # that file keeps working, and collect_usage falls back to it when no
    # per-reporter file is fresh.
    local usid
    usid=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
    if [ -n "$usid" ]; then
      printf '%s' "$payload" | jq -c --arg at "$(date '+%s')" --arg sid "$usid" '
        select(.rate_limits != null)
        | { at: ($at|tonumber), session: $sid,
            five_hour: .rate_limits.five_hour,
            seven_day: .rate_limits.seven_day,
            seven_day_opus: .rate_limits.seven_day_opus,
            spend_limit: .rate_limits.spend_limit }' 2>/dev/null \
        >"$USAGE_DIR/$usid.json.tmp" \
        && [ -s "$USAGE_DIR/$usid.json.tmp" ] \
        && mv "$USAGE_DIR/$usid.json.tmp" "$USAGE_DIR/$usid.json"
      rm -f "$USAGE_DIR/$usid.json.tmp"
    fi

    # Per-session, keyed by session id so a row can find its own. The cost
    # figure comes along because it is in the same payload and is the only
    # per-session spend number available for a session that is not a spec-run
    # phase.
    local sid
    sid=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
    if [ -n "$sid" ]; then
      printf '%s' "$payload" | jq -c --arg at "$(date '+%s')" '
        { at: ($at|tonumber),
          used_percentage: (.context_window.used_percentage // null),
          window: (.context_window.context_window_size // null),
          cost_usd: (.cost.total_cost_usd // null),
          model: (.model.display_name // .model.id // null),
          effort: (.effort.level // null) }' 2>/dev/null \
        >"$CTX_DIR/$sid.json.tmp" \
        && [ -s "$CTX_DIR/$sid.json.tmp" ] && mv "$CTX_DIR/$sid.json.tmp" "$CTX_DIR/$sid.json"
      rm -f "$CTX_DIR/$sid.json.tmp"
    fi
  } >/dev/null 2>&1

  # Compose rather than replace. Wrapping an existing statusline means you keep
  # it and gain the feed; replacing it would make adopting ccwatch cost you the
  # status line you already tuned.
  if [ -n "$exec_cmd" ]; then
    printf '%s' "$payload" | eval "$exec_cmd" 2>/dev/null || true
  else
    # Standalone use: something has to be printed, or the status line is blank.
    printf '%s' "$payload" | jq -r '
      def pct(x): if x == null then empty else "\(x.used_percentage | floor)%" end;
      [ (if .rate_limits.five_hour != null then "5h \(pct(.rate_limits.five_hour))" else empty end),
        (if .rate_limits.seven_day != null then "7d \(pct(.rate_limits.seven_day))" else empty end),
        (if .context_window.used_percentage != null
         then "ctx \(.context_window.used_percentage | floor)%" else empty end)
      ] | join("  ")' 2>/dev/null || true
  fi
  exit 0
}

# install-statusline wires the wrapper IN FRONT of whatever is already
# configured, so the existing command keeps running and its output is what you
# still see. It shows the change and asks first, like install-hooks.
cmd_install_statusline() {
  local settings="$CLAUDE_HOME/settings.json"
  local self
  self=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")
  [ -f "$settings" ] || die "no settings file at $settings" \
    "create it first, or point CLAUDE_CONFIG_DIR at the right directory"

  local current proposed
  current=$(jq -r '.statusLine.command // empty' "$settings" 2>/dev/null)

  case "$current" in
    *"ccwatch statusline"*)
      say "Already wired:"
      say "  ${_c_dim}$current${_c_reset}"
      return 0;;
  esac

  if [ -n "$current" ]; then
    say "You already have a statusline command:"
    say "  ${_c_dim}$current${_c_reset}"
    say ""
    say "ccwatch will run ${_c_bold}in front of it${_c_reset} and pass its output through, so"
    say "what you see does not change — it just also records the usage numbers."
    say ""
    proposed=$(jq --arg cmd "$self statusline --exec '$current'" \
      '.statusLine = ((.statusLine // {type:"command"}) | .type = "command" | .command = $cmd)' \
      "$settings") || die "could not compute the settings change" "is $settings valid JSON?"
  else
    proposed=$(jq --arg cmd "$self statusline" \
      '.statusLine = {type:"command", command:$cmd, refreshInterval:10}' \
      "$settings") || die "could not compute the settings change" "is $settings valid JSON?"
  fi

  say "${_c_bold}This will set${_c_reset} .statusLine.command ${_c_bold}in${_c_reset} $settings"
  say ""
  printf '%s' "$proposed" | jq -r '"  " + .statusLine.command'
  say ""
  printf 'Apply? [y/N] '
  local reply=""
  read -r reply
  case "$reply" in
    y|Y|yes|YES) ;;
    *) say "Nothing changed."; return 0;;
  esac

  local backup
  backup="$settings.ccwatch-backup.$(date '+%Y%m%d%H%M%S')"
  cp "$settings" "$backup" || die "could not back up $settings"
  printf '%s\n' "$proposed" >"$settings.ccwatch-tmp" \
    && mv "$settings.ccwatch-tmp" "$settings" \
    || die "could not write $settings" "your original is at $backup"
  mkdir -p "$CCWATCH_HOME" "$CTX_DIR"
  say "${_c_green}Wired.${_c_reset} Previous settings saved to $backup"
  say "${_c_dim}Existing sessions pick it up on their next repaint.${_c_reset}"
}

# collect_usage / collect_context — read the feed back.
#
# Both report their own age. A percentage with no timestamp is the same failure
# this whole tool exists to avoid: a number presented as current when nobody
# knows whether it is.
# collect_usage — the account-wide reading, reconstructed from every session
# that reports one.
#
# ⚠️ Why the highest reading wins, and why this is not a guess. Captured from
# twelve real payloads with `debug-payloads`:
#
#     session   model               5h%    resets_at
#     42591a89  claude-fable-5-1     26   1789961400
#     319aa7d0  claude-opus-5[1m]    32   1789961400
#     6d9d48c2  claude-sonnet-5      35   1789961400
#     2638948e  claude-opus-5[1m]    36   1789961400
#     921774f7  claude-opus-5[1m]    42   1789961400
#
# Every session reports the SAME `resets_at`, so they are all describing one
# window of one account — they are not measuring different things, and the
# model makes no difference either. What differs is when each session last
# fetched the figure: Claude Code does not refetch the rate limit on every
# statusline repaint, so each payload carries that session's last known value.
# Eight sessions written within two seconds of each other were carrying caches
# minutes apart.
#
# Within a window `used_percentage` only climbs — usage accrues and resets, it
# does not decay — so every reading is a valid LOWER BOUND on the figure now,
# and the largest is the freshest. Maximum per window, grouped by `resets_at`
# so a reading left over from the previous window cannot drag the answer down.
#
# ⚠️ This replaced withholding the number whenever readings disagreed, which
# was wrong and disruptive: it hid the figure on a machine where the figure was
# perfectly knowable, and it was reported as such ("8 sessions report different
# figures — not shown"). Constitution III withholds a reading nobody can stand
# behind; it does not license refusing to work out which reading is right.
collect_usage() {
  local out
  mkdir -p "$USAGE_DIR" 2>/dev/null
  # The legacy single file is read as one more reporter, de-duplicated by
  # session, because `ccwatch statusline` writes the same reading to both.
  out=$( { cat "$USAGE_DIR"/*.json 2>/dev/null; cat "$USAGE_FILE" 2>/dev/null; } \
    | jq -sc --argjson now "$(date '+%s')" \
          --argjson stale "$CCWATCH_USAGE_STALE" '
    # Staleness is NOT filtered here: a feed that died an hour ago and one that
    # was never installed are different facts, and dropping the old reading
    # would render them identically (constitution IV). The age is reported and
    # the renderers decide.
    [ .[] | select(type == "object" and .at != null) | . + { age: ($now - .at) } ]
    | group_by(.session // "legacy")
    | map(sort_by(-.at) | .[0])
    | sort_by(-.at)
    | if length == 0 then null
      else
        . as $all
        | [ $all[] | select(.age <= $stale) ] as $fresh

        # best(window) — the freshest known figure for one window, which is the
        # largest among the readings that agree on when it resets.
        # ⚠️ Same window means resets_at NEAR the latest, not equal to it.
        # Exact equality was the first version and it is a trap: two sessions
        # reporting an instant one second apart would be treated as two
        # different windows, and the higher — that is, fresher — reading would
        # be silently discarded. Caught by an assertion that passed alone and
        # failed in the full suite, because the fixture generated the
        # resets_at of each reading from its own clock.
        #
        # (No apostrophes in this program. It is a single-quoted jq argument
        # and one closes it, giving a bash syntax error hundreds of lines from
        # the typo. That is twice now.)
        # A window that has actually rolled moves by its whole length: five
        # hours for five_hour, days for the others. Ten minutes of slack
        # separates those two cases with room to spare and tolerates any
        # plausible skew between sessions.
        | def best(sel):
            [ $fresh[] | sel | select(. != null) | select(.used_percentage != null) ]
            | if length == 0 then null
              else ( [ .[] | .resets_at ] | map(select(. != null))
                     | if length == 0 then null else max end ) as $w
                   | [ .[] | select(($w == null) or (.resets_at == null)
                                    or (($w - .resets_at) <= 600)) ]
                   | sort_by(-.used_percentage) | .[0]
              end;

        ( $fresh[0] // $all[0] ) as $newest
        | $newest
          + { stale_after: $stale,
              reporters: ($fresh | length),
              five_hour:      best(.five_hour),
              seven_day:      best(.seven_day),
              seven_day_opus: best(.seven_day_opus) }
      end' 2>/dev/null)
  if [ -n "$out" ] && [ "$out" != "null" ]; then printf '%s' "$out"; else printf 'null'; fi
}

collect_context() { # collect_context <sid>...
  local sid
  [ -d "$CTX_DIR" ] || { printf '[]'; return 0; }
  {
    for sid in "$@"; do
      [ -f "$CTX_DIR/$sid.json" ] || continue
      jq -c --arg sid "$sid" --argjson now "$(date '+%s')" \
        '. + { sid: $sid, age: ($now - .at) }' "$CTX_DIR/$sid.json" 2>/dev/null
    done
  } | jq -s '.'
}

# ============================================================== the join =====

# snapshot — one JSON array, one object per live session, fully classified.
#
# All the judgement lives in this jq program so that `ccwatch`, `ccwatch --json` and
# the watch loop can never disagree about what a session's status is.
# pids_alive — of the pids given, which are still running. Used for spec-run's
# recorded runner pids, which are not Claude processes and so never appear in
# the session registry.
pids_alive() {
  local csv
  csv=$(printf '%s' "$1" | tr ' ' ',' | sed 's/^,*//; s/,*$//')
  [ -n "$csv" ] || { printf '[]'; return 0; }
  ps_out "$csv" | awk '{print $1}' | jq -R 'select(length>0) | tonumber' | jq -s '.'
}

# require_json — a collector's output really is JSON, or say which one failed.
#
# ⚠️ An empty collector output must never reach `jq --argjson`. jq dies with
# "invalid JSON text passed to --argjson", which names no stage and reads like
# a bug in ccwatch rather than what it is: a collector that returned nothing.
# Found when the host ran out of memory mid-snapshot — `ccwatch kill` then
# reported the resulting failure as an ambiguous name match, so the visible
# symptom pointed at the wrong thing entirely.
#
# Defaulting an empty producer to `[]` or `{}` would be worse than the crash.
# A collector that failed would be presented as a host with nothing to show,
# which is the single thing this tool exists not to do.
# ⚠️ The check is `jq empty`, which asks only "does this parse". `jq -e .` looks
# equivalent and is not: it exits 1 for `null` and `false`, and `null` is a
# legitimate value here — `collect_usage` returns it when no statusline has ever
# reported, and `host` is passed as `${host:-null}`. Using `-e` made a machine
# with no usage feed report "collect_usage produced no usable JSON", turning a
# normal condition into a failure, which is the same mistake in the opposite
# direction as the bug this function exists to fix.
# ⚠️ The test is "exactly ONE JSON value", not "this parses". `jq empty`
# accepts a STREAM of values, and `--argjson` accepts exactly one — so the
# guard was weaker than the constraint it exists to enforce, and the one shape
# that mattered walked straight through it. Measured on a real machine:
# `collect_live` returned `[]\n[]`, `jq empty` passed it, and two lines later
# the operator got
#     jq: invalid JSON text passed to --argjson
# with no stage named — which is the exact failure the comment above describes
# and this function was written to replace. `jq -s length` counts the values,
# which is the property `--argjson` actually requires.
#
# `null` and `false` each count as one and still pass, which they must:
# `collect_usage` returns `null` on any machine with no statusline wired, and
# rejecting that would turn a normal condition into a failure.
require_json() { # require_json <stage> <value>
  if [ -n "$2" ] && [ "$(printf '%s' "$2" | jq -s 'length' 2>/dev/null)" = "1" ]; then
    return 0
  fi
  err "snapshot: $1 produced no usable JSON — it failed or was killed"
  printf '  %s\n' "if the host is under memory pressure, the OS may have killed it mid-run" >&2
  return 1
}

snapshot() {
  local sessions_obj sessions parse_failed live transcripts pipelines sids cwds now
  now=$(date '+%s')
  prof start
  sessions_obj=$(collect_sessions)
  require_json collect_sessions "$sessions_obj" || return 1
  sessions=$(printf '%s' "$sessions_obj" | jq -c '.rows')
  parse_failed=$(printf '%s' "$sessions_obj" | jq -r '.parse_failed // 0')
  prof collect_sessions

  live=$(collect_live "$sessions")
  require_json collect_live "$live" || return 1
  prof collect_live

  # Only live sessions are worth gathering the expensive signals for. A dead
  # registry file is `ccwatch resume`'s business, not the table's.
  local live_sessions
  live_sessions=$(printf '%s' "$sessions" | jq -c \
    --argjson live "$live" --argjson tol 300 '
      ( $live | map({ key: (.pid|tostring), value: .start }) | from_entries ) as $L
      | [ .[]
          | select(.pid != null)
          | . as $s
          | ($L[.pid|tostring]) as $ps
          | select($ps != null)
          # PID reuse guard: the process running under this number must have
          # started when this session did, within a few minutes of slack.
          | select( $ps == 0 or (($ps - (($s.startedAt // 0) / 1000)) | fabs) <= $tol )
        ]')

  sids=$(printf '%s' "$live_sessions" | jq -r '[.[].sessionId // empty] | .[]')
  cwds=$(printf '%s' "$live_sessions" | jq -r '[.[].cwd // empty] | unique | .[]')

  # shellcheck disable=SC2086
  transcripts=$(collect_transcripts $sids)
  require_json collect_transcripts "$transcripts" || return 1
  prof collect_transcripts
  local ctx usage
  # shellcheck disable=SC2086
  ctx=$(collect_context $sids)
  require_json collect_context "$ctx" || return 1
  usage=$(collect_usage)
  require_json collect_usage "$usage" || return 1
  local host
  host=$(collect_host)
  prof collect_host
  pipelines='[]'
  if [ -n "$cwds" ]; then
    local -a cwda=()
    while IFS= read -r c; do [ -n "$c" ] && cwda+=("$c"); done <<<"$cwds"
    [ ${#cwda[@]} -gt 0 ] && pipelines=$(collect_pipelines "${cwda[@]}")
  fi
  prof collect_pipelines

  # What the blocked sessions are actually asking. Only for sessions the
  # registry says are waiting — normally none or one — so this is not a
  # transcript read per session.
  local waiting_sids asks
  waiting_sids=$(printf '%s' "$live_sessions" | jq -r '.[] | select(.status == "waiting") | .sessionId // empty')
  asks='{}'
  if [ -n "$waiting_sids" ]; then
    # shellcheck disable=SC2086
    asks=$(collect_asks $waiting_sids)
  fi
  prof collect_asks

  # Which repository each directory actually belongs to. Needed by both the
  # session rows and the unfinished-run rows, so it covers both sets of cwds.
  local repos allcwds
  allcwds=$( { printf '%s\n' "$cwds"
               printf '%s' "$pipelines" | jq -r '.[].cwd // empty'; } | sort -u )
  local -a rcwda=()
  while IFS= read -r c; do [ -n "$c" ] && rcwda+=("$c"); done <<<"$allcwds"
  if [ ${#rcwda[@]} -gt 0 ]; then repos=$(collect_repos "${rcwda[@]}"); else repos='{}'; fi
  prof collect_repos

  # Which of spec-run's recorded runner pids are still up.
  local runners runners_alive
  runners=$(printf '%s' "$pipelines" | jq -r '[.[].phases[].runner_pid // empty] | unique | join(" ")')
  runners_alive=$(pids_alive "$runners")

  # The previous samples, and the merged write-back. Merging rather than
  # replacing is what lets two watchers share the file without destroying each
  # other's baselines.
  local prev='{}' nowf
  nowf=$(perl -MTime::HiRes -e 'print Time::HiRes::time()' 2>/dev/null) || nowf="$now"
  # ⚠️ Slurped, so a cache holding more than one object yields `{}` rather than
  # a stream. `jq -c 'if type == "object" …'` without -s is a per-value filter:
  # handed a file with two objects in it, it prints BOTH, jq exits 0, the `||`
  # never fires, and `$prev` becomes `{}\n{}` — which `--argjson prev` two
  # lines down refuses outright, taking every snapshot with it.
  #
  # That file really does end up holding two objects, and this is the second
  # half of one bug: the writer below feeds `$live` to `jq`, and while
  # collect_live was appending its fallback, `$live` was two values, so the
  # reduce ran twice and wrote two objects. The writer is fixed, but a cache
  # poisoned before that fix would otherwise break ccwatch on that machine
  # for good — the read has to heal it, not just stop causing it. Measured
  # here: one real cache file with 2 values, and `ccwatch --json` dead until
  # this discarded it.
  #
  # Discarding costs one CPU baseline, which the next frame re-establishes.
  if [ -f "$CPU_CACHE" ]; then
    prev=$(jq -cs 'if length == 1 and (.[0] | type) == "object" then .[0] else {} end' \
           "$CPU_CACHE" 2>/dev/null) || prev='{}'
    [ -n "$prev" ] || prev='{}'
  fi
  printf '%s' "$live" | jq -c --argjson prev "$prev" --argjson at "$nowf" \
    --argjson gap "$CCWATCH_CPU_MIN_GAP" '
    # Keep a previous sample when it is still too fresh to have produced a
    # usable gap: overwriting it would reset the baseline on every repaint and
    # make the delta permanently unmeasurable at a fast refresh rate.
    reduce .[] as $s ($prev;
      ($s.pid|tostring) as $k
      | if (.[$k] != null) and (($at - .[$k].at) < $gap) then .
        else .[$k] = { cpu: $s.cpu, at: $at } end)' \
    >"$CPU_CACHE.tmp" 2>/dev/null && mv "$CPU_CACHE.tmp" "$CPU_CACHE" 2>/dev/null || true

  printf '%s' "$live_sessions" | jq \
    --argjson parse_failed "$parse_failed" \
    --argjson t "$transcripts" \
    --argjson p "$pipelines" \
    --argjson live "$live" \
    --argjson prev "$prev" \
    --argjson nowf "$nowf" \
    --argjson cpu_gap "$CCWATCH_CPU_MIN_GAP" \
    --argjson runners "$runners_alive" \
    --argjson now "$now" \
    --argjson busy_stale "$CCWATCH_BUSY_STALE" \
    --argjson sdk_stale "$CCWATCH_SDK_STALE" \
    --argjson unfinished_hours "$CCWATCH_UNFINISHED_HOURS" \
    --argjson ctx "$ctx" \
    --argjson usage "$usage" \
    --argjson host "${host:-null}" \
    --argjson swap_warn "$CCWATCH_SWAP_WARN" \
    --argjson ctx_stale "$CCWATCH_CTX_STALE" \
    --argjson repos "$repos" \
    --argjson asks "${asks:-\{\}}" '
    # Shared by session rows and unfinished-run rows, and derived from the git
    # REMOTE rather than the path — see collect_repos for why the path version
    # was wrong three different ways.
    #
    # A directory with no remote (a scratch dir, /tmp) falls back to its
    # basename and is marked so, rather than being silently lumped in with a
    # real repository.
    def repo_of(cwd): ($repos[cwd // ""] // {});
    def project(cwd):
      (repo_of(cwd)) as $r
      | if ($r.slug // "") != "" then ($r.slug | split("/") | last)
        else ((cwd // "?") | split("/") | last | if . == "" then "/" else . end)
        end;
    ( $t | map({ key: .sid, value: .mtime }) | from_entries ) as $T
    # One entry per session id that spec-run recorded, so a phase can be
    # attached to the session that actually ran it. `crashed` is decided once,
    # here, against the live runner pids.
    | ( [ $p[]
          | .feature as $f | .cwd as $c | .cost as $rc
          | .phases[]
          | . as $ph
          | ( $ph.status == "running"
              and $ph.runner_pid != null
              and ($runners | index($ph.runner_pid)) == null ) as $crashed
          | $ph.sids[]
          | { key: .,
              value: { feature: $f, cwd: $c, phase: $ph.name,
                       status: $ph.status, model: $ph.model,
                       # The run total, not this phase alone — a phase still
                       # running has spent nothing yet, and "$0" under a live
                       # run reads as a broken number rather than a true one.
                       cost: $rc,
                       runner_pid: $ph.runner_pid, started_at: $ph.started_at,
                       crashed: $crashed } } ]
        | from_entries ) as $P
    | ( $live | map({ key: (.pid|tostring), value: .cpu }) | from_entries ) as $C
    | ( $live | map({ key: (.pid|tostring), value: .rss_mb }) | from_entries ) as $M
    | $prev as $PC
    | ( $ctx | map({ key: .sid, value: . }) | from_entries ) as $X
    | [ .[]
        | . as $s
        | ($s.sessionId // "") as $sid
        | ($T[$sid]) as $mtime
        # quiet: seconds since the transcript last grew. null means there is no
        # transcript to read at all, which is itself reported rather than
        # silently treated as fresh.
        # Clamped at zero. `$now` is captured at the start of the snapshot and
        # the transcript is stat-ed after, so a session writing right now has an
        # mtime a second or two AHEAD of it — which rendered as "-2s ago".
        | (if $mtime == null then null else ([$now - $mtime, 0] | max) end) as $quiet
        | ($s.status) as $st
        # Two very different kinds of statusless session, and conflating them
        # produces a false alarm on every one of the second kind:
        #   sdk-cli  `claude -p` — what spec-run spawns. Writes a transcript,
        #            so transcript silence is a real signal.
        #   sdk-ts   the TypeScript SDK embedded in another program. Writes NO
        #            transcript, ever. Silence there measures nothing, so it is
        #            never reported as a hang — only CPU can speak for these.
        | (($s.entrypoint // "") == "sdk-cli") as $is_sdk_cli
        | (($s.entrypoint // "") | startswith("sdk")) as $is_sdk
        | ($C[$s.pid|tostring]) as $cpu
        # null = no previous frame yet. Distinct from 0, which means measured
        # and did not move. The classification below never treats the first as
        # if it were the second.
        | ($PC[$s.pid|tostring]) as $psample
        | (if $psample == null or $cpu == null
                or (($nowf - $psample.at) < $cpu_gap) then null
           else ($cpu - $psample.cpu) end) as $cpud
        | ($cpud != null and $cpud > 0.05) as $cpu_moved
        | (if   $st == "waiting" then
               { sev: 4, token: "waiting", note: ($s.waitingFor // "input needed") }

           # --- interactive, claims to be working ---------------------------
           # A transcript that has gone quiet is suspicion, not proof: one Bash
           # call running a long test suite is legitimately silent. So CPU gets
           # a vote. Quiet AND no CPU is two signals agreeing. Quiet WITH CPU
           # is a session that is genuinely working, and saying HUNG there
           # would be the cry-wolf that stops you reading the column at all.
           elif $st == "busy" and $quiet == null and $cpu_moved then
               { sev: 2, token: "busy", note: "no transcript; cpu moving" }
           elif $st == "busy" and $quiet == null then
               { sev: 3, token: "NO TRANSCRIPT", note: "cannot verify progress" }
           elif $st == "busy" and $quiet > $busy_stale and $cpu_moved then
               { sev: 2, token: "busy", note: "quiet but cpu moving" }
           elif $st == "busy" and $quiet > ($busy_stale * 3) then
               { sev: 3, token: "HUNG!!", note: "quiet" }
           elif $st == "busy" and $quiet > $busy_stale then
               { sev: 3, token: "HUNG?", note: "quiet" }
           elif $st == "busy"  then { sev: 2, token: "busy",  note: "" }
           elif $st == "shell" then { sev: 1, token: "shell", note: "" }
           elif $st == "idle"  then { sev: 0, token: "idle",  note: "" }

           # --- headless `claude -p`: transcript is trustworthy here ---------
           elif $is_sdk_cli and $quiet == null then
               { sev: 3, token: "NO TRANSCRIPT", note: "headless, cannot verify" }
           elif $is_sdk_cli and $quiet > $sdk_stale and $cpu_moved then
               { sev: 2, token: "sdk", note: "quiet but cpu moving" }
           elif $is_sdk_cli and $quiet > $sdk_stale then
               { sev: 3, token: "SDK STALE?", note: "quiet" }
           elif $is_sdk_cli then { sev: 2, token: "sdk", note: "no status published" }

           # --- embedded SDK: only the process itself is observable ----------
           # Deliberately never escalated to a hang. An embedded session
           # waiting on its host program is quiet and idle by design, and
           # ccwatch has no way to tell that from wedged. It says so.
           elif $is_sdk and $cpu_moved then
               { sev: 2, token: "sdk-ts", note: "cpu moving" }
           elif $is_sdk and $cpud == null then
               { sev: 1, token: "sdk-ts", note: "no status or transcript — liveness only" }
           elif $is_sdk then
               { sev: 1, token: "sdk-ts", note: "alive, no cpu since last frame" }

           # Status absent on a non-SDK session means an older Claude Code that
           # predates the field. Say so; do not imply health we did not measure.
           else { sev: 1, token: "unknown", note: "no status published" }
           end) as $c
        # Keyed by session id, not by directory: the phase that shows here is
        # the one this very session ran.
        | ($P[$sid]) as $pl
        | { sid: $sid,
            pid: $s.pid,
            name: ($s.name // ""),
            cwd:  ($s.cwd // "?"),
            # The basename of a worktree is the branch, useless without
            # the repo it belongs to — show both.
            project: project($s.cwd),
            # The full owner/name, which is what `gh` returns for a deploy, so
            # the two can be matched exactly instead of by a guessed leaf name.
            repo: ((repo_of($s.cwd).slug) | if (. // "") == "" then null else . end),
            # What distinguishes two sessions in different worktrees of one
            # repository. The repo alone cannot.
            branch: ((repo_of($s.cwd).branch) | if (. // "") == "" then null else . end),
            entrypoint: ($s.entrypoint // ""),
            version: ($s.version // ""),
            status_raw: ($st // null),
            token: $c.token, sev: $c.sev, note: $c.note,
            age: ([($now - (($s.startedAt // 0) / 1000)), 0] | max | floor),
            quiet: $quiet,
            cpu: $cpu,
            cpu_delta: $cpud,
            rss_mb: ($M[$s.pid|tostring]),
            # Only from a statusline that is still reporting. A session whose
            # last report is older than the threshold has its context reading
            # dropped rather than shown — a context gauge frozen at the value it
            # had an hour ago is worse than no gauge, because it looks live.
            context: ( ($X[$sid]) as $c
                       | if $c == null or $c.age > $ctx_stale then null
                         else { used_percentage: $c.used_percentage,
                                window: $c.window, cost_usd: $c.cost_usd,
                                model: $c.model, effort: $c.effort,
                                age: $c.age } end ),
            # For a waiting session the number you want is not transcript
            # silence but how long it has been blocked on you.
            # The question itself, when there is one. `waitingFor` only ever
            # gives a label; this is what it wants.
            questions: ($asks[$sid] // null),
            waited: (if $st == "waiting" and ($s.statusUpdatedAt // 0) > 0
                     then ([($now - ($s.statusUpdatedAt / 1000)), 0] | max | floor)
                     else null end),
            pipeline: $pl }
      ]
    # Pipeline severity is kept SEPARATE from session severity, because they are
    # different claims about different things. A session can be honestly `idle`
    # while the run it belongs to has crashed; collapsing those into one number
    # produced rows reading "! idle", which is not a sentence.
    #
    # `needs_input` is the record spec-run keeps when a phase stopped to ask you
    # something, so it ranks with a session that is waiting: both mean the run
    # goes nowhere until you look at it.
    | map(. + { psev:
        (if   (.pipeline.status // "") == "needs_input" then 4
         elif (.pipeline.crashed // false) then 3
         elif ((.pipeline.status // "") | test("^(interrupted|failed)$")) then 3
         else 0 end) })
    # Sorted on whichever claim is louder, so nothing urgent can sort below a
    # row that merely looks busy.
    | sort_by(-([.sev, .psev] | max), -(.waited // .quiet // 0))
    | { sessions: .,
        parse_failed: $parse_failed,
        usage: $usage,
        host: (if $host == null then null
               else $host + { pressure: (($host.swap_used_pct // 0) >= $swap_warn),
                              # What the sessions themselves account for, so
                              # "would killing agents help" has a number rather
                              # than an intuition behind it.
                              sessions_mb: ([ .[] | .rss_mb // 0 ] | add),
                              idle_mb: ([ .[] | select(.sev <= 1) | .rss_mb // 0 ] | add) } end),
        # Runs that stopped and whose session is already gone. These are the
        # ones nothing else reports: no live session carries them, so without
        # this block a crashed phase from yesterday is invisible until the next
        # spec-run invocation stumbles over it.
        unfinished: [ . as $rows
                      | $p[]
                      | .feature as $f | .cwd as $c | .cost as $rc
                      | .phases[]
                      | . as $ph
                      | select( $ph.status == "interrupted"
                                or $ph.status == "failed"
                                or $ph.status == "needs_input"
                                or ( $ph.status == "running"
                                     and $ph.runner_pid != null
                                     and ($runners | index($ph.runner_pid)) == null ) )
                      # Anything a live row already shows is not repeated here.
                      | select( [ $ph.sids[] ] - [ $rows[].sid ] | length > 0
                                or ($ph.sids | length) == 0 )
                      | { feature: $f, cwd: $c, project: project($c),
                          repo: ((repo_of($c).slug)
                                 | if (. // "") == "" then null else . end),
                          phase: $ph.name,
                          status: (if $ph.status == "running" then "CRASHED" else $ph.status end),
                          model: $ph.model, cost: $rc,
                          started_at: $ph.started_at,
                          sid: ($ph.sids[0] // null),
                          age: (if $ph.started_at == null then null
                                else ($now - ($ph.started_at|fromdate)) end) } ]
          | unique_by([.cwd, .feature, .phase])
          | sort_by(.age // 9e18) }
    | .unfinished_old = ([ .unfinished[] | select((.age // 9e18) > ($unfinished_hours * 3600)) ] | length)
    | .unfinished = [ .unfinished[] | select((.age // 9e18) <= ($unfinished_hours * 3600)) ]'
}

# ============================================================== rendering ====

# reset_clock — an epoch second as an Eastern wall clock, e.g. "3:45 PM EDT".
# Empty for an empty, null or unparseable input: a usage window with no reset
# instant has no clock, and inventing one is worse than printing none.
#
# ⚠️ Eastern, not the reader's own zone, because that is what was asked for and
# because a fixed zone means two people reading the same dashboard say the same
# time out loud. The abbreviation is printed with it: EDT and EST are an hour
# apart and a bare clock time is ambiguous for half the year.
#
# ⚠️ `date -r`, never jq. `TZ=America/New_York jq 'strflocaltime("%Z")'`
# reported EST for an instant in September — measured against this function and
# against the browser's Intl formatter, which agree with each other and not
# with jq. tests/run.sh asserts that this and web/usage.js still agree, on both
# sides of a daylight-saving boundary, because two formatters of one instant
# will otherwise drift apart unseen.
reset_clock() { # reset_clock <epoch-seconds>
  # Validity is checked here too, unconditionally, before consulting the
  # platform section: an empty/null/non-numeric input returns empty without
  # consulting any implementation, exactly as before this was extracted
  # (contracts/probe-layer.md).
  case "${1:-}" in
    ''|null|*[!0-9]*) return 0;;
  esac
  probe_clock "$1"
}

# write_roster — remember what was live. Called from the places that take a
# snapshot for display, not from snapshot() itself, so that a --json consumer
# reading the state does not rewrite history as a side effect.
write_roster() { # write_roster <snapshot-json>
  mkdir -p "$CCWATCH_HOME" 2>/dev/null || return 0
  printf '%s' "$1" | jq -c --argjson at "$(date '+%s')" '
    { at: $at,
      sessions: [ .sessions[]
                  | { sid, name, project, repo, branch, cwd, token, note,
                      sev, age, cost: (.context.cost_usd // null),
                      pipeline: (if .pipeline == null then null
                                 else {feature: .pipeline.feature, phase: .pipeline.phase,
                                       status: .pipeline.status, cost: .pipeline.cost} end) } ] }'     >"$ROSTER.tmp" 2>/dev/null && mv "$ROSTER.tmp" "$ROSTER" 2>/dev/null
  return 0
}

render() {
  local snap="$1"
  write_roster "$snap"
  local count
  count=$(printf '%s' "$snap" | jq '.sessions | length')

  # Account-wide usage, above the table because it is the one fact that is not
  # about any single row. Absent until `ccwatch install-statusline` is wired,
  # and it says which rather than showing nothing.
  #
  # The reset instants are turned into Eastern wall clocks HERE, in one read,
  # rather than inside the jq program below.
  # ⚠️ Not with jq. `strflocaltime("%Z")` under TZ=America/New_York reported
  # EST for an instant in September — measured against `date -r` and against
  # the browser's own Intl formatter, which agree with each other (10:53 PM
  # EDT) and disagree with jq. An hour wrong, half the year, on a number whose
  # entire purpose is to be put in a calendar.
  local r5 r7 r7o
  IFS='	' read -r r5 r7 r7o <<<"$(printf '%s' "$snap" | jq -r \
    '[(.usage.five_hour.resets_at // ""), (.usage.seven_day.resets_at // ""),
      (.usage.seven_day_opus.resets_at // "")] | @tsv')"
  printf '%s' "$snap" | jq -r --argjson now "$(date '+%s')" \
    --arg c5 "$(reset_clock "$r5")" --arg c7 "$(reset_clock "$r7")" \
    --arg c7o "$(reset_clock "$r7o")" \
    --arg d "$_c_dim" --arg b "$_c_bold" --arg y "$_c_yellow" --arg r "$_c_red" --arg z "$_c_reset" \
    --argjson usage_stale "$CCWATCH_USAGE_STALE" '
    def dur(s): if s == null then "?"
      elif s < 60    then "\(s|floor)s"
      elif s < 3600  then "\((s/60)|floor)m"
      elif s < 86400 then "\((s/3600)|floor)h"
      else                "\((s/86400)|floor)d" end;
    # A percentage is coloured by how close it is to the limit, not decoratively.
    def band(p): if p >= 90 then $r elif p >= 70 then $y else $z end;
    # The relative time is what you act on; the wall clock is what you put in
    # a calendar. Both, when the clock could be formatted at all.
    def gauge(nm; x; clock):
      if x == null then empty
      else "\($d)\(nm)\($z) \(band(x.used_percentage))\($b)\(x.used_percentage|floor)%\($z)"
           + ( if x.resets_at == null then ""
               elif clock == "" then " \($d)(resets \(dur(x.resets_at - $now)))\($z)"
               else " \($d)(resets \(dur(x.resets_at - $now)) \u00b7 \(clock))\($z)" end )
      end;
    if .usage == null then
      "\($d)usage: not reporting — run: ccwatch install-statusline\($z)"
    elif (.usage.age // 0) > $usage_stale then
      # The numbers are withheld, not annotated. A percentage on screen is read
      # as current no matter what is printed next to it.
      "\($y)usage: last reading is \(dur(.usage.age)) old — not shown\($z)"
      + " \($d)(is the statusline still running? ccwatch doctor)\($z)"
    else
      ( [ gauge("5h"; .usage.five_hour; $c5),
          gauge("7d"; .usage.seven_day; $c7),
          gauge("7d-opus"; .usage.seven_day_opus; $c7o) ] | join("  ") )
      # The reading has an age, and past a minute it is stated rather than
      # presented as current.
      + ( if .usage.age > 60 then "  \($d)[\(dur(.usage.age)) old]\($z)" else "" end )
    end' || say "${_c_red}x${_c_reset} usage header failed to render — run: ccwatch doctor"

  # Only shown under pressure. A monitoring tool that reports normal conditions
  # on every refresh trains you to skip the line that eventually is not normal.
  #
  # Placed above the "no live sessions" return on purpose: an empty session list
  # is exactly the situation where the reason matters most.
  printf '%s' "$snap" | jq -r --arg r "$_c_red" --arg d "$_c_dim" --arg z "$_c_reset" '
    if (.host // null) == null or ((.host.pressure // false) | not) then empty
    else "\($r)! host under memory pressure\($z) \($d)swap \(.host.swap_used_pct)% used"
         + " (\(.host.swap_used_mb)/\(.host.swap_total_mb)MB), \(.host.ram_free_mb)MB RAM free"
         + " — the OS may kill sessions, and a killed session looks exactly"
         + " like a clean exit\($z)"
    end' || true
  say ""

  if [ "$count" -eq 0 ]; then
    say "${_c_dim}No live Claude Code sessions.${_c_reset}"
    say "${_c_dim}Reboot or crash? ${_c_reset}ccwatch resume${_c_dim} rebuilds the list from transcripts.${_c_reset}"
    return 0
  fi

  printf '%s' "$snap" | jq -r --argjson now "$(date '+%s')" '
    def dur(s): if s == null then "-"
      elif s < 60      then "\(s|floor)s"
      elif s < 3600    then "\((s/60)|floor)m"
      elif s < 86400   then "\((s/3600)|floor)h"
      else                  "\((s/86400)|floor)d" end;
    .sessions[] |
    [ .sev, .name, .project, .token,
      dur(.age),
      # Blank rather than a guess: only sessions with a statusline report this,
      # so headless rows legitimately have nothing here.
      ( if .context == null or .context.used_percentage == null then ""
        else "\(.context.used_percentage|floor)%" end ),
      # The LAST column carries the reason a row is flagged, so that the verdict
      # is never asserted without the measurement that produced it.
      ( if .waited != null then "\(.note) \(dur(.waited))"
        elif .note == "quiet" then "quiet \(dur(.quiet))"
        elif .note != "" then .note
        elif .quiet != null then "\(dur(.quiet)) ago"
        else "-" end ),
      # The pipeline sub-row carries its OWN severity, so an idle session above
      # a crashed run reads as two separate true statements instead of one
      # muddled one.
      ( if .pipeline == null then ""
        else [ .psev,
               .pipeline.feature,
               "\(.pipeline.phase)/\(if .pipeline.crashed then "CRASHED" else .pipeline.status end)",
               (.pipeline.model // ""),
               (.pipeline.cost | .*100 | round | ./100 | tostring),
               ( if .pipeline.crashed and .pipeline.started_at != null
                 then "started \(dur($now - (.pipeline.started_at|fromdate))) ago — needs a rerun"
                 elif .pipeline.status == "needs_input" then "the phase stopped to ask you something"
                 elif .pipeline.crashed then "needs a rerun"
                 else "" end ) ] | join("|")
        end )
    ] | @tsv' | awk -F'\t' \
      -v red="$_c_red" -v yel="$_c_yellow" -v grn="$_c_green" -v cyn="$_c_cyan" \
      -v dim="$_c_dim" -v bold="$_c_bold" -v mag="$_c_magenta" -v rst="$_c_reset" '
    { sev[NR]=$1; name[NR]=$2; proj[NR]=$3; tok[NR]=$4; age[NR]=$5; ctx[NR]=$6; last[NR]=$7; pipe[NR]=$8
      if (length($2)>w1) w1=length($2)
      if (length($3)>w2) w2=length($3)
      if (length($4)>w3) w3=length($4)
      if (length($5)>w4) w4=length($5)
      if (length($6)>w5) w5=length($6)
      n=NR
    }
    function glyph(s) { return (s==4) ? "*" : (s==3) ? "!" : (s==2) ? "+" : (s==1) ? "~" : "-" }
    function colour(s) { return (s==4) ? mag : (s==3) ? red : (s==2) ? grn : (s==1) ? cyn : dim }
    END {
      if (w1<4) w1=4; if (w2<7) w2=7; if (w3<6) w3=6; if (w4<3) w4=3; if (w5<3) w5=3
      printf "%s%-*s  %-*s  %-*s  %-*s  %*s  %s%s\n", bold, w1,"NAME", w2,"PROJECT", w3+2,"STATUS", w4,"AGE", w5,"CTX", "LAST", rst
      for (i=1;i<=n;i++) {
        s=sev[i]+0
        # A context window past 80% is worth seeing before the session
        # compacts under you mid-task.
        cc = dim
        if (ctx[i] != "") { v = ctx[i]+0; cc = (v>=80) ? red : (v>=60) ? yel : dim }
        printf "%-*s  %-*s  %s%s %-*s%s  %-*s  %s%*s%s  %s%s%s\n", \
          w1,name[i], w2,proj[i], colour(s),glyph(s), w3,tok[i], rst, w4,age[i], \
          cc,w5,ctx[i],rst, dim,last[i],rst
        if (pipe[i] != "") {
          split(pipe[i], p, "|")
          ps = p[1]+0
          printf "  %s%s\\_%s %s%s%s  %s%s%s  %s%s $%s%s", \
            dim, colour(ps), rst, dim,p[2],rst, colour(ps),p[3],rst, dim,p[4],p[5],rst
          if (p[6] != "") printf "  %s%s%s", colour(ps), p[6], rst
          printf "\n"
        }
      }
    }'

  # Runs that stopped with nobody left holding them. Printed above the footer
  # because it is the one section that reports work already lost, rather than
  # work in progress.
  if [ "$(printf '%s' "$snap" | jq '.unfinished | length')" -gt 0 ]; then
    say ""
    say "${_c_bold}UNFINISHED RUNS${_c_reset} ${_c_dim}— stopped in the last ${CCWATCH_UNFINISHED_HOURS}h, and no live session is holding them${_c_reset}"
    printf '%s' "$snap" | jq -r '
      def dur(s): if s == null then "?"
        elif s < 3600  then "\((s/60)|floor)m"
        elif s < 86400 then "\((s/3600)|floor)h"
        else                "\((s/86400)|floor)d" end;
      .unfinished[]
      | [ "\(.project) \(.feature)", "\(.phase)/\(.status)", (.model // ""),
          .cost,
          (if .age == null then "" else "\(dur(.age)) ago" end),
          (.sid // ""), .cwd ] | @tsv' \
    | awk -F'\t' -v red="$_c_red" -v mag="$_c_magenta" -v cyn="$_c_cyan" \
                 -v dim="$_c_dim" -v rst="$_c_reset" '
      { c = ($2 ~ /needs_input/) ? mag : red
        # Project first, then feature: the project is what you scan for.
        n = split($1, pf, " ")
        printf "  %s%-22s%s  %s%-16s%s %s%-30s%s  %s%-7s $%.2f%s\n", \
          c,$2,rst, "",pf[1],"", dim,pf[2],rst, dim,$3, $4,rst
        if ($5 != "") printf "      %s%s%s", dim,$5,rst
        if ($6 != "") printf "  %sclaude --resume %s%s", cyn,$6,rst
        if ($5 != "" || $6 != "") printf "\n"
      }'
    local older
    older=$(printf '%s' "$snap" | jq '.unfinished_old')
    [ "${older:-0}" -gt 0 ] && say "  ${_c_dim}(+$older older — see: ccwatch resume)${_c_reset}"
  fi

  # The footer is the part you read from across the room.
  printf '%s' "$snap" | jq -r '
    [ (.sessions | length),
      ([ .sessions[] | select(.sev == 4) ] | length),
      ([ .sessions[] | select(.sev == 3) ] | length),
      ([ .sessions[] | select(.psev == 4) ] | length),
      (.unfinished | length),
      (.parse_failed // 0) ] | @tsv' | awk -F'\t' \
      -v mag="$_c_magenta" -v red="$_c_red" -v dim="$_c_dim" -v bold="$_c_bold" -v rst="$_c_reset" '
    { out = sprintf("%d live", $1)
      if ($2>0) out = out sprintf(" %s· %d waiting on you%s", mag bold, $2, rst)
      if ($4>0) out = out sprintf(" %s· %d phase(s) asking you something%s", mag bold, $4, rst)
      if ($3>0) out = out sprintf(" %s· %d suspect%s", red bold, $3, rst)
      if ($5>0) out = out sprintf(" %s· %d unfinished run(s)%s", red, $5, rst)
      if ($6>0) out = out sprintf(" %s· %d unreadable registry file(s) — run: ccwatch doctor%s", red, $6, rst)
      printf "\n%s%s\n", out, rst
    }'
}

# ================================================================== bar ======
#
# `ccwatch bar` — the same snapshot as a macOS menu bar item, in SwiftBar's
# (and xbar's) plugin format.
#
# Why this is a subcommand rather than a plugin that reads `--json` and makes
# up its own mind: the menu bar is the reading you trust from across the room
# without opening anything, and a second place that decides "is anything stuck"
# from the raw fields will eventually disagree with the table — with no way to
# tell which of them is lying. That is the argument `/api/state` settles by
# invoking the CLI instead of reimplementing the join, and `ccwatch statusline`
# already shows the tool emitting another program's format. The plugin under
# extra/ is a pipe with no judgement in it.
#
# The format: line 1 is the menu bar title, `---` opens the dropdown, and
# ` | ` separates an item's text from its key=value parameters (`color=`,
# `font=`, `href=`, `bash=`, `refresh=`).
#
# ⚠️ Nothing here is put behind a `--` submenu, though the format offers them
# and they would tidy the list up. A submenu is a collapsed badge: it turns a
# crashed phase into something you have to hover to discover, which is the
# failure-as-an-absence constitution IV forbids and the exact mistake the
# pages' alert control was built to avoid. Sub-rows are indented with spaces
# and stay visible.

# bar_dashboard_up — is something already answering on the dashboard port.
#
# Asked so the menu can offer "Open dashboard" (a link that works) or "Start
# dashboard" (which starts one), rather than one link that silently fails for
# anyone who has not got `serve` running. A dead link is a failure dressed as a
# working feature, and it stays dressed as one until somebody clicks it.
#
# /dev/tcp rather than curl: this runs every few seconds for as long as the
# menu bar is up, and `bar` should not acquire a dependency the rest of the
# read path does without. A loopback connect to a closed port is refused
# immediately, so there is nothing to time out.
bar_dashboard_up() { # bar_dashboard_up <port>
  (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

cmd_bar() {
  local title_only=false actions=true
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) title_only=true; shift;;
      # ⚠️ For a host that supplies its own actions natively — the menu bar app
      # under app/ opens its overlay and its dashboard in-process, so the
      # shell-out versions of those items would be a second way to do the same
      # thing, and the one that works differently. The STATUS content is never
      # affected by this flag: what a host may replace is the verbs, never a
      # verdict.
      --no-actions) actions=false; shift;;
      *) die "bar: unrecognised argument '$1'" \
             "usage: ccwatch bar [--title] [--no-actions]";;
    esac
  done

  local self port up=false snap
  self=$(resolved_self)
  port="${CCWATCH_PORT:-8787}"
  bar_dashboard_up "$port" && up=true

  snap=$(snapshot 2>/dev/null)

  # ⚠️ A snapshot that failed must not render as `cc 0`. "Nothing is running"
  # and "the collection broke" are different facts, and the menu bar is where
  # that difference is hardest to see: a quiet machine and a blind tool both
  # look equally calm up there, and there is no surrounding page to carry the
  # reason. `?` is not a number anyone reads as a count.
  if [ -z "$snap" ] || ! printf '%s' "$snap" | jq empty >/dev/null 2>&1; then
    if [ "$title_only" = true ]; then say "cc ?"; return 0; fi
    say "cc ? | sfimage=questionmark.circle"
    say "---"
    say "ccwatch could not read the sessions | color=red"
    say "This is NOT \"nothing is running\" — the snapshot itself failed. | size=11"
    if [ "$actions" = true ]; then
      say "---"
      say "Run ccwatch doctor | bash=\"$self\" param1=doctor terminal=true"
      say "Refresh now | refresh=true"
    fi
    return 0
  fi

  # The menu bar is a display, so it records what was live the same way the
  # table does. Side benefit worth having: with the menu bar running, the
  # roster `ccwatch resume` reads after a crash is at most one refresh old,
  # whether or not a terminal happened to be open.
  write_roster "$snap"

  # ⚠️ The reset instants become Eastern wall clocks HERE, with `date -r`, for
  # the reason `render` records: `TZ=America/New_York jq 'strflocaltime("%Z")'`
  # reported EST for an instant in September, an hour wrong for half the year,
  # on a number whose whole purpose is to go in a calendar. The terminal and
  # web/usage.js agree with each other and not with jq, and the suite asserts
  # that this and the page still match on both sides of a DST boundary.
  local r5 r7 r7o
  IFS='	' read -r r5 r7 r7o <<<"$(printf '%s' "$snap" | jq -r \
    '[(.usage.five_hour.resets_at // ""), (.usage.seven_day.resets_at // ""),
      (.usage.seven_day_opus.resets_at // "")] | @tsv')"

  printf '%s' "$snap" | jq -r \
    --argjson now "$(date '+%s')" \
    --arg c5 "$(reset_clock "$r5")" \
    --arg c7 "$(reset_clock "$r7")" \
    --arg c7o "$(reset_clock "$r7o")" \
    --argjson title_only "$title_only" \
    --argjson actions "$actions" \
    --argjson up "$up" \
    --arg port "$port" \
    --arg self "$self" \
    --arg version "$CCWATCH_VERSION" \
    --argjson unfinished_hours "$CCWATCH_UNFINISHED_HOURS" '
    def dur(s): if s == null then "-"
      elif s < 60    then "\(s|floor)s"
      elif s < 3600  then "\((s/60)|floor)m"
      elif s < 86400 then "\((s/3600)|floor)h"
      else                "\((s/86400)|floor)d" end;

    # The time left on a rate-limit window, with one decimal once it is in
    # hours or days: "resets in 2h" was asked about because at 2h59m it is an
    # hour short of the truth. Floored, never rounded, so it can say the window
    # resets sooner than it does but never later. A whole number drops the
    # ".0" -- "2h", not "2.0h" -- so the common case costs no width.
    def rdur(s): if s == null or s < 3600 then dur(s)
      elif s < 86400 then "\((s/360)|floor|./10)h"
      else                "\((s/8640)|floor|./10)d" end;

    # ⚠️ A security control, not tidying. A bare pipe opens SwiftBar parameter
    # parsing and `bash=` is one of the parameters it accepts, so a session
    # name or a waitingFor note carrying one would put a CLICKABLE COMMAND in
    # the menu. Applied inside this program to every interpolated field rather
    # than at the call sites, because exactly one call site will eventually be
    # added without it.
    #
    # It becomes a broken bar rather than a space: the name stays legible as
    # the name it is, instead of being quietly reshaped into a different one.
    def clean: (. // "") | tostring | gsub("\\|"; "¦") | gsub("[\n\r\t]"; " ");

    def pad(w): . as $s
      | $s + (if w > ($s|length) then (" " * (w - ($s|length))) else "" end);

    # Every severity carries a word too, so the glyph and the colour are both
    # additions to a reading that survives without either.
    def glyph(s): if s == 4 then "*" elif s == 3 then "!"
                  elif s == 2 then "+" elif s == 1 then "~" else "-" end;
    def colour(s): if s == 4 then "purple" elif s == 3 then "red"
                   elif s == 2 then "green" elif s == 1 then "teal" else "gray" end;
    def money(c): (c // 0) | .*100 | round | ./100 | tostring;

    ( .sessions | length )                                as $live
    | ( [ .sessions[] | select(.sev  == 4) ] | length )   as $waiting
    | ( [ .sessions[] | select(.psev == 4) ] | length )   as $asking
    | ( [ .sessions[] | select(.sev  == 3) ] | length )   as $suspect
    | ( .unfinished | length )                            as $unfin
    | ( .parse_failed // 0 )                              as $bad

    # ⚠️ The title states every condition it found, not just the worst one.
    # Showing only the loudest would leave the others absent from the one
    # surface visible without a click, and an absence reads as nothing wrong.
    # Normal is the quiet case: with no condition found the title is the live
    # count and nothing else, because a title that always says something is
    # one you stop reading.
    #
    # Unfinished runs are the one exception, left out of the title AND its
    # icon and colour. They are runs that already stopped, not a session
    # blocked right now, and "1 unfinished" spent width the notch leaves little
    # of on something that needs nothing from you this minute. The summary line
    # of the dropdown and its UNFINISHED RUNS block still list every one. The icon
    # goes with the words, because a red triangle beside a title that names no
    # condition would leave the colour carrying the meaning alone (rule VII).
    | ( [ (if $waiting > 0 then "\($waiting) waiting"    else empty end),
          (if $asking  > 0 then "\($asking) asking"      else empty end),
          (if $suspect > 0 then "\($suspect) suspect"    else empty end),
          (if $bad     > 0 then "\($bad) unreadable"     else empty end) ]
        | join(" · ") )                              as $conditions

    # ⚠️ The menu bar leads with the rate-limit figure because that is what it
    # is looked at FOR — but only when the reading is fresh. Past the staleness
    # window there is no number to lead with, and inventing one there would be
    # the worst instance of the mistake constitution III exists to stop: a
    # percentage alone in a menu bar has nothing around it to date it, and the
    # reader supplies "now" for free. So a stale or absent reading falls back to
    # the live count, and the dropdown says which it was.
    # ⚠️ No "5h" here, and that is the point. `5h` is the NAME of the
    # five-hour rate-limit window, and in the terminal it earns its place as a
    # column label beside `7d`. Alone in a menu bar it reads as a duration —
    # "5h 59%" was asked, reasonably, what the 5h meant — and the duration
    # that actually matters, how long until the window resets, was missing
    # entirely. So the label goes and the reset comes in. The dropdown one
    # click away still labels every window, which is where telling 5h from 7d
    # matters.
    #
    # "resets in 2h", not "2h left": the latter reads as two hours of quota
    # remaining, which is a different and much more expensive thing to believe.
    | ( if .usage != null
             and ((.usage.age // 0) <= (.usage.stale_after // 600))
             and (.usage.five_hour != null)
        then "\(.usage.five_hour.used_percentage|floor)%"
             + ( if .usage.five_hour.resets_at == null then ""
                 else " · resets in \(rdur(.usage.five_hour.resets_at - $now))" end )
        else "cc \($live)" end )                          as $lead

    | ( [ $lead, (if $conditions == "" then empty else $conditions end) ]
        | join(" · ") )                                    as $title

    # ⚠️ The colour is an ADDITION to the words, never the carrier. Every
    # condition is already spelled out in $conditions, so `ccwatch bar --title
    # | grep waiting` still works, a screen reader still reads it, and a
    # screenshot still shows it. Constitution VII, in the one place where a
    # glance is all anyone gives it.
    #
    # Pink for "a session is blocked on you", which is the only state where the
    # answer is you rather than waiting. Red for suspect/unreadable.
    # Both are light enough to read on a dark menu bar and dark enough on a
    # light one.
    | ( [ (if   $waiting > 0 or $asking > 0 then "sfimage=bell.badge"
           elif $suspect > 0 or $bad > 0 then "sfimage=exclamationmark.triangle"
           else empty end),
          (if   $waiting > 0 or $asking > 0 then "color=#ff6fb5"
           elif $suspect > 0 or $bad > 0 then "color=#ff6b6b"
           else empty end) ]
        | if length == 0 then "" else " | " + join(" ") end ) as $icon

    | (([ .sessions[] | (.name    | clean | length) ] | max) // 4) as $w1
    | (([ .sessions[] | (.project | clean | length) ] | max) // 7) as $w2
    | (([ .sessions[] | (.token   | clean | length) ] | max) // 6) as $w3

    | if $title_only then $title
      else
      ( [ "\($title)\($icon)", "---" ]

        # The summary, in the words the terminal footer uses, because that is
        # the line this tool is already read from across the room by.
        + [ ( "\($live) live"
              + (if $waiting > 0 then " · \($waiting) waiting on you" else "" end)
              + (if $asking  > 0 then " · \($asking) phase(s) asking you something" else "" end)
              + (if $suspect > 0 then " · \($suspect) suspect" else "" end)
              + (if $unfin   > 0 then " · \($unfin) unfinished run(s)" else "" end)
              + " | size=12" ) ]
        + (if $bad > 0
           then [ "\($bad) unreadable registry file(s) — run: ccwatch doctor | color=red size=12" ]
           else [] end)

        # Account-wide usage, under the rule the table and the pages follow,
        # against the same threshold travelling in the payload beside it.
        #
        # ⚠️ Past that threshold the numbers are WITHHELD, not annotated. A
        # percentage in a menu bar is read as current even harder than one on
        # a page: it sits there between glances with nothing around it to date
        # it, and the reader supplies "now" for free.
        + ( if .usage == null then
              [ "usage: not reporting — run: ccwatch install-statusline | color=gray size=11" ]
            elif (.usage.age // 0) > (.usage.stale_after // 600) then
              [ "usage: last reading is \(dur(.usage.age)) old — not shown | color=orange size=11" ]
            else
              # ⚠️ Both the remaining time AND the wall clock. "resets in 2h"
              # is what you act on; "3:45 PM EDT" is what you put in a
              # calendar, and you cannot derive one from the other at a glance
              # without knowing what time it is now. The terminal has printed
              # both for a while; the menu was dropping the reset entirely.
              #
              # The abbreviation travels with the clock because EDT and EST are
              # an hour apart and a bare time is ambiguous for half the year.
              ( def gauge(nm; x; clock):
                  if x == null then empty
                  # The name of the window belongs HERE, where there is
                  # more than one of them and telling 5h from 7d is the whole
                  # job of a label. And "used", because a bare percentage does
                  # not say whether it is what you have spent or what is left.
                  #
                  # No apostrophes in this program: it is a single-quoted jq
                  # argument, and one closes it. That is a bash syntax error
                  # 400 lines from the typo.
                  else "\(nm) · \(x.used_percentage|floor)% used"
                       + ( if x.resets_at == null then ""
                           elif clock == ""
                           then " · resets in \(rdur(x.resets_at - $now))"
                           else " · resets in \(rdur(x.resets_at - $now)) · \(clock)"
                           end )
                  end;
                [ gauge("5h"; .usage.five_hour; $c5),
                  gauge("7d"; .usage.seven_day; $c7),
                  gauge("7d-opus"; .usage.seven_day_opus; $c7o) ]
                | map("\(.) | font=Menlo size=12") )
            end )

        # Only under pressure. A line that appears on every refresh to say
        # things are fine is a line you learn to skip, and then it is not
        # there when it matters.
        + ( if (.host // null) == null or ((.host.pressure // false) | not) then []
            else [ "! host under memory pressure — swap \(.host.swap_used_pct)% used, \(.host.ram_free_mb)MB RAM free | color=red size=12",
                   "the OS may kill sessions, and a killed session looks exactly like a clean exit | color=red size=11" ]
            end )

        + [ "---" ]

        + ( if $live == 0 then
              [ "No live Claude Code sessions | size=12",
                "Reboot or crash? ccwatch resume rebuilds the list from transcripts | size=11 color=gray" ]
            else
              ( .sessions | map(
                  # ⚠️ The measurement travels with the verdict, and it is the
                  # SAME expression the LAST column uses. A menu printing
                  # HUNG? with no silence beside it would be asking to be
                  # believed; one computing its own measurement would
                  # eventually print a different number from the table for the
                  # same session.
                  ( if   .waited != null    then "\(.note|clean) \(dur(.waited))"
                    elif .note == "quiet"   then "quiet \(dur(.quiet))"
                    elif .note != ""        then (.note|clean)
                    elif .quiet != null     then "\(dur(.quiet)) ago"
                    else                         "-" end ) as $last
                  | [ "\(glyph(.sev)) \((.name|clean)|pad($w1))  \((.project|clean)|pad($w2))  \((.token|clean)|pad($w3))  \(dur(.age)|pad(3))  \($last)"
                      + " | font=Menlo size=12 color=\(colour(.sev))" ]
                    # The run carries its OWN severity, kept apart from the
                    # session: a session can be honestly idle while the run it
                    # drove has crashed, and collapsing those two gives a row
                    # that is not a sentence.
                    + ( if .pipeline == null then []
                        else [ "    \\_ \(.pipeline.feature|clean)  \(.pipeline.phase|clean)/\(if .pipeline.crashed then "CRASHED" else (.pipeline.status|clean) end)  \((.pipeline.model // "")|clean)  $\(money(.pipeline.cost))"
                               + (if .pipeline.crashed then " — needs a rerun"
                                  elif .pipeline.status == "needs_input" then " — stopped to ask you something"
                                  else "" end)
                               + " | font=Menlo size=11 color=\(colour(.psev))" ]
                        end )
                ) | flatten )
            end )

        # Runs that stopped with nobody left holding them. Nothing else
        # reports these: no live session carries them, so without this block
        # they stay invisible until the next spec-run invocation trips over
        # them.
        + ( if $unfin == 0 then []
            else [ "---",
                   "UNFINISHED RUNS — stopped in the last \($unfinished_hours)h, no live session holding them | size=11 color=gray" ]
                 + ( .unfinished | map(
                     "\(.phase|clean)/\(.status|clean)  \(.project|clean) \(.feature|clean)  $\(money(.cost))"
                     + (if .age == null then "" else "  \(dur(.age)) ago" end)
                     + " | font=Menlo size=11 color=red" ) )
                 + ( if (.unfinished_old // 0) > 0
                     then [ "(+\(.unfinished_old) older — see: ccwatch resume) | size=11 color=gray" ]
                     else [] end )
            end )

        + ( if $actions | not then []
            else
              [ "---" ]
              + ( if $up
                  then [ "Open dashboard | href=http://127.0.0.1:\($port)" ]
                  else [ "Start dashboard | bash=\"\($self)\" param1=serve param2=--open terminal=true" ]
                  end )
              + [ "Refresh now | refresh=true",
                  "ccwatch \($version) | size=11 color=gray" ]
            end )
      ) | join("\n")
      end'
}

# ============================================================== resume =======
#
# The registry cannot help here. It is a directory of pid-named files and every
# one of them is gone after a restart — which is the exact moment you need the
# list. Transcripts are what survive: append-only, one file per session, and
# every line carries its own cwd, branch and session id. So the resume list is
# rebuilt from those, and cross-referenced against the live registry only to
# drop the sessions that are already running.

cmd_resume() {
  local limit=20 with_cd=0 all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--limit) limit="${2:-20}"; shift 2 || exit 3;;
      --cd)       with_cd=1; shift;;
      --all)      all=1; shift;;
      *) die "resume: unrecognised argument '$1'" "try: ccwatch resume [-n N] [--cd] [--all]";;
    esac
  done

  [ -d "$PROJ_DIR" ] || die "no transcript directory at $PROJ_DIR" \
    "nothing to resume from — has Claude Code ever run as this user?"

  # ⚠️ With a template, so it lands in $TMPDIR. Bare `mktemp -d` resolves
  # against confstr(_CS_DARWIN_USER_TEMP_DIR) — the login /var/folders/…/T —
  # and ignores $TMPDIR entirely, so anything that grants $TMPDIR and not
  # /var/folders refuses it with "Operation not permitted". This died, `die`
  # fired, and the command printed nothing at all.
  TMP=$(mktemp -d "${TMPDIR:-/tmp}/ccwatch.XXXXXX") \
    || die "could not create a temp directory" "tried under ${TMPDIR:-/tmp}"

  # Live sessions are excluded: resuming one that is already running is how you
  # end up with two processes on one conversation. This read has to be `.sessions`
  # — when it was `.[]` jq errored on every invocation, the exclusion list came
  # out empty, and resume cheerfully offered to reopen sessions that were still
  # running. The error went to stderr under a heading that looked fine.
  local snap
  snap=$(snapshot)
  printf '%s' "$snap" | jq -r '.sessions[].sid' | sort >"$TMP/live.txt"

  # What was live the last time anything looked. After a reboot the registry is
  # empty and transcripts alone cannot tell you which sessions were open
  # TOGETHER, what each was called, or what it was doing when everything
  # stopped. That is the part you would otherwise reconstruct from memory.
  if [ -f "$ROSTER" ]; then
    local rage rn
    rage=$(jq -r --argjson now "$(date '+%s')" '($now - (.at // 0))' "$ROSTER" 2>/dev/null) || rage=""
    rn=$(jq -r '.sessions | length' "$ROSTER" 2>/dev/null) || rn=0
    if [ -n "$rage" ] && [ "${rn:-0}" -gt 0 ]; then
      local gone
      gone=$(jq -c --slurpfile live <(printf '%s' "$snap" | jq -c '[.sessions[].sid]') '
        ( $live[0] // [] ) as $l
        | [ .sessions[] | select( ([.sid] | inside($l)) | not ) ]' "$ROSTER" 2>/dev/null)
      if [ "$(printf '%s' "${gone:-[]}" | jq 'length')" -gt 0 ]; then
        say "${_c_bold}LAST KNOWN ROSTER${_c_reset} ${_c_dim}— $rn session(s) were live $(
          awk -v s="$rage" 'BEGIN{ if (s<60) printf "%ds", s; else if (s<3600) printf "%dm", s/60;
            else if (s<86400) printf "%dh", s/3600; else printf "%dd", s/86400 }'
        ) ago; these are not running now${_c_reset}"
        say ""
        printf '%s' "$gone" | jq -r --arg c "$_c_cyan" --arg d "$_c_dim" \
            --arg m "$_c_magenta" --arg r "$_c_red" --arg z "$_c_reset" '
          .[]
          | ( if .sev == 4 then $m elif .sev == 3 then $r else $d end ) as $col
          | "  \($col)\(.name)\($z) \($d)\(.project // "?")\($z)"
            + " \($col)\(.token // "?")\($z)"
            + (if .note != null and .note != "" then " \($d)(\(.note))\($z)" else "" end)
            + (if .pipeline != null then
                 " \($d)· \(.pipeline.feature) \(.pipeline.phase)/\(.pipeline.status)\($z)"
               else "" end)
            + "
      \($c)claude --resume \(.sid)\($z)  \($d)(\(.cwd))\($z)"'
        say ""
      fi
    fi
  fi

  local window=()
  [ "$all" -eq 1 ] || window=(-mtime "-$CCWATCH_RESUME_DAYS")

  # Newest first, and only as many as asked for — tailing 1200 transcripts to
  # print 20 rows is waste the user pays for in latency.
  #
  # -maxdepth 2 is load-bearing. Subagent transcripts live one level deeper, at
  # <sessionId>/subagents/agent-*.jsonl, and recursing into them offered
  # `claude --resume agent-a9cec8c7fe67e1238` — a task id, not a session id, so
  # the command could not have worked. 131 of them on this machine, crowding out
  # the real sessions.
  probe_mtimes "$PROJ_DIR" -maxdepth 2 "${window[@]}" >"$TMP/all.txt"

  local shown=0 mtime path sid last cwd branch state
  say "${_c_bold}RESUMABLE${_c_reset} ${_c_dim}— not currently running, newest first${_c_reset}"
  say ""
  while read -r mtime path; do
    [ "$shown" -ge "$limit" ] && break
    sid=$(basename "$path" .jsonl)
    grep -qxF "$sid" "$TMP/live.txt" && continue

    # ⚠️ The last line with a CWD, not simply the last line.
    #
    # A transcript can end with metadata records that carry no cwd —
    # `last-prompt`, `mode`, `pr-link` and others are written after the
    # conversation. The first version read `tail -1`, found a null cwd, and
    # skipped the session entirely: a session killed moments earlier was
    # missing from its own recovery list, which is precisely the case this
    # command exists for. Found by killing a session and looking for it.
    last=$(tail -40 "$path" 2>/dev/null \
           | jq -R -c 'fromjson? // empty | select(.cwd != null)' 2>/dev/null | tail -1)
    cwd=$(printf '%s' "$last" | jq -r '.cwd // empty' 2>/dev/null)
    branch=$(printf '%s' "$last" | jq -r '.gitBranch // empty' 2>/dev/null)
    [ "$CCWATCH_PLATFORM" = windows ] && cwd="${cwd//\\//}"
    [ -n "$cwd" ] || continue
    # A sidechain is a subagent's transcript, not a conversation you can reopen.
    # Checked as well as the depth limit above, because the two failures are
    # independent: one guards the path, this guards the content.
    [ "$(printf '%s' "$last" | jq -r '.isSidechain // false' 2>/dev/null)" = "true" ] && continue
    # The id comes from INSIDE the transcript, not from the filename. That makes
    # the printed `--resume` correct by construction rather than by the
    # filename happening to be a session id.
    local realsid
    realsid=$(printf '%s' "$last" | jq -r '.sessionId // empty' 2>/dev/null)
    [ -n "$realsid" ] && sid="$realsid"
    # A session whose directory is gone cannot be resumed there; say so rather
    # than handing over a command that will fail.
    local gone=""
    [ -d "$cwd" ] || gone=" ${_c_red}(directory is gone)${_c_reset}"

    local ago
    ago=$(awk -v s="$(( $(date '+%s') - mtime ))" 'BEGIN{
      if (s<60) printf "%ds", s; else if (s<3600) printf "%dm", s/60;
      else if (s<86400) printf "%dh", s/3600; else printf "%dd", s/86400 }')

    printf '%s%-22s%s %s%-10s%s %s%s%s%s\n' \
      "$_c_bold" "$(basename "$cwd")" "$_c_reset" \
      "$_c_dim" "$ago ago" "$_c_reset" \
      "$_c_dim" "${branch:+branch $branch}" "$_c_reset" "$gone"

    # If this session was a spec-run phase, whether that phase finished is the
    # single most important thing to know before resuming — it says whether the
    # run needs a rerun or just a reattach.
    #
    # Matched on THIS session's id, across every state file in the repo. The
    # first version took the newest state file in the directory and reported
    # whatever phase it found unfinished, which attached a stranger's crash to
    # an unrelated session.
    for state in "$cwd"/specs/*/.pipeline/state.json; do
      [ -f "$state" ] || continue
      jq -r --arg sid "$sid" --arg d "$_c_dim" --arg r "$_c_red" --arg z "$_c_reset" '
        ( .phases // {} ) | to_entries
        | [ .[] | select( ( [ .value.session_id // empty ] + (.value.sessions // []) )
                          | index($sid) ) ]
        | if length == 0 then empty
          else .[-1] as $p
            | ( if ($p.value.status | . == "running" or . == "interrupted" or . == "failed")
                then " — needs a rerun"
                elif $p.value.status == "needs_input" then " — it stopped to ask you something"
                else "" end ) as $verdict
            # A phase that finished is reported too, without an alarm: knowing
            # this session already did its job is also worth knowing.
            | "  \($d)\\_ pipeline:\($z) \(if $verdict == "" then $d else $r end)\($p.key)/\($p.value.status)\($z) \($d)\($p.value.model // "?")\($verdict)\($z)"
          end' "$state" 2>/dev/null
    done

    if [ "$with_cd" -eq 1 ]; then
      printf '  %scd %s && claude --resume %s%s\n' "$_c_cyan" "$cwd" "$sid" "$_c_reset"
    else
      printf '  %sclaude --resume %s%s  %s(%s)%s\n' "$_c_cyan" "$sid" "$_c_reset" "$_c_dim" "$cwd" "$_c_reset"
    fi
    say ""
    shown=$((shown + 1))
  done <"$TMP/all.txt"

  if [ "$shown" -eq 0 ]; then
    say "${_c_dim}Nothing resumable in the last $CCWATCH_RESUME_DAYS days.${_c_reset}"
    say "${_c_dim}Widen the window with ${_c_reset}ccwatch resume --all${_c_dim}.${_c_reset}"
  fi
}

# ============================================================== events ======
#
# Polling can miss a transition that opens and closes between two ticks. Hooks
# cannot: Claude Code fires them synchronously. So the hook log is the durable,
# gap-free record — it answers "did anything need me while I was away", which no
# amount of polling can reconstruct after the fact.

cmd_hook() {
  local event="${1:-unknown}"
  # A hook that fails must never break the session that called it. Everything
  # here is best-effort and always exits 0.
  mkdir -p "$CCWATCH_HOME" 2>/dev/null || exit 0
  local payload
  payload=$(cat 2>/dev/null) || payload=""
  printf '%s' "$payload" | jq -c --arg e "$event" --arg t "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" '
    { at: $t, event: $e,
      session_id: (.session_id // .sessionId // null),
      cwd: (.cwd // null),
      message: (.message // .notification // null),
      title: (.title // null) }' >>"$EVENTS" 2>/dev/null \
    || printf '{"at":"%s","event":"%s","note":"unparseable hook payload"}\n' \
         "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$event" >>"$EVENTS" 2>/dev/null
  exit 0
}

cmd_log() {
  local limit="${1:-30}"
  [ -f "$EVENTS" ] || die "no event log at $EVENTS" \
    "the hooks are not installed yet — run: ccwatch install-hooks"
  tail -"$limit" "$EVENTS" | jq -r --arg d "$_c_dim" --arg m "$_c_magenta" --arg z "$_c_reset" '
    "\($d)\(.at)\($z)  " +
    (if .event == "Notification" then "\($m)\(.event)\($z)" else .event end) +
    "  \($d)\((.cwd // "?") | split("/") | last)\($z)" +
    (if .message then "  \(.message)" else "" end)' 2>/dev/null
}

# install-hooks writes to the user'"'"'s settings.json, so it shows the exact change
# and asks first. It is also idempotent: re-running it after an upgrade repairs
# the entries rather than appending a second copy.
cmd_install_hooks() {
  local settings="$CLAUDE_HOME/settings.json"
  local self
  self=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")
  [ -f "$settings" ] || die "no settings file at $settings" \
    "create it first, or point CLAUDE_CONFIG_DIR at the right directory"

  need jq

  local proposed
  proposed=$(jq --arg self "$self" '
    def entry($event): {
      matcher: "",
      hooks: [ { type: "command", command: "\($self) hook \($event)", timeout: 5 } ]
    };
    # Notification is the one that matters: it fires when Claude needs you.
    # The lifecycle three make the log reconstructable after a crash.
    reduce ["Notification","SessionStart","SessionEnd","Stop"][] as $e
      ( .;
        .hooks[$e] = ( [ ( .hooks[$e] // [] )[]
                         | select( [ .hooks[]?.command? ]
                                   | map(. // "" | contains("ccwatch hook")) | any | not ) ]
                       + [ entry($e) ] ) )
  ' "$settings") || die "could not compute the settings change" "is $settings valid JSON?"

  say "${_c_bold}This will add four hooks to${_c_reset} $settings"
  say ""
  printf '%s' "$proposed" | jq '.hooks' | sed 's/^/  /'
  say ""
  say "${_c_dim}Events will be appended to $EVENTS${_c_reset}"
  say ""
  printf 'Apply? [y/N] '
  local reply=""
  read -r reply
  case "$reply" in
    y|Y|yes|YES) ;;
    *) say "Nothing changed."; return 0;;
  esac

  # Backup first, and write via a temp file so an interrupted write cannot
  # leave a truncated settings.json behind.
  local backup
  backup="$settings.ccwatch-backup.$(date '+%Y%m%d%H%M%S')"
  cp "$settings" "$backup" || die "could not back up $settings"
  printf '%s\n' "$proposed" >"$settings.ccwatch-tmp" \
    && mv "$settings.ccwatch-tmp" "$settings" \
    || die "could not write $settings" "your original is at $backup"
  mkdir -p "$CCWATCH_HOME"
  say "${_c_green}Installed.${_c_reset} Previous settings saved to $backup"
  say "${_c_dim}New sessions pick the hooks up; existing ones need a restart.${_c_reset}"
}



# ============================================================ transcript ====
#
# The recent conversation for one session, so you can see what an agent is
# actually doing before deciding what to say to it.
#
# ⚠️ Transcripts contain entire tool outputs and file contents. Reading one
# whole and shipping it to a browser would mean megabytes per poll and would
# put whatever those files contain on a socket. So:
#   - only the tail of the file is read, by bytes, never the whole thing
#   - assistant text and user turns are kept in full-ish (truncated)
#   - tool USE is reduced to the tool name and a short argument summary
#   - tool RESULTS are reduced to a size, not the content
# What survives is enough to see what is going on and nothing more.
CCWATCH_TAIL_BYTES="${CCWATCH_TAIL_BYTES:-400000}"
CCWATCH_TAIL_TEXT="${CCWATCH_TAIL_TEXT:-1200}"

transcript_path() { # transcript_path <sid>
  ls -t "$PROJ_DIR"/*/"$1".jsonl 2>/dev/null | head -1
}

cmd_convo() {
  local as_json=0 n=25 target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1; shift;;
      -n)     n="${2:-25}"; shift 2 || exit 3;;
      -*) die "convo: unrecognised option '$1'" "usage: ccwatch convo [-n N] [--json] <name|session-id|pid>";;
      *) target="$1"; shift;;
    esac
  done
  [ -n "$target" ] || die "convo: no session given" \
    "usage: ccwatch convo [-n N] <name|session-id|pid>"

  local t sid name file
  # A session id is accepted directly so an exited session can still be read —
  # resolve_target only knows about live ones.
  if [ -f "$(transcript_path "$target")" ]; then
    sid="$target"; name="$target"
  else
    t=$(resolve_target "$target") || exit 1
    sid=$(printf '%s' "$t" | jq -r .sid)
    name=$(printf '%s' "$t" | jq -r .name)
  fi
  file=$(transcript_path "$sid")
  [ -n "$file" ] || die "no transcript for $name" \
    "the session may be too new to have written one, or an embedded-SDK session, which never does"

  local turns
  # -R with fromjson?, not plain jq. A byte-tail starts mid-line, so the first
  # line is invalid JSON — and parsing the stream as JSON makes jq abort the
  # WHOLE thing on it. The comment about this was here before the code was.
  turns=$(tail -c "$CCWATCH_TAIL_BYTES" "$file" \
    | jq -R -c --argjson lim "$CCWATCH_TAIL_TEXT" '
        (fromjson? // empty)
        | select(.type == "user" or .type == "assistant")
        | { at: .timestamp,
            role: .type,
            origin: (.origin.kind // null),
            from: (.origin.from // null),
            # A tool result arrives as a user-role turn. It is not something
            # the user said, and showing it as one is actively misleading.
            # A user-role turn is not necessarily something the user SAID. Tool
            # results, task notifications and system reminders all arrive that
            # way, and labelling them "you" misattributes machine output to the
            # person — which matters most in exactly the situation you opened
            # this view for.
            kind: (( [ (.message.content
                        | if type == "string" then [{type:"text", text:.}] else . end)[]?
                       | select(.type == "text") | .text ] | first // "") as $first
                   | if .toolUseResult != null then "tool_result"
                     elif .type != "user" then "assistant"
                     # Origin first. A message from another session is a peer
                     # message whatever else is true of the record — checking
                     # the system heuristics ahead of this relabelled real
                     # agent-to-agent traffic as "system", which hides exactly
                     # the thing the peer graph exists to surface.
                     elif (.origin.kind == "peer") then "said"
                     elif ($first | startswith("<task-notification>")) then "system"
                     elif ($first | startswith("<system-reminder>")) then "system"
                     elif ($first | startswith("<local-command")) then "system"
                     elif (.isMeta // false) then "system"
                     else "said" end),
            text: ( [ (.message.content
                       | if type == "string" then [{type:"text", text:.}] else . end)[]?
                      | if .type == "text" then .text
                        elif .type == "tool_use" then
                          "→ \(.name)" +
                          ( (.input // {}) | if type == "object" then
                              ( [ .command?, .file_path?, .path?, .pattern?, .description? ]
                                | map(select(. != null) | tostring) | first
                                | if . == null then "" else ": \(.[0:120])" end )
                            else "" end )
                        elif .type == "tool_result" then
                          "  ← \((.content // "" | tostring | length)) bytes"
                        elif .type == "thinking" then "· thinking"
                        else "· \(.type)" end ] | join("\n") | .[0:$lim] ) }' \
    2>/dev/null | jq -s --argjson n "$n" '.[-$n:]')

  # `from` on a peer message is a socket path like uds:/tmp/cc-socks/74260.sock.
  # The pid in it is the only useful part, so it is resolved to the name you
  # know that session by. Cheap: the registry is one jq now.
  local names
  names=$(collect_sessions | jq -c '[ .rows[] | {key: (.pid|tostring), value: .name} ] | from_entries')
  turns=$(printf '%s' "${turns:-[]}" | jq -c --argjson names "${names:-\{\}}" '
    map(if .from == null then .
        else .from = ( (.from | capture("(?<pid>[0-9]+)\\.sock$") | .pid) as $pid
                       | $names[$pid] // ("pid " + $pid) ) end)' 2>/dev/null)     || turns="${turns:-[]}"

  if [ "$as_json" -eq 1 ]; then
    jq -cn --arg sid "$sid" --arg name "$name" --argjson turns "${turns:-[]}" \
      '{session_id: $sid, name: $name, turns: $turns}'
    return 0
  fi

  say "${_c_bold}$name${_c_reset} ${_c_dim}${sid:0:8} — last $(printf '%s' "${turns:-[]}" | jq 'length') turns${_c_reset}"
  say ""
  printf '%s' "${turns:-[]}" | jq -r --arg d "$_c_dim" --arg c "$_c_cyan" \
      --arg g "$_c_green" --arg m "$_c_magenta" --arg z "$_c_reset" '
    .[]
    | ( if .kind == "said" then
            (if .origin == "peer" then $m + "peer(" + (.from // "?") + ")" else $c + "you" end)
        elif .kind == "system" then $d + "system"
        elif .kind == "tool_result" then $d + "result"
        else $g + "claude" end ) as $who
    | "\($d)\(.at[11:19])\($z) \($who)\($z)  "
      + ((.text // "") | gsub("\n"; "\n                   ") )'
}




# ================================================================== kill ====
#
# The one destructive thing this tool does, so it is the most careful.
#
# What survives a kill: the transcript. It is append-only and flushed as the
# session runs, so the conversation is kept and `claude --resume <sid>` reopens
# it — the same guarantee `claude stop` gives for a background session. That is
# what makes this recoverable rather than a deletion, and it is printed every
# time so the operator does not have to remember it.
#
# What does NOT survive: whatever was in flight. A tool call mid-execution, an
# unwritten file, a spec-run phase halfway through a paid model call. So the
# cases where that matters are refused by default rather than warned about,
# because a warning in a list of nineteen rows is a warning nobody reads.
CCWATCH_KILL_GRACE="${CCWATCH_KILL_GRACE:-8}"

cmd_kill() {
  platform_detect
  [ "$CCWATCH_PLATFORM" = windows ] && die "kill: not available on Windows" \
    "this needs POSIX signals and the per-session Unix socket"
  local force=0 yes=0 target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift;;
      -y|--yes) yes=1; shift;;
      -*) die "kill: unrecognised option '$1'" \
              "usage: ccwatch kill [--force] [-y] <name|session-id|pid>";;
      *) target="$1"; shift;;
    esac
  done
  [ -n "$target" ] || die "kill: no session given" \
    "usage: ccwatch kill [--force] [-y] <name|session-id|pid>"

  local t
  t=$(resolve_target "$target") || exit 1

  local name sid pid kindv rss tok phase pstatus prunner
  name=$(printf '%s' "$t" | jq -r '.name')
  sid=$(printf '%s' "$t" | jq -r '.sid')
  pid=$(printf '%s' "$t" | jq -r '.pid')
  rss=$(printf '%s' "$t" | jq -r '.rss_mb // "?"')
  tok=$(printf '%s' "$t" | jq -r '.token')
  pstatus=$(printf '%s' "$t" | jq -r '.pipeline.status // ""')
  phase=$(printf '%s' "$t" | jq -r '.pipeline.phase // ""')
  prunner=$(printf '%s' "$t" | jq -r '.pipeline.runner_pid // ""')
  kindv=$(jq -r '.kind // "interactive"' "$SESS_DIR/$pid.json" 2>/dev/null) || kindv="interactive"

  # --- the refusals ---------------------------------------------------------
  # A spec-run phase that is genuinely running is a paid model call in flight.
  # Killing it wastes what has been spent and leaves the pipeline recording a
  # crash. Refused, not warned.
  if [ "$pstatus" = "running" ] && [ -n "$prunner" ] && [ "$force" -eq 0 ]; then
    if kill -0 "$prunner" 2>/dev/null; then
      err "$name is running spec-run phase '$phase' right now"
      say "  ${_c_dim}Killing it aborts a paid model call mid-flight and leaves the"
      say "  pipeline recording a crash. Let it finish, or:${_c_reset} ccwatch kill --force $target"
      exit 1
    fi
  fi
  # Mid-turn means a tool call may be part-applied. The transcript survives
  # either way, but the working tree might be left half-edited.
  if [ "$tok" = "busy" ] && [ "$force" -eq 0 ]; then
    err "$name is mid-turn (busy)"
    say "  ${_c_dim}A tool call may be part-way through, so the working tree could be"
    say "  left half-edited. Wait for it to go idle, or:${_c_reset} ccwatch kill --force $target"
    exit 1
  fi

  say "${_c_bold}Kill $name${_c_reset} ${_c_dim}($tok, ${rss}MB, pid $pid)${_c_reset}"
  say "  ${_c_dim}The conversation is kept. Reopen it with:${_c_reset}"
  say "  ${_c_cyan}claude --resume $sid${_c_reset}"
  [ "$tok" = "waiting" ] && \
    say "  ${_c_yellow}!${_c_reset} ${_c_dim}This session is waiting on you — whatever it asked will be lost from the dialog.${_c_reset}"
  if [ "$yes" -eq 0 ]; then
    printf 'Kill it? [y/N] '
    local reply=""
    read -r reply
    case "$reply" in y|Y|yes|YES) ;; *) say "Nothing killed."; return 0;; esac
  fi

  # --- graceful first -------------------------------------------------------
  # A background session has a supported command for this, which does the
  # bookkeeping ccwatch would otherwise have to guess at. Use it.
  local method=""
  if [ "$kindv" = "bg" ] && command -v claude >/dev/null 2>&1; then
    method="claude stop"
    claude stop "${sid:0:8}" >/dev/null 2>&1 || method="TERM"
  else
    method="TERM"
  fi
  # SIGTERM, never SIGKILL: a terminated session gets to flush. Escalation is
  # not offered, because a session that ignores TERM is doing something and
  # the right answer is to look at it rather than to insist.
  [ "$method" = "TERM" ] && kill -TERM "$pid" 2>/dev/null

  local waited=0
  while [ "$waited" -lt "$CCWATCH_KILL_GRACE" ]; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
    waited=$((waited + 1))
  done

  if kill -0 "$pid" 2>/dev/null; then
    warn "$name is still running after ${CCWATCH_KILL_GRACE}s (sent $method)"
    say "  ${_c_dim}It may be finishing a tool call. Look at it before insisting:${_c_reset}"
    say "  ${_c_cyan}ccwatch convo $sid${_c_reset}"
    kill_record "$t" "$method" "still-running"
    exit 1
  fi

  say "${_c_green}killed${_c_reset} $name ${_c_dim}— ${rss}MB released, conversation kept${_c_reset}"
  kill_record "$t" "$method" "killed"
}

# Every kill is recorded. "Who stopped that agent, and why is it not running"
# needs an answer afterwards, and a monitoring tool that can destroy without
# leaving a trace is one you cannot audit.
kill_record() { # kill_record <target-json> <method> <outcome>
  mkdir -p "$CCWATCH_HOME" 2>/dev/null || return 0
  jq -cn --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
         --arg sid "$(printf '%s' "$1" | jq -r .sid)" \
         --arg name "$(printf '%s' "$1" | jq -r .name)" \
         --arg cwd "$(printf '%s' "$1" | jq -r .cwd)" \
         --argjson rss "$(printf '%s' "$1" | jq '.rss_mb // 0')" \
         --arg method "$2" --arg outcome "$3" \
    '{at:$at, event:"ccwatch.kill", session_id:$sid, target:$name, cwd:$cwd,
      rss_mb:$rss, method:$method, outcome:$outcome}' >>"$EVENTS" 2>/dev/null || true
  return 0
}

# ================================================================= host =====
#
# Why an agent died, when it died for a reason that had nothing to do with
# Claude.
#
# A session killed by the OS under memory pressure leaves exactly the same
# trace as one that exited cleanly: its registry file disappears. ccwatch can
# say the session is gone; without this it cannot say the machine was out of
# swap when it went. That turns "it died mysteriously" — the original complaint
# this tool was built for — into a cause.
#
# Measured on the machine this was written on: 26.3GB of 27.6GB swap in use and
# 59MB of free RAM, with nineteen sessions running and no single large
# consumer. The OS was reaping background tasks at the time.
CCWATCH_SWAP_WARN="${CCWATCH_SWAP_WARN:-80}"

collect_host() {
  local out
  out=$(probe_host)
  if [ -n "$out" ]; then printf '%s' "$out"; else printf 'null'; fi
}

# ============================================================ pending asks ==
#
# WHAT a blocked session is asking, not merely that it is blocked.
#
# `waitingFor` in the registry gives a label ("input needed"). The actual
# question — its text, and every option with its description — is in the
# transcript, as the input to an `AskUserQuestion` tool call. It is the single
# most valuable thing this tool can show: a session has stopped, and here is
# exactly what it wants.
#
# The pending one is the tool_use with NO matching tool_result. An answered
# question has a result referencing its id, so "unanswered" is a fact in the
# file rather than a guess from position or recency.
CCWATCH_ASK_BYTES="${CCWATCH_ASK_BYTES:-600000}"

# collect_asks — pending questions for the given session ids.
#
# Only called for sessions the registry says are waiting, so this is normally
# zero or one file reads, not one per session.
collect_asks() { # collect_asks <sid>...
  local sid file
  [ $# -gt 0 ] || { printf '{}'; return 0; }
  {
    for sid in "$@"; do
      file=$(transcript_path "$sid")
      [ -n "$file" ] || continue
      # ⚠️ Seeks to the LAST AskUserQuestion by byte offset rather than reading
      # a fixed-size tail.
      #
      # A fixed tail is wrong in both directions. Too small and a pending
      # question just outside the window is missed — measured on a real 4.9MB
      # transcript whose last question sat 850KB from the end. Too small the
      # other way and a tool_result can fall outside the window while its
      # tool_use is inside it, which makes an ANSWERED question look pending.
      #
      # A result always appears after its call, so reading from the last call
      # to EOF is both sufficient and bounded, whatever the file size.
      $CCWATCH_PY -c '
import json, sys

path, sid = sys.argv[1], sys.argv[2]
try:
    with open(path, "rb") as fh:
        data = fh.read()
except OSError:
    sys.exit(0)

i = data.rfind(b"\"AskUserQuestion\"")
if i < 0:
    sys.exit(0)
# Back up to the start of that line so the record parses.
start = data.rfind(b"\n", 0, i) + 1

asked_id = None
asked_input = None
answered = set()
for line in data[start:].split(b"\n"):
    if not line.strip():
        continue
    try:
        rec = json.loads(line)
    except ValueError:
        continue
    msg = rec.get("message") or {}
    content = msg.get("content")
    if not isinstance(content, list):
        continue
    for block in content:
        if not isinstance(block, dict):
            continue
        if (block.get("type") == "tool_use"
                and block.get("name") == "AskUserQuestion"
                and asked_id is None):
            asked_id = block.get("id")
            asked_input = block.get("input") or {}
        elif block.get("type") == "tool_result" and block.get("tool_use_id"):
            answered.add(block["tool_use_id"])

if asked_id is None or asked_id in answered:
    sys.exit(0)

qs = []
for q in (asked_input.get("questions") or []):
    qs.append({
        "question": q.get("question"),
        "header": q.get("header"),
        "options": [{"label": o.get("label"), "description": o.get("description")}
                    for o in (q.get("options") or [])],
    })
if qs:
    print(json.dumps({"key": sid, "value": qs}))
' "$(probe_native_path "$file")" "$sid" 2>/dev/null
    done
  } | jq -s 'from_entries'
}

cmd_ask() {
  local as_json=0 target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1; shift;;
      -*) die "ask: unrecognised option '$1'" "usage: ccwatch ask [--json] [<name|session-id>]";;
      *) target="$1"; shift;;
    esac
  done

  local snap waiting
  snap=$(snapshot)
  if [ -n "$target" ]; then
    local t
    t=$(resolve_target "$target") || exit 1
    waiting=$(printf '%s' "$t" | jq -c '[.]')
  else
    # No target: everything currently blocked on you, which is the question you
    # are actually asking when you run this.
    waiting=$(printf '%s' "$snap" | jq -c '[ .sessions[] | select(.sev == 4) ]')
  fi

  local n
  n=$(printf '%s' "$waiting" | jq 'length')
  if [ "${n:-0}" -eq 0 ]; then
    say "${_c_dim}Nothing is waiting on you.${_c_reset}"
    return 0
  fi

  local sids asks
  sids=$(printf '%s' "$waiting" | jq -r '.[].sid')
  # shellcheck disable=SC2086
  asks=$(collect_asks $sids)

  if [ "$as_json" -eq 1 ]; then
    jq -cn --argjson w "$waiting" --argjson a "${asks:-\{\}}" \
      '[ $w[] | . + {questions: ($a[.sid] // null)} ]'
    return 0
  fi

  printf '%s' "$waiting" | jq -r --argjson a "${asks:-\{\}}" \
      --arg b "$_c_bold" --arg m "$_c_magenta" --arg c "$_c_cyan" \
      --arg d "$_c_dim" --arg z "$_c_reset" '
    .[]
    | ($a[.sid]) as $qs
    | "\($m)\($b)\(.name)\($z) \($d)\(.project // "?")\($z)"
      + " \($d)waiting \(if .waited == null then "" else "\(.waited | floor)s" end) — \(.note // "input needed")\($z)"
      + ( if $qs == null then
            # A permission prompt is not an AskUserQuestion and has no options
            # in the transcript. Saying so beats printing nothing.
            "\n  \($d)(no question recorded — this is a dialog, e.g. a permission"
            + " prompt. Its label is above.)\($z)"
          else
            ( $qs | to_entries | map(
                "\n  \($b)\(.value.question)\($z)"
                + ( .value.options | to_entries
                    | map("\n    \($c)\(.key + 1).\($z) \(.value.label)"
                          + (if (.value.description // "") == "" then ""
                             else "\n       \($d)\(.value.description)\($z)" end))
                    | join("") )
              ) | join("\n") )
          end )
      + "\n"'
  [ -z "$target" ] && say "${_c_dim}Answer with:${_c_reset} ccwatch send <name> \"<your answer>\""
  return 0
}

# ============================================================ send ==========
#
# Injecting a message into a session that is ALREADY RUNNING, rather than
# resuming a copy of its conversation.
#
# Claude Code listens on a per-session Unix socket — the `messagingSocketPath`
# already in the registry — and documents the wire format in its own debug log:
#
#   { echo '{"type":"auth","token":"..."}'
#     echo '{"type":"user","message":{"role":"user","content":"hello"}}'
#   } | socat - UNIX-CONNECT:/tmp/cc-socks/<pid>.sock
#
# Newline-delimited JSON, an auth line first. The token is the `peerToken` in
# ~/.claude/sessions/<pid>.<hash>.key, whose other two fields (`procStart`,
# `pidDomain`) are the same PID-reuse guard used for liveness above.
#
# ⚠️ This is the least stable thing ccwatch does. The registry and the
# transcripts are at least stable file formats; this is a protocol, and a
# version bump could change the frames. `ccwatch doctor` probes it, and
# `--dry-run` prints exactly what would be sent so the frames can be checked by
# eye against a newer Claude Code before trusting them.

# resolve_target — a name, a session id, or a pid, to one live session.
#
# Refuses an ambiguous match rather than picking one. Sending a message to the
# wrong agent is not recoverable by the tool: it has already been said.
# ⚠️ This returns a STATUS; it does not exit. It is called in a command
# substitution, and `exit` inside `$( )` kills only the subshell — so the first
# version printed "matches 2 live sessions", then carried on with an empty
# target and exited 0. The refusal was real; the enforcement was not. Caught
# only because an assertion checked the exit code as well as the message.
resolve_target() { # resolve_target <needle>  -> JSON on stdout, non-zero on failure
  local needle="$1" snap matches n
  # A non-zero snapshot and an empty snapshot are the same fact here, and both
  # go through require_json so the reason is always printed. `|| return 1` on
  # the assignment alone returned silently, which is a refusal with no reason.
  snap=$(snapshot) || snap=""
  # ⚠️ A failed snapshot is its own fact, not an ambiguous match. Without this,
  # an empty `$snap` gave an empty `$matches`, `jq length` printed nothing, `$n`
  # was the empty string, and the `case` below fell through to its `*)` arm —
  # so `ccwatch kill` reported "'<pid>' matches  live sessions — be specific:"
  # with a blank where the count belongs, and listed nothing. Observed for real
  # while the host was out of memory: eight kills, five of them refused with a
  # message that described a completely different problem.
  require_json snapshot "$snap" || return 1
  matches=$(printf '%s' "$snap" | jq -c --arg n "$needle" '
    [ .sessions[]
      | select( .name == $n
                or .sid == $n
                or (.pid|tostring) == $n
                # A prefix is allowed for session ids only, because they are
                # long and always pasted. Names are matched whole: a prefix
                # match on `agents` would hit five different sessions.
                or (($n | length) >= 8 and (.sid | startswith($n))) ) ]')
  n=$(printf '%s' "$matches" | jq 'length')
  case "$n" in
    # An unreadable count is a failure of the match itself, and is never
    # allowed to fall through to the ambiguity arm below and be described as
    # a count of sessions that was never obtained (constitution V).
    ''|*[!0-9]*)
       err "could not match '$needle' against the live sessions"
       printf '  %s\n' "the session list could not be read; 'ccwatch doctor' reports why" >&2
       return 1;;
    0) err "no live session matches '$needle'"
       printf '  %s\n' "run 'ccwatch once' for the names, or 'ccwatch resume' if it has exited" >&2
       return 1;;
    1) printf '%s' "$matches" | jq -c '.[0]'; return 0;;
    # Sending to the wrong agent is not recoverable by the tool: it has already
    # been said. So an ambiguous needle is refused, never resolved by picking.
    *) err "'$needle' matches $n live sessions — be specific:"
       printf '%s' "$matches" | jq -r '.[] | "    \(.name)  pid \(.pid)  \(.sid)"' >&2
       return 1;;
  esac
}

# session_token — the peerToken for a pid, with the PID-reuse guard applied.
#
# The key file is named <pid>.<hash>.key and carries `procStart`. If that does
# not match the process now running under the pid, the file outlived its
# session and the token is not for the process we are about to talk to.
session_token() { # session_token <pid>
  local pid="$1" f
  for f in "$SESS_DIR/$pid".*.key; do
    [ -f "$f" ] || continue
    jq -r '.peerToken // empty' "$f" 2>/dev/null
    return 0
  done
  return 1
}

# uds_send — newline-delimited JSON to a Unix socket.
#
# python3 only, deliberately. The first version tried `nc -U` first and fell
# back to python, but the nc path needs a half-close to tell the peer the
# frames are finished and a timeout so an unresponsive session cannot hang the
# monitor, and nc does neither portably. Two code paths where one is subtly
# wrong is worse than one that is right; python3 ships with macOS and does both
# correctly.
uds_send() { # uds_send <socket>, frames on stdin
  # ⚠️ The program is passed with -c, NOT on stdin. `python3 - "$sock" <<EOF`
  # looks equivalent and is not: python then reads its PROGRAM from stdin, so
  # the heredoc consumes the very stdin the frames arrive on and
  # sys.stdin.read() returns empty. The frames never left the shell, the socket
  # write "succeeded", and ccwatch reported "sent". Found only because delivery
  # is verified in the receiver's transcript rather than assumed.
  #
  # python3 rather than nc because the exchange needs a half-close (to tell the
  # peer the frames are complete) and a timeout (so an unresponsive session
  # cannot hang the monitor), and nc does neither portably.
  $CCWATCH_PY -c '
import socket, sys
sock = sys.argv[1]
data = sys.stdin.buffer.read()
if not data:
    sys.stderr.write("nothing to send: no frames arrived on stdin\n")
    sys.exit(1)
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(5)
try:
    s.connect(sock)
    s.sendall(data)
    s.shutdown(socket.SHUT_WR)
    try:
        reply = s.recv(4096)
        if reply:
            sys.stdout.write(reply.decode("utf-8", "replace"))
    except socket.timeout:
        pass
except OSError as e:
    sys.stderr.write("socket error: %s\n" % e)
    sys.exit(1)
finally:
    s.close()
' "$1"
}

cmd_send() {
  platform_detect
  [ "$CCWATCH_PLATFORM" = windows ] && die "send: not available on Windows" \
    "this needs POSIX signals and the per-session Unix socket"
  local dry=0 target="" msg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift;;
      -*) die "send: unrecognised option '$1'" "usage: ccwatch send [--dry-run] <name|session-id|pid> <message>";;
      *) if [ -z "$target" ]; then target="$1"; else msg="${msg:+$msg }$1"; fi; shift;;
    esac
  done
  [ -n "$target" ] || die "send: no target" "usage: ccwatch send <name|session-id|pid> <message>"
  [ -n "$msg" ] || die "send: no message" "usage: ccwatch send <name|session-id|pid> <message>"

  local t pid sock token
  # The status is checked here, in the main shell, which is the only place it
  # can actually stop the command.
  t=$(resolve_target "$target") || exit 1
  pid=$(printf '%s' "$t" | jq -r '.pid')
  sock="/tmp/cc-socks/$pid.sock"
  [ -S "$sock" ] || sock=$(jq -r --arg p "$pid" 'select(.pid|tostring == $p) | .messagingSocketPath // empty' \
                             "$SESS_DIR/$pid.json" 2>/dev/null)
  # A real send needs the socket. A dry-run does NOT: reporting that the socket
  # is missing is one of the things you run a dry-run to find out, and aborting
  # instead means the preview cannot tell you what it would have sent.
  local sock_ok=1
  [ -n "$sock" ] && [ -S "$sock" ] || sock_ok=0
  if [ "$sock_ok" -eq 0 ] && [ "$dry" -eq 0 ]; then
    die "session $(printf '%s' "$t" | jq -r .name) has no messaging socket" \
        "it may predate peer messaging, or the socket directory has been cleaned"
  fi

  token=$(session_token "$pid") || token=""

  local frames
  # `from` is a top-level field on the user frame and IS honoured — it lands in
  # the receiver as origin.from, so an injected message is attributable in the
  # transcript instead of showing as "unknown". Tested: `fromName` and
  # `from_name` are ignored, only `from` works.
  frames=$(jq -cn --arg tok "$token" --arg body "$msg" --arg from "${CCWATCH_SEND_AS:-ccwatch}" '
    ( if $tok == "" then empty else {type:"auth", token:$tok} end ),
    {type:"user", from:$from, message:{role:"user", content:$body}}')

  if [ "$dry" -eq 1 ]; then
    say "${_c_bold}Would send to${_c_reset} $(printf '%s' "$t" | jq -r '"\(.name)  pid \(.pid)  \(.sid)"')"
    if [ "$sock_ok" -eq 1 ]; then
      say "${_c_dim}socket:${_c_reset} $sock"
    else
      say "${_c_dim}socket:${_c_reset} ${sock:-<none recorded>} ${_c_red}MISSING — a real send would fail${_c_reset}"
    fi
    say "${_c_dim}auth:${_c_reset}   $([ -n "$token" ] && echo "peerToken from ${SESS_DIR/#$HOME/~}/$pid.<hash>.key (not shown)" || echo "none found — will try without")"
    say ""
    # The token is redacted. Printing it would put a live credential into
    # whatever scrollback or CI log this ran in.
    printf '%s\n' "$frames" | jq -c 'if .type == "auth" then .token = "<redacted>" else . end'
    return 0
  fi

  # The transcript position BEFORE sending, so a new arrival is distinguishable
  # from an identical message sent earlier. Counting lines is enough: the
  # transcript is append-only.
  local tfile before=0
  tfile=$(ls -t "$PROJ_DIR"/*/"$(printf '%s' "$t" | jq -r .sid)".jsonl 2>/dev/null | head -1)
  [ -n "$tfile" ] && before=$(wc -l <"$tfile" | tr -d ' ')

  local reply
  if ! reply=$(printf '%s\n' "$frames" | uds_send "$sock" 2>&1); then
    die "could not deliver to $(printf '%s' "$t" | jq -r .name)" "$reply"
  fi
  case "$reply" in
    *'"dropped"'*|*'"refused"'*)
      err "the session REFUSED or DROPPED the message"
      printf '  %s\n' "$reply" >&2
      exit 1;;
  esac

  # ⚠️ Writing to the socket is NOT evidence of delivery. The first version
  # printed "sent" here and stopped, and the first real test proved it a liar:
  # the write succeeded, nothing arrived, and the tool reported success. The
  # server accepts a connection, parses lines, and can drop one silently.
  #
  # So delivery is now OBSERVED, in the receiver's own transcript. A message
  # that arrives shows up as a user entry with origin.kind == "peer" — that is
  # how Claude Code records a message from another session.
  local waited=0 name
  name=$(printf '%s' "$t" | jq -r .name)
  if [ -z "$tfile" ]; then
    warn "delivered to the socket, but $name has no transcript to confirm it in"
    say "${_c_dim}the write succeeded; whether the session acted on it is unobservable here${_c_reset}"
  else
    while [ "$waited" -lt "$CCWATCH_SEND_VERIFY" ]; do
      if [ "$(wc -l <"$tfile" | tr -d ' ')" -gt "$before" ] \
         && tail -n "+$((before + 1))" "$tfile" \
            | jq -e --arg m "${msg:0:40}" 'select(.type == "user")
                | select(.origin.kind == "peer")
                | select((.message.content | if type == "string" then . else (.[0].text // "") end)
                         | contains($m))' >/dev/null 2>&1; then
        say "${_c_green}delivered${_c_reset} to $name ${_c_dim}(confirmed in its transcript after ${waited}s)${_c_reset}"
        record_send "$t" "$msg" "delivered"
        return 0
      fi
      sleep 1
      waited=$((waited + 1))
    done
    # Queued-but-unprocessed is the normal case for a busy session, and it is a
    # different fact from "not delivered". Said as such.
    warn "queued for $name, but not in its transcript after ${CCWATCH_SEND_VERIFY}s"
    say "${_c_dim}normal if it is mid-turn — the queue is drained between turns.${_c_reset}"
    say "${_c_dim}check later with:${_c_reset} ccwatch peers --session $(printf '%s' "$t" | jq -r '.sid[0:8]')"
  fi
  record_send "$t" "$msg" "queued"
}

# Recorded in the same log as the hooks, so "who told that agent to do that"
# has an answer afterwards.
record_send() { # record_send <target-json> <message> <outcome>
  mkdir -p "$CCWATCH_HOME" 2>/dev/null || return 0
  jq -cn --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
         --arg sid "$(printf '%s' "$1" | jq -r .sid)" \
         --arg cwd "$(printf '%s' "$1" | jq -r .cwd)" \
         --arg name "$(printf '%s' "$1" | jq -r .name)" \
         --arg body "$2" --arg outcome "$3" \
    '{at:$at, event:"ccwatch.send", session_id:$sid, cwd:$cwd,
      target:$name, outcome:$outcome, message:$body}' \
    >>"$EVENTS" 2>/dev/null || true
}


# ============================================================== revive ======
#
# Unsticking an agent that stopped when it should not have, by saying the one
# thing you would have typed yourself.
#
# Two ways an unattended session stops, both measured in this machine's own
# transcripts over a month before any of this was written:
#
#   It stopped on an API error. Claude Code records these as an assistant
#   entry with `isApiErrorMessage` and an `error` field — 86 "Can't reach the
#   API server — check your internet or DNS", 33 "Connection lost
#   mid-response", 23 "went to sleep mid-response", 19 "Request timed out",
#   and about 200 session limits. Typing "retry" once the network is back is
#   the whole fix, and it is a fix nobody is there to make.
#
#   It gave an update and did not carry on. 47 messages over that month were
#   some form of "keep going" or "are you done?", 44 were followed by the
#   agent going straight back to tool calls, and the agent had sat idle a
#   median of 30 minutes first. 60 of the 64 that waited ten minutes or more
#   were in a repository with a spec-roadmap still unfinished at the time.
#   Asking "are you actually done with the work and this pause is
#   intentional?" was enough, every time it was tried by hand.
#
# What this must NOT do is talk an agent out of a pause that was right. So
# every nudge is gated on the reading that justifies it, and every gate that
# cannot be read refuses rather than assumes (principle VI):
#
#   ✗ a session waiting on a permission prompt — that gate is yours
#   ✗ a turn that ended on a question to you
#   ✗ a session you interrupted yourself
#   ✗ a session whose spec-run/spec-roadmap runner is still beneath it, or
#     whose process tree could not be read
#   ✗ background work launched and not yet reported back
#   ✗ a session asked once already that answered without doing anything —
#     it has said the pause is intentional, and that is its call
#   ✗ a retry while the API host is still unreachable, and more than
#     CCWATCH_REVIVE_MAX_RETRIES of them, with the wait doubling each time
#
# Delivery goes through `cmd_send`, so it is observed in the receiver's
# transcript rather than assumed (principle VIII), and is recorded in the
# event log beside every other send.

# How long a turn that ended mid-roadmap is left alone before it is asked.
# Ten minutes: the measured nudges were a median of 30 minutes late, and under
# ten most of them were somebody still at the keyboard.
CCWATCH_REVIVE_AFTER="${CCWATCH_REVIVE_AFTER:-600}"
# The first wait after an API error; it doubles after each retry.
CCWATCH_REVIVE_RETRY_AFTER="${CCWATCH_REVIVE_RETRY_AFTER:-60}"
CCWATCH_REVIVE_MAX_RETRIES="${CCWATCH_REVIVE_MAX_RETRIES:-6}"
# How many times one stretch of work (everything since your last message) may
# be asked whether it is done. The ask is cheap; asking forever is not.
CCWATCH_REVIVE_MAX_ASKS="${CCWATCH_REVIVE_MAX_ASKS:-3}"
# How many tool calls after an ask count as the work having resumed, so that
# the next stop is a new stall worth asking about. Fewer is an agent that
# checked and answered. See collect_stops for the measurement behind 10.
CCWATCH_REVIVE_RESUMED="${CCWATCH_REVIVE_RESUMED:-10}"
CCWATCH_REVIVE_INTERVAL="${CCWATCH_REVIVE_INTERVAL:-60}"
# Session limits reset on a clock the message itself states; this is the
# margin past it before "continue" is sent, so the first request is not early.
CCWATCH_REVIVE_LIMIT_GRACE="${CCWATCH_REVIVE_LIMIT_GRACE:-120}"
# The exact words. They double as the marker for "ccwatch already said this",
# which is why they are compared verbatim and why changing one is a setting
# rather than an edit.
CCWATCH_REVIVE_ASK="${CCWATCH_REVIVE_ASK:-Are you actually done with the work and this pause is intentional?}"
CCWATCH_REVIVE_RETRY="${CCWATCH_REVIVE_RETRY:-retry}"
CCWATCH_REVIVE_CONTINUE="${CCWATCH_REVIVE_CONTINUE:-continue}"
# What "the network is back" is measured against.
CCWATCH_REVIVE_NET="${CCWATCH_REVIVE_NET:-api.anthropic.com:443}"

# collect_stops — how each session's last turn ended, from its transcript.
#
# Emits {sid: {...}} for every session whose transcript could be read. Only
# Claude Code's own records are interpreted: an API error's message (Claude
# Code wrote it, not the model and not a tool), whether the final text ends in
# a question mark, and counts. No assistant text, user text or tool output
# leaves this function (principle X).
collect_stops() { # collect_stops <sid>...
  local sid file
  [ $# -gt 0 ] || { printf '{}'; return 0; }
  {
    for sid in "$@"; do
      file=$(transcript_path "$sid")
      [ -n "$file" ] || continue
      printf '%s\t%s\n' "$sid" "$(probe_native_path "$file")"
    done
  } | $CCWATCH_PY -c '
import json, re, sys
from datetime import datetime, timedelta, timezone

ask, retry, cont = sys.argv[1], sys.argv[2], sys.argv[3]
resumed = int(sys.argv[4])
ours = {ask: "asks", retry: "retries", cont: "continues"}
ROADMAP_CMD = re.compile(r"spec-roadmap(\s+run\b|\s*$|\s+--)")
# The roadmap a spec-roadmap command names: `run --slug x`, or `run x`. Words
# that are the runner own flags are not slugs; anything else that matches no
# roadmap file is dropped by the join, so a stray word costs nothing.
SLUG = re.compile(r"spec-roadmap[\"\x27]?\s+(?:run|show)\b[^\n|;&]*?(?:--slug[ =]+|\s)([a-z0-9][a-z0-9-]{2,})")
# Tools whose only effect is talking to other sessions. They do no work.
TALK_ONLY = {"SendMessage", "ListAgents"}

def epoch(s):
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None

def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(b.get("text", "") for b in content
                         if isinstance(b, dict) and b.get("type") == "text")
    return ""

def blocks(rec, kind):
    c = (rec.get("message") or {}).get("content")
    return [b for b in c if isinstance(b, dict) and b.get("type") == kind] if isinstance(c, list) else []

def said(rec):
    """What a user record IS, in the terms that matter here."""
    origin = rec.get("origin") or {}
    o = origin.get("kind")
    content = (rec.get("message") or {}).get("content")
    if blocks(rec, "tool_result"):
        return ("tool_result", None)
    if o == "human":
        return ("human", text_of(content))
    if o == "peer":
        # A subagent hand-back arrives as a peer message, but it is the
        # completion of background work, not somebody speaking.
        if origin.get("handback"):
            return ("handback", None)
        if isinstance(origin.get("body"), str):
            return ("peer", origin.get("body"))
        # ⚠️ No `body` is the common case, not the odd one: the first real
        # ask revive sent arrived with only `content`, wrapped in Claude Code
        # own envelope ("Another Claude session sent a message:", the text,
        # then a paragraph about peers). Compared whole, that never equalled
        # the ask, so revive never saw it had asked, and asked the same
        # session again ten minutes after it had answered. The text it sent
        # is a line of its own inside the envelope, so it is found as one.
        t = text_of(content)
        lines = [ln.strip() for ln in t.split("\n")]
        for mine in ours:
            if mine in lines:
                return ("peer", mine)
        return ("peer", t)
    if o == "task-notification":
        return ("meta", None)
    if o is not None or rec.get("isMeta"):
        return ("meta", None)
    t = text_of(content)
    if t.startswith("[Request interrupted"):
        return ("interrupt", None)
    # Older transcripts carry no origin at all. Plain text with no harness
    # tag is somebody typing.
    if t and not t.lstrip().startswith("<"):
        return ("human", t)
    return ("meta", None)

def limit_reset(msg, at):
    # "You have hit your session limit · resets 2:20am (America/New_York)"
    m = re.search(r"resets\s+(\d{1,2})(?::(\d{2}))?\s*([ap]m)\s*\(([^)]+)\)", msg, re.I)
    if not m or at is None:
        return None
    try:
        from zoneinfo import ZoneInfo
        tz = ZoneInfo(m.group(4))
    except Exception:
        return None
    h = int(m.group(1)) % 12 + (12 if m.group(3).lower() == "pm" else 0)
    local = datetime.fromtimestamp(at, tz)
    r = local.replace(hour=h, minute=int(m.group(2) or 0), second=0, microsecond=0)
    if r <= local:
        r += timedelta(days=1)
    return int(r.timestamp())

out = {}
for line in sys.stdin:
    sid, _, path = line.rstrip("\n").partition("\t")
    try:
        with open(path, "rb") as fh:
            data = fh.read()
    except OSError:
        continue

    # Did this session drive spec-roadmap itself? Read over the WHOLE file,
    # because the run is usually launched hours before the stall. Only lines
    # naming it are parsed, and only a command the session ran or a slash
    # command it was given counts: every session carries the skill listing,
    # which names spec-roadmap too, and that matched 88% of all sessions.
    #
    # Over the same pass: does it have a recurring cron job of its own still
    # live? A session that set one will be woken by it, so its silence is the
    # schedule working. Found on the first real run: a session flagged as
    # paused mid-roadmap had a CronCreate polling every three hours.
    #
    # ⚠️ Recurring only, and only for a week. Replayed against a month of real
    # stops, counting every CronCreate blocked 5 that were then nudged by hand:
    # one-shot jobs (`recurring: false`) fire once and are spent, and a
    # recurring job expires after seven days, so a week-old one schedules
    # nothing. A CronDelete cancels the newest live one, since the id it names
    # is only in a tool result.
    roadmap = False
    crons = []
    # WHICH roadmaps it ran, by slug. A repository can hold a dozen roadmaps
    # driven by different sessions - one real one holds 13 - and asking a
    # session about whichever unfinished roadmap comes first asked it, four
    # times, about one it had never touched: its own had landed in full.
    slugs = set()
    for raw in data.split(b"\n"):
        if b"spec-roadmap" not in raw and b"Cron" not in raw:
            continue
        try:
            rec = json.loads(raw)
        except ValueError:
            continue
        if rec.get("isSidechain"):
            continue
        if rec.get("type") == "assistant":
            for b in blocks(rec, "tool_use"):
                inp = b.get("input") or {}
                if b.get("name") == "Bash" and ROADMAP_CMD.search(str(inp.get("command", ""))):
                    roadmap = True
                    slugs.update(SLUG.findall(str(inp.get("command", ""))))
                elif b.get("name") == "Skill" and "spec-roadmap" in str(inp.get("skill", "")):
                    roadmap = True
                    slugs.update(SLUG.findall("spec-roadmap " + str(inp.get("args", ""))))
                elif b.get("name") == "CronCreate" and inp.get("recurring") is not False:
                    crons.append(epoch(rec.get("timestamp")) or 0)
                elif b.get("name") == "CronDelete" and crons:
                    crons.pop()
        elif rec.get("type") == "user":
            c = (rec.get("message") or {}).get("content")
            if isinstance(c, str) and re.search(r"<command-name>/?(speckit-pipeline:)?spec-roadmap<", c):
                roadmap = True

    recs = []
    for raw in data[-600000:].split(b"\n"):
        try:
            rec = json.loads(raw)
        except ValueError:
            continue
        if rec.get("isSidechain") or rec.get("type") not in ("user", "assistant"):
            continue
        recs.append(rec)
    if not recs:
        continue

    last = recs[-1]
    at = epoch(last.get("timestamp"))
    row = {"kind": "none", "at": int(at) if at else None, "error": None, "label": None,
           "resets_at": None, "ends_q": False, "asks": 0, "retries": 0,
           "continues": 0, "answered_ask": False, "bg_pending": 0, "roadmap": roadmap,
           "scheduled": any(at and 0 <= at - c < 7 * 86400 for c in crons),
           "roadmap_slugs": sorted(slugs)}

    if last["type"] == "assistant":
        if last.get("isApiErrorMessage"):
            row["error"] = last.get("error") or "unknown"
            msg = text_of((last.get("message") or {}).get("content"))
            row["label"] = msg.replace("API Error: ", "").split("\n")[0][:80]
            if row["error"] == "rate_limit":
                row["kind"] = "limit"
                row["resets_at"] = limit_reset(msg, at)
            else:
                row["kind"] = "api_error"
        elif blocks(last, "tool_use"):
            row["kind"] = "mid_turn"
        else:
            row["kind"] = "end_turn"
            # The final words of the turn, which may span several records.
            for rec in reversed(recs):
                if rec["type"] != "assistant":
                    break
                t = text_of((rec.get("message") or {}).get("content")).strip()
                if t:
                    row["ends_q"] = t.endswith("?")
                    break
    else:
        k, _ = said(last)
        row["kind"] = {"interrupt": "interrupted", "tool_result": "mid_turn"}.get(k, "unanswered")

    # Everything since the last thing YOU typed: how often ccwatch has spoken
    # in that stretch, whether its last ask was answered with no work done,
    # and how many background subagents have not yet handed back.
    #
    # ⚠️ Subagents only. Background Bash and Monitor were counted too, and the
    # replay showed that count to be noise: a dev server or a watcher never
    # reports back (11 launches against 2 notifications in one real stretch),
    # so the guard blocked 8 of the stops that were then nudged by hand. A
    # subagent always ends in exactly one hand-back, so that pairing is exact.
    #
    # ⚠️ "Answered" means fewer than CCWATCH_REVIVE_RESUMED tool calls since
    # the most recent ask, not none. Asked whether it is done, an agent
    # usually CHECKS before it answers - a `git status`, a `spec-roadmap show`,
    # one to three commands - and a gate of "no tool calls since" read that
    # check as the work resuming, so ten minutes later it was a new stall:
    # measured over one day, one session asked 20 times in runs of three. The
    # agents that really did resume ran 16 to 438 tool calls before stopping
    # again; the ones answering ran 0 to 3.
    launched = finished = since_ask = 0
    seen_ask = False
    last_real = None
    for rec in reversed(recs):
        if rec["type"] == "assistant":
            for b in blocks(rec, "tool_use"):
                # ⚠️ Replying is not working. An agent asked whether it is done
                # very often answers by MESSAGING back (SendMessage), and that
                # is a tool call: counted, the answer read as "it did more
                # work", the answered-once gate never closed, and a session
                # that had said "intentional" was asked three times running.
                if not seen_ask and b.get("name") not in TALK_ONLY:
                    since_ask += 1
                inp = b.get("input") or {}
                if b.get("name") == "ScheduleWakeup" and not inp.get("stop") and last_real is None:
                    row["scheduled"] = True
                if b.get("name") in ("Agent", "Task") and inp.get("run_in_background"):
                    launched += 1
            continue
        k, t = said(rec)
        if k == "handback":
            finished += 1
        elif k == "human":
            if last_real is None:
                last_real = "human"
            break
        elif k == "peer":
            key = ours.get((t or "").strip())
            if key:
                row[key] += 1
            if key == "asks":
                seen_ask = True
            if last_real is None:
                last_real = (t or "").strip()
    row["answered_ask"] = seen_ask and since_ask < resumed
    row["bg_pending"] = max(0, launched - finished)
    out[sid] = row
print(json.dumps(out))
' "$CCWATCH_REVIVE_ASK" "$CCWATCH_REVIVE_RETRY" "$CCWATCH_REVIVE_CONTINUE" \
    "$CCWATCH_REVIVE_RESUMED" 2>/dev/null
}

# collect_roadmaps — every spec-roadmap in the given directories, and how far
# through it the recorded state says it is.
#
# The definition and the progress are separate files, written by different
# hands (.specify/roadmaps/<slug>.json is authored, <slug>.state.json is the
# runner's), so a roadmap with no state yet is "0 of N", not absent.
collect_roadmaps() { # collect_roadmaps <cwd>...
  [ $# -gt 0 ] || { printf '[]'; return 0; }
  $CCWATCH_PY -c '
import glob, json, os, sys
out = []
for cwd in sys.argv[1:]:
    for f in sorted(glob.glob(os.path.join(cwd, ".specify", "roadmaps", "*.json"))):
        if f.endswith(".state.json"):
            continue
        slug = os.path.basename(f)[:-5]
        try:
            with open(f) as fh:
                entries = [e.get("slug") for e in (json.load(fh).get("entries") or [])]
        except (OSError, ValueError, AttributeError):
            continue
        state = {}
        try:
            with open(f[:-5] + ".state.json") as fh:
                state = json.load(fh).get("entries") or {}
        except (OSError, ValueError, AttributeError):
            pass
        done = [s for s in entries if (state.get(s) or {}).get("status") == "done"]
        current = next((s for s in entries if s not in done), None)
        out.append({"cwd": cwd, "slug": slug, "total": len(entries), "done": len(done),
                    "current": current,
                    "current_status": ((state.get(current) or {}).get("status") or "not started")
                                      if current else None})
print(json.dumps(out))
' "$@" 2>/dev/null || printf '[]'
}

# revive_net — can the API host be reached? Prints "up", or "down: <reason>".
revive_net() {
  case "${CCWATCH_FAKE_NET:-}" in
    up) printf 'up'; return 0;;
    down*) printf 'down: %s' "$(printf '%s' "${CCWATCH_FAKE_NET#down}" | sed 's/^:* *//')"; return 0;;
  esac
  $CCWATCH_PY -c '
import socket, sys
host, _, port = sys.argv[1].rpartition(":")
try:
    socket.create_connection((host, int(port)), timeout=3).close()
    print("up", end="")
except OSError as e:
    print("down: %s" % (e.strerror or e), end="")
' "$CCWATCH_REVIVE_NET" 2>/dev/null || printf 'down: no python to test with'
}

# revive_plan — what to do about each stopped session, and why.
#
# Pure: everything it decides on is passed in, so the whole decision table can
# be asserted against fixtures without a socket, a network or a clock.
revive_plan() { # revive_plan <snapshot> <stops> <roadmaps> <runners|"unreadable"> <net> <now>
  local runners="$4"
  [ "$runners" = "unreadable" ] && runners='null'
  printf '%s' "$1" | jq -c \
    --argjson stops "$2" --argjson roadmaps "$3" --argjson runners "$runners" \
    --arg net "$5" --argjson now "$6" \
    --argjson after "$CCWATCH_REVIVE_AFTER" \
    --argjson retry_after "$CCWATCH_REVIVE_RETRY_AFTER" \
    --argjson max_retries "$CCWATCH_REVIVE_MAX_RETRIES" \
    --argjson max_asks "$CCWATCH_REVIVE_MAX_ASKS" \
    --argjson grace "$CCWATCH_REVIVE_LIMIT_GRACE" \
    --arg ask "$CCWATCH_REVIVE_ASK" --arg retry "$CCWATCH_REVIVE_RETRY" \
    --arg cont "$CCWATCH_REVIVE_CONTINUE" '
    def dur(s): if s < 90 then "\(s|floor)s" elif s < 5400 then "\(s/60|floor)m"
                else "\(s/3600*10|floor/10)h" end;
    [ .sessions[]
      # Only an interactive session that says it is idle. `waiting` is a gate
      # that belongs to you; `busy` is not stopped.
      | select(.entrypoint == "cli" and .status_raw == "idle")
      | . as $s
      | ($stops[.sid]) as $st
      | select($st != null)
      | (if $st.at == null then null else ([$now - $st.at, 0] | max) end) as $since
      # The roadmap THIS session ran. Named by slug when its commands named
      # one; otherwise only when its directory has exactly one unfinished
      # roadmap, because with several, picking one is a guess (principle VI).
      | ([ $roadmaps[] | select(.cwd == $s.cwd and .done < .total) ]) as $open
      | ([ $roadmaps[] | select(.cwd == $s.cwd) ]) as $here
      # Only slugs that name a roadmap file here count: the matcher also picks
      # up prose that follows `spec-roadmap run`, and junk must not stop the
      # one-roadmap fallback from applying.
      | ([ $here[].slug ] - ([ $here[].slug ] - ($st.roadmap_slugs // []))) as $mine
      | (($mine | length) > 0) as $named
      | (if $named then [ $open[] | select(.slug as $x | $mine | index($x)) ] | first
         elif ($open | length) == 1 then $open[0] else null end) as $rm
      | { sid, name, pid, cwd, kind: $st.kind, since: $since,
          resets_at: $st.resets_at }
        + ( if $st.kind == "api_error" then
              ($retry_after * pow(2; $st.retries)) as $wait
              | ( "API error \(dur($since // 0)) ago (\($st.label // $st.error))" ) as $m
              | if $st.retries >= $max_retries then
                  { action: null, why: "\($m) · gave up after \($st.retries) retries" }
                elif ($since // 0) < $wait then
                  { action: null, why: "\($m) · retry \($st.retries + 1) in \(dur($wait - $since))" }
                elif ($net | startswith("up") | not) then
                  { action: null, why: "\($m) · API still unreachable: \($net | sub("^down: "; ""))" }
                else
                  { action: "retry", message: $retry,
                    why: "\($m) · API reachable · retry \($st.retries + 1) of \($max_retries)" }
                end
            elif $st.kind == "limit" then
              if $st.resets_at == null then
                { action: null, why: "session limit · reset time unreadable: \($st.label // "")" }
              elif $now < ($st.resets_at + $grace) then
                { action: null, why: "session limit · resets in \(dur($st.resets_at - $now))" }
              elif $st.continues >= 2 then
                { action: null, why: "session limit · continued twice since your last message, and it stopped again" }
              else
                { action: "continue", message: $cont,
                  why: "session limit reset \(dur($now - $st.resets_at)) ago" }
              end
            elif $st.kind == "end_turn" and $st.roadmap then
              ( "paused \(dur($since // 0))"
                + (if $rm == null then "" else " mid-roadmap \($rm.slug) \($rm.done)/\($rm.total)" end) ) as $m
              | if $rm == null and $named then
                  { action: null, why: "\($m) · the roadmap it ran (\($mine | join(", "))) has landed in full" }
                elif $rm == null and ($open | length) > 1 then
                  { action: null, why: "\($m) · it never named its roadmap, and \($s.cwd) has \($open | length) unfinished ones" }
                elif $rm == null then
                  { action: null, why: "\($m) · no unfinished roadmap in \($s.cwd)" }
                elif $st.answered_ask then
                  { action: null, why: "\($m) · already asked, and it answered without resuming the work — its call" }
                elif $st.asks >= $max_asks then
                  { action: null, why: "\($m) · asked \($st.asks) times since your last message" }
                elif $st.ends_q then
                  { action: null, why: "\($m) · its last turn ended on a question to you" }
                elif $st.scheduled then
                  { action: null, why: "\($m) · it scheduled its own wake-up" }
                elif $st.bg_pending > 0 then
                  { action: null, why: "\($m) · waiting on \($st.bg_pending) background task(s)" }
                elif $runners == null then
                  { action: null, why: "\($m) · process table unreadable, so a live runner cannot be ruled out" }
                elif ($runners | index($s.pid)) != null then
                  { action: null, why: "\($m) · its spec-run/spec-roadmap runner is still running" }
                elif ($since // 0) < $after then
                  { action: null, why: "\($m) · asking at \(dur($after))" }
                else
                  { action: "ask", message: $ask,
                    why: "\($m) · next entry \($rm.current) is \($rm.current_status) · no runner, no question pending" }
                end
            elif $st.kind == "interrupted" and $st.roadmap then
              { action: null, why: "you interrupted it — left alone" }
            else empty
            end ) ]'
}

# The on/off switch `serve` honours, so that turning revive on is one act that
# outlives the page, the serve and a reboot. Off until somebody turns it on: a
# tool that starts messaging your agents because it was installed would be
# acting on a decision nobody made.
REVIVE_SWITCH="$CCWATCH_HOME/revive.json"

revive_enabled() { jq -e '.enabled == true' "$REVIVE_SWITCH" >/dev/null 2>&1; }

revive_set() { # revive_set <true|false> <by>
  mkdir -p "$CCWATCH_HOME" 2>/dev/null || return 1
  jq -cn --argjson on "$1" --arg by "$2" --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    '{enabled:$on, at:$at, by:$by}' >"$REVIVE_SWITCH.tmp" 2>/dev/null \
    && mv "$REVIVE_SWITCH.tmp" "$REVIVE_SWITCH"
}

cmd_revive() {
  platform_detect
  [ "$CCWATCH_PLATFORM" = windows ] && die "revive: not available on Windows" \
    "it delivers through ccwatch send, which needs the per-session Unix socket"
  local dry=0 once=0 as_json=0 send=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift;;
      --once)    once=1; shift;;
      --json)    as_json=1; once=1; shift;;
      # --json is for reading; it sends only when told to in so many words,
      # because `revive --json` typed to have a look must never be the thing
      # that messages six agents.
      --send)    send=1; shift;;
      --enable|--disable)
        revive_set "$([ "$1" = --enable ] && echo true || echo false)" cli \
          || die "could not write $REVIVE_SWITCH"
        say "revive is $([ "$1" = --enable ] && echo "ON" || echo "OFF") for ccwatch serve ${_c_dim}(${REVIVE_SWITCH/#$HOME/~})${_c_reset}"
        return 0;;
      --status)
        if revive_enabled; then say "revive: ON for ccwatch serve"; else say "revive: OFF for ccwatch serve"; fi
        return 0;;
      *) die "revive: unrecognised option '$1'" \
             "usage: ccwatch revive [--once] [--dry-run] [--json [--send]] [--enable|--disable|--status]";;
    esac
  done
  [ "$as_json" -eq 1 ] && [ "$send" -eq 0 ] && dry=1
  [ "$as_json" -eq 1 ] || {
    say "${_c_bold}ccwatch revive${_c_reset} ${_c_dim}— $([ "$dry" -eq 1 ] && echo "dry run, nothing is sent" || echo "will send")$([ "$once" -eq 1 ] || echo " · every ${CCWATCH_REVIVE_INTERVAL}s, Ctrl-C to stop")${_c_reset}"
  }
  while :; do
    revive_tick "$dry" "$as_json"
    [ "$once" -eq 1 ] && return 0
    sleep "$CCWATCH_REVIVE_INTERVAL"
  done
}

# ⚠️ One pass at a time across the whole machine. `serve` runs a pass every
# minute and a terminal may run `ccwatch revive` beside it; two passes reading
# the same transcript in the same second both see a stall nobody has answered,
# and the agent is asked twice. A directory is the lock because mkdir is
# atomic, and it holds the owner's pid so a pass that was killed does not hold
# it for ever.
revive_lock() {
  local d="$CCWATCH_HOME/revive.lock" owner
  mkdir -p "$CCWATCH_HOME" 2>/dev/null
  if mkdir "$d" 2>/dev/null; then printf '%s\n' "$$" > "$d/pid"; return 0; fi
  owner=$(cat "$d/pid" 2>/dev/null)
  if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
    printf '%s' "$owner"; return 1
  fi
  rm -rf "$d" 2>/dev/null
  mkdir "$d" 2>/dev/null && { printf '%s\n' "$$" > "$d/pid"; return 0; }
  printf 'unknown'; return 1
}
revive_unlock() { rm -rf "$CCWATCH_HOME/revive.lock" 2>/dev/null; }

# revive_tick — one pass. With <as_json> it prints one object:
#   {at, rows: [...plan rows, each acted-on one with outcome + detail], skipped}
# `skipped` carries the reason a pass did not run, so a pass that was refused
# never reads as a pass that found nothing (principle IV).
revive_tick() { # revive_tick <dry> <as_json>
  local dry="$1" as_json="$2" snap idle_sids cwds stops roadmaps runners net plan now owner
  now=$(date '+%s')
  if ! owner=$(revive_lock); then
    if [ "$as_json" -eq 1 ]; then
      jq -cn --argjson at "$now" --arg why "another revive pass is running (pid $owner)" \
        '{at:$at, rows:[], skipped:$why}'
    else
      say "${_c_dim}$(date '+%H:%M:%S') skipped: another revive pass is running (pid $owner)${_c_reset}"
    fi
    return 0
  fi
  # shellcheck disable=SC2064
  trap "revive_unlock; cleanup" EXIT
  snap=$(snapshot) || snap=""
  require_json snapshot "$snap" || { revive_unlock; return 1; }
  idle_sids=$(printf '%s' "$snap" | jq -r '.sessions[] | select(.entrypoint == "cli" and .status_raw == "idle") | .sid')
  if [ -z "$idle_sids" ]; then
    revive_unlock
    if [ "$as_json" -eq 1 ]; then jq -cn --argjson at "$now" '{at:$at, rows:[], skipped:null}'
    else say "${_c_dim}$(date '+%H:%M:%S') nothing idle${_c_reset}"; fi
    return 0
  fi
  # shellcheck disable=SC2086
  stops=$(collect_stops $idle_sids)
  require_json collect_stops "$stops" || { revive_unlock; return 1; }
  local -a cwda=()
  cwds=$(printf '%s' "$snap" | jq -r '[.sessions[] | select(.entrypoint == "cli" and .status_raw == "idle") | .cwd] | unique | .[]')
  while IFS= read -r c; do [ -n "$c" ] && cwda+=("$c"); done <<<"$cwds"
  roadmaps=$(collect_roadmaps "${cwda[@]}")
  # shellcheck disable=SC2046
  runners=$(probe_runners $(printf '%s' "$snap" | jq -r '.sessions[] | select(.status_raw == "idle") | .pid')) \
    || runners="unreadable"
  # Only measured when something is waiting on it: a connection attempt every
  # minute to say nothing is wanted is not free.
  if printf '%s' "$stops" | jq -e 'any(.[]; .kind == "api_error")' >/dev/null 2>&1; then
    net=$(revive_net)
  else
    net="unmeasured"
  fi
  plan=$(revive_plan "$snap" "$stops" "$roadmaps" "$runners" "$net" "$now")
  require_json revive_plan "$plan" || { revive_unlock; return 1; }

  if [ "$as_json" -eq 0 ] && [ "$(printf '%s' "$plan" | jq 'length')" = "0" ]; then
    revive_unlock
    say "${_c_dim}$(date '+%H:%M:%S') nothing stopped${_c_reset}"
    return 0
  fi

  local row action name sid msg why out rc outcome done_rows=""
  while IFS= read -r row; do
    action=$(printf '%s' "$row" | jq -r '.action // ""')
    name=$(printf '%s' "$row" | jq -r '.name')
    sid=$(printf '%s' "$row" | jq -r '.sid')
    msg=$(printf '%s' "$row" | jq -r '.message // ""')
    why=$(printf '%s' "$row" | jq -r '.why')
    if [ -z "$action" ]; then
      [ "$as_json" -eq 1 ] || say "  ${_c_dim}wait${_c_reset}      $name  ${_c_dim}$why${_c_reset}"
      done_rows="$done_rows$row"$'\n'
      continue
    fi
    # The word is the verdict and travels without colour (principle VII).
    [ "$as_json" -eq 1 ] || say "  ${_c_yellow}$(printf '%-8s' "$(printf '%s' "$action" | tr '[:lower:]' '[:upper:]')")${_c_reset}  $name  $why"
    if [ "$dry" -eq 1 ]; then
      [ "$as_json" -eq 1 ] || say "            ${_c_dim}would send:${_c_reset} $msg"
      done_rows="$done_rows$row"$'\n'
      continue
    fi
    # A subshell, because cmd_send ends in `die` on any failure and one bad
    # socket must not end the watch over every other session.
    out=$( ( CCWATCH_SEND_AS="ccwatch revive" cmd_send "$sid" "$msg" ) 2>&1 ); rc=$?
    # The same three outcomes `send` itself reports, read off its own words.
    case "$out" in
      *"delivered to"*) outcome=delivered;;
      *"queued for"*)   outcome=queued;;
      *)                outcome=failed;;
    esac
    [ "$rc" -eq 0 ] || outcome=failed
    [ "$as_json" -eq 1 ] || printf '%s\n' "$out" | sed 's/^/            /'
    revive_record "$row" "$outcome"
    done_rows="$done_rows$(printf '%s' "$row" | jq -c --arg o "$outcome" --arg d "$out" \
      '. + {outcome:$o, detail:($d | gsub("\u001b\\[[0-9;]*m"; "") | .[-300:])}')"$'\n'
  done < <(printf '%s' "$plan" | jq -c '.[]')
  revive_unlock
  if [ "$as_json" -eq 1 ]; then
    printf '%s' "$done_rows" | jq -cs --argjson at "$now" '{at:$at, rows:., skipped:null}'
  fi
}

revive_record() { # revive_record <plan-row> <outcome>
  mkdir -p "$CCWATCH_HOME" 2>/dev/null || return 0
  printf '%s' "$1" | jq -c --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" --arg outcome "$2" \
    '{at:$at, event:"ccwatch.revive", session_id:.sid, cwd, target:.name,
      action, outcome:$outcome, why}' >>"$EVENTS" 2>/dev/null || true
}


# ============================================================== deploys =====
#
# The queue of things you are waiting on that are not sessions, and the answer
# to "can the agents subscribe to those".
#
# They can, and they do it themselves. Claude Code exports
# CLAUDE_CODE_SESSION_ID into the environment of every tool call, so an agent
# that runs `ccwatch subscribe deploy-production` identifies itself with no
# ceremony and no plumbing. ccwatch records the subscription, watches, and
# messages the session back over the socket when a matching run finishes. The
# agent does not poll and does not hold a connection open — which is the only
# design that survives the agent being mid-turn, compacting, or restarted.

# cwd -> repo identity. Cached because it needs two git subprocesses per
# directory and the answer essentially never changes.
REPO_CACHE="$CCWATCH_HOME/repos.json"
CCWATCH_REPO_TTL="${CCWATCH_REPO_TTL:-21600}"

# What was live, last time anything looked.
#
# This is the answer to "if the machine restarts, can I get back quickly".
# Transcripts survive and are the resume AUTHORITY, but they do not record
# which sessions were open together, what each was named, or what it was doing
# at the moment everything stopped — and that is the part you have to
# reconstruct from memory otherwise. So every snapshot writes the roster down.
ROSTER="$CCWATCH_HOME/roster.json"

SUBS="$CCWATCH_HOME/subscriptions.jsonl"
DEPLOY_CACHE="$CCWATCH_HOME/deploys.json"
DEPLOY_SEEN="$CCWATCH_HOME/deploys-seen.json"


# collect_repos — which repository each working directory actually belongs to.
#
# ⚠️ NOT the directory basename. That was the first version and it was wrong in
# three ways at once, all visible on one real machine:
#
#   ~/code/platform                    is acme/checkout-api, so a territory
#                                      labelled "platform" named nothing that
#                                      exists on GitHub.
#   ~/code/platform/.claude/worktrees/X  is the SAME repo as above, but was
#                                      shown as a separate project "platform:X".
#   .../worktrees/X/services/pricing   is a DIFFERENT repo nested inside that
#                                      worktree, and was grouped under the
#                                      outer one — merging two repositories.
#
# It also broke deploys silently: runs come back from `gh` keyed by owner/name,
# so a deploy on checkout-api could never match a territory called "platform",
# and those badges simply never appeared.
#
# The remote is the identity. The branch is carried separately, because that is
# what distinguishes two worktrees of one repo.
collect_repos() { # collect_repos <cwd>...
  local cwd cached fresh now
  now=$(date '+%s')
  mkdir -p "$CCWATCH_HOME" 2>/dev/null

  cached='{}'
  if [ -f "$REPO_CACHE" ]; then
    cached=$(jq -c --argjson now "$now" --argjson ttl "$CCWATCH_REPO_TTL" \
      'if type == "object" then with_entries(select(($now - (.value.at // 0)) < $ttl)) else {} end' \
      "$REPO_CACHE" 2>/dev/null) || cached='{}'
    [ -n "$cached" ] || cached='{}'
  fi

  fresh=$( for cwd in "$@"; do
      [ -n "$cwd" ] || continue
      # Already known and still fresh: no subprocess at all.
      printf '%s' "$cached" | jq -e --arg c "$cwd" 'has($c)' >/dev/null 2>&1 && continue
      local slug branch root
      root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || root=""
      slug=$(git -C "$cwd" remote get-url origin 2>/dev/null \
             | sed -E 's#^git@[^:]+:##; s#^ssh://[^/]+/##; s#^https?://[^/]+/##; s#\.git$##') || slug=""
      branch=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
      jq -cn --arg c "$cwd" --arg slug "$slug" --arg branch "$branch" \
             --arg root "$root" --argjson at "$now" \
        '{key: $c, value: {slug: $slug, branch: $branch, root: $root, at: $at}}'
    done | jq -s 'from_entries' )

  jq -cn --argjson a "$cached" --argjson b "${fresh:-\{\}}" '$a + $b' >"$REPO_CACHE.tmp" 2>/dev/null \
    && mv "$REPO_CACHE.tmp" "$REPO_CACHE" 2>/dev/null
  # Not `|| printf '{}'`: the same file-input hazard as collect_usage, and this
  # one reaches `--argjson repos` with no require_json in front of it at all.
  cached=$(jq -c '.' "$REPO_CACHE" 2>/dev/null)
  if [ -n "$cached" ]; then printf '%s' "$cached"; else printf '{}'; fi
}

# repo_slug — owner/name for a working directory, or nothing.
#
# Reads the git remote rather than guessing from the path: a worktree under
# .claude/worktrees/ has a directory name that is a branch, not a repo.
repo_slug() { # repo_slug <cwd>
  local url
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
  printf '%s' "$url" | sed -E 's#^git@[^:]+:##; s#^https?://[^/]+/##; s#\.git$##'
}

# collect_deploys — recent runs for every repo a live session sits in.
#
# Cached with a TTL. The cache records when it was taken so the table can age
# it, and a `gh` failure leaves the previous cache in place rather than
# replacing it with an empty list — an empty deploy list and a failed lookup
# must not look the same.
collect_deploys() { # collect_deploys <cwd>...
  local now age
  now=$(date '+%s')
  if [ -f "$DEPLOY_CACHE" ]; then
    age=$(jq -r --argjson now "$now" '($now - (.at // 0))' "$DEPLOY_CACHE" 2>/dev/null) || age=99999
    if [ "${age:-99999}" -lt "$CCWATCH_DEPLOY_TTL" ]; then
      jq -c --argjson now "$now" '. + { age: ($now - .at) }' "$DEPLOY_CACHE" 2>/dev/null && return 0
    fi
  fi

  command -v gh >/dev/null 2>&1 || { printf '{"at":%s,"age":0,"runs":[],"error":"gh not on PATH"}' "$now"; return 0; }

  local cwd slug slugs="" runs
  for cwd in "$@"; do
    slug=$(repo_slug "$cwd") || continue
    [ -n "$slug" ] || continue
    case " $slugs " in *" $slug "*) continue;; esac
    slugs="$slugs $slug"
  done
  [ -n "$slugs" ] || { printf '{"at":%s,"age":0,"runs":[],"error":"no git remotes found"}' "$now"; return 0; }

  # gh's stderr is CAPTURED, not discarded. The first version sent it to
  # /dev/null and reported "gh returned nothing", which is true and useless:
  # the actual message was `HTTP 401: Bad credentials`, and no amount of staring
  # at an empty deploy list would have suggested an auth problem.
  local failed="" errs="" out
  runs=$( for slug in $slugs; do
            out=$(gh run list --repo "$slug" --limit "$CCWATCH_DEPLOY_LIMIT" \
                    --json databaseId,workflowName,status,conclusion,headBranch,createdAt,updatedAt,url,event \
                    2>&1) && printf '%s' "$out" \
                  | jq -c --arg slug "$slug" '.[] | . + {repo: $slug}' 2>/dev/null \
              || printf '%s\n' "$out" >&2
          done 2>"$DEPLOY_CACHE.err" | jq -s '.' )
  if [ -s "$DEPLOY_CACHE.err" ]; then
    errs=$(head -3 "$DEPLOY_CACHE.err" | tr '\n' ' ')
    failed="gh failed: $errs"
  fi
  rm -f "$DEPLOY_CACHE.err"

  jq -cn --argjson now "$now" --argjson runs "$runs" --arg err "$failed" \
    '{at: $now, age: 0, runs: $runs} + (if $err == "" then {} else {error: $err} end)' \
    >"$DEPLOY_CACHE.tmp" 2>/dev/null \
    && mv "$DEPLOY_CACHE.tmp" "$DEPLOY_CACHE" 2>/dev/null
  jq -c '. + {age: 0}' "$DEPLOY_CACHE" 2>/dev/null || printf '{"at":%s,"age":0,"runs":[]}' "$now"
}

# deploys_of_interest — in-flight runs, plus ones that ended recently.
#
# A deploy that succeeded three days ago is not something you are waiting on.
deploys_filter() {
  jq -c --arg pat "$CCWATCH_DEPLOY_PATTERN" --argjson now "$(date '+%s')" '
    .runs
    | map(select(.workflowName | test($pat; "i")))
    | map(. + { ended: ((.updatedAt // .createdAt) | fromdate),
                live: (.status != "completed") })
    | map(select(.live or (($now - .ended) < 86400)))
    | sort_by(if .live then 0 else 1 end, -.ended)'
}

cmd_deploys() {
  local as_json=0
  [ "${1:-}" = "--json" ] && as_json=1
  local snap cwds
  snap=$(snapshot)
  cwds=$(printf '%s' "$snap" | jq -r '[.sessions[].cwd] | unique | .[]')
  local -a cwda=()
  while IFS= read -r c; do [ -n "$c" ] && cwda+=("$c"); done <<<"$cwds"
  local d
  if [ ${#cwda[@]} -gt 0 ]; then d=$(collect_deploys "${cwda[@]}"); else d='{"runs":[],"age":0}'; fi

  if [ "$as_json" -eq 1 ]; then
    printf '%s' "$d" | jq -c --arg pat "$CCWATCH_DEPLOY_PATTERN" --argjson now "$(date '+%s')" '
      { at: .at, age: .age, error: (.error // null),
        runs: ( .runs | map(select(.workflowName | test($pat; "i")))
                | map(. + { ended: ((.updatedAt // .createdAt) | fromdate),
                            live: (.status != "completed") })
                | map(select(.live or (($now - .ended) < 86400)))
                | sort_by(if .live then 0 else 1 end, -.ended) ) }'
    return 0
  fi
  local errmsg
  errmsg=$(printf '%s' "$d" | jq -r '.error // empty')
  [ -n "$errmsg" ] && warn "$errmsg"

  local filtered
  filtered=$(printf '%s' "$d" | deploys_filter)
  if [ "$(printf '%s' "$filtered" | jq 'length')" -eq 0 ]; then
    say "${_c_dim}No deploy-shaped runs in the last 24h for the repos you have sessions in.${_c_reset}"
    say "${_c_dim}Matching on:${_c_reset} $CCWATCH_DEPLOY_PATTERN ${_c_dim}(set CCWATCH_DEPLOY_PATTERN to widen)${_c_reset}"
    return 0
  fi
  render_deploys "$filtered" "$(printf '%s' "$d" | jq -r '.age')"
}

render_deploys() { # render_deploys <filtered-json> <cache-age>
  say "${_c_bold}DEPLOYS${_c_reset} ${_c_dim}— in flight, and concluded in the last 24h${_c_reset}${_c_dim}$([ "${2:-0}" -gt 5 ] && printf ' [%ss old]' "$2")${_c_reset}"
  printf '%s' "$1" | jq -r --argjson now "$(date '+%s')" '
    def dur(s): if s < 60 then "\(s|floor)s" elif s < 3600 then "\((s/60)|floor)m"
      elif s < 86400 then "\((s/3600)|floor)h" else "\((s/86400)|floor)d" end;
    .[] | [ (if .live then "RUNNING" else (.conclusion // "?" | ascii_upcase) end),
            .workflowName, .repo, .headBranch,
            (if .live then "started \(dur($now - (.createdAt|fromdate))) ago"
             else "\(dur($now - .ended)) ago" end),
            .url ] | @tsv' \
  | awk -F'\t' -v grn="$_c_green" -v red="$_c_red" -v yel="$_c_yellow" \
               -v cyn="$_c_cyan" -v dim="$_c_dim" -v rst="$_c_reset" '
    { c = ($1=="SUCCESS") ? grn : ($1=="RUNNING") ? yel : red
      printf "  %s%-9s%s %s%-22s%s %s%-26s%s %s%-18s%s %s%s%s\n", \
        c,$1,rst, "",$2,"", dim,$3,rst, dim,$4,rst, dim,$5,rst
      if ($1 != "SUCCESS") printf "      %s%s%s\n", cyn,$6,rst
    }'
}

# --------------------------------------------------------- subscriptions -----

cmd_subscribe() {
  local pattern="" sid="${CLAUDE_CODE_SESSION_ID:-}" once=0 repo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) sid="${2:-}"; shift 2 || exit 3;;
      --repo)    repo="${2:-}"; shift 2 || exit 3;;
      --once)    once=1; shift;;
      -*) die "subscribe: unrecognised option '$1'" \
              "usage: ccwatch subscribe [--once] [--repo owner/name] <workflow-pattern>";;
      *) pattern="${pattern:+$pattern|}$1"; shift;;
    esac
  done
  [ -n "$pattern" ] || die "subscribe: no workflow pattern" \
    "e.g. ccwatch subscribe deploy-production"
  # An agent running this from inside a session needs no arguments beyond the
  # pattern: Claude Code puts its own session id in the environment.
  [ -n "$sid" ] || die "subscribe: no session to subscribe" \
    "run this from inside a Claude Code session, or pass --session <id>"

  [ -z "$repo" ] && repo=$(repo_slug "$PWD" 2>/dev/null || true)

  mkdir -p "$CCWATCH_HOME"
  jq -cn --arg sid "$sid" --arg pat "$pattern" --arg repo "$repo" \
         --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" --argjson once "$once" \
    '{session_id:$sid, pattern:$pat, repo:$repo, once:($once == 1), at:$at}' >>"$SUBS"
  say "${_c_green}subscribed${_c_reset} ${sid:0:8} to ${_c_bold}$pattern${_c_reset}${repo:+ in $repo}"
  say "${_c_dim}ccwatch will message this session when a matching run finishes.${_c_reset}"
  say "${_c_dim}Needs a watcher running:${_c_reset} ccwatch daemon"
}

cmd_unsubscribe() {
  local sid="${1:-${CLAUDE_CODE_SESSION_ID:-}}"
  [ -n "$sid" ] || die "unsubscribe: no session given" "pass a session id, or run from inside a session"
  [ -f "$SUBS" ] || { say "nothing subscribed"; return 0; }
  local kept
  kept=$(jq -c --arg sid "$sid" 'select(.session_id != $sid)' "$SUBS" 2>/dev/null)
  printf '%s\n' "$kept" | sed '/^$/d' >"$SUBS.tmp" && mv "$SUBS.tmp" "$SUBS"
  say "unsubscribed ${sid:0:8}"
}

cmd_subs() {
  [ -f "$SUBS" ] || { say "${_c_dim}No subscriptions.${_c_reset}"; return 0; }
  local live
  live=$(snapshot | jq -c '[.sessions[] | {sid, name}]')
  say "${_c_bold}SUBSCRIPTIONS${_c_reset}"
  jq -s -c --argjson live "$live" '
    ( $live | map({key: .sid, value: .name}) | from_entries ) as $L
    | unique_by([.session_id, .pattern, .repo])
    | .[] | . + { name: ($L[.session_id] // null) }' "$SUBS" 2>/dev/null \
  | jq -r --arg d "$_c_dim" --arg r "$_c_red" --arg z "$_c_reset" '
      "  \(.pattern)\($d) → \(.name // "(session has exited)")\($z)"
      + (if .repo == "" then "" else " \($d)[\(.repo)]\($z)" end)
      + (if .name == null then " \($r)stale\($z)" else "" end)'
}

# --------------------------------------------------------------- daemon ------
#
# One watcher, N subscribers. The agents do not poll; this does, and messages
# them. Deliberately a separate command rather than folded into the live table,
# because the whole point is that it keeps working while you are away from the
# terminal.
cmd_daemon() {
  local interval="${CCWATCH_DEPLOY_TTL}"
  say "${_c_bold}ccwatch daemon${_c_reset} ${_c_dim}— polling deploys every ${interval}s, notifying subscribers${_c_reset}"
  say "${_c_dim}Ctrl-C to stop. Subscriptions: ${SUBS/#$HOME/~}${_c_reset}"
  [ -f "$DEPLOY_SEEN" ] || printf '{}' >"$DEPLOY_SEEN"
  while :; do
    daemon_tick
    sleep "$interval"
  done
}

# One pass. Factored out so it can be run once, and tested.
daemon_tick() {
  local snap cwds
  snap=$(snapshot)
  cwds=$(printf '%s' "$snap" | jq -r '[.sessions[].cwd] | unique | .[]')
  local -a cwda=()
  while IFS= read -r c; do [ -n "$c" ] && cwda+=("$c"); done <<<"$cwds"
  [ ${#cwda[@]} -gt 0 ] || return 0

  local d finished
  d=$(collect_deploys "${cwda[@]}")
  # Only runs that have CONCLUDED, and only ones not already notified. The seen
  # file is what stops a subscriber being told about the same deploy on every
  # tick — the failure mode that would make the whole feature unusable.
  finished=$(printf '%s' "$d" | jq -c --arg pat "$CCWATCH_DEPLOY_PATTERN" '
    .runs | map(select(.status == "completed"))
          | map(select(.workflowName | test($pat; "i")))')

  [ -f "$SUBS" ] || return 0
  local seen
  seen=$(cat "$DEPLOY_SEEN" 2>/dev/null); [ -n "$seen" ] || seen='{}'

  local pending
  pending=$(jq -s -c --argjson runs "$finished" --argjson seen "$seen" '
    unique_by([.session_id, .pattern, .repo]) as $subs
    | [ $subs[] as $sub
        | $runs[]
        | select(.workflowName | test($sub.pattern; "i"))
        | select($sub.repo == "" or .repo == $sub.repo)
        | ("\($sub.session_id):\(.databaseId)") as $key
        | select($seen[$key] == null)
        | { key: $key, session_id: $sub.session_id, run: . } ]' "$SUBS" 2>/dev/null)

  local n
  n=$(printf '%s' "$pending" | jq 'length' 2>/dev/null) || n=0
  [ "${n:-0}" -gt 0 ] || return 0

  local i=0 sid msg key
  while [ "$i" -lt "$n" ]; do
    sid=$(printf '%s' "$pending" | jq -r --argjson i "$i" '.[$i].session_id')
    key=$(printf '%s' "$pending" | jq -r --argjson i "$i" '.[$i].key')
    # Built with a single-quoted jq program and an index argument. Interpolating
    # the index into a double-quoted program meant escaping jq string quotes
    # through the shell, which does not survive.
    msg=$(printf '%s' "$pending" | jq -r --argjson i "$i" '
      .[$i].run
      | "Deploy update from ccwatch: \(.workflowName) on \(.repo)@\(.headBranch) "
        + "finished with \(.conclusion // "unknown"). \(.url)"')
    # A subscription whose session has exited is dropped rather than retried
    # forever. Marking it seen first means a send that fails for any other
    # reason also does not loop.
    seen=$(printf '%s' "$seen" | jq -c --arg k "$key" --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" '. + {($k): $at}')
    printf '%s' "$seen" >"$DEPLOY_SEEN.tmp" && mv "$DEPLOY_SEEN.tmp" "$DEPLOY_SEEN"
    # ⚠️ A SUBSHELL, deliberately. cmd_send uses `die` for an unreachable
    # target, and `die` exits — which in an `if` condition exits the whole
    # process, not the condition. So the first subscriber whose session had
    # gone away killed the daemon outright: the watcher died silently and
    # nothing was notified again, which is precisely the failure mode this
    # tool exists to catch. One subscriber's problem must not be the
    # watcher's.
    if ( cmd_send "$sid" "$msg" >/dev/null 2>&1 ); then
      say "${_c_green}notified${_c_reset} ${sid:0:8} ${_c_dim}$(printf '%s' "$msg" | head -c 80)${_c_reset}"
    else
      warn "could not notify ${sid:0:8} — session gone? drop it with: ccwatch unsubscribe $sid"
    fi
    i=$((i + 1))
  done
}


# ================================================================ peers =====
#
# Which sessions have been talking to each other.
#
# A message from another session is recorded in the RECEIVER's transcript as a
# user entry with origin.kind == "peer", carrying:
#   .origin.from             the sender's declared name ("unknown" if it did not
#                            declare one; ccwatch declares "ccwatch")
#   .origin.verifiedPeerPid  the pid of the connecting process, verified by the
#                            server from the socket's peer credentials — so it
#                            cannot be spoofed by the frame
#   .origin.hopChain         for a relayed message, the full path it took, so
#                            A→B→C reconstructs as a path and not as two
#                            unrelated edges
#
# The receiver's transcript is the only place this is written, which is why the
# graph is built by scanning transcripts rather than by watching traffic: it
# works retrospectively, and it survives a reboot.

cmd_peers() {
  platform_detect
  [ "$CCWATCH_PLATFORM" = windows ] && die "peers: not available on Windows" \
    "this needs POSIX signals and the per-session Unix socket"
  local days="$CCWATCH_RESUME_DAYS" only="" as_json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --days)    days="${2:-14}"; shift 2 || exit 3;;
      --session) only="${2:-}"; shift 2 || exit 3;;
      --json)    as_json=1; shift;;
      *) die "peers: unrecognised argument '$1'" "usage: ccwatch peers [--days N] [--session <id>] [--json]";;
    esac
  done
  [ -d "$PROJ_DIR" ] || die "no transcript directory at $PROJ_DIR" "nothing to read"

  # ⚠️ With a template, so it lands in $TMPDIR. Bare `mktemp -d` resolves
  # against confstr(_CS_DARWIN_USER_TEMP_DIR) — the login /var/folders/…/T —
  # and ignores $TMPDIR entirely, so anything that grants $TMPDIR and not
  # /var/folders refuses it with "Operation not permitted". This died, `die`
  # fired, and the command printed nothing at all.
  TMP=$(mktemp -d "${TMPDIR:-/tmp}/ccwatch.XXXXXX") \
    || die "could not create a temp directory" "tried under ${TMPDIR:-/tmp}"

  # Live names, so a pid or a session id can be shown as the name you know it by.
  snapshot | jq -c '[.sessions[] | {sid, pid, name}]' >"$TMP/live.json"

  # -maxdepth 2 for the same reason as resume: subagent sidechains live deeper
  # and are not sessions.
  local f edges=0 sid
  : >"$TMP/edges.jsonl"
  # ONE grep over every candidate file, not one grep per file. The first
  # version spawned a process per transcript — 700 of them across 1.7GB — and
  # took 56 seconds, which timed out the web refresher at 90s. Batching through
  # xargs brings it to a couple of seconds: grep -l stops reading a file at its
  # first match, and the files without a match are the ones worth scanning fast.
  find "$PROJ_DIR" -maxdepth 2 -name '*.jsonl' -type f -mtime "-$days" -print0 2>/dev/null \
  | xargs -0 grep -l '"kind":"peer"' 2>/dev/null >"$TMP/candidates.txt" || true

  while IFS= read -r f; do
    [ -f "$f" ] || continue
    sid=$(basename "$f" .jsonl)
    [ -n "$only" ] && case "$sid" in "$only"*) ;; *) continue;; esac
    jq -c --arg to "$sid" '
      select(.type == "user" and .origin.kind == "peer")
      | { to: $to,
          from: (.origin.from // "unknown"),
          from_pid: (.origin.verifiedPeerPid // null),
          from_session: (.origin.fromSession // null),
          hops: (.origin.hopChain // null),
          at: .timestamp,
          cwd: (.cwd // null),
          text: ((.message.content
                  | if type == "string" then . else (.[0].text // "") end)
                 | gsub("\n"; " ") | .[0:100]) }' "$f" 2>/dev/null >>"$TMP/edges.jsonl"
  done <"$TMP/candidates.txt"

  edges=$(wc -l <"$TMP/edges.jsonl" | tr -d ' ')
  if [ "$as_json" -eq 1 ]; then
    peers_graph "$TMP/edges.jsonl" "$TMP/live.json"
    return 0
  fi
  if [ "${edges:-0}" -eq 0 ]; then
    say "${_c_dim}No peer messages in the last $days days.${_c_reset}"
    say ""
    say "${_c_dim}Nothing has been sent between sessions yet. This populates when a${_c_reset}"
    say "${_c_dim}session uses SendMessage, or when ccwatch does — try:${_c_reset}"
    say "  ccwatch send <name> \"hello\""
    return 0
  fi

  say "${_c_bold}PEER MESSAGES${_c_reset} ${_c_dim}— last $days days, $edges message(s)${_c_reset}"
  say ""
  peers_graph "$TMP/edges.jsonl" "$TMP/live.json" \
  | jq -r --arg c "$_c_cyan" --arg b "$_c_bold" --arg d "$_c_dim" --arg z "$_c_reset" '
      .edges[] | "  \($b)\(.from)\($z) \($c)\(.count > 1 | if . then "==>" else "-->" end)\($z) \($b)\(.to)\($z)"
            + "  \($d)\(.count) msg\(if .count == 1 then "" else "s" end), last \(.last[0:16])Z\($z)"
            + "\n      \($d)\(.sample)\($z)"'
}

# peers_graph — edges grouped into a directed graph, as JSON.
#
# Shared by the table and by --json on purpose: two renderings that derive the
# graph separately will eventually disagree about who talked to whom, and the
# one you are not looking at is the one that is wrong.
peers_graph() { # peers_graph <edges.jsonl> <live.json>
  jq -s -c --slurpfile live "$2" '
    ( $live[0] | map({key: .sid, value: .name}) | from_entries ) as $BYSID
    | ( $live[0] | map({key: (.pid|tostring), value: .name}) | from_entries ) as $BYPID
    | map( . + { to_name: ($BYSID[.to] // (.to[0:8])),
                 # The verified pid is preferred over the declared name: the
                 # server checked the pid against the socket peer credentials,
                 # whereas the name was merely asserted by the sender.
                 from_name: ( if .from_pid != null and $BYPID[(.from_pid|tostring)] != null
                              then $BYPID[(.from_pid|tostring)]
                              elif (.from // "unknown") != "unknown" then .from
                              elif .from_pid != null then "pid \(.from_pid) (exited)"
                              else "unknown" end ) } ) as $all
    | { messages: ($all | length),
        nodes: ( [ $all[].from_name ] + [ $all[].to_name ] | unique
                 | map({ id: ., live: ($BYSID | to_entries | map(.value) | index(.) != null) }) ),
        edges: ( $all | group_by([.from_name, .to_name])
                 | map({ from: .[0].from_name, to: .[0].to_name, count: length,
                         last: (max_by(.at) | .at),
                         sample: (max_by(.at) | .text) })
                 | sort_by(-.count) ) }' "$1"
}


# ================================================================ serve =====
#
# The same data as the table, in a browser, for when you want it on a second
# monitor rather than in a terminal you are also typing in.
#
# Deliberately a thin shell around the existing commands: /api/state runs
# `ccwatch --json`, `deploys --json` and `peers --json` and concatenates them.
# Nothing is derived twice. A dashboard that computes its own version of the
# status is a dashboard that will eventually disagree with the terminal, and
# you would have no way to tell which one was lying.
#
# Binds to loopback only. This exposes which repositories you are working in
# and fragments of peer messages; that is not something to serve on 0.0.0.0.
# serve_stop — reap every serve this machine recorded.
#
# ⚠️ By pid from the pidfiles, never by `pkill -f`. The whole reason these
# accumulate is that the pattern reaper cannot run where the process table is
# refused, which is exactly where they pile up.
serve_stop() {
  local d="$CCWATCH_HOME/serve" f pid port n=0 stale=0
  if [ ! -d "$d" ]; then
    say "No serve recorded as running."
    return 0
  fi
  for f in "$d"/*.pid; do
    [ -f "$f" ] || continue
    port=$(basename "$f" .pid)
    pid=$(cat "$f" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) rm -f "$f"; stale=$((stale + 1)); continue;; esac
    # A recorded pid that is gone is a crash, not a server. Said separately,
    # because "nothing to stop" and "it died without cleaning up" are
    # different facts.
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$f"; stale=$((stale + 1)); continue
    fi
    if kill "$pid" 2>/dev/null; then
      say "${_c_green}+${_c_reset} stopped serve on $port ${_c_dim}(pid $pid)${_c_reset}"
      rm -f "$f"; n=$((n + 1))
    else
      err "could not stop the serve on $port (pid $pid) — not yours to signal?"
    fi
  done
  [ "$stale" -gt 0 ] && say "${_c_dim}cleared $stale stale record(s) whose process was already gone${_c_reset}"
  [ "$n" -eq 0 ] && [ "$stale" -eq 0 ] && say "No serve recorded as running."
  return 0
}

cmd_serve() {
  local port="${CCWATCH_PORT:-8787}" open=0 readonly=0 allowkill=0
  local idle_grace="${CCWATCH_IDLE_GRACE:-15}" snapshot_timeout="${CCWATCH_SNAPSHOT_TIMEOUT:-90}"
  local snapshot_cadence="${CCWATCH_SNAPSHOT_CADENCE:-2}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)      port="${2:-8787}"; shift 2 || exit 3;;
      --open)      open=1; shift;;
      --read-only) readonly=1; shift;;
      --allow-kill) allowkill=1; shift;;
      --stop)      serve_stop; return $?;;
      *) die "serve: unrecognised argument '$1'" \
             "usage: ccwatch serve [--port N] [--open] [--read-only] [--allow-kill]";;
    esac
  done

  # Write endpoints (send/kill) need the same POSIX signals and per-session
  # Unix socket that `ccwatch send`/`kill` refuse without on Windows (D23), so
  # serve is read-only there whatever --read-only says — never silently, the
  # reason travels in the startup banner and in `doctor`.
  local readonly_reason=""
  if [ "$CCWATCH_PLATFORM" = windows ] && [ "$readonly" -eq 0 ]; then
    readonly=1
    readonly_reason="Windows has no POSIX signals or per-session Unix socket"
  fi

  # ⚠️ Sending from the browser is a real capability, so it is gated.
  #
  # Binding to loopback is NOT sufficient on its own: any page open in your
  # browser can POST to 127.0.0.1, so without a gate a random site could
  # inject prompts into every agent you have running. Two checks close that:
  #
  #   1. A per-run token, generated here and embedded in the page ccwatch
  #      itself serves. A drive-by request cannot read it (same-origin policy
  #      keeps another page from fetching our HTML).
  #   2. An Origin check. Browsers attach Origin to cross-origin POSTs, so one
  #      that does not match this server is refused.
  #
  # --read-only drops the endpoint entirely for anyone who would rather not
  # have it at all.
  local send_token=""
  if [ "$readonly" -eq 0 ]; then
    send_token=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n') \
      || die "could not generate a session token" "is /dev/urandom readable?"
  fi

  local root
  root=$(cd -- "$(dirname -- "$(resolved_self)")/.." && pwd)
  [ -f "$root/web/index.html" ] || die "cannot find web/index.html under $root" \
    "the web assets ship alongside bin/ — has the checkout been split up?"

  [ -n "$CCWATCH_PY" ] || die "ccwatch needs a python3 interpreter on PATH" \
    "none of python3, python, py -3 answered"
  say "${_c_bold}ccwatch serve${_c_reset} ${_c_dim}on${_c_reset} http://127.0.0.1:$port"
  if [ "$readonly" -eq 1 ]; then
    if [ -n "$readonly_reason" ]; then
      say "${_c_dim}loopback only, read-only: $readonly_reason. Ctrl-C to stop.${_c_reset}"
    else
      say "${_c_dim}loopback only, read-only. Ctrl-C to stop.${_c_reset}"
    fi
  else
    say "${_c_dim}loopback only. Replies from the page are enabled (token-gated).${_c_reset}"
    if [ "$allowkill" -eq 1 ]; then
      say "${_c_yellow}!${_c_reset} ${_c_dim}Killing from the page is ENABLED (--allow-kill).${_c_reset}"
    else
      say "${_c_dim}Killing is disabled; pass --allow-kill to enable it.${_c_reset}"
    fi
    say "${_c_dim}Use --read-only to disable writes entirely. Ctrl-C to stop.${_c_reset}"
  fi
  # ⚠️ A pidfile, because the only reaper this had was `pkill -f`, and that
  # needs a process table the host may refuse: under a sandbox here `pgrep`
  # answers "Cannot get process list", so every server a suite run starts is
  # leaked and neither the suite nor I could clear them. 36 were live at once
  # and a second agent had to be asked to kill them. A recorded pid needs no
  # enumeration, which is what `serve --stop` uses.
  #
  # Written before the child starts and removed by the trap, so a file whose
  # pid is dead means a crash rather than a running server — `--stop` checks
  # before believing it.
  local pidfile="$CCWATCH_HOME/serve/$port.pid"
  mkdir -p "$CCWATCH_HOME/serve" 2>/dev/null
  printf '%s\n' "$$" > "$pidfile" 2>/dev/null || true

  [ "$open" -eq 1 ] && command -v open >/dev/null 2>&1 && open "http://127.0.0.1:$port" 2>/dev/null

  # ⚠️ NOT `local`, and the trap reads it with `${srv_pid:-}`. Both matter, and
  # a Ctrl-C used to print an error because of it: the EXIT trap body runs
  # AFTER cmd_serve has returned, where a local of its is out of scope, so
  # under `set -u` the trap itself aborted with
  #   ccwatch: line NNNN: srv_pid: unbound variable
  # and the kill/wait that reaps the HTTP child never ran. Two costs, and the
  # second is the real one: a clean Ctrl-C looked like a crash, exited
  # non-zero, and printed exactly what a crashed child would print — so the
  # case worth noticing was indistinguishable from the one that happens every
  # time. The line number moves between runs because bash names wherever
  # execution had reached, which makes it read like a different bug each time.
  srv_pid=""
  # shellcheck disable=SC2064
  trap 'if [ -n "${srv_pid:-}" ]; then kill "${srv_pid}" 2>/dev/null; wait "${srv_pid}" 2>/dev/null; fi; rm -f "'"$pidfile"'" 2>/dev/null' \
    EXIT INT TERM

  # ⚠️ CCWATCH_WEB is an override, not a fixed path, so `verify-ui` can serve a
  # directory holding the real pages PLUS its own harness. The harness has to
  # be same-origin with /map to reach into an iframe of it, and copying the
  # pages somewhere writable is the only way to get that without putting test
  # scaffolding in web/.
  CCWATCH_SELF="$root/bin/ccwatch" CCWATCH_WEB="$(probe_native_path "${CCWATCH_WEB:-$root/web}")" CCWATCH_BIND_PORT="$port" \
  CCWATCH_SEND_TOKEN="$send_token" CCWATCH_ALLOW_KILL="$allowkill" \
  CCWATCH_IDLE_GRACE="$idle_grace" CCWATCH_SNAPSHOT_TIMEOUT="$snapshot_timeout" \
  CCWATCH_TRANSCRIPT_TIMEOUT="${CCWATCH_TRANSCRIPT_TIMEOUT:-30}" \
  CCWATCH_SNAPSHOT_CADENCE="$snapshot_cadence" \
  CCWATCH_REVIVE_SWITCH="$REVIVE_SWITCH" CCWATCH_EVENTS="$EVENTS" \
  CCWATCH_REVIVE_INTERVAL="$CCWATCH_REVIVE_INTERVAL" \
  CCWATCH_PLATFORM="$CCWATCH_PLATFORM" CCWATCH_BASH="$CCWATCH_BASH" \
  $CCWATCH_PY -c '
import calendar, hashlib, http.server, json, os, socketserver, subprocess, sys, threading, time
from urllib.parse import urlsplit

SELF = os.environ["CCWATCH_SELF"]
# CPython on Windows cannot execute the shebang line directly (D6): every
# call site below runs SELF through bash explicitly on that platform.
SELF_ARGV = [os.environ["CCWATCH_BASH"], SELF] if os.environ.get("CCWATCH_PLATFORM") == "windows" else [SELF]
WEB  = os.environ["CCWATCH_WEB"]
PORT = int(os.environ["CCWATCH_BIND_PORT"])
SEND_TOKEN = os.environ.get("CCWATCH_SEND_TOKEN", "")
# ⚠️ Killing from a browser is OFF unless asked for. Sending a message to the
# wrong agent is embarrassing; killing the wrong one costs work in flight. A
# monitoring tool should not be able to destroy by default, so this needs
# --allow-kill in addition to the token every other write already requires.
ALLOW_KILL = os.environ.get("CCWATCH_ALLOW_KILL", "0") == "1" and bool(SEND_TOKEN)
ALLOWED_ORIGINS = {"http://127.0.0.1:%d" % PORT, "http://localhost:%d" % PORT}
MAX_MESSAGE = 4000

# ⚠️ The state is refreshed by ONE background thread and served from memory.
#
# The first version ran `ccwatch --json` inside the request handler. Each call
# takes seconds (it shells out to ps, stats hundreds of files, and runs jq
# repeatedly), the page polls every 3 seconds, and the requests piled up
# without a single one completing — eleven concurrent snapshots and an empty
# dashboard. Chrome showed every request as `pending`, which is how it was
# found.
#
# So: one refresher, N readers. The handler never blocks, and the page gets a
# `stale` age it can display rather than silently showing old numbers.
#
# "warming" is derived from STATE["snapshot_at"] being unset, not stored as
# its own flag — a flag can be left stale by a code path that forgets to
# clear it; a timestamp cannot.
STATE = {}
LOCK = threading.Lock()
LAST_READ = time.monotonic()
GRACE = float(os.environ.get("CCWATCH_IDLE_GRACE", "15"))
# How long a transcript read may take before the panel is told it was given up
# on. Settable so the suite can force the timeout it needs to assert, and so a
# genuinely slow host can raise it rather than lose the panel.
TRANSCRIPT_TIMEOUT = float(os.environ.get("CCWATCH_TRANSCRIPT_TIMEOUT", "30"))
# WARNING: a forgotten serve exits on its own. Every leak of this process has
# been somebody forgetting one, or a reaper that could not run: the suite kills
# by `pkill -f`, which needs a process table a sandbox may refuse, so a run
# there leaks every server it started. Measured on this machine: 36 of them
# live at once, and a second agent was asked to clear them.
#
# Binding to a port is cheap; a dozen processes each walking a 1.7GB transcript
# tree is not, and they are all computing the same answer. So a server nobody
# has read for this long stops being one. 0 disables it.
#
# The gate is the SAME LAST_READ the collector uses, so a serve with a browser
# or a menu bar app attached is never at risk: anything that reads /api/state
# keeps it alive.
IDLE_EXIT = float(os.environ.get("CCWATCH_SERVE_IDLE_EXIT", "1800"))

def run(args, timeout):
    try:
        out = subprocess.run(SELF_ARGV + args, capture_output=True, text=True,
                             timeout=timeout, env={**os.environ, "NO_COLOR": "1"})
        if out.returncode != 0 and not out.stdout.strip():
            return {"error": "%s exited %d: %s" % (" ".join(args), out.returncode,
                                                   out.stderr.strip()[:200])}
        return json.loads(out.stdout) if out.stdout.strip() else None
    except Exception as e:
        # Surfaced to the page. A panel that is empty because a command failed
        # must not look like a panel that is empty because there is nothing to
        # show.
        return {"error": "%s: %s" % (" ".join(args), e)}

# THREE independent refreshers, not one loop.
#
# The first version refreshed everything in one pass, so the session table —
# which is the whole point and takes ~1s — was gated on the deploy check (a
# network call to gh) and the peer scan (hundreds of files). One pass took 14
# seconds, and when gh hung the sessions panel went stale with it. Measured
# with CCWATCH_PROFILE=1; found because Chrome showed every /api/state request
# as `pending`.
#
# Each refresher owns one key and writes it under the lock. A slow one can only
# make its own panel stale, and the page shows the age of each panel.
#
# Each loop holds its own `next_due` and checks two gates before doing any
# work: idle (nobody has read /api/state within GRACE) and not-yet-due. Idle
# does NOT advance next_due, so a collector that idled through several of its
# own cadences fires on the very first tick after a reader returns rather than
# leaving its panel stale for up to `every` more seconds. A collection already
# in flight is never interrupted — the gate is only checked before starting.
TICK = 0.25
def refresh_loop(key, args, timeout, every, transform=None):
    def loop():
        next_due = 0.0
        while True:
            now = time.monotonic()
            # Checked in the collector loop rather than on a timer of its own,
            # so it costs no extra thread and cannot fire while a collection
            # is in flight.
            # Not while revive is on. Revive exists for the hours nobody is
            # looking, so a serve that shut itself down for want of a reader
            # would stop revive at exactly the moment it was turned on for.
            if IDLE_EXIT > 0 and now - LAST_READ > IDLE_EXIT and not revive_on():
                sys.stderr.write(
                    "ccwatch serve: nothing has read /api/state for %ds; exiting so a "
                    "forgotten server does not accumulate. Set CCWATCH_SERVE_IDLE_EXIT=0 "
                    "to disable.\n" % int(IDLE_EXIT))
                sys.stderr.flush()
                os._exit(0)
            if now - LAST_READ > GRACE:
                time.sleep(TICK)
                continue
            if now < next_due:
                time.sleep(TICK)
                continue
            val = run(args, timeout)
            if transform:
                val = transform(val)
            with LOCK:
                if key == "snapshot":
                    # A failed or timed-out collection must not overwrite a
                    # retained good snapshot with an empty one -- that is
                    # indistinguishable from a host with no sessions
                    # (Constitution IV). Leave snapshot/snapshot_at
                    # untouched on failure so the retained panels age keeps
                    # growing truthfully; record the failure alongside it.
                    if isinstance(val, dict) and "sessions" in val:
                        STATE["snapshot"] = val
                        STATE["snapshot_at"] = time.time()
                        STATE["snapshot_ok"] = True
                        STATE["snapshot_error"] = None
                    else:
                        STATE["snapshot_ok"] = False
                        STATE["snapshot_error"] = (
                            (val or {}).get("error", "snapshot failed")
                            if isinstance(val, dict) else "snapshot failed")
                else:
                    STATE[key] = val
                    STATE[key + "_at"] = time.time()
                refresh_etag()
            next_due = time.monotonic() + every
    return loop

# ---- revive -----------------------------------------------------------------
#
# Revive runs HERE, on its own thread, so that turning it on in the page is the
# last thing anybody has to do: the menu bar app keeps this process up, and this
# thread keeps passing whether or not anything is reading /api/state. That is
# the difference from the three refreshers above, which idle without a reader
# by design. Revive is FOR the hours nobody is reading.
#
# Off, it still runs a dry pass while somebody is looking, so the page can show
# what it would do before anybody lets it. Each pass is `ccwatch revive --json`,
# the same decision table the terminal uses (principle XI), and `--send` only
# when the switch is on.
REVIVE_SWITCH = os.environ.get("CCWATCH_REVIVE_SWITCH", "")
EVENTS = os.environ.get("CCWATCH_EVENTS", "")
REVIVE_EVERY = max(5.0, float(os.environ.get("CCWATCH_REVIVE_INTERVAL", "60")))
REVIVE_WAKE = threading.Event()
REVIVE_UNAVAILABLE = (None if SEND_TOKEN else
                      "this server was started read-only, so it cannot send")

def revive_on():
    try:
        with open(REVIVE_SWITCH) as fh:
            return json.load(fh).get("enabled") is True
    except Exception:
        return False

def revive_set(on):
    tmp = REVIVE_SWITCH + ".tmp"
    with open(tmp, "w") as fh:
        json.dump({"enabled": bool(on), "by": "page",
                   "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}, fh)
    os.replace(tmp, REVIVE_SWITCH)
    try:
        with open(EVENTS, "a") as fh:
            fh.write(json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                                 "event": "ccwatch.revive.switch",
                                 "enabled": bool(on), "by": "page"}) + "\n")
    except OSError:
        pass

def revive_recent(limit=20, window=86400):
    # What revive has actually sent, from the event log rather than memory, so
    # a restarted serve still shows what happened before it.
    out = []
    try:
        with open(EVENTS, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            fh.seek(max(0, size - 400000))
            lines = fh.read().split(b"\n")
    except OSError:
        return out
    cutoff = time.time() - window
    for raw in reversed(lines):
        if b"ccwatch.revive" not in raw:
            continue
        try:
            ev = json.loads(raw)
        except ValueError:
            continue
        if ev.get("event") != "ccwatch.revive":
            continue
        try:
            at = calendar.timegm(time.strptime(ev.get("at", ""), "%Y-%m-%dT%H:%M:%SZ"))
        except ValueError:
            continue
        if at < cutoff:
            break
        out.append({"at": at, "target": ev.get("target"), "action": ev.get("action"),
                    "outcome": ev.get("outcome"), "why": ev.get("why")})
        if len(out) >= limit:
            break
    return out

def revive_loop():
    next_due = 0.0
    last = {}
    while True:
        now = time.monotonic()
        on = revive_on()
        reader = (now - LAST_READ) <= GRACE
        woken = REVIVE_WAKE.is_set()
        if not woken and (now < next_due or not (on or reader)):
            REVIVE_WAKE.wait(TICK)
            continue
        REVIVE_WAKE.clear()
        # Published before the pass as well as after it: a pass takes 5-12s
        # (measured on the suite fixtures), and a switch that still read "off"
        # that long after it was flipped looked like a switch that had not
        # taken.
        started = time.time()
        revive_publish(dict(STATE.get("revive") or {}, enabled=on, running=True,
                            started_at=started))
        rec = {"enabled": on, "available": REVIVE_UNAVAILABLE is None,
               "reason": REVIVE_UNAVAILABLE, "every": REVIVE_EVERY, "running": False,
               "started_at": started}
        if REVIVE_UNAVAILABLE is None:
            val = run(["revive", "--json"] + (["--send"] if on else []), 180)
            if isinstance(val, dict) and isinstance(val.get("rows"), list):
                last = {"rows": val["rows"], "skipped": val.get("skipped"),
                        "live": on, "pass_at": time.time(), "error": None}
            else:
                # A failed pass keeps the last good rows and says it failed,
                # rather than replacing them with an empty list that reads as
                # "nothing stopped" (principle IV).
                last = dict(last)
                last["error"] = (val or {}).get("error", "revive pass failed") \
                    if isinstance(val, dict) else "revive pass failed"
            rec.update(last)
        rec["recent"] = revive_recent()
        revive_publish(rec)
        # The same floor the three refreshers take from SNAPSHOT_CADENCE, for
        # the same reason: every publish changes the ETag, and the ETag checks
        # pin the cadence so that two reads see one collection. A fourth
        # publisher outside that floor made them fail under load. At the
        # default cadence of 2s the floor is far below 60s and changes nothing.
        next_due = time.monotonic() + max(REVIVE_EVERY, SNAPSHOT_CADENCE)

def revive_publish(rec):
    rec.setdefault("available", REVIVE_UNAVAILABLE is None)
    rec.setdefault("reason", REVIVE_UNAVAILABLE)
    rec.setdefault("every", REVIVE_EVERY)
    with LOCK:
        STATE["revive"] = rec
        STATE["revive_at"] = time.time()
        refresh_etag()

def build_canonical():
    # Assumes LOCK held. Same shape as the /api/state payload minus
    # `ages`/`stale`/`feed` — those are recomputed per request, never
    # published, so they must never affect the ETag (a 304 must guarantee
    # every MEASURED number is unchanged, not merely that time passed).
    snap = dict(STATE.get("snapshot") or {})
    body = dict(snap)
    body["warming"] = STATE.get("snapshot_at") is None
    if body["warming"]:
        # No snapshot has ever succeeded — `null`, never a fabricated `[]`,
        # so a genuinely empty host and a never-succeeded one cannot be
        # confused by inspection of the payload alone.
        body["sessions"] = None
        body["unfinished"] = None
    body["deploys"] = STATE.get("deploys")
    body["peers"] = STATE.get("peers")
    body["revive"] = STATE.get("revive")
    body["can_kill"] = ALLOW_KILL
    body["snapshot_ok"] = STATE.get("snapshot_ok", True)
    body["snapshot_error"] = STATE.get("snapshot_error")
    if body["snapshot_error"]:
        # Mirrored into the existing top-level `error` key so the table
        # views footer surfaces a failed collection without a page change.
        body["error"] = body["snapshot_error"]
    body["collected_at"] = {
        k: STATE.get(k + "_at") for k in ("snapshot", "deploys", "peers", "revive")}
    return body

def refresh_etag():
    # Assumes LOCK held. Computed once per publish, not per request, so
    # concurrent readers see the same validator without re-hashing the
    # payload on every /api/state hit.
    canon = json.dumps(build_canonical(), sort_keys=True, separators=(",", ":"))
    STATE["etag"] = hashlib.sha256(canon.encode()).hexdigest()[:16]

class H(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *a, **kw):
        super().__init__(*a, directory=WEB, **kw)

    def serve_page(self, name):
        # The token is injected into the page ccwatch serves, which is what
        # makes it a secret a drive-by page cannot obtain: same-origin policy
        # stops another site reading this HTML.
        try:
            with open(os.path.join(WEB, name), "rb") as fh:
                body = fh.read()
        except OSError:
            self.send_error(404)
            return
        body = body.replace(b"__CCWATCH_SEND_TOKEN__", SEND_TOKEN.encode())
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def reply_json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        if not (self.path.startswith("/api/send") or self.path.startswith("/api/kill")
                or self.path.startswith("/api/revive")):
            self.send_error(404)
            return
        if not SEND_TOKEN:
            self.reply_json(403, {"error": "this server was started --read-only"})
            return
        # Both checks, not either: the token stops a page that cannot read our
        # HTML, and the Origin check stops one that somehow could.
        origin = self.headers.get("Origin")
        if origin is not None and origin not in ALLOWED_ORIGINS:
            self.reply_json(403, {"error": "refused: unexpected Origin %s" % origin})
            return
        if self.headers.get("X-CCWatch-Token", "") != SEND_TOKEN:
            self.reply_json(403, {"error": "refused: bad or missing token"})
            return
        # Two separate limits, and they have to give separate reasons. The byte
        # cap exists so an unbounded body is never read at all; the message cap
        # is about content. The first version let the byte cap fire first and
        # report "bad request", so an oversized message got a reason that did
        # not mention size — the caller could not tell what to shorten.
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            self.reply_json(400, {"error": "bad request: unreadable Content-Length"})
            return
        if length <= 0:
            self.reply_json(400, {"error": "bad request: empty body"})
            return
        if length > MAX_MESSAGE + 512:
            self.reply_json(413, {"error": "message too long (limit %d characters)" % MAX_MESSAGE})
            return
        if self.path.startswith("/api/revive"):
            # The same token and Origin gate as send, above: turning revive on
            # is consent to messages being sent on your behalf, and a page that
            # could flip it could have every idle agent asked a question.
            try:
                req = json.loads(self.rfile.read(length))
                on = req["enabled"]
                if not isinstance(on, bool):
                    raise ValueError("enabled must be true or false")
            except Exception as e:
                self.reply_json(400, {"error": "bad request: %s" % e})
                return
            try:
                revive_set(on)
            except OSError as e:
                self.reply_json(500, {"error": "could not record the switch: %s" % e})
                return
            REVIVE_WAKE.set()
            now_on = revive_on()
            revive_publish(dict(STATE.get("revive") or {}, enabled=now_on))
            self.reply_json(200, {"enabled": now_on})
            return
        try:
            req = json.loads(self.rfile.read(length))
            target = str(req["target"]).strip()
            message = str(req.get("message") or "").strip()
        except Exception as e:
            self.reply_json(400, {"error": "bad request: %s" % e})
            return
        if self.path.startswith("/api/kill"):
            if not ALLOW_KILL:
                self.reply_json(403, {"error": "killing is disabled — start with: "
                                               "ccwatch serve --allow-kill"})
                return
            if not target:
                self.reply_json(400, {"error": "target is required"})
                return
            args = SELF_ARGV + ["kill", "-y"]
            if req.get("force"):
                args.append("--force")
            args.append(target)
            try:
                out = subprocess.run(args, capture_output=True, text=True, timeout=40,
                                     env={**os.environ, "NO_COLOR": "1"})
                text = (out.stdout + out.stderr).strip()
                # The refusals are the useful part of the reply: the page shows
                # them verbatim rather than reducing everything to "failed".
                state = ("killed" if "killed" in out.stdout
                         else "refused" if out.returncode != 0 else "unknown")
                self.reply_json(200 if state == "killed" else 409,
                                {"state": state, "detail": text})
            except Exception as e:
                self.reply_json(504, {"state": "failed", "detail": str(e)})
            return

        if not target or not message:
            self.reply_json(400, {"error": "target and message are both required"})
            return
        if len(message) > MAX_MESSAGE:
            self.reply_json(413, {"error": "message too long (limit %d characters)" % MAX_MESSAGE})
            return

        # `ccwatch send` waits to SEE the message land in the receiver, so the
        # page gets the same three honest outcomes the terminal does rather
        # than an optimistic "sent".
        try:
            out = subprocess.run(SELF_ARGV + ["send", target, message],
                                 capture_output=True, text=True, timeout=45,
                                 env={**os.environ, "NO_COLOR": "1"})
            text = (out.stdout + out.stderr).strip()
            state = ("delivered" if "delivered" in out.stdout
                     else "queued" if "queued" in text
                     else "failed")
            self.reply_json(200 if out.returncode == 0 else 502,
                            {"state": state, "detail": text})
        except Exception as e:
            self.reply_json(504, {"state": "failed", "detail": str(e)})

    def do_GET(self):
        # WARNING: matched on the PATH, with the query stripped. These were
        # exact string comparisons against self.path, so /map?sid=... did not
        # match, fell through to the static fallback and answered 404 - which
        # is the deep link the overlay itself offers. Reported from a real
        # browser. The page handled ?sid= correctly the whole time; nothing
        # ever asked the SERVER for the URL, because the check posed the query
        # inside the page instead of requesting it.
        route = urlsplit(self.path).path
        if route in ("/", "/index.html"):
            return self.serve_page("index.html")
        if route in ("/map", "/map.html"):
            return self.serve_page("map.html")
        if self.path.startswith("/api/transcript"):
            from urllib.parse import urlparse, parse_qs
            q = parse_qs(urlparse(self.path).query)
            sid = (q.get("sid") or [""])[0]
            n = (q.get("n") or ["30"])[0]
            # Fetched on demand rather than folded into /api/state: it is only
            # wanted for the one session you clicked, and putting every
            # transcript in the polled payload would ship megabytes of tool
            # output every three seconds.
            if not sid or not all(c in "0123456789abcdef-" for c in sid.lower()):
                self.reply_json(400, {"error": "sid must be a session id"})
                return
            try:
                nn = max(1, min(200, int(n)))
            except ValueError:
                nn = 30
            # WARNING: the timeout is CAUGHT. It was not, and a real one
            # escaped do_GET: socketserver printed a full traceback into the
            # serve log and the panel got a reset connection, so the reader
            # saw an empty transcript and no reason for it. Reported from a
            # real terminal at load average 210, where `convo` on a large
            # transcript took longer than the 30s allowed here.
            #
            # /api/state has always wrapped its subprocess and turned a
            # failure into an {"error": ...} that the page renders. This route
            # did not, which is the same gap in the same file: a failure
            # presenting as an absence (constitution IV).
            #
            # No apostrophes in this program. It is a single-quoted argument
            # to python3 -c, and one closes it, giving a bash syntax error
            # far from the typo. That is three times in this session.
            try:
                # SELF_ARGV, not [SELF]: on Windows the script is not directly
                # executable and has to be invoked through the bash the probe
                # seam located, so the interpreter is part of the argv.
                out = subprocess.run(SELF_ARGV + ["convo", "-n", str(nn), "--json", sid],
                                     capture_output=True, text=True,
                                     timeout=TRANSCRIPT_TIMEOUT,
                                     env={**os.environ, "NO_COLOR": "1"})
            except subprocess.TimeoutExpired:
                self.reply_json(504, {"error": "reading the transcript took longer than "
                                               "%gs and was given up on" % TRANSCRIPT_TIMEOUT})
                return
            except Exception as e:
                self.reply_json(500, {"error": "could not read the transcript: %s"
                                               % str(e)[:200]})
                return
            if out.returncode != 0 or not out.stdout.strip():
                self.reply_json(404, {"error": (out.stderr or "no transcript").strip()[:300]})
                return
            try:
                self.reply_json(200, json.loads(out.stdout))
            except ValueError as e:
                self.reply_json(500, {"error": "unparseable transcript: %s" % e})
            return
        if self.path.startswith("/api/state"):
            global LAST_READ
            prev_read = LAST_READ
            LAST_READ = time.monotonic()
            now = time.time()
            with LOCK:
                payload = build_canonical()
                etag = STATE.get("etag")
                # Every panel carries its OWN age, so one slow collector cannot
                # make the whole dashboard look stale — or worse, make a stale
                # panel look current.
                payload["ages"] = {
                    k: (now - STATE[k + "_at"]) if STATE.get(k + "_at") else None
                    for k in ("snapshot", "deploys", "peers", "revive")}
            payload["stale"] = payload["ages"].get("snapshot")
            # Derived per request, never stored: "warming" if no snapshot has
            # ever succeeded, else "idle" if the read that preceded THIS one
            # (before the stamp above overwrote it) was more than GRACE ago,
            # else "collecting".
            payload["feed"] = ("warming" if STATE.get("snapshot_at") is None
                                else "idle" if (LAST_READ - prev_read) > GRACE
                                else "collecting")
            quoted_etag = ("\"%s\"" % etag) if etag else None
            inm = self.headers.get("If-None-Match")
            # A comma-separated list of validators, each optionally quoted;
            # "*" matches whatever the server currently holds. Absent, stale
            # or unparseable ⇒ fall through to a full 200 (FR-011).
            if quoted_etag and inm and (
                    "*" in inm or quoted_etag in [t.strip() for t in inm.split(",")]):
                self.send_response(304)
                self.send_header("ETag", quoted_etag)
                self.send_header("Cache-Control", "no-cache, private")
                self.end_headers()
                return
            body = json.dumps(payload).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            if quoted_etag:
                self.send_header("ETag", quoted_etag)
            self.send_header("Cache-Control", "no-cache, private")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        return super().do_GET()

    def log_message(self, fmt, *args):
        pass  # the access log is noise; failures surface in the page

class S(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True

SNAPSHOT_TIMEOUT = float(os.environ.get("CCWATCH_SNAPSHOT_TIMEOUT", "90"))
# ⚠️ Settable so a test can make the snapshot cadence longer than the exchange
# it is measuring. The ETag assertions compare two reads that must not have a
# collection between them; at the 2s default on a loaded machine each `curl`
# takes longer than the cadence, so a collection ALWAYS lands in between and
# the assertion fails for a reason that has nothing to do with the validator.
# Retrying could not fix that — the race was not unlucky, it was certain — so
# the cadence is a knob and the test removes the race instead of re-rolling it.
SNAPSHOT_CADENCE = float(os.environ.get("CCWATCH_SNAPSHOT_CADENCE", "2"))
# ⚠️ The cadence raises a FLOOR under all three refreshers, not just the
# snapshot. The ETag covers the whole published payload — deploys and peers
# included — and `refresh_etag` runs on every publish, so a deploys refresh at
# 60s or a peers refresh at 45s changes the validator just as a snapshot does.
# Slowing only the snapshot left the ETag assertions comparing two reads that a
# peers publish could still slip between, and they failed intermittently for a
# reason that had nothing to do with the snapshot they were pinning. At the
# default of 2 the floor is below both, so production cadences are unchanged.
for _key, _args, _to, _every, _tf in (
        ("snapshot", ["--json"], SNAPSHOT_TIMEOUT, SNAPSHOT_CADENCE, None),
        ("deploys",  ["deploys", "--json"], 120, max(60, SNAPSHOT_CADENCE), None),
        ("peers",    ["peers", "--days", "2", "--json"], 120, max(45, SNAPSHOT_CADENCE), None)):
    threading.Thread(target=refresh_loop(_key, _args, _to, _every, _tf), daemon=True).start()
threading.Thread(target=revive_loop, daemon=True).start()
try:
    with S(("127.0.0.1", PORT), H) as httpd:
        httpd.serve_forever()
except KeyboardInterrupt:
    pass
except OSError as e:
    sys.stderr.write("could not bind 127.0.0.1:%d — %s\n" % (PORT, e))
    sys.exit(1)
' &
  srv_pid=$!
  wait "$srv_pid"
}

# =========================================================== verify-ui ======
#
# ⚠️ This exists because 567 assertions passed while the map showed nothing.
#
# All of them check structure — a role attribute, which node a handler is bound
# to, what a module function returns — and none renders the page and looks at
# it. So a roster whose rows collapsed into a four-character ribbon, a map that
# opened on a zoom level where figures are `display:none`, a drag that selected
# text instead of panning, and 258px of page scroll with an unreachable panel
# below the fold were all green at once. Every one was found in the first ten
# minutes of a person opening the page, which is the single thing the suite
# could not do.
#
# The checks are those bugs restated as numbers a script can read. None of them
# is clever; they did not exist because the suite is entirely browserless, so
# nobody reached for a browser.
CHROME_CANDIDATES='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
/Applications/Chromium.app/Contents/MacOS/Chromium
/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge'

find_chrome() {
  if [ -n "${CCWATCH_CHROME:-}" ] && [ -x "${CCWATCH_CHROME}" ]; then
    printf '%s' "$CCWATCH_CHROME"; return 0
  fi
  printf '%s\n' "$CHROME_CANDIDATES" | while IFS= read -r c; do
    if [ -x "$c" ]; then printf '%s' "$c"; break; fi
  done
}

free_verify_port() {
  $CCWATCH_PY -c 'import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()'
}

# The harness page. It lives in a COPIED web directory, never in web/ itself:
# a production page does not carry its own test scaffolding. Serving it from
# the same origin as /map is what lets it reach into an iframe of the real
# page, dispatch genuine pointer and wheel events at it, and read computed
# styles and rendered boxes back out.
write_verify_harness() {
  cat > "$1" <<'CCWATCH_HARNESS_EOF'
<!doctype html>
<meta charset="utf-8">
<title>ccwatch . verify-ui</title>
<style>
  html, body { margin:0; background:#111; }
  /* A fixed frame size, so a proportion check means the same thing on every
     machine that runs this.
     ⚠️ BOTH frames. #frame2 was added without a width and inherited the
     default 300x150, so the table view rendered at phone width and its
     header measured 291px - a real failure with a misleading cause. A frame
     with no size is a check measuring a layout nobody uses. */
  #frame, #frame2 { width:1180px; height:760px; border:0; display:block; }
  #verify-out { color:#ddd; font:12px monospace; white-space:pre-wrap; }
</style>
<iframe id="frame" src="/map"></iframe>
<!-- ⚠️ The table view gets a frame of its own. It went unlooked-at in a
     browser for as long as this harness only drove /map, and what that cost
     was a usage gauge whose name and percentages were built and never
     attached: the page rendered two bars and a reset line under nothing at
     all, with the whole suite green. A shared instrument needs looking at in
     both places it is drawn. -->
<iframe id="frame2" src="/"></iframe>
<pre id="verify-out"></pre>
<script>
var out = [];
function ok(name)          { out.push("PASS|" + name + "|"); }
function bad(name, detail) { out.push("FAIL|" + name + "|" + String(detail)); }
function check(name, cond, detail) { if (cond) { ok(name); } else { bad(name, detail); } }
function skip(name, why)   { out.push("SKIP|" + name + "|" + String(why)); }
function done() { document.getElementById("verify-out").textContent = out.join("\n"); }

function boxOf(el) {
  var r = el.getBoundingClientRect();
  return {t: r.top, l: r.left, b: r.bottom, r: r.right, w: r.width, h: r.height};
}
function onScreen(b, vw, vh) {
  return b.r > 0 && b.l < vw && b.b > 0 && b.t < vh && b.w > 0 && b.h > 0;
}
// ⚠️ Branches share a row when their room has space for two. As a flex
// column every branch took the room's full width, and the markup is identical
// either way, so only geometry can see it. It asks only of a room wide enough
// for two floor-width rugs, so a narrow card that honestly holds one per row
// is not counted against it.
function branchesShareRow(doc, win, name, floorRem) {
  var rem = parseFloat(win.getComputedStyle(doc.documentElement).fontSize);
  var pick = null;
  [].slice.call(doc.querySelectorAll(".zones")).forEach(function (z) {
    var gap = parseFloat(win.getComputedStyle(z).columnGap) || 0;
    if (!pick && z.children.length >= 2 && z.clientWidth >= 2 * floorRem * rem + gap) { pick = z; }
  });
  if (!pick) {
    skip(name, "no repo on this machine has two branches in a room wide enough for two");
    return;
  }
  var aB = boxOf(pick.children[0]), bB = boxOf(pick.children[1]);
  check(name, Math.abs(aB.t - bB.t) < 2 && bB.l > aB.l,
        "rug tops " + Math.round(aB.t) + " and " + Math.round(bB.t) + ", lefts " +
        Math.round(aB.l) + " and " + Math.round(bB.l) + " in a " + pick.clientWidth + "px room");
}

function run(doc, win) {
  var de = doc.documentElement;
  var vw = de.clientWidth, vh = de.clientHeight;
  var board = doc.getElementById("board");
  var inner = doc.getElementById("boardinner");

  var agents = [].slice.call(inner.querySelectorAll(".agent[data-sid]"));
  var rows = [].slice.call(doc.querySelectorAll("#rosterlist [role=option]"));

  // 1 - "just two empty squares". A default view that draws no agent answers
  // no question, and it was empty by construction: fit-to-world always landed
  // on a zoom level whose level-of-detail set display:none on the figures.
  var shown = agents.filter(function (a) { return onScreen(boxOf(a), vw, vh); });
  check("an agent is visible in the default view", shown.length > 0,
        agents.length + " in the DOM, " + shown.length + " rendered on screen");

  // 2 - the map draws EVERY session, not just one. This is the check that the
  // camera version did not have and needed: measured on a real eight-session
  // machine, its default view had 2 of 8 sessions entirely off-screen and 1 of
  // 4 territories fully visible, and check 1 above passed the whole time
  // because *an* agent was visible. The roster is driven by the same payload
  // on the same page, so a count it disagrees with is a session the map lost.
  check("the map draws a figure for every session the roster lists",
        agents.length === rows.length,
        agents.length + " figures vs " + rows.length + " roster rows");

  // 3 - and every one of them is actually rendered. A figure hidden by its own
  // stylesheet, or collapsed to nothing, is in the DOM and not on the page.
  var unrendered = agents.filter(function (a) {
    var b = boxOf(a);
    return b.w === 0 || b.h === 0 || win.getComputedStyle(a).display === "none";
  });
  check("no figure is hidden or collapsed to zero size", unrendered.length === 0,
        unrendered.map(function (a) { return a.dataset.name; }).join(", "));

  // 3b - and each is pixel art that is actually drawn, at a whole number of
  // screen pixels per art pixel. A box of the right size can hold no paths at
  // all (a sprite module that drew nothing is a figure-shaped hole), and at a
  // fractional scale some art pixels are one screen pixel and some two, which
  // is the smear that pixel art is ruined by. Only asserted at the default
  // root size: the narrow layouts shrink the board in rem on purpose, and
  // that trade is theirs.
  var arts = agents.map(function (a) { return a.querySelector(".figure"); });
  // At least one path, not "several": the hollow outline is legitimately a
  // single path, and a first version of this check asking for five flagged
  // every uncorroborated session on the board.
  var blank = agents.filter(function (a, i) { return !arts[i] || arts[i].querySelectorAll("path[d]").length < 1; });
  check("every figure is drawn from sprite paths, not an empty box", blank.length === 0,
        blank.map(function (a) { return a.dataset.name; }).join(", "));
  if (win.getComputedStyle(de).fontSize === "16px") {
    var smeared = arts.filter(function (s) {
      var b = boxOf(s);
      return !s || Math.abs(b.w / 16 - Math.round(b.w / 16)) > 0.01 || Math.round(b.w / 16) < 1;
    });
    check("at the default size every art pixel is a whole number of screen pixels",
          smeared.length === 0,
          smeared.length + " figures at " + (arts[0] ? boxOf(arts[0]).w : "?") + "px for a 16-cell sprite");
  } else {
    skip("at the default size every art pixel is a whole number of screen pixels",
         "the root is " + win.getComputedStyle(de).fontSize + ", not the 16px default");
  }

  // 3c - the world is painted round every block: a hedge round each owner, a
  // wall round each repo, a rug under each branch. Asserted on the COMPUTED
  // border-image, because every way this fails leaves a plausible page — a
  // custom property that never got set, a url() the CSS parser rejected — a
  // transparent border of exactly the right width, and the board looks tidy
  // and empty rather than broken.
  var unpainted = [];
  [".district", ".building", ".zone"].forEach(function (sel) {
    [].slice.call(doc.querySelectorAll(sel)).forEach(function (e) {
      if (!/^url\("data:image\/svg\+xml/.test(win.getComputedStyle(e).borderImageSource)) unpainted.push(sel);
    });
  });
  check("every owner, repo and branch is framed in painted scenery", unpainted.length === 0,
        unpainted.length + " unpainted: " + unpainted.slice(0, 5).join(", "));
  // And a repo with an unfinished run is drawn with a different wall. A red
  // border cannot carry that any more — border-color is ignored under a
  // border-image — so if the scorched wall does not apply, nothing does.
  var wreck = doc.querySelector(".building.has-unfinished");
  var sound = doc.querySelector(".building:not(.has-unfinished)");
  if (wreck && sound) {
    check("a repo with an unfinished run stands behind a different wall",
          win.getComputedStyle(wreck).borderImageSource !== win.getComputedStyle(sound).borderImageSource,
          "both repos computed the same border-image, so the scorched wall never applied");
  } else {
    skip("a repo with an unfinished run stands behind a different wall",
         "the board needs one repo with an unfinished run and one without");
  }
  branchesShareRow(doc, win, "two branches in one repo share a row rather than stacking", 10.5);
  // ⚠️ The figure's hover and focus rules PARSED, asserted on the stylesheet.
  // An edit once left `} background:…; }` where `.agent:hover {` had been:
  // the stray text became the selector prelude of the next rule, so the CSS
  // parser dropped `.agent:focus-visible` along with it, and a keyboard user
  // lost the focus ring with nothing on screen looking wrong.
  var sels = [];
  [].slice.call(doc.styleSheets).forEach(function (s) {
    [].slice.call(s.cssRules || []).forEach(function (r) { if (r.selectorText) sels.push(r.selectorText); });
  });
  var lost = [".agent:hover", ".agent:focus-visible"].filter(function (s) { return sels.indexOf(s) < 0; });
  check("a figure's hover and focus rules survive the CSS parser", lost.length === 0,
        "missing from the parsed stylesheet: " + lost.join(", "));

  // 4 - reachable means "in the scroll content", which in flow layout is the
  // whole of it. Anything outside the scrollable range cannot be scrolled to,
  // and that is the failure mode the camera had no way to rule out.
  var ib = boxOf(inner);
  var unreachable = agents.filter(function (a) {
    var b = boxOf(a);
    return (b.t - ib.t) < -1 || (b.b - ib.t) > board.scrollHeight + 1 ||
           (b.l - ib.l) < -1 || (b.r - ib.l) > inner.offsetWidth + 1;
  });
  check("every figure is inside the scrollable content", unreachable.length === 0,
        unreachable.map(function (a) { return a.dataset.name; }).join(", "));

  // 5 - "I can still scroll down on the map page": the PAGE must not scroll.
  // The board scrolls; the document around it does not.
  check("the page itself does not scroll", de.scrollHeight - de.clientHeight === 0,
        "overflows by " + (de.scrollHeight - de.clientHeight) + "px");

  // 6 - the map, not the chrome, gets the leftover height.
  var bh = boxOf(board).h;
  check("the map takes most of the viewport height", bh > vh * 0.55,
        Math.round(bh) + "px of " + vh + "px");

  // 7 - the board must be scrollable BY THE USER, not merely by script.
  // ⚠️ This is a computed-style check on purpose. The first version asserted
  // `scrollHeight > clientHeight` and then moved `scrollTop` — and an
  // `overflow:hidden` box satisfies both: it still reports its full content
  // height, and it still moves under a programmatic scrollTop. So that check
  // passed against `#board { overflow-y:hidden }`, a board nobody can scroll
  // with a wheel, a scrollbar or a key. It could not fail; it is in the
  // mutation table. What the user actually depends on is the overflow value.
  var ov = win.getComputedStyle(board);
  check("the board is scrollable by the user, not just by script",
        (ov.overflowY === "auto" || ov.overflowY === "scroll") &&
        (ov.overflowX === "auto" || ov.overflowX === "scroll"),
        "overflow is " + ov.overflowX + " / " + ov.overflowY);

  // 8 - and there is really more than fits, so check 7 is guarding something.
  // Stated as a skip rather than a pass when the content happens to fit: a
  // check that reports success for "there was nothing to test" is the shape
  // that hid the bug above.
  if (board.scrollHeight > board.clientHeight + 1) {
    var top0 = board.scrollTop;
    board.scrollTop = 120;
    var moved = board.scrollTop !== top0;
    board.scrollTop = top0;
    check("and its content really does overflow the viewport", moved,
          "scrollTop stayed at " + top0);
  } else {
    skip("and its content really does overflow the viewport",
         "the fixture fits in " + board.clientHeight + "px; nothing to scroll");
  }

  // 8b - nothing overflows SIDEWAYS at this width. The layout is built so it
  // cannot (min-width:0 plus an ellipsis on every long label, and a grid that
  // collapses to one column), and #board is overflow:auto so a mistake here
  // shows a scrollbar rather than clipping — but a horizontal scrollbar on a
  // vertical list is still a bug, so it is asserted rather than tolerated.
  check("and nothing overflows it sideways",
        board.scrollWidth <= board.clientWidth + 1,
        board.scrollWidth + "px of content in " + board.clientWidth + "px");

  // 9 - "an agent chat window below the map that I can't interact with": an
  // unconditional display:flex overrode the UA's dialog:not([open]) rule.
  var ghosts = [].slice.call(doc.querySelectorAll("dialog")).filter(function (d) {
    return !d.open && boxOf(d).h > 0;
  });
  check("no closed dialog is rendered", ghosts.length === 0,
        ghosts.map(function (d) { return "#" + d.id; }).join(", "));

  // 10 - the roster ribbon: six fields in a flex ROW gave .rname width 0, and
  // every field then wrapped into a four-character column.
  // ⚠️ Skip anything deliberately hidden. `.rsel` carries the word "selected"
  // and is display:none until its row is selected, so a naive "has text but
  // zero width" test reported it seven times on the first run. A check that
  // cries wolf is a check people stop reading.
  var collapsed = [].slice.call(doc.querySelectorAll("#rosterlist [role=option] > *"))
    .filter(function (el) {
      if ((el.textContent || "").trim() === "") { return false; }
      if (win.getComputedStyle(el).display === "none") { return false; }
      return el.getBoundingClientRect().width === 0;
    });
  check("no roster field with text collapses to zero width", collapsed.length === 0,
        collapsed.map(function (e) { return "." + e.className; }).join(", "));

  // 11 - a figure is a real button, so it is focusable and operable by the
  // keyboard without a hand-written keymap. As an SVG <g> this needed an
  // explicit tabindex, an explicit role and a keydown handler.
  var fig0 = agents[0];
  if (fig0) {
    check("a figure is a real button", fig0.tagName.toLowerCase() === "button",
          "it is a <" + fig0.tagName.toLowerCase() + ">");
    fig0.focus();
    check("and it takes keyboard focus", doc.activeElement === fig0,
          "focus went to " + (doc.activeElement && doc.activeElement.tagName));
    fig0.blur();
  }

  // 12 - selecting a roster row brings its figure into the board, which is
  // what "fly to the selection" became without a camera.
  //
  // ⚠️ An earlier version of this check called scrollIntoView ITSELF and then
  // asserted the figure was on screen. It passed whatever the page did, which
  // makes it worse than no check: it was counted as coverage for the one
  // behaviour it could not see. Nothing here may move the board — the click
  // is the only thing allowed to, and what is asserted is that it did.
  //
  // The selection mark is synchronous and checked here; the scroll is not
  // (revealSelection uses behavior:"smooth" unless reduced motion is set), so
  // it is read after a delay in finish() below.
  // Asserted before it is relied on: the reveal check below reads the scroll
  // synchronously, which is only correct because the page takes its instant
  // path. If the --force-prefers-reduced-motion flag ever stops being passed,
  // this names the cause instead of leaving the next check looking like a bug
  // in the page.
  var reducedMotion = win.matchMedia("(prefers-reduced-motion: reduce)").matches;
  check("the harness runs with reduced motion forced", reducedMotion,
        "smooth scrolling cannot complete under --virtual-time-budget, so the "
        + "reveal check below would race the compositor");

  // 12 - selecting a roster row brings its figure into the board, which is what
  // "fly to the selection" became without a camera.
  //
  // ⚠️ Three earlier versions of this check could not fail. The first called
  // scrollIntoView ITSELF and then asserted the figure was on screen, so it
  // passed whatever the page did. The second picked the last row and reported a
  // PASS worded "already on screen; nothing to reveal" whenever the target was
  // visible — and since verify-ui runs against the real ~/.claude, whether it
  // was varied run to run. The third scrolled to the bottom assuming that put
  // the first figure off screen, and on a fixture that overflows by only 346px
  // it does not. All three are in the mutation table.
  //
  // So the target is now SEARCHED FOR rather than assumed: at each end of the
  // scroll range, the first row whose figure is genuinely off screen. Nothing
  // but the click may move the board afterwards. If no such row exists the
  // check is skipped with the reason — a fixture that cannot pose the question
  // is not an answer to it.
  var revealTarget = null, revealRow = null;
  if (rows.length > 1 && reducedMotion) {
    var ends = [0, board.scrollHeight];
    for (var ei = 0; ei < ends.length && !revealTarget; ei++) {
      board.scrollTop = ends[ei];
      for (var ri = 0; ri < rows.length; ri++) {
        var cand = inner.querySelector('.agent[data-sid="' + rows[ri].dataset.sid + '"]');
        if (cand && !onScreen(boxOf(cand), vw, vh)) {
          revealTarget = cand; revealRow = rows[ri];
          break;
        }
      }
    }
  }
  if (revealTarget) {
    var revealTop0 = board.scrollTop;
    revealRow.click();
    check("selecting a roster row marks its figure",
          revealTarget.classList.contains("selected"),
          "classes: " + revealTarget.className);
    check("selecting a roster row reveals its figure",
          onScreen(boxOf(revealTarget), vw, vh) && board.scrollTop !== revealTop0,
          "scrollTop " + revealTop0 + " -> " + board.scrollTop +
          ", on screen: " + onScreen(boxOf(revealTarget), vw, vh));
    board.scrollTop = 0;
  } else {
    skip("selecting a roster row reveals its figure",
         rows.length <= 1 ? "only " + rows.length + " session(s) in the fixture"
           : !reducedMotion ? "reduced motion is not in effect"
           : "every figure is on screen at both ends of the scroll range, so "
             + "none can be used as an off-screen target");
  }

  // 13 - the wire overlay covers the content it draws over. Sized wrong, every
  // wire is clipped at whatever the SVG's default 300x150 happens to cover.
  var wires = doc.getElementById("wires");
  if (wires) {
    check("the wire overlay is sized to the board content",
          Math.abs(wires.getAttribute("width") - inner.offsetWidth) <= 1 &&
          Math.abs(wires.getAttribute("height") - inner.offsetHeight) <= 1,
          wires.getAttribute("width") + "x" + wires.getAttribute("height") +
          " vs content " + inner.offsetWidth + "x" + inner.offsetHeight);
  }

  // 13a - message lines are drawn for the figures being looked at, never all
  // of them at rest (web/comms.js). The board used to draw every edge from the
  // last two days as a permanent line, and each one crossed the blocks between
  // its ends. Posed with a synthetic payload between figures that really are
  // on the board, so it asks the question on a machine with no peer traffic
  // too — and read synchronously, before the page's own tick can repaint the
  // real one over it.
  if (agents.length >= 2 && win.CCWATCH_COMMS && win.wires && win.renderComms && win.selectRow) {
    var countWires = function () { return doc.querySelectorAll("#wires .wire").length; };
    var footEdges = function () { return (doc.getElementById("foot") || {textContent: ""}).textContent; };
    var priorSel = inner.querySelector(".agent.selected");
    // Focusing a figure scrolls it into view, and so can restoring the
    // selection. Put back afterwards, as 12 does: the checks after this one
    // measure boxes, and a board left scrolled puts its labels under the header.
    var priorTop = board.scrollTop;
    win.selectRow(null);
    // Against the real feed first. ⚠️ Skipped, not passed, when the feed has
    // no edge between two figures on the board: then "no lines" is true of a
    // page that draws every edge too, and mutated to do exactly that, this
    // stayed green on a machine with no peer traffic.
    var rest = win.relayoutWires();
    if (rest && rest.drawable > 0) {
      check("at rest the board draws no message lines, whatever the feed holds",
            countWires() === 0, countWires() + " lines for " + rest.drawable
              + " drawable edges, with nothing hovered, focused or selected");
    } else {
      skip("at rest the board draws no message lines, whatever the feed holds",
           "the live feed has no edge between two figures on the board; the posed one below asks instead");
    }

    var A = agents[0], B = agents[1], Cf = agents[2] || null;
    var nowMs = Date.now();
    var iso = function (s) { return new Date(nowMs - s * 1000).toISOString(); };
    var synth = {edges: [{from: A.dataset.name, to: B.dataset.name, count: 3, last: iso(30)}]};
    if (Cf) synth.edges.push({from: Cf.dataset.name, to: B.dataset.name, count: 1, last: iso(7200)});
    win.wires(synth);
    check("and still none when there is traffic to draw", countWires() === 0,
          countWires() + " lines for " + synth.edges.length + " posed edges");

    A.dispatchEvent(new win.PointerEvent("pointerover", {bubbles: true}));
    var hovered = [].slice.call(doc.querySelectorAll("#wires .wire"));
    check("hovering a figure draws its own lines and only those",
          hovered.length === 1 && /^M/.test(hovered[0].querySelector("path").getAttribute("d") || ""),
          hovered.length + " lines drawn for 1 edge touching " + A.dataset.name);
    check("with a recent one drawn stronger than history",
          hovered.length === 1 && hovered[0].classList.contains("recent")
            && +win.getComputedStyle(hovered[0].querySelector("path")).opacity > 0.6,
          hovered.length ? hovered[0].getAttribute("class") + " at opacity "
            + win.getComputedStyle(hovered[0].querySelector("path")).opacity : "no line");
    check("and the footer says how many of how many are drawn",
          footEdges().indexOf("drawing 1 of") !== -1, JSON.stringify(footEdges()));
    inner.dispatchEvent(new win.PointerEvent("pointerleave"));
    check("and leaving the board takes them away again", countWires() === 0,
          countWires() + " lines after the pointer left");
    check("at which point the footer says they are hidden, not absent",
          footEdges().indexOf("hover or select") !== -1, JSON.stringify(footEdges()));

    A.focus();
    check("keyboard focus on a figure draws its lines as hover does", countWires() === 1,
          countWires() + " lines with " + A.dataset.name + " focused");
    A.blur();
    check("and they go when focus leaves", countWires() === 0, countWires() + " lines after blur");

    // A click selects as well as opening the inspector, because the inspector
    // is modal: a click could otherwise never leave the lines on screen.
    A.click();
    var afterClick = countWires();
    if (win.closeModal) win.closeModal();
    // ⚠️ closeModal hands focus back to the figure, and focus draws its lines
    // by itself — left there, this passes with the pinning removed entirely.
    if (doc.activeElement && doc.activeElement.blur) doc.activeElement.blur();
    check("clicking a figure pins its lines, and they outlast the inspector",
          afterClick === 1 && countWires() === 1 && A.classList.contains("selected"),
          afterClick + " lines while open, " + countWires() + " after close, selected: "
            + A.classList.contains("selected"));
    if (Cf) {
      Cf.dispatchEvent(new win.PointerEvent("pointerover", {bubbles: true}));
      check("hovering another figure adds its lines to the pinned ones", countWires() === 2,
            countWires() + " lines with " + A.dataset.name + " pinned and "
              + Cf.dataset.name + " hovered");
      inner.dispatchEvent(new win.PointerEvent("pointerleave"));
    }
    win.selectRow(null);

    // 13a' - the comms marker: on a figure that has just talked, absent on one
    // whose only traffic is old, and out of flow so a message arriving does not
    // move the board.
    var hA = boxOf(A).h, hB = boxOf(B).h;
    var marked = win.renderComms(synth);
    var envA = A.querySelector(".comms"), envB = B.querySelector(".comms");
    check("a figure that just sent a message wears the comms marker, and so does its receiver",
          !!envA && !!envB && envA.querySelectorAll("path[d]").length >= 1
            && boxOf(envA).w > 0 && boxOf(envA).h > 0,
          marked + " marked; " + A.dataset.name + ": " + !!envA + ", " + B.dataset.name + ": " + !!envB);
    if (Cf) {
      check("but not one whose only traffic is two hours old", !Cf.querySelector(".comms"),
            Cf.dataset.name + " is marked for an edge 7200s old");
    }
    check("the marker says who and when in words, not only as a picture",
          A.title.indexOf("messaged " + B.dataset.name) !== -1
            && (A.getAttribute("aria-label") || "").indexOf("messaged " + B.dataset.name) !== -1,
          JSON.stringify(A.title));
    check("and it sits over the figure without moving it",
          envA && win.getComputedStyle(envA).position === "absolute"
            && Math.abs(boxOf(A).h - hA) < 0.5 && Math.abs(boxOf(B).h - hB) < 0.5,
          "height " + hA + " -> " + boxOf(A).h + ", position "
            + (envA ? win.getComputedStyle(envA).position : "n/a"));
    win.renderComms({edges: [{from: A.dataset.name, to: B.dataset.name, count: 3, last: iso(7200)}]});
    check("once the traffic is old the marker is gone, not dimmed",
          !A.querySelector(".comms") && !B.querySelector(".comms")
            && A.title.indexOf("messaged") === -1,
          "still marked: " + !!A.querySelector(".comms") + ", title " + JSON.stringify(A.title));

    if (priorSel) win.selectRow(priorSel.dataset.sid);
    board.scrollTop = priorTop;
  } else {
    skip("message lines are drawn only for the figures being looked at",
         agents.length < 2 ? "the board needs two figures to pose an edge between"
                           : "the page does not expose wires/renderComms/selectRow");
  }

  // 13b - no branch label is a placeholder. A session with no branch must show
  // no branch line, not a line reading "?" — and not a visible empty one
  // either, which is what `textContent = ""` alone would leave. The count of
  // labels examined is reported, because "none of zero labels was wrong" and
  // "none of nine was" are different facts and this check cannot tell the
  // fixture which it got.
  var zlabels = [].slice.call(inner.querySelectorAll(".zlabel"));
  var badLabels = zlabels.filter(function (l) {
    var t = (l.textContent || "").trim();
    var visible = win.getComputedStyle(l).display !== "none";
    return t === "?" || (visible && t === "");
  });
  check("no branch label is a placeholder or a visible blank",
        badLabels.length === 0,
        badLabels.length + " of " + zlabels.length + " labels are \"?\" or blank");

  // 13c - nothing chrome-like sits on top of the board's content. The map-key
  // button used to float at the bottom-left of the map area, inheriting the
  // retired camera cluster's position, and once the board scrolled under it it
  // covered whatever was there — measured, two `implement/CRASHED` badges. The
  // check is geometric rather than a position-value check, because "does this
  // control cover content" is a question about boxes, and a future control
  // could float somewhere else and be just as wrong.
  var floaters = [].slice.call(doc.querySelectorAll("#keyhelp, #boardctl"))
    .filter(function (c) { return boxOf(c).w > 0; });
  var obscured = [];
  floaters.forEach(function (c) {
    var cb = boxOf(c);
    [].slice.call(inner.querySelectorAll(".agent, .wreck-badge, .deploy-badge, .blabel, .zlabel, .dlabel"))
      .forEach(function (e) {
        var b = boxOf(e);
        if (b.w === 0 || b.h === 0) { return; }
        if (b.l < cb.r && b.r > cb.l && b.t < cb.b && b.b > cb.t) {
          obscured.push("#" + c.id + " over ." + String(e.className).split(" ")[0]);
        }
      });
  });
  check("no control floats over the board's content", obscured.length === 0,
        obscured.join(", "));

  // 15 - the alert control must not be able to move the board, which is the
  // entire reason it exists and is a question about boxes that nothing outside
  // a browser can answer. The banners it replaced were measured pushing the
  // board down 32px (feed down), 50px (host pressure) and 81px (both, plus an
  // unreadable-registry line) out of 676 - arriving and clearing on their own
  // while you read the figures underneath.
  //
  // Both states are FORCED here rather than waited for. verify-ui runs against
  // the real ~/.claude, so whether this machine is swapping or its feed is
  // healthy varies run to run, and a check that only measures the state it
  // happened to find is the shape that has passed against three broken
  // implementations in this file already.
  var slot = doc.getElementById("alertslot");
  var abtn = doc.getElementById("alertbtn");
  var amodal = doc.getElementById("alertmodal");
  var header = doc.querySelector("header");
  if (!slot || !abtn || !amodal || !win.CCWATCH_ALERTS || !win.renderAlerts) {
    bad("the alert control is on the page",
        "missing: " + [!slot && "#alertslot", !abtn && "#alertbtn",
                       !amodal && "#alertmodal", !win.CCWATCH_ALERTS && "CCWATCH_ALERTS",
                       !win.renderAlerts && "renderAlerts"].filter(Boolean).join(", "));
  } else {
    var quietModel = win.CCWATCH_ALERTS.alerts(
      {cond: {trust: "ok", unreadable: 0}, host: null, volatile: true});
    var loudModel = win.CCWATCH_ALERTS.alerts({
      cond: {trust: "feed_down", reason: "ECONNREFUSED", dataAge: 125, unreadable: 2},
      host: {pressure: true, swap_used_pct: 92, swap_used_mb: 8100,
             swap_total_mb: 9216, ram_free_mb: 210},
      volatile: false,
    });

    win.renderAlerts(quietModel);
    var quiet = {board: boxOf(board), header: boxOf(header)};
    // A quiet machine has no control at all: not a green one, not an empty
    // bordered box. visibility:hidden also keeps it out of the tab order.
    check("no alert control is shown while there is nothing wrong",
          win.getComputedStyle(abtn).visibility === "hidden"
            && (abtn.textContent || "") === "",
          "visibility " + win.getComputedStyle(abtn).visibility
            + ", text " + JSON.stringify(abtn.textContent));

    win.renderAlerts(loudModel);
    var loud = {board: boxOf(board), header: boxOf(header)};
    check("three live alerts do not move the board's top edge",
          Math.round(loud.board.t) === Math.round(quiet.board.t),
          "board top " + Math.round(quiet.board.t) + " -> " + Math.round(loud.board.t));
    check("nor take any of the board's height",
          Math.round(loud.board.h) === Math.round(quiet.board.h),
          "board height " + Math.round(quiet.board.h) + " -> " + Math.round(loud.board.h));
    check("nor re-wrap the header they sit in",
          Math.round(loud.header.h) === Math.round(quiet.header.h),
          "header height " + Math.round(quiet.header.h) + " -> " + Math.round(loud.header.h));
    // ⚠️ A collapsed control that read "3 alerts" would have turned a stated
    // failure into an absence, which is the one thing this tool may not do.
    // What is asserted is the words, at a size somebody can read.
    var tb = boxOf(abtn);
    check("the trigger names the worst condition in words, not just a count",
          (abtn.textContent || "").indexOf("the feed is down") !== -1,
          JSON.stringify(abtn.textContent));
    check("and is actually rendered, at a non-zero size",
          tb.w > 0 && tb.h > 0 && win.getComputedStyle(abtn).visibility === "visible"
            && onScreen(tb, vw, vh),
          Math.round(tb.w) + "x" + Math.round(tb.h)
            + ", visibility " + win.getComputedStyle(abtn).visibility);

    abtn.click();
    check("clicking it opens the panel", amodal.open, "the dialog did not open");
    // The board must not move when the panel opens either - a popover that
    // reflows the page on open is the banner again, one click later.
    //
    // ⚠️ Mutation-checking this one took three tries and the first two say
    // something worth keeping: `position:static` on the dialog does NOT turn
    // it red, and neither does `show()` in place of `showModal()`. A dialog in
    // the top layer is out of flow whatever `position` says, and a non-modal
    // dialog is still `position:absolute` by the UA sheet. It goes red only
    // when the panel is BOTH non-modal and in flow - which is precisely what a
    // hand-rolled <div> dropdown would be, and is the rewrite this guards.
    var opened = boxOf(board);
    check("and opening the panel does not move the board either",
          Math.round(opened.t) === Math.round(quiet.board.t)
            && Math.round(opened.h) === Math.round(quiet.board.h),
          "board " + Math.round(quiet.board.t) + "/" + Math.round(quiet.board.h)
            + " -> " + Math.round(opened.t) + "/" + Math.round(opened.h));
    // Whole-view, in the sense check 2 means it: every alert in the model is
    // drawn, not merely "an alert was drawn".
    var aitems = [].slice.call(amodal.querySelectorAll(".alertitem"));
    check("the panel lists every alert the model holds",
          aitems.length === loudModel.items.length,
          aitems.length + " rendered vs " + loudModel.items.length + " in the model");
    var acollapsed = aitems.filter(function (el) {
      var b = boxOf(el);
      return b.w === 0 || b.h === 0 || win.getComputedStyle(el).display === "none";
    });
    check("and none of them is hidden or collapsed to nothing",
          acollapsed.length === 0,
          acollapsed.map(function (el) { return el.textContent.slice(0, 30); }).join(" | "));
    // ⚠️ The measurement has to be IN the panel. Moving the verdict behind a
    // control is only acceptable because the reading that produced it is one
    // click away; a panel that repeated the headline would have lost it.
    var panelText = amodal.textContent || "";
    check("the measurements behind the verdicts are in the panel, not only the verdicts",
          panelText.indexOf("ECONNREFUSED") !== -1 && panelText.indexOf("2m") !== -1
            && panelText.indexOf("ccwatch doctor") !== -1,
          JSON.stringify(panelText.slice(0, 160)));
    // 258px of page scroll with an unreachable dialog below the fold is why
    // this is asserted rather than assumed.
    var pb = boxOf(amodal);
    check("the panel is wholly inside the viewport",
          pb.t >= tb.t && pb.t <= vh && pb.l >= 0 && pb.r <= vw + 1 && pb.b <= vh + 1,
          "panel " + [pb.l, pb.t, pb.r, pb.b].map(Math.round).join(",")
            + " in " + vw + "x" + vh + ", trigger bottom " + Math.round(tb.b));
    // ⚠️ And anchored to the TRIGGER, which the check above cannot see. The
    // UA stylesheet gives a dialog `left:0; right:0`; with only `right` set the
    // box stays stretched from the left edge and max-width resolves it at x=0,
    // so the panel rendered hard against the left of the window, 288px from
    // the control that opens it. Every geometric check here passed, and a
    // screenshot found it in a second.
    check("and anchored to the trigger rather than to the window",
          Math.abs(pb.r - tb.r) <= 16,
          "panel right " + Math.round(pb.r) + " vs trigger right " + Math.round(tb.r));

    abtn.click();
    check("clicking it again closes the panel, leaving nothing rendered",
          !amodal.open && boxOf(amodal).h === 0,
          "open=" + amodal.open + ", height=" + boxOf(amodal).h);

    // ---- the revive switch -------------------------------------------
    // Forced, like the alerts above: whether revive is on, and what it found,
    // depends on this machine, and a check that measures whatever it found is
    // the shape that passes against a broken implementation.
    var rv = win.CCWATCH_REVIVE && win.CCWATCH_REVIVE.ui;
    var rbtn = doc.getElementById("revivebtn"), rmodal = doc.getElementById("revivemodal");
    if (!rv || !rbtn || !rmodal) {
      bad("the revive switch is on the page",
          "missing: " + [!rv && "CCWATCH_REVIVE.ui", !rbtn && "#revivebtn",
                         !rmodal && "#revivemodal"].filter(Boolean).join(", "));
    } else {
      var nowS = Date.now() / 1000;
      var rvOff = {enabled: false, available: true, every: 60, live: false, pass_at: nowS - 20,
                   rows: [{name: "web-app-fc", action: "ask", why: "paused 46m mid-roadmap checkout 4/5"},
                          {name: "pricing-7b", action: null, why: "session limit · resets in 14m"}],
                   recent: []};
      var rvOn = {enabled: true, available: true, every: 60, live: true, pass_at: nowS - 5,
                  rows: [{name: "web-app-fc", action: "ask", outcome: "delivered", why: "paused 46m mid-roadmap checkout 4/5"},
                         {name: "pricing-7b", action: "retry", outcome: "failed", why: "API error 6m ago (ENOTFOUND)"},
                         {name: "search-9d", action: null, why: "paused 5m mid-roadmap reindex 0/3 · asking at 10m"}],
                  recent: [{at: nowS - 300, target: "web-app-fc", action: "ask", outcome: "delivered", why: "paused 46m"}]};
      rv.update(rvOff);
      var rq = {board: boxOf(board), header: boxOf(header)};
      var rb = boxOf(rbtn);
      check("the revive switch says its state in words",
            /^revive: off/.test(rbtn.textContent || ""), JSON.stringify(rbtn.textContent));
      check("and is rendered, at a non-zero size, on screen",
            rb.w > 0 && rb.h > 0 && win.getComputedStyle(rbtn).visibility === "visible" && onScreen(rb, vw, vh),
            Math.round(rb.w) + "x" + Math.round(rb.h));
      rv.update(rvOn);
      check("turning revive on, with sends to report, does not move the board or re-wrap the header",
            Math.round(boxOf(board).t) === Math.round(rq.board.t)
              && Math.round(boxOf(header).h) === Math.round(rq.header.h),
            "board top " + Math.round(rq.board.t) + " -> " + Math.round(boxOf(board).t)
              + ", header " + Math.round(rq.header.h) + " -> " + Math.round(boxOf(header).h));
      // ⚠️ The switch itself must not move either. Its label grows when it
      // turns on, and that once wrapped the header's left half under the
      // gauges, which set the header's height - so the check above stayed
      // green while the switch jumped 220px.
      var rbOn = boxOf(rbtn);
      check("nor move the switch itself",
            Math.round(rbOn.l) === Math.round(rb.l) && Math.round(rbOn.t) === Math.round(rb.t),
            "switch " + Math.round(rb.l) + "," + Math.round(rb.t) + " -> " + Math.round(rbOn.l) + "," + Math.round(rbOn.t));
      check("and the switch then says it is on, and how many it sent",
            /^revive: on · 1 sent/.test(rbtn.textContent || ""), JSON.stringify(rbtn.textContent));
      rbtn.click();
      check("clicking the switch opens its panel", rmodal.open, "the dialog did not open");
      var rrows = [].slice.call(rmodal.querySelectorAll("#reviverows .revrow"));
      check("the panel lists every session the pass decided about",
            rrows.length === rvOn.rows.length, rrows.length + " rendered vs " + rvOn.rows.length);
      // The CELLS, not the row: a row is `display:contents` so the list can be
      // one grid, and has no box of its own to measure - measuring it flagged
      // every row of a panel that rendered all of them.
      var rhidden = rrows.filter(function (el) {
        return [].slice.call(el.children).some(function (c) {
          var b = boxOf(c); return c.textContent && (b.w === 0 || b.h === 0);
        });
      });
      check("and none of them is collapsed to nothing", rhidden.length === 0,
            rhidden.map(function (el) { return el.textContent.slice(0, 30); }).join(" | "));
      var rtext = rmodal.textContent || "";
      check("the reason behind every decision is in the panel, beside its verdict",
            rtext.indexOf("mid-roadmap checkout 4/5") !== -1 && rtext.indexOf("ENOTFOUND") !== -1
              && rtext.indexOf("retried · failed") !== -1 && rtext.indexOf("asking at 10m") !== -1,
            JSON.stringify(rtext.slice(0, 200)));
      var rtog = doc.getElementById("revivetoggle");
      check("and it carries the switch itself, labelled for what it will do",
            rtog && !rtog.hidden && (rtog.textContent || "") === "turn off",
            rtog ? JSON.stringify(rtog.textContent) + (rtog.hidden ? " (hidden)" : "") : "no #revivetoggle");
      var rp = boxOf(rmodal);
      check("the revive panel is wholly inside the viewport, anchored to its switch",
            rp.t >= rb.t && rp.l >= 0 && rp.r <= vw + 1 && rp.b <= vh + 1
              && (Math.abs(rp.l - rb.l) <= 16 || Math.abs(rp.r - (vw - 8)) <= 16),
            "panel " + [rp.l, rp.t, rp.r, rp.b].map(Math.round).join(",")
              + ", switch " + Math.round(rb.l) + "-" + Math.round(rb.r) + " in " + vw);
      rv.update({enabled: true, available: true, every: 60, live: true, pass_at: nowS - 5,
                 rows: [], recent: [], error: "revive exited 1: snapshot failed"});
      check("a failed pass is said in words, not left as an empty list",
            (rmodal.textContent || "").indexOf("last pass failed: revive exited 1") !== -1
              && (rmodal.textContent || "").indexOf("nothing stopped") === -1,
            JSON.stringify((rmodal.textContent || "").slice(0, 200)));
      rmodal.close();
      rv.update(win.lastBody ? win.lastBody.revive : null);
    }

    // ⚠️ And again at a narrow width, because at this harness's 1180px the
    // header has room to absorb the trigger whether or not its slot reserves
    // any - so the check above passes with the reservation removed and cannot
    // see the bug it describes. Measured: at 420px an unreserved slot wraps
    // the gauges onto a second header line, which moves the board by the
    // height of that line. The frame is put back afterwards so every check
    // after this one measures the width they all assume.
    var frame = document.getElementById("frame");
    var wideWidth = frame.style.width || "1180px";
    frame.style.width = "420px";
    win.renderAlerts(quietModel);
    var narrowQuiet = {board: boxOf(board), header: boxOf(header)};
    win.renderAlerts(loudModel);
    var narrowLoud = {board: boxOf(board), header: boxOf(header)};
    check("and at 420px, where the header has no room to spare, still neither",
          Math.round(narrowLoud.board.t) === Math.round(narrowQuiet.board.t)
            && Math.round(narrowLoud.header.h) === Math.round(narrowQuiet.header.h),
          "board top " + Math.round(narrowQuiet.board.t) + " -> "
            + Math.round(narrowLoud.board.t) + ", header height "
            + Math.round(narrowQuiet.header.h) + " -> " + Math.round(narrowLoud.header.h));
    // ⚠️ The overlay's own width, posed the same way and for the same reason.
    // A whole-view property needs a whole-view assertion: the complaint that
    // produced these was about PROPORTIONS, and nothing structural can see
    // one — a docked roster and a stacked one have identical DOM, roles and
    // handlers. Measured in the app's 470x630 panel, the stacked roster took
    // over half the height and the board it sits above was a strip.
    frame.style.width = "470px";
    // ⚠️ The fold is recomputed on `resize`, and setting the iframe's style
    // does not deliver that event synchronously — so without this the page is
    // still in whatever state it was built in at 1180px, and the checks below
    // measure the wide layout while claiming to measure the narrow one.
    win.dispatchEvent(new win.Event("resize"));
    if (win.CCWATCH_ROSTER && win.CCWATCH_ROSTER.stacked(470)) {
      var rB = boxOf(doc.getElementById("roster"));
      var wB = boxOf(doc.getElementById("wrap"));
      // ⚠️ Skipped rather than asserted when the machine is quiet, and this is
      // not caution. `verify-ui` serves the REAL ~/.claude, so the roster holds
      // whatever happens to be running — and an empty roster is short whether
      // it is folded or not, so the comparison passes against an unfolded
      // panel and counts as coverage of nothing. It went green exactly that
      // way on a machine reporting 0 sessions.
      var rosterRows = doc.querySelectorAll("#rosterlist .rrow").length;
      var stageB = boxOf(doc.getElementById("stage"));
      // ⚠️ Against the STAGE, not against the roster. Comparing the two
      // heights is a check that cannot fail once the roster leaves the layout:
      // a `display:none` panel measures 0 and any board beats it. What is
      // actually claimed is that the board gets essentially all of the space,
      // so that is what is measured.
      if (rosterRows >= 3) {
        check("at 470px the board gets the whole stage, and the roster no layout",
              stageB.h > 0 && wB.h >= stageB.h * 0.95 && rB.h === 0,
              "board " + Math.round(wB.h) + "px of stage " + Math.round(stageB.h) +
              "px, roster " + Math.round(rB.h) + "px across " + rosterRows + " rows");
        // Opened, it must float rather than shove. Same rule as the chip.
        var foldBtn = doc.getElementById("rosterfold");
        foldBtn.click();
        var openBoard = boxOf(doc.getElementById("wrap"));
        var openRoster = boxOf(doc.getElementById("roster"));
        check("and opening it floats over the board instead of resizing it",
              Math.round(openBoard.h) === Math.round(wB.h) &&
                win.getComputedStyle(doc.getElementById("roster")).position === "absolute",
              "board " + Math.round(wB.h) + " -> " + Math.round(openBoard.h) +
              "px, roster position " +
              win.getComputedStyle(doc.getElementById("roster")).position +
              " at " + Math.round(openRoster.h) + "px");
        foldBtn.click();
      } else {
        skip("at 470px the board gets the whole stage, and the roster no layout",
             "only " + rosterRows + " roster row(s) live; an empty roster is "
             + "short whether it is folded or not");
        skip("and opening it floats over the board instead of resizing it",
             "needs a populated roster to be worth measuring");
      }
      // ⚠️ And the figures actually got smaller, which is the whole point of
      // the root-size change: the board is laid out in rem, so a figure at
      // 4.4rem is 70px at the default and 57px at 13px. A check on the media
      // query would pass against a rule that no longer applies to anything.
      // ⚠️ The chip is out of flow, so nothing stops the nav rendering under
      // it — and the nav did: "show agents" was half-hidden behind the alert.
      // Neither the height checks above nor "no control floats over the
      // board" can see a collision INSIDE the header, so it gets its own
      // geometric check.
      win.renderAlerts(loudModel);
      var chipB = boxOf(doc.getElementById("alertbtn"));
      var navB = boxOf(doc.querySelector("header nav"));
      var h1B = boxOf(doc.querySelector("header h1"));
      var hits = [];
      [["nav", navB], ["h1", h1B]].forEach(function (pair) {
        var b = pair[1];
        if (b.w === 0 || chipB.w === 0) { return; }
        if (b.l < chipB.r && b.r > chipB.l && b.t < chipB.b && b.b > chipB.t) {
          hits.push(pair[0]);
        }
      });
      check("and the alert chip does not render over the title or the nav",
            hits.length === 0,
            "chip " + Math.round(chipB.l) + ".." + Math.round(chipB.r) +
            " overlaps: " + (hits.join(", ") || "nothing"));
      // The gauge uses the whole width instead of a right-aligned column, with
      // the reset instant pushed to the far end of its first line.
      var gg = doc.querySelector(".g-gauge");
      if (gg) {
        var ggB = boxOf(gg);
        var hdrB = boxOf(doc.querySelector("header"));
        var resetB = boxOf(gg.querySelector(".g-reset"));
        var headB = boxOf(gg.querySelector(".g-head"));
        check("the usage gauge spans the header width at overlay size",
              ggB.w > hdrB.w * 0.8,
              "gauge " + Math.round(ggB.w) + "px of header " + Math.round(hdrB.w) + "px");
        check("and the reset instant sits to the right of the numbers, not under them",
              resetB.w > 0 && resetB.l > headB.l &&
                Math.abs(resetB.t - headB.t) < headB.h,
              "reset at x=" + Math.round(resetB.l) + " y=" + Math.round(resetB.t) +
              " vs numbers x=" + Math.round(headB.l) + " y=" + Math.round(headB.t));
      } else {
        skip("the usage gauge spans the header width at overlay size",
             "no gauge rendered; this machine reports no usage");
        skip("and the reset instant sits to the right of the numbers, not under them",
             "no gauge rendered");
      }

      // ⚠️ Repos share a row when they fit. The base rule reserves 280px per
      // card, so in a 470px overlay every repo took a line of its own — and a
      // `grid-template-columns:1fr` in the dense block made it unconditional.
      // The claim is geometric and nothing structural can see it: the cards
      // have identical markup whether they stack or sit side by side.
      var multi = null;
      [].slice.call(doc.querySelectorAll(".district")).forEach(function (d) {
        var cards = d.querySelectorAll(".building");
        if (!multi && cards.length >= 2) { multi = cards; }
      });
      if (multi) {
        var aB = boxOf(multi[0]), bB = boxOf(multi[1]);
        check("two repos in one owner share a row rather than stacking",
              Math.abs(aB.t - bB.t) < 2 && bB.l > aB.l,
              "card tops " + Math.round(aB.t) + " and " + Math.round(bB.t) +
              ", lefts " + Math.round(aB.l) + " and " + Math.round(bB.l));
      } else {
        skip("two repos in one owner share a row rather than stacking",
             "no owner on this machine has two repos to place");
      }
      branchesShareRow(doc, win, "and at 470px two branches in one repo still share a row", 7.75);

      var figW = boxOf(doc.querySelector(".agent")).w;
      check("and a figure is scaled down so more of them fit per row",
            figW > 0 && figW < 50,
            ".agent rendered " + Math.round(figW) + "px wide (70px at the default root size)");
      // ⚠️ The art itself, not just its container. `figure()` creates the SVG
      // at a fixed size in JS, so before it was sized in CSS the labels and
      // gaps shrank around figures that stayed exactly as big — which is most
      // of why the board did not get denser. A check on `.agent` alone cannot
      // see that: the container was already narrowing.
      var artW = boxOf(doc.querySelector(".figure")).w;
      check("and the figure art shrank with it, not just its container",
            artW > 0 && artW < 30,
            ".figure rendered " + Math.round(artW) + "px wide (32px at the default)");
      // ⚠️ And the labels, which are in px and so are reached by NONE of the
      // root-size change. An owner heading at 14px beside a 12px board was the
      // complaint; a check on the media query would pass against a rule that
      // applies to nothing.
      var dl = doc.querySelector(".dlabel");
      var dlSize = dl ? parseFloat(win.getComputedStyle(dl).fontSize) : 0;
      check("and the owner heading is smaller than the board it labels",
            dlSize > 0 && dlSize <= 11,
            ".dlabel computed " + dlSize + "px (14px at wide widths)");
      // ⚠️ The deep link, driven for real rather than checked for its markup.
      // `?sid=` is the route out of the overlay into a browser tab, and a link
      // that is present but opens nothing is worse than no link: the reader
      // clicks it and the page sits there. So a sid from the live payload is
      // pushed through the same handler the query string uses, and the panel
      // is asserted to be open ON THAT AGENT — a modal that opened on the
      // wrong session would satisfy "a modal opened".
      // ⚠️ Read through the page's own scope. `lastRows` is a top-level `let`,
      // and a `let` never becomes a property of `window` — `win.lastRows` is
      // undefined however many sessions are on the board, so the first version
      // of this check skipped itself with "no sessions in the payload" on a
      // machine showing sixteen.
      var anySid = win.eval("Object.keys(lastRows)[0] || ''");
      var anyName = anySid
        ? win.eval("(lastRows[" + JSON.stringify(anySid) + "].name || '')") : "";
      if (anySid) {
        var dlg = doc.getElementById("agentmodal");
        if (dlg.open) { dlg.close(); }
        win.deepLinkDone = false;
        var realSearch = win.location.search;
        // The handler reads location.search, so it is posed rather than
        // navigated to: reloading the iframe would throw away the payload the
        // rest of these checks are measuring.
        win.__dlSid = anySid;
        win.eval("deepLinkDone = false; (function(){var w=window.__dlSid;" +
                 "var row=lastRows[w]; if (row) openModal(w, row.name || w, 'deeplink');})()");
        check("a deep link opens the agent panel on the session it names",
              dlg.open === true,
              "#agentmodal open=" + dlg.open + " for sid " + anySid.slice(0, 8));
        var nameEl = doc.getElementById("iname");
        check("and the panel is showing that agent, not merely showing",
              (nameEl.textContent || "").indexOf(String(anyName).slice(0, 6)) >= 0,
              "#iname=" + JSON.stringify(nameEl.textContent) +
              " vs row name " + JSON.stringify(anyName));
        var link = doc.getElementById("ibrowser");
        check("and it offers the browser link for that same session",
              (link.getAttribute("href") || "").indexOf(anySid) >= 0 &&
                link.getAttribute("target") === "_blank",
              "href=" + link.getAttribute("href") +
              " target=" + link.getAttribute("target"));
        dlg.close();
        void realSearch;
      } else {
        skip("a deep link opens the agent panel on the session it names",
             "no sessions in the payload to link to");
      }

      // A floor, stated as an assertion so nobody shrinks it into noise later.
      var al = doc.querySelector(".alabel");
      var alSize = al ? parseFloat(win.getComputedStyle(al).fontSize) : 0;
      check("and no label is shrunk below the 8px legibility floor",
            alSize >= 8 && dlSize >= 8,
            ".alabel " + alSize + "px, .dlabel " + dlSize + "px");
      var fold = doc.getElementById("rosterfold");
      var fB = boxOf(fold);
      check("and the fold control is rendered and says what it does",
            fB.w > 0 && fB.h > 0 && /agents/.test(fold.textContent),
            "#rosterfold " + Math.round(fB.w) + "x" + Math.round(fB.h) +
            " text=" + JSON.stringify(fold.textContent));
      // hidden, not merely invisible: a collapsed list that keeps its rows in
      // the tab order drops a keyboard user into rows they cannot see.
      check("and the collapsed list leaves the tab order, not just the screen",
            doc.getElementById("rosterlist").hidden === true,
            "#rosterlist.hidden=" + doc.getElementById("rosterlist").hidden);
      // ⚠️ The chip is out of flow here, so it costs no row in EITHER state.
      // The reserved row it replaced was paid by a quiet machine too, which is
      // what kept the header height independent of what was wrong — so the
      // test is that the height does not move when the trigger arrives.
      win.renderAlerts(quietModel);
      var ovQuiet = {board: boxOf(board), header: boxOf(header)};
      win.renderAlerts(loudModel);
      var ovLoud = {board: boxOf(board), header: boxOf(header)};
      check("and at 470px an arriving alert still adds no row",
            Math.round(ovLoud.header.h) === Math.round(ovQuiet.header.h)
              && Math.round(ovLoud.board.t) === Math.round(ovQuiet.board.t),
            "header " + Math.round(ovQuiet.header.h) + " -> "
              + Math.round(ovLoud.header.h) + ", board top "
              + Math.round(ovQuiet.board.t) + " -> " + Math.round(ovLoud.board.t));
      // And it is still WORDS. A chip narrowed to a glyph would satisfy the
      // check above and lose the claim entirely (constitution IV and VII).
      var chip = boxOf(doc.getElementById("alertbtn"));
      check("and reaches the header as readable words, not a bare glyph",
            chip.w >= 60,
            "#alertbtn rendered " + Math.round(chip.w) + "x" + Math.round(chip.h));
    } else {
      skip("the overlay layout at 470px", "CCWATCH_ROSTER does not stack at 470px");
    }
    frame.style.width = wideWidth;

    // Put the page back to whatever is actually true, rather than leaving a
    // fabricated condition on screen for the screenshot pass.
    win.renderAlerts(quietModel);
  }

  // 16 - the usage meter's two bars. The whole instrument is a comparison of
  // two lengths, so what has to be true is geometric: both bars drawn, to the
  // same scale, at widths that match the numbers beside them. A bar that
  // ignores its percentage still renders, and every structure-only assertion
  // passes against it.
  //
  // The usage state is POSED, for the same reason the alert states are: this
  // runs against the real ~/.claude, where the statusline may never have
  // reported and where a window may or may not carry a reset instant.
  var gaugesEl = doc.getElementById("gauges");
  if (!gaugesEl || !win.updateGauges || !win.CCWATCH_USAGE) {
    bad("the usage meter is on the page",
        "missing: " + [!gaugesEl && "#gauges", !win.updateGauges && "updateGauges",
                       !win.CCWATCH_USAGE && "CCWATCH_USAGE"].filter(Boolean).join(", "));
  } else {
    var nowSec = Date.now() / 1000;
    win.updateGauges({
      age: 0, stale_after: 600,
      // 78% of the limit against 20% of the clock: the bars must come out
      // visibly different, and the longer one must be the consumption.
      five_hour: {used_percentage: 78, resets_at: nowSec + 4 * 3600},
      seven_day: {used_percentage: 12, resets_at: nowSec + 4 * 86400},
      // No reset instant: this window's clock bar must be ABSENT, not zero.
      seven_day_opus: {used_percentage: 3},
    });
    var gauges = [].slice.call(gaugesEl.querySelectorAll(".g-gauge"));
    if (gauges.length === 0) {
      // Withheld for a reason the page is entitled to have (an untrusted feed
      // withholds every volatile reading), so this is a skip with the reason
      // rather than a failure against a page doing its job.
      skip("the usage meter draws a bar pair for every window reported",
           "the posed usage was withheld - the feed this run is not trusted, "
             + "so there is nothing to measure");
    } else {
      check("the usage meter draws a gauge for every window the payload reports",
            gauges.length === 3, gauges.length + " of 3");
      var usedBars = [].slice.call(gaugesEl.querySelectorAll(".g-used"));
      var timeBars = [].slice.call(gaugesEl.querySelectorAll(".g-time"))
        .filter(function (b) { return win.getComputedStyle(b).display !== "none"; });
      check("with a consumption bar on each and a clock bar on the two that can have one",
            usedBars.length === 3 && timeBars.length === 2,
            usedBars.length + " consumption, " + timeBars.length + " clock");
      // ⚠️ Absent, not zero-width. A clock bar at 0% for a window with no
      // reset instant reads as "this window just started", which is nobody's
      // measurement - and it is the kind of thing that looks fine in the DOM.
      var opus = gauges[2];
      var opusTime = opus.querySelector(".g-time");
      check("and no clock bar at all for the window with no reset instant",
            !opusTime || win.getComputedStyle(opusTime).display === "none",
            opusTime ? "display is " + win.getComputedStyle(opusTime).display : "absent");
      var collapsed = usedBars.concat(timeBars).filter(function (b) {
        var bb = boxOf(b);
        return bb.w === 0 || bb.h === 0;
      });
      check("no bar collapses to zero size", collapsed.length === 0,
            collapsed.length + " of " + (usedBars.length + timeBars.length));
      // ⚠️ One scale, or the comparison is meaningless: the two tracks must be
      // the same width, so equal lengths mean equal percentages.
      var tracks = gauges.map(function (g) { return Math.round(boxOf(g.querySelector(".g-used")).w); });
      var fiveTrack = boxOf(gauges[0].querySelector(".g-used")).w;
      var fiveTimeTrack = boxOf(gauges[0].querySelector(".g-time")).w;
      check("the two bars of a gauge share one width, so their lengths are comparable",
            Math.abs(fiveTrack - fiveTimeTrack) <= 1,
            fiveTrack + "px vs " + fiveTimeTrack + "px");
      check("and every gauge is drawn to that same scale",
            tracks.every(function (w) { return Math.abs(w - tracks[0]) <= 1; }),
            tracks.join(","));
      // ⚠️ The fills must match the numbers. This is the check that a bar
      // wired to the wrong field, or to a constant, cannot survive - and the
      // one no amount of DOM structure can stand in for.
      function fillPct(bar) {
        var track = boxOf(bar).w;
        var fill = boxOf(bar.firstChild).w;
        return track > 0 ? (fill / track) * 100 : null;
      }
      var usedAt = fillPct(gauges[0].querySelector(".g-used"));
      var timeAt = fillPct(gauges[0].querySelector(".g-time"));
      check("the consumption bar is drawn at the percentage it reports",
            usedAt != null && Math.abs(usedAt - 78) <= 2,
            "drawn at " + (usedAt == null ? "?" : Math.round(usedAt)) + "% against 78%");
      check("and the clock bar at the fraction of the window that has elapsed",
            timeAt != null && Math.abs(timeAt - 20) <= 2,
            "drawn at " + (timeAt == null ? "?" : Math.round(timeAt)) + "% against 20%");
      // The point of the pair: consumption ahead of the clock is visible as
      // the longer bar, and is also said in words for anyone the lengths do
      // not reach.
      check("so consumption ahead of the clock is the longer bar",
            usedAt > timeAt, Math.round(usedAt) + "% vs " + Math.round(timeAt) + "%");
      check("and is stated in words, not left to the lengths alone",
            (gauges[0].textContent || "").indexOf("ahead of the clock") !== -1,
            JSON.stringify(gauges[0].textContent));
      // Both times: the relative one to act on, the wall clock to put in a
      // calendar, with the zone named because EDT and EST are an hour apart.
      var resetText = (gauges[0].querySelector(".g-reset").textContent || "");
      check("the reset is stated as a relative time and an Eastern wall clock",
            /resets \d/.test(resetText) && /(AM|PM) E[DS]T/.test(resetText),
            JSON.stringify(resetText));
      // A bar is a length, and a length is not available to a screen reader.
      var unlabelled = usedBars.concat(timeBars).filter(function (b) {
        return !(b.getAttribute("aria-label") || "").match(/\d+% of the/);
      });
      check("every bar carries its reading as text for a screen reader",
            unlabelled.length === 0, unlabelled.length + " without a labelled reading");

      // ⚠️ And the meter must not move the board when a reading goes away. A
      // usage reading is withheld whenever it goes stale or the feed stops
      // being trusted, and it returns on the next good snapshot - measured
      // before the reservation: header 89px with a reading, 52px without,
      // so the board shifted 37px up and back down on its own. This is the
      // banner problem one element over, and it needs the same assertion.
      var usageStates = {};
      [["reading", {age: 0, stale_after: 600,
                    five_hour: {used_percentage: 78, resets_at: nowSec + 4 * 3600},
                    seven_day: {used_percentage: 12, resets_at: nowSec + 4 * 86400},
                    seven_day_opus: {used_percentage: 3}}],
       ["stale", {age: 9999, stale_after: 600, five_hour: {used_percentage: 78}}],
       ["absent", null]].forEach(function (pair) {
        win.updateGauges(pair[1]);
        usageStates[pair[0]] = {
          header: Math.round(boxOf(header).h),
          boardTop: Math.round(boxOf(board).t),
          boardH: Math.round(boxOf(board).h),
        };
      });
      var shapes = Object.keys(usageStates).map(function (k) {
        return k + " " + usageStates[k].header + "/" + usageStates[k].boardTop
          + "/" + usageStates[k].boardH;
      });
      check("a withheld usage reading does not move the board either",
            usageStates.reading.header === usageStates.stale.header
              && usageStates.reading.header === usageStates.absent.header
              && usageStates.reading.boardTop === usageStates.absent.boardTop
              && usageStates.reading.boardH === usageStates.absent.boardH,
            shapes.join(" | "));
      // ⚠️ And again at 1100px, which is chosen and not arbitrary. The header
      // has two columns above 1000px and one below, and the width the meter's
      // column reserves only matters in the two-column band - below it the
      // columns stack and nothing sits beside the meter to be squeezed.
      // Measured with the reservation removed: 108/92/92 at 1100px and
      // 108/92/92 at 1020px, against 130/130/130 at 900px. A check at 900px
      // was green through all of it, which is what a check in the wrong
      // regime looks like.
      //
      // Not asserted at phone width, and that is a stated boundary rather
      // than an oversight: there the three blocks wrap among themselves
      // (248px with a reading against 187px without, at 420px) and reserving
      // for that would be a header wider than the window. See web/map.html.
      var frame900 = document.getElementById("frame");
      var wide900 = frame900.style.width || "1180px";
      frame900.style.width = "1100px";
      // ⚠️ The title's own length is POSED here, and without that this check
      // could not fail. What the width reservation prevents is the title
      // re-wrapping when the meter's column narrows - so whether the bug
      // reproduces depends on how long the title happens to be, which depends
      // on how many sessions this machine is running. Measured: with the
      // reservation removed the check stayed green against the real
      // ~/.claude, and went red the moment the title was pinned to a length
      // that wraps. A fixed string is the fixture.
      var countsEl = doc.getElementById("counts");
      var realCounts = countsEl ? countsEl.textContent : null;
      if (countsEl) {
        countsEl.textContent = " 6 live in 3 projects \u00b7 1 waiting on you \u00b7 3 suspect";
      }
      var narrowHeaders = [];
      [{age: 0, stale_after: 600,
        five_hour: {used_percentage: 78, resets_at: nowSec + 4 * 3600},
        seven_day: {used_percentage: 12, resets_at: nowSec + 4 * 86400},
        seven_day_opus: {used_percentage: 3}},
       {age: 9999, stale_after: 600, five_hour: {used_percentage: 78}},
       null].forEach(function (u) {
        win.updateGauges(u);
        narrowHeaders.push(Math.round(boxOf(header).h));
      });
      check("and does not at 1100px either, where the column's width is what decides it",
            narrowHeaders.every(function (h) { return h === narrowHeaders[0]; }),
            "header heights: " + narrowHeaders.join(","));
      if (countsEl && realCounts != null) { countsEl.textContent = realCounts; }
      // ⚠️ And the header must not be wider than the window at phone width.
      // The fix above reserves 45em for the meter's column, which is 585px -
      // wider than a 420px window - and `body` is overflow:hidden, so the far
      // end would be clipped and unreachable rather than scrollable. That is a
      // failure presenting as an absence, and it was one media query away from
      // shipping: every height check was green while it was true.
      frame900.style.width = "420px";
      win.updateGauges({age: 0, stale_after: 600,
                        five_hour: {used_percentage: 78, resets_at: nowSec + 4 * 3600},
                        seven_day: {used_percentage: 12, resets_at: nowSec + 4 * 86400},
                        seven_day_opus: {used_percentage: 3}});
      var de420 = doc.documentElement;
      check("and at 420px the header does not overflow the window sideways",
            de420.scrollWidth <= de420.clientWidth + 1,
            de420.scrollWidth + "px of content in " + de420.clientWidth + "px");
      frame900.style.width = wide900;
      // And the meter is really the tall thing being reserved for, so the
      // check above is guarding something rather than comparing two short
      // headers that happen to match.
      check("and the reservation is what makes that true, not a coincidence",
            usageStates.reading.header >= 70,
            "header is " + usageStates.reading.header + "px with a reading");
    }
  }

  // 14 - the key is reachable, and named rather than identified by a glyph.
  var keyBtn = doc.getElementById("keyhelp");
  check("the map key is behind a named control",
        !!keyBtn && !!keyBtn.getAttribute("aria-label"),
        keyBtn ? "no aria-label" : "#keyhelp missing");
  if (keyBtn) {
    keyBtn.click();
    var km = doc.getElementById("keymodal");
    check("and it opens on demand", !!km && km.open,
          km ? "did not open" : "#keymodal missing");
    if (km && km.open) { km.close(); }
  }
}

// The table view, checked for the properties it shares with the map rather
// than re-checking the map's own layout: the gauge is one instrument built by
// two renderers, and "both renderers draw all of it" is the property.
function runTable(doc, win) {
  var gaugesEl = doc.getElementById("gauges");
  if (!gaugesEl || !win.renderGauges || !win.CCWATCH_USAGE) {
    bad("the table view's usage meter is on the page",
        "missing: " + [!gaugesEl && "#gauges", !win.renderGauges && "renderGauges",
                       !win.CCWATCH_USAGE && "CCWATCH_USAGE"].filter(Boolean).join(", "));
    return;
  }
  var nowSec = Date.now() / 1000;
  win.renderGauges({
    age: 0, stale_after: 600,
    five_hour: {used_percentage: 78, resets_at: nowSec + 4 * 3600},
    seven_day: {used_percentage: 12, resets_at: nowSec + 4 * 86400},
    seven_day_opus: {used_percentage: 3},
  });
  var gauges = [].slice.call(gaugesEl.querySelectorAll(".g-gauge"));
  check("the table view draws a gauge for every window too",
        gauges.length === 3, gauges.length + " of 3");
  if (gauges.length === 0) { return; }
  // ⚠️ The check the missing `appendChild` would have failed. A gauge is the
  // numbers AND the bars: bars under no name and no percentage are an
  // instrument with its scale cut off.
  var first = gauges[0];
  var headText = (first.querySelector(".g-head") || {textContent: ""}).textContent || "";
  check("and each carries the window's name and both percentages above its bars",
        headText.indexOf("5h") !== -1 && headText.indexOf("78%") !== -1
          && headText.indexOf("20%") !== -1,
        JSON.stringify(headText));
  var hb = boxOf(first.querySelector(".g-head"));
  check("with that head actually rendered, not built and left off the page",
        hb.w > 0 && hb.h > 0 && onScreen(hb, doc.documentElement.clientWidth,
                                         doc.documentElement.clientHeight),
        Math.round(hb.w) + "x" + Math.round(hb.h));
  var usedBar = first.querySelector(".g-used"), timeBar = first.querySelector(".g-time");
  check("and both bars, to one scale",
        !!usedBar && !!timeBar
          && Math.abs(boxOf(usedBar).w - boxOf(timeBar).w) <= 1,
        usedBar && timeBar
          ? Math.round(boxOf(usedBar).w) + "px vs " + Math.round(boxOf(timeBar).w) + "px"
          : "a bar is missing");
  if (usedBar && timeBar) {
    var uw = boxOf(usedBar.firstChild).w / boxOf(usedBar).w * 100;
    var tw = boxOf(timeBar.firstChild).w / boxOf(timeBar).w * 100;
    check("drawn at the percentages they report",
          Math.abs(uw - 78) <= 2 && Math.abs(tw - 20) <= 2,
          Math.round(uw) + "% / " + Math.round(tw) + "%");
  }
  // The same reservation, on the page whose gauge head went missing for want
  // of anybody looking at it in a browser.
  var tHeader = doc.querySelector("header");
  var tShapes = [];
  [[ "reading", {age: 0, stale_after: 600,
                 five_hour: {used_percentage: 78, resets_at: nowSec + 4 * 3600},
                 seven_day: {used_percentage: 12, resets_at: nowSec + 4 * 86400},
                 seven_day_opus: {used_percentage: 3}}],
   ["stale", {age: 9999, stale_after: 600, five_hour: {used_percentage: 78}}],
   ["absent", null]].forEach(function (pair) {
    win.renderGauges(pair[1]);
    tShapes.push(Math.round(boxOf(tHeader).h));
  });
  check("a withheld usage reading does not move the table either",
        tShapes.every(function (h) { return h === tShapes[0]; }),
        "header heights: " + tShapes.join(","));

  check("the table view's alert control is a control, not a banner in the flow",
        !!doc.getElementById("alertslot") && !!doc.getElementById("alertmodal")
          && !doc.getElementById("hostwarn"),
        "#hostwarn present: " + !!doc.getElementById("hostwarn"));
}

document.getElementById("frame").addEventListener("load", function () {
  var f = document.getElementById("frame");
  var doc = f.contentDocument, win = f.contentWindow;
  // The server has already published a snapshot, but the roster and the board
  // settle over a frame or two. A figure existing is the signal; the timeout is
  // the honest failure if it never arrives, rather than a set of checks that
  // quietly measure an empty page and pass.
  var waited = 0;
  (function settle() {
    var list = doc.getElementById("rosterlist");
    var ready = doc.querySelector("#boardinner .agent[data-sid]") && list && list.children.length > 0;
    if (ready || waited > 8000) {
      if (!ready) { bad("the map rendered at all", "no figures after 8s - see the server log"); }
      try { run(doc, win); } catch (e) { bad("the harness ran without throwing", e && e.message); }
      // The table view second, into the same output, so one run covers both
      // renderers of the shared instrument. `done()` moves here: it publishes
      // the results, and publishing before the second frame has been read
      // would report a pass for checks that never ran.
      var f2 = document.getElementById("frame2");
      var waited2 = 0;
      (function settle2() {
        var d2 = f2.contentDocument, w2 = f2.contentWindow;
        var ready2 = d2 && d2.getElementById("gauges") && w2 && w2.CCWATCH_USAGE;
        if (ready2 || waited2 > 8000) {
          if (!ready2) { bad("the table view rendered at all", "no #gauges after 8s"); }
          else {
            try { runTable(d2, w2); }
            catch (e) { bad("the table harness ran without throwing", e && e.message); }
          }
          done();
          return;
        }
        waited2 += 250;
        setTimeout(settle2, 250);
      })();
      return;
    }
    waited += 250;
    setTimeout(settle, 250);
  })();
});
</script>
CCWATCH_HARNESS_EOF
}

cmd_verify_ui() {
  local port="" shots="" keep=0 vw=1280 vh=900
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)  port="${2:-}"; shift 2 || exit 3;;
      --shots) shots="${2:-}"; shift 2 || exit 3;;
      --size)  vw="${2%%x*}"; vh="${2##*x}"; shift 2 || exit 3;;
      --keep)  keep=1; shift;;
      -h|--help)
        say "usage: ccwatch verify-ui [--port N] [--shots DIR] [--size WxH] [--keep]"
        return 0;;
      *) err "unknown option: $1"; return 3;;
    esac
  done

  local chrome
  chrome=$(find_chrome)
  if [ -z "$chrome" ]; then
    # A host that cannot supply what a check needs is skipped with the reason,
    # never failed. A red result meaning "this machine has no Chrome" costs the
    # same attention as a real regression.
    say "${_c_yellow}-${_c_reset} verify-ui skipped: no Chrome or Chromium found"
    printf '  %s\n' "set CCWATCH_CHROME=/path/to/chrome to point at one" >&2
    return 0
  fi

  local root work
  root=$(cd -- "$(dirname -- "$(resolved_self)")/.." && pwd)
  work=$(mktemp -d "${TMPDIR:-/tmp}/ccwatch-verify.XXXXXX") || { err "mktemp failed"; return 1; }
  # ⚠️ NOT a local. The trap body is evaluated when the trap fires, which for
  # EXIT is after this function has already returned — a local is gone by then,
  # and under `set -u` the trap died with "vport: unbound variable" instead of
  # reaping the server it exists to reap. A cleanup that fails silently at the
  # moment it is needed is worse than none, because the leak it was meant to
  # prevent is the thing that then goes unnoticed.
  VERIFY_PORT=""
  # Reaped on every exit path including interruption: a leaked server holds a
  # port a later run may pick, which cost 1686 orphaned processes once already.
  # shellcheck disable=SC2064
  trap "if [ -n \"\${VERIFY_PORT:-}\" ]; then pkill -f \"ccwatch serve --port \${VERIFY_PORT}\" 2>/dev/null; fi; if [ $keep -eq 0 ]; then rm -rf '$work'; fi" EXIT INT TERM HUP

  mkdir -p "$work/web" "$work/profile"
  cp "$root/web/"*.html "$work/web/" 2>/dev/null || true
  cp "$root/web/"*.js "$work/web/" 2>/dev/null || true
  write_verify_harness "$work/web/verify.html" || { err "could not write the harness"; return 1; }

  VERIFY_PORT="${port:-$(free_verify_port)}"
  [ -n "$VERIFY_PORT" ] || { err "no free port for the verification server"; return 1; }

  CCWATCH_WEB="$work/web" "$root/bin/ccwatch" serve --port "$VERIFY_PORT" >"$work/serve.log" 2>&1 &
  local i=0 ready=""
  while [ "$i" -lt 90 ]; do
    ready=$(curl -s --max-time 3 "http://127.0.0.1:$VERIFY_PORT/api/state" 2>/dev/null \
            | jq -r '[.warming == false, (.collected_at.snapshot != null)] | all' 2>/dev/null)
    [ "$ready" = "true" ] && break
    sleep 1; i=$((i + 1))
  done
  if [ "$ready" != "true" ]; then
    err "the verification server never published a snapshot"
    printf '  %s\n' "see $work/serve.log" >&2
    return 1
  fi

  say "${_c_bold}verify-ui${_c_reset} ${_c_dim}— ${vw}x${vh}, 127.0.0.1:$VERIFY_PORT${_c_reset}"

  # ⚠️ Chrome writes the DOM and then does NOT exit — `--headless=new` with a
  # `--user-data-dir` lingers, and the first run of this command hung for
  # minutes with a complete dom.html already on disk. macOS has no `timeout`,
  # so the wait is explicit: run it in the background, wait for the harness's
  # closing tag to appear, then reap it. A bounded wait that fails loudly beats
  # an unbounded one that looks like work.
  # ⚠️ --force-prefers-reduced-motion is load-bearing, not cosmetic.
  # `--virtual-time-budget` fast-forwards timers, but a smooth scroll is driven
  # by the compositor's real animation frames, which virtual time does not
  # advance — so `scrollIntoView({behavior: "smooth"})` never progresses and
  # `scrollTop` stays exactly where it was. Measured: smooth moved 0 -> 0 after
  # a 900ms wait while `behavior: "auto"` moved 0 -> 346 on the same page.
  # Forcing reduced motion makes the page take its own instant path, which is
  # a configuration real users have, and makes the reveal check deterministic
  # instead of a timing race the environment cannot win. The harness asserts
  # the flag took effect, so dropping it fails loudly rather than silently
  # turning that check into a no-op.
  "$chrome" --headless=new --disable-gpu --no-first-run --no-default-browser-check \
    --user-data-dir="$work/profile" --window-size="$vw,$vh" \
    --force-prefers-reduced-motion \
    --virtual-time-budget=20000 --dump-dom \
    "http://127.0.0.1:$VERIFY_PORT/verify.html" >"$work/dom.html" 2>/dev/null &
  local chrome_pid=$! waited=0
  while [ "$waited" -lt 60 ]; do
    grep -q '</pre>' "$work/dom.html" 2>/dev/null && break
    kill -0 "$chrome_pid" 2>/dev/null || break
    sleep 1; waited=$((waited + 1))
  done
  kill "$chrome_pid" 2>/dev/null
  wait "$chrome_pid" 2>/dev/null || true

  local results
  results=$($CCWATCH_PY -c 'import io, re, sys, html
raw = io.open(sys.argv[1], encoding="utf-8", errors="replace").read()
m = re.search(r"<pre id=\"verify-out\">(.*?)</pre>", raw, re.S)
sys.stdout.write(html.unescape(m.group(1)) if m else "")' "$work/dom.html")

  if [ -z "$results" ]; then
    err "the harness produced no results — the page never ran"
    printf '  %s\n' "re-run with --keep and open $work/web/verify.html by hand" >&2
    return 1
  fi

  # A skipped check is reported as skipped, never counted as a pass: "there was
  # nothing to test" and "the thing under test worked" are different facts, and
  # a check that says the second when it means the first is how two checks here
  # stayed green against implementations that had the bug.
  local pass=0 fail=0 skipped=0 line name detail
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    name=${line#*|}; name=${name%%|*}
    detail=${line##*|}
    case "$line" in
      PASS\|*) pass=$((pass + 1)); say "  ${_c_green}✓${_c_reset} $name";;
      SKIP\|*) skipped=$((skipped + 1))
               say "  ${_c_yellow}-${_c_reset} $name ${_c_dim}(skipped: $detail)${_c_reset}";;
      FAIL\|*) fail=$((fail + 1))
               say "  ${_c_red}✗${_c_reset} $name"
               [ -n "$detail" ] && printf '      %s\n' "$detail" >&2;;
      *)       fail=$((fail + 1)); say "  ${_c_yellow}?${_c_reset} unparsed: $line";;
    esac
  done <<EOF
$results
EOF

  # ⚠️ Screenshots are written every run, not on request, and that is the point:
  # a change under web/ that nobody looked at leaves a stale image next to a
  # newer page, which is visible. The suite checks their freshness.
  if [ -n "$shots" ]; then
    mkdir -p "$shots"
    local p
    # A screenshot is only evidence if this run wrote it; see the check below.
    # The sleep is because `-nt` compares whole seconds under bash 3.2, and a
    # shot written in the marker's own second would read as not newer.
    : > "$work/shots-started"; sleep 1
    for p in map ""; do
      # ⚠️ Remove the old image first. The wait below ends on `-s`, and a file
      # left by the previous run is already non-empty, so it broke at once
      # and signalled a Chrome that had barely started. Either it died before
      # writing, and the run reported "screenshots:" over images a day old
      # while the page they were meant to show had changed, or it ignored
      # the TERM and `wait` sat on it for ten minutes — both measured.
      rm -f "$shots/${p:-table}.png"
      "$chrome" --headless=new --disable-gpu --no-first-run --no-default-browser-check \
        --user-data-dir="$work/profile" --window-size="$vw,$vh" \
        --virtual-time-budget=12000 --hide-scrollbars \
        --screenshot="$shots/${p:-table}.png" \
        "http://127.0.0.1:$VERIFY_PORT/$p" >/dev/null 2>&1 &
      local shot_pid=$! sw=0
      while [ "$sw" -lt 45 ]; do
        [ -s "$shots/${p:-table}.png" ] && break
        kill -0 "$shot_pid" 2>/dev/null || break
        sleep 1; sw=$((sw + 1))
      done
      kill "$shot_pid" 2>/dev/null
      wait "$shot_pid" 2>/dev/null || true
      if [ "$shots/${p:-table}.png" -nt "$work/shots-started" ]; then
        pass=$((pass + 1)); say "  ${_c_green}✓${_c_reset} the ${p:-table} screenshot was written by this run"
      else
        fail=$((fail + 1)); say "  ${_c_red}✗${_c_reset} the ${p:-table} screenshot was written by this run"
        printf '      %s\n' "$shots/${p:-table}.png is missing or older than this run" >&2
      fi
    done
    say "${_c_dim}screenshots: $shots${_c_reset}"
  fi

  printf '\n%s checked, %s failed' "$((pass + fail))" "$fail"
  [ "$skipped" -gt 0 ] && printf ', %s skipped' "$skipped"
  printf '\n'
  [ "$fail" -eq 0 ] || return 1
  return 0
}

# ============================================================== doctor ======
#
# This is the load-bearing command for the "nothing fails silently" promise.
# ccwatch reads an internal file layout, so a Claude Code upgrade could change it
# under us. The failure mode that must never happen is an EMPTY, CONFIDENT table
# — so doctor cross-checks our own parse against the supported `claude agents
# --json` and reports disagreement as a defect in ccwatch, not in your sessions.

cmd_doctor() {
  local problems=0
  ok()   { printf '  %s+%s %s\n' "$_c_green" "$_c_reset" "$*"; }
  bad()  { printf '  %sx%s %s\n' "$_c_red" "$_c_reset" "$*"; problems=$((problems + 1)); }
  meh()  { printf '  %s~%s %s\n' "$_c_yellow" "$_c_reset" "$*"; }

  say "${_c_bold}ccwatch doctor${_c_reset} ${_c_dim}(ccwatch v$CCWATCH_VERSION)${_c_reset}"
  say ""

  # The platform/probe block (FR-014, contracts/probe-layer.md "What doctor
  # must print"): every probe appears, including the healthy ones, because
  # the question this answers is "which probes produced this view" and a
  # report listing only problems cannot answer it.
  say "platform"
  platform_detect
  ok "platform: $CCWATCH_PLATFORM ($CCWATCH_UNAME)"
  if [ -n "$CCWATCH_PY" ]; then
    ok "python: $CCWATCH_PY ($($CCWATCH_PY --version 2>&1))"
  else
    bad "python: none found (python3, python, or py -3)"
  fi
  if [ "$CCWATCH_PLATFORM" = windows ]; then
    if [ -n "$CCWATCH_BASH" ]; then
      ok "bash: $CCWATCH_BASH"
    else
      bad "bash: no verified MSYS/MINGW/Cygwin bash found"
    fi
    meh "send/kill/peers: not available on Windows — this needs POSIX signals and the per-session Unix socket"
    meh "serve: read-only on Windows for the same reason — write endpoints refuse"
  fi
  # Exercise every probe once so the report has one row per probe.
  probe_proc "" >/dev/null
  probe_mtimes "$PROJ_DIR" -maxdepth 2 >/dev/null
  probe_clock "$(date '+%s')" >/dev/null
  probe_host >/dev/null
  local pname pimpl poutcome preason pdetail
  while IFS=$'\t' read -r pname pimpl poutcome preason pdetail; do
    [ -n "$pname" ] || continue
    case "$poutcome" in
      ok)     ok "$(printf '%-9s %-18s ok' "$pname" "$pimpl")${preason:+  $preason}" ;;
      absent) meh "$(printf '%-9s %-18s absent' "$pname" "$pimpl")${preason:+  $preason}" ;;
      failed) bad "$(printf '%-9s %-18s failed' "$pname" "$pimpl")${preason:+  $preason}${pdetail:+ ($pdetail)}" ;;
      *)      bad "$pname: unrecognised probe outcome '$poutcome' — never fell through a default silently" ;;
    esac
  done < <(probe_report)
  say ""

  for t in jq awk ps date stat find; do
    command -v "$t" >/dev/null 2>&1 && ok "$t found" || bad "$t is missing — ccwatch cannot run"
  done

  say ""
  if [ -d "$SESS_DIR" ]; then
    local nfiles
    nfiles=$(find "$SESS_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | wc -l | tr -d ' ')
    ok "registry at $SESS_DIR ($nfiles file(s))"
  else
    bad "no registry at $SESS_DIR — is this the right CLAUDE_CONFIG_DIR?"
  fi
  [ -d "$PROJ_DIR" ] && ok "transcripts at $PROJ_DIR" \
    || bad "no transcripts at $PROJ_DIR — resume cannot work"

  # Schema check. Missing keys mean our reader has drifted from the format.
  say ""
  local sessions_obj sessions probe pf
  sessions_obj=$(collect_sessions)
  sessions=$(printf '%s' "$sessions_obj" | jq -c '.rows')
  pf=$(printf '%s' "$sessions_obj" | jq -r '.parse_failed // 0')
  [ "$pf" -gt 0 ] && meh "$pf registry file(s) would not parse (a session mid-write does this; persistent means trouble)"
  # The union of keys across all sessions, not the keys of one: most fields are
  # optional per session (an SDK session has no `status`), so testing a single
  # entry reports absences that are not defects.
  probe=$(printf '%s' "$sessions" | jq -r '
    if length == 0 then "empty"
    else ( ["pid","cwd","sessionId","startedAt"] - ([ .[] | keys[] ] | unique) | join(",") )
    end' 2>/dev/null)
  if [ "$probe" = "empty" ]; then
    meh "registry parsed to zero sessions — expected if no Claude Code is running"
  elif [ -n "$probe" ]; then
    bad "registry is missing expected field(s): $probe — ccwatch needs updating"
  else
    ok "registry schema looks right (pid, cwd, sessionId, startedAt)"
  fi
  local unknown
  unknown=$(printf '%s' "$sessions" | jq -r '
    [ .[].status // empty ] | map(select(. as $s | ["busy","shell","idle","waiting"] | index($s) | not))
    | unique | join(",")')
  [ -n "$unknown" ] \
    && bad "unrecognised status value(s): $unknown — ccwatch does not know how to classify these" \
    || ok "all status values are ones ccwatch understands"

  # The cross-check. Two independent readers of the same truth must agree.
  say ""
  if command -v claude >/dev/null 2>&1; then
    local theirs ours
    theirs=$(claude agents --json 2>/dev/null | jq -r '[.[].sessionId] | sort | join(",")' 2>/dev/null)
    ours=$(snapshot | jq -r '[.sessions[].sid] | sort | join(",")')
    if [ -z "$theirs" ] && [ -z "$ours" ]; then
      meh "both ccwatch and 'claude agents --json' see no live sessions"
    elif [ "$theirs" = "$ours" ]; then
      ok "agrees with 'claude agents --json' exactly"
    else
      bad "DISAGREES with 'claude agents --json' — ccwatch's view is not trustworthy"
      printf '      %sonly claude sees:%s %s\n' "$_c_dim" "$_c_reset" \
        "$(comm -13 <(tr ',' '\n' <<<"$ours" | sort) <(tr ',' '\n' <<<"$theirs" | sort) | tr '\n' ' ')"
      printf '      %sonly ccwatch sees:%s  %s\n' "$_c_dim" "$_c_reset" \
        "$(comm -23 <(tr ',' '\n' <<<"$ours" | sort) <(tr ',' '\n' <<<"$theirs" | sort) | tr '\n' ' ')"
    fi
  else
    meh "'claude' not on PATH — skipping the cross-check that would catch a format change"
  fi

  # Hooks: without them, a prompt that opens and closes between polls is lost.
  say ""
  local hp
  hp=$(collect_host | jq -r 'if . == null then "?" else "\(.swap_used_pct)|\(.ram_free_mb)" end' 2>/dev/null)
  case "$hp" in
    "?"|"") meh "could not read host memory state";;
    *) local swp="${hp%%|*}" freem="${hp##*|}"
       # swp is the literal string "null" on a platform with no pagefile
       # (D15) — arithmetic on it must never run, or be silently treated as
       # 0%, which claims a measurement ccwatch never took (FR-012).
       if [ "$swp" = "null" ]; then
         meh "swap usage unavailable on this host (${freem}MB RAM free)"
       elif [ "$swp" -ge "$CCWATCH_SWAP_WARN" ]; then
         bad "host under memory pressure — swap ${swp}% used, ${freem}MB RAM free"
         printf '      %sthe OS kills processes in this state, and a killed session%s\n' "$_c_dim" "$_c_reset"
         printf '      %slooks identical to a clean exit. Check: ccwatch resume%s\n' "$_c_dim" "$_c_reset"
       else
         ok "host memory is fine (swap ${swp}% used, ${freem}MB RAM free)"
       fi;;
  esac

  say ""
  # ⚠️ Every reporter, with its figure and its age, because "why does the
  # percentage jump" is a real question with a non-obvious answer: Claude Code
  # does not refetch the rate limit on every statusline repaint, so each
  # session carries its own last-known value and they can be minutes apart.
  # ccwatch takes the HIGHEST for the current window — within a window usage
  # only climbs, so the largest reading is the freshest — and this is where you
  # can see that being done rather than take it on trust.
  local udis
  udis=$(collect_usage)
  if [ -n "$udis" ] && [ "$udis" != "null" ] && [ -d "$USAGE_DIR" ]; then
    local nrep
    nrep=$(printf '%s' "$udis" | jq -r '.reporters // 0')
    if [ "${nrep:-0}" -gt 1 ]; then
      local usedpct
      usedpct=$(printf '%s' "$udis" | jq -r '(.five_hour.used_percentage // "none") | if type == "number" then (.|floor|tostring) + "%" else . end')
      ok "$nrep sessions report usage; using the freshest 5h figure ($usedpct)"
      local uf ufsid ufpct ufage ufres
      for uf in "$USAGE_DIR"/*.json; do
        [ -f "$uf" ] || continue
        ufsid=$(jq -r '.session // "?"' "$uf" 2>/dev/null)
        ufpct=$(jq -r '(.five_hour.used_percentage // "none") | if type == "number" then (.|floor|tostring) + "%" else . end' "$uf" 2>/dev/null)
        ufage=$(jq -r --argjson now "$(date '+%s')" '($now - (.at // 0))' "$uf" 2>/dev/null)
        ufres=$(jq -r '.five_hour.resets_at // "-"' "$uf" 2>/dev/null)
        printf '        %s  5h %-6s written %ss ago, window resets %s\n' \
          "$(printf '%.8s' "$ufsid")" "$ufpct" "$ufage" "$ufres"
      done
      printf '      %sdifferent figures for the same resets_at are caches of one counter,%s\n' \
        "$_c_dim" "$_c_reset"
      printf '      %snot a conflict. A different resets_at is a window that has rolled.%s\n' \
        "$_c_dim" "$_c_reset"
    fi
  fi
  if [ -f "$USAGE_FILE" ]; then
    local uage
    uage=$(jq -r --argjson now "$(date '+%s')" '($now - (.at // 0))' "$USAGE_FILE" 2>/dev/null) || uage=999999
    if [ "${uage:-999999}" -le "$CCWATCH_USAGE_STALE" ]; then
      ok "usage feed is live (${uage}s old)"
    else
      meh "usage feed has not reported in ${uage}s — the numbers are being withheld"
      printf '      %sis your statusline still running? re-run: ccwatch install-statusline%s\n' \
        "$_c_cyan" "$_c_reset"
    fi
  else
    meh "no usage feed — run: ccwatch install-statusline (rate limits and context will be blank)"
  fi

  say ""
  if [ -f "$CLAUDE_HOME/settings.json" ] \
     && jq -e '[ .hooks // {} | .[]? | .[]? | .hooks[]?.command? // "" ] | map(contains("ccwatch hook")) | any' \
        "$CLAUDE_HOME/settings.json" >/dev/null 2>&1; then
    ok "hooks installed"
    if [ -f "$EVENTS" ]; then
      ok "event log has $(wc -l <"$EVENTS" | tr -d ' ') entr(ies)"
    else
      meh "no events recorded yet — hooks apply to sessions started after install"
    fi
  else
    meh "hooks NOT installed — a prompt that opens and closes between polls will be missed"
    printf '      %srun: ccwatch install-hooks%s\n' "$_c_cyan" "$_c_reset"
  fi

  say ""
  [ "$problems" -eq 0 ] \
    && say "${_c_green}No problems found.${_c_reset}" \
    || { say "${_c_red}$problems problem(s) found.${_c_reset}"; return 1; }
}

# ============================================================== watch =======

cmd_watch() {
  # Without a TTY there is nothing to repaint, so print once and exit. That
  # makes `ccwatch` safe in a pipe, a cron job or a status bar.
  if [ ! -t 1 ]; then
    render "$(snapshot)"
    return 0
  fi
  local hide_cursor=$'\033[?25l' show_cursor=$'\033[?25h'
  # shellcheck disable=SC2064
  trap "printf '%s' '$show_cursor'; cleanup; exit 0" INT TERM
  printf '%s' "$hide_cursor"
  while :; do
    local snap out
    snap=$(snapshot)
    out=$(render "$snap")
    # Painted in one write after the frame is fully built, so the table never
    # flickers half-drawn.
    printf '\033[H\033[2J%s\n%s\n' "$out" \
      "${_c_dim}$(date '+%H:%M:%S') · every ${CCWATCH_REFRESH}s · q/Ctrl-C to quit${_c_reset}"
    # read -t doubles as the sleep and as the keypress check, so quitting is
    # instant rather than up to one refresh away.
    local key=""
    if read -r -t "$CCWATCH_REFRESH" -n 1 key 2>/dev/null; then
      case "$key" in
        q|Q) break;;
      esac
    fi
  done
  printf '%s' "$show_cursor"
}

# ============================================================== usage =======

usage() {
  cat <<'EOF'
ccwatch — every Claude Code session on this machine, and which one is stuck

USAGE
  ccwatch                    live table, refreshed until you quit (q / Ctrl-C)
  ccwatch once               draw the table once and exit
  ccwatch --json             the same data as JSON, for scripting

  ccwatch ask [<who>]        what each blocked session is actually asking —
                           the question and every option, from its transcript
  ccwatch convo [-n N] <who>  the recent conversation of one session. Tool
                           results are reduced to a size, never their contents.

  ccwatch send <who> <msg>   put a message into a session that is ALREADY
                           running, and watch its transcript to confirm arrival
        --dry-run          print the exact frames instead of sending them
  ccwatch revive             watch for agents that stopped when they should not
                           have, and say what you would have typed: "retry"
                           after an API error once the API answers again,
                           "continue" after a session limit resets, and "are
                           you actually done?" to one that paused mid-roadmap
        --dry-run          say what it would send, and send nothing
        --once             one pass, then exit
        --json             one pass, as JSON. Sends nothing unless --send
        --enable           turn it on for `ccwatch serve`, which then runs it
                           every minute whether or not a page is open. The
                           same switch as the one in the page header
        --disable / --status
  ccwatch peers [--days N]   which sessions have been talking to each other
  ccwatch kill <who>         stop a session with SIGTERM, never SIGKILL. The
                           transcript survives, and the resume command is
                           printed. Refuses a session mid-turn or mid-phase
        --force            stop it anyway
        -y                 skip the confirmation

  ccwatch bar                the same verdicts as one line for a macOS menu bar
                           item, in SwiftBar/xbar plugin format
        --title            just the title line, for any other status bar
        --no-actions       status only, for a host with its own menu verbs
  ccwatch serve              table + map in a browser (127.0.0.1 only)
        --stop             stop every serve this machine recorded, by pid
        --open             open it once it is up
        --port N           default 8787
        --read-only        drop the send endpoint and serve no token

  ccwatch resume [-n N]      what to reopen after a crash or reboot, plus the
                           last known roster of what was live
        --cd               print a `cd <dir> && claude --resume` you can paste
        --all              ignore the recency window

  ccwatch deploys            deploy runs in flight, and concluded in the last 24h
  ccwatch subscribe <wf>     (run BY an agent, in its own session) tell me when
                           a matching deploy finishes
  ccwatch unsubscribe <wf>   the reverse
  ccwatch subs               current subscriptions
  ccwatch daemon             watch deploys and notify subscribers while you are
                           away

  ccwatch log [N]            recent hook events (needs install-hooks)
  ccwatch setup              put ccwatch on your PATH and say what is left to
                           do. Run it once, from the checkout.
        --bin-dir DIR      install the symlink here instead of choosing
  ccwatch install-hooks      record "needs your input" events, so a prompt that
                           opens and closes between polls is never lost
  ccwatch install-statusline  wrap your statusline to report rate limits and
                           context fill. Wraps, does not replace.
  ccwatch doctor             check that ccwatch's own view is trustworthy
  ccwatch verify-ui          render the pages in a browser and check what they look like
  ccwatch -h | --version

  <who> is a session name, a session id, or a pid. Names must match whole; a
  session id may be given as a prefix of 8 or more characters. Anything that
  matches more than one live session is refused with the candidates listed,
  never resolved by picking — the wrong agent has already been told.

STATUS COLUMN
  * waiting        blocked on you. LAST says on what, and for how long.
  ! HUNG?          says busy, but its transcript has stopped growing.
  ! HUNG!!         the same, past 3x the threshold.
  ! SDK STALE?     headless session, publishes no status, gone quiet.
  ! NO TRANSCRIPT  claims to be working with nothing to corroborate it.
  + busy / sdk     working, and the transcript proves it.
  ~ sdk-ts         an embedded-SDK session. Publishes no status and writes no
                   transcript, so only CPU can speak for it — deliberately
                   never escalated to a hang, because a session waiting on its
                   host program is quiet by design.
  ~ shell          dropped to a shell.
  - idle           waiting for a prompt, nothing pending.

  A `busy` row is never trusted on its own: the LAST column always shows the
  measurement behind the verdict, because one long-running Bash call is
  legitimately silent and only you can tell those apart.

PIPELINE SUB-ROWS
  Under a session that ran a spec-run phase: which feature, which phase, on
  what model, and what the run has cost. Attached by session id, so it names
  the run this session actually drove rather than every run in the directory.

    plan/CRASHED     the phase is still marked `running` but its runner is
                     gone. Lost work, and nothing else reports it until the
                     next spec-run invocation reconciles the state file.
    plan/needs_input the phase stopped to ask you something.

  A session's own status and its run's status are kept separate on purpose: a
  session can be honestly idle while the run it drove has crashed.

ENVIRONMENT
  CCWATCH_BUSY_STALE   seconds of transcript silence before `busy` is
                     suspect (default 600)
  CCWATCH_SDK_STALE    the same for headless sessions (default 900)
  CCWATCH_REFRESH      seconds between repaints (default 2)
  CCWATCH_RESUME_DAYS  how far back `ccwatch resume` looks (default 14)
  CCWATCH_UNFINISHED_HOURS
                     how recent an unfinished run must be to appear in the
                     live table (default 24) — older ones are counted, and
                     listed by `ccwatch resume`
  CCWATCH_HOME         where the event log lives (default ~/.claude/ccwatch)
  CLAUDE_CONFIG_DIR  which Claude Code config directory to read
  NO_COLOR           set to disable colour

  CCWATCH_PLATFORM   override platform detection (macos/windows/unsupported)
                     — the seam the test suite uses to exercise both
                     platforms' probes from either host
  CCWATCH_PY         override the resolved python interpreter (python3,
                     python, or "py -3")
  CCWATCH_BASH       Windows only: override the verified MSYS/Git bash,
                     passed to `serve`'s subprocess calls
EOF
}

# =============================================================== setup ======
#
# `ccwatch setup` — put the tool on PATH, then say what is left to do.
#
# What this does NOT do is install anything on your behalf beyond one symlink.
# `install-hooks` and `install-statusline` each show their exact change and ask
# first, and duplicating that consent here would mean two places to keep honest;
# the SwiftBar plugin is a symlink into a directory this has no business
# guessing at. So setup does the one step that is fiddly and prints the rest.
#
# The fiddly step is choosing where the symlink goes. The README said
# /usr/local/bin for a long time, which on a stock Apple Silicon machine is
# root-owned — so the documented install ended in `Permission denied` and the
# reader's next move was `sudo`, which puts a root-owned symlink to a file in
# their home directory on PATH. `~/.local/bin` is preferred here because it
# needs no privileges, and whether it is on PATH is checked rather than assumed.
setup_bin_dir() {
  local d
  # ⚠️ Ordered by how little damage a mistake does, not by convention.
  # ~/.local/bin is per-user and needs no sudo; the Homebrew and /usr/local
  # directories are shared, so they are only used when already writable.
  for d in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin; do
    if [ -d "$d" ] && [ -w "$d" ]; then printf '%s' "$d"; return 0; fi
  done
  # Nothing writable existed. Creating the per-user one is the only option that
  # does not need privileges, and it is the one the reader can undo.
  if mkdir -p "$HOME/.local/bin" 2>/dev/null; then
    printf '%s' "$HOME/.local/bin"; return 0
  fi
  return 1
}

cmd_setup() {
  local bindir="" self link cur reply
  while [ $# -gt 0 ]; do
    case "$1" in
      --bin-dir) bindir="${2:-}"; shift 2 || exit 3;;
      *) die "setup: unrecognised argument '$1'" \
             "usage: ccwatch setup [--bin-dir DIR]";;
    esac
  done

  self=$(resolved_self)
  say "${_c_bold}ccwatch $CCWATCH_VERSION${_c_reset} ${_c_dim}$self${_c_reset}"
  say ""

  # --- what is present, and what that costs when it is not -----------------
  # jq and awk are already guaranteed: `need` runs for both before dispatch,
  # so this cannot be reached without them. The rest degrade rather than fail,
  # and each line says what is lost so an absence is never just an absence.
  local missing=0
  if command -v python3 >/dev/null 2>&1; then
    say "  ${_c_green}✓${_c_reset} python3      ${_c_dim}$(python3 --version 2>&1)${_c_reset}"
  else
    say "  ${_c_red}x${_c_reset} python3      ${_c_dim}no dashboard, no send, no date parsing${_c_reset}"
    missing=$((missing + 1))
  fi
  if command -v git >/dev/null 2>&1; then
    say "  ${_c_green}✓${_c_reset} git         ${_c_dim}repository names come from the git remote${_c_reset}"
  else
    say "  ${_c_yellow}!${_c_reset} git         ${_c_dim}absent — every session shows as 'no repo'${_c_reset}"
  fi
  if command -v gh >/dev/null 2>&1; then
    say "  ${_c_green}✓${_c_reset} gh          ${_c_dim}deploy panel available${_c_reset}"
  else
    say "  ${_c_yellow}!${_c_reset} gh          ${_c_dim}absent — no deploy panel (brew install gh)${_c_reset}"
  fi
  say ""

  # --- the symlink ----------------------------------------------------------
  if [ -z "$bindir" ]; then
    bindir=$(setup_bin_dir) || die "no writable directory to install into" \
      "tried ~/.local/bin, /opt/homebrew/bin and /usr/local/bin — pass --bin-dir DIR"
  fi
  [ -d "$bindir" ] || mkdir -p "$bindir" 2>/dev/null \
    || die "cannot create $bindir"
  [ -w "$bindir" ] || die "$bindir is not writable" \
    "pass --bin-dir DIR, or make it writable — do NOT run this under sudo"

  link="$bindir/ccwatch"
  # ⚠️ A symlink, never a copy. The documented upgrade path is `git pull`, and
  # a copy silently stops receiving them — it would keep working, at whatever
  # version it was copied at, which is the worst way for this to be wrong.
  # It also matters for `serve`: bin/ccwatch finds web/ relative to its own
  # RESOLVED path, so a copy sitting alone in a bin directory cannot find the
  # pages at all.
  #
  # On Windows, `ln -s` can succeed and still not produce a symlink: without
  # admin rights or Developer Mode, MSYS silently falls back to copying the
  # target (D24). The result is checked with `-L`, not trusted from the exit
  # code — and when it is not a real symlink, a two-line shim that `exec`s the
  # checkout takes its place, so the same "never a copy" property holds by a
  # different mechanism.
  _ccwatch_setup_link() { # _ccwatch_setup_link <target> <link> <verb-for-a-fresh-link>
    local verb="${3:-linked}"
    rm -f "$2"
    if ln -s "$1" "$2" 2>/dev/null && [ -L "$2" ]; then
      say "${_c_green}✓${_c_reset} $verb ${_c_dim}$2 -> $1${_c_reset}"
      return 0
    fi
    rm -f "$2"
    { printf '#!/bin/sh\n'; printf 'exec "%s" "$@"\n' "$1"; } >"$2" \
      && chmod +x "$2" || die "could not create $2"
    say "${_c_green}✓${_c_reset} shimmed ${_c_dim}$2 -> $1${_c_reset} ${_c_dim}(no symlink support here)${_c_reset}"
  }
  if [ -L "$link" ]; then
    cur=$(readlink "$link")
    if [ "$cur" = "$self" ]; then
      say "${_c_green}✓${_c_reset} already linked ${_c_dim}$link${_c_reset}"
    else
      say "${_c_yellow}!${_c_reset} $link already points somewhere else:"
      say "    ${_c_dim}$cur${_c_reset}"
      printf 'Repoint it at this checkout? [y/N] '
      read -r reply
      case "$reply" in
        y|Y|yes|YES) _ccwatch_setup_link "$self" "$link" relinked;;
        *) say "Left alone. ${_c_dim}Nothing else here depends on it.${_c_reset}";;
      esac
    fi
  elif [ -e "$link" ] && ! grep -qF "$self" "$link" 2>/dev/null; then
    # Refused rather than overwritten: this is somebody else's file, possibly
    # another install of this tool, and clobbering it is not recoverable. The
    # grep exempts a shim this same command wrote last time.
    die "$link already exists and is not a symlink" \
        "move it aside, or pass --bin-dir DIR to install elsewhere"
  else
    _ccwatch_setup_link "$self" "$link"
  fi

  # ⚠️ Delivery is observed, not assumed. A symlink that exists proves nothing:
  # it can point at a path that has moved, a file without its executable bit,
  # or a checkout whose web/ is gone. So it is RUN, through the link, and the
  # version it reports is compared against the one doing the installing.
  local got
  got=$("$link" --version 2>/dev/null) || got=""
  if [ "$got" = "ccwatch $CCWATCH_VERSION" ]; then
    say "${_c_green}✓${_c_reset} runs through the link ${_c_dim}($got)${_c_reset}"
  elif [ -n "$got" ]; then
    warn "$link runs but reports '$got', not 'ccwatch $CCWATCH_VERSION'"
    say "  ${_c_dim}another checkout may be shadowing it${_c_reset}"
  else
    die "$link was created but does not run" \
        "is $self executable? try: chmod +x '$self'"
  fi

  # ⚠️ Stated, not guessed. An installer that says "installed" while the
  # directory is not on PATH has reported a success the reader cannot use, and
  # the symptom — `ccwatch: command not found` — reads as a failed install
  # rather than as one missing line of shell config.
  case ":$PATH:" in
    *":$bindir:"*) say "${_c_green}✓${_c_reset} $bindir is on your PATH";;
    *)
      say ""
      warn "$bindir is NOT on your PATH"
      say "  ${_c_dim}add this to your shell profile, then open a new terminal:${_c_reset}"
      say "    export PATH=\"$bindir:\$PATH\"";;
  esac

  say ""
  say "${_c_bold}Try it${_c_reset}"
  say "  ccwatch                    ${_c_dim}the live table${_c_reset}"
  say "  ccwatch doctor             ${_c_dim}check it can read what it needs${_c_reset}"
  say "  ccwatch serve --open       ${_c_dim}the same thing in a browser${_c_reset}"
  say ""
  say "${_c_bold}Optional, each asks first${_c_reset}"
  say "  ccwatch install-statusline ${_c_dim}report rate limits and context fill${_c_reset}"
  say "  ccwatch install-hooks      ${_c_dim}never miss a prompt between polls${_c_reset}"
  # The menu bar app, not the SwiftBar plugin it superseded: this line is the
  # last thing a new user reads, and it sent them to install a third-party host
  # for the fallback while the app sat unmentioned. Printed, not run — building
  # needs swiftc and writes /Applications, and both are the reader's call.
  # macOS only, because the app is.
  local appbuild
  appbuild=$(cd -- "$(dirname -- "$self")/.." && pwd)/app/build.sh
  if [ "$CCWATCH_PLATFORM" = macos ] && [ -f "$appbuild" ]; then
    say ""
    say "${_c_bold}Menu bar app${_c_reset} ${_c_dim}(needs Xcode Command Line Tools: xcode-select --install)${_c_reset}"
    say "  '$appbuild' --install --run"
  fi
  [ "$missing" -gt 0 ] && say "" && warn "$missing required tool(s) missing — see above"
  return 0
}

# ============================================================== dispatch ====

platform_detect
need jq "install with: brew install jq"
need awk

# ⚠️ The dispatch is ONE `{ ... }` block that ends in `exit`, and both halves
# are load-bearing. Bash reads a script incrementally and remembers a byte
# offset into the file; when it needs the next command it seeks back to that
# offset and reads the bytes that are there NOW. So a long-running command —
# `serve`, `watch`, `daemon` — plus an edit to this file while it runs means
# the read after that command lands at a stale offset in rewritten bytes. A
# `serve` started from one revision printed this on the way out, after the
# file had been committed over by another session:
#
#   ccwatch: line 5582: syntax error near unexpected token `)'
#   ccwatch: line 5582: `bscribe)       shift; cmd_subscribe "$@";;'
#
# Byte 281701 was the start of line 5582 as that process had counted the lines;
# in the new file it is four characters into the `subscribe)` line. Nothing was
# wrong with either revision — the named line is correct in both, and the token
# it quotes exists in neither — so it reads as a corrupt install of a tool
# whose whole job is to be believed about whether something is broken.
#
# Wrapped, bash must parse to the closing brace (the end of the file) before it
# runs any of this, and `exit` inside a command already parsed in full means it
# never reads the file again.
{
  case "${1:-}" in
    ''|watch)        cmd_watch;;
    once)            render "$(snapshot)";;
    --json)          snapshot;;
    resume)          shift; cmd_resume "$@";;
    hook)            shift; cmd_hook "$@";;
    log)             shift; cmd_log "${1:-30}";;
    setup)           shift; cmd_setup "$@";;
    install-hooks)   cmd_install_hooks;;
    statusline)      shift; cmd_statusline "$@";;
    install-statusline) cmd_install_statusline;;
    bar)             shift; cmd_bar "$@";;
    send)            shift; cmd_send "$@";;
    revive)          shift; cmd_revive "$@";;
    kill)          shift; cmd_kill "$@";;
    deploys)         shift; cmd_deploys "$@";;
    subscribe)       shift; cmd_subscribe "$@";;
    unsubscribe)     shift; cmd_unsubscribe "$@";;
    subs)            cmd_subs;;
    peers)           shift; cmd_peers "$@";;
    convo)           shift; cmd_convo "$@";;
    ask)             shift; cmd_ask "$@";;
    serve)           shift; cmd_serve "$@";;
    daemon)          cmd_daemon;;
    tick)            daemon_tick;;
    verify-ui)       shift; cmd_verify_ui "$@";;
    doctor)          cmd_doctor;;
    -h|--help|help)  usage;;
    --version)       say "ccwatch $CCWATCH_VERSION";;
    *) die "unrecognised command '$1'" "try: ccwatch --help";;
  esac
  exit $?
}
