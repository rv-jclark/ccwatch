#!/usr/bin/env bash
#
# ccwatch — every Claude Code session on this machine, and which one is stuck.
#
# Three questions this answers, in the order they cost you time:
#
#   1. Which session is blocked on me right now, and for how long?
#   2. Which session says it is working but has gone quiet — the silent hang?
#   3. After a reboot, which sessions was I in the middle of?
#
# The design point is that a session must never be able to fail QUIETLY. Claude
# Code's own registry reports `busy` from UI state alone (`isLoading ||
# delegatedActive`), so a session wedged on a network stall or a hung tool call
# reports `busy` forever and nothing ever re-checks it. So every status here is
# corroborated against a second, independent signal — whether the session's
# transcript is still growing — and a `busy` that has stopped writing is called
# out as suspect rather than trusted. Silence is a reading, not an absence.
#
# This is deliberately self-contained: no lib/common.sh, no state file, nothing
# spec-kit specific required. It ships with the plugin because the pipeline
# overlay (which phase, on what model, for how much) is the most useful column
# it draws — but it works the same in a repo that has never seen spec-run.
#
# SOURCES, and how much each is trusted
#   ~/.claude/sessions/<pid>.json   the live registry. One file per process.
#                                   Richer than `claude agents --json`, which
#                                   drops `entrypoint` and `waitingFor` — the
#                                   two fields that matter most here. Internal
#                                   format, so `ccwatch doctor` cross-checks it
#                                   against the supported CLI and complains
#                                   loudly if a Claude Code upgrade moves it.
#   ~/.claude/projects/*/<sid>.jsonl  the transcript. Append-only, survives
#                                   reboots, and its mtime is the one honest
#                                   answer to "is this thing still moving".
#                                   This is also the ONLY resume authority: the
#                                   registry is pid-keyed and evaporates on
#                                   restart, exactly when you need it.
#   <repo>/specs/*/.pipeline/state.json  the spec-run pipeline overlay, when
#                                   present. Already distinguishes ok from
#                                   interrupted, which the registry cannot.

set -uo pipefail

# ⚠️ The trailing marker is load-bearing: release-please rewrites the version on
# any line carrying it, and this is the only copy of the number in the repo that
# the tool itself reads. Do not bump it by hand — the release PR does that, and
# a hand-edit makes the tag and the script disagree about what shipped.
CCWATCH_VERSION=1.1.0 # x-release-please-version

# ---------------------------------------------------------------- output ------
# A dumb terminal, a pipe, or a CI log gets plain text. Colour is decoration and
# must never be the only thing carrying a meaning — every severity here also has
# a distinct word, so `ccwatch | grep HUNG` works.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != dumb ]; then
  _c_red=$'\033[31m';    _c_yellow=$'\033[33m'; _c_green=$'\033[32m'
  _c_cyan=$'\033[36m';   _c_dim=$'\033[2m';     _c_bold=$'\033[1m'
  _c_reset=$'\033[0m';   _c_magenta=$'\033[35m'
else
  _c_red=; _c_yellow=; _c_green=; _c_cyan=; _c_dim=; _c_bold=; _c_reset=
  _c_magenta=
fi

say()  { printf '%s\n' "$*"; }
warn() { printf '%s!%s %s\n' "$_c_yellow" "$_c_reset" "$*" >&2; }
err()  { printf '%sx%s %s\n' "$_c_red" "$_c_reset" "$*" >&2; }
die()  { err "$1"; [ -n "${2:-}" ] && printf '  %s\n' "$2" >&2; exit 1; }

# ------------------------------------------------------------ where things ----
CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SESS_DIR="$CLAUDE_HOME/sessions"
PROJ_DIR="$CLAUDE_HOME/projects"
CCWATCH_HOME="${CCWATCH_HOME:-$CLAUDE_HOME/ccwatch}"
EVENTS="$CCWATCH_HOME/events.jsonl"
# Account-wide usage, written by `ccwatch statusline`. One file, last writer
# wins — the numbers are per-account, not per-session, so any session that
# reports is as good as any other.
USAGE_FILE="$CCWATCH_HOME/usage.json"
# Context-window fill, which IS per-session, so one file each.
CTX_DIR="$CCWATCH_HOME/context"

# Thresholds. A `busy` session that has not appended to its transcript in this
# long is reported as suspect. It is not proof of a hang — one `Bash` call
# running a long test suite is legitimately silent — which is why the table
# always prints the actual silence next to the verdict, and why crossing 3x the
# threshold escalates rather than the first crossing being final. Judgement
# stays with you; the tool's job is to make the silence impossible to miss.
CCWATCH_BUSY_STALE="${CCWATCH_BUSY_STALE:-600}"
CCWATCH_SDK_STALE="${CCWATCH_SDK_STALE:-900}"
CCWATCH_REFRESH="${CCWATCH_REFRESH:-2}"
CCWATCH_RESUME_DAYS="${CCWATCH_RESUME_DAYS:-14}"
# How recent an unfinished run has to be to earn a place in the live table. The
# first version had no window and listed 24 runs going back a fortnight, which
# buried the two from the last hour that actually mattered. Older wreckage is
# still reachable, just through `ccwatch resume` rather than in your face.
CCWATCH_UNFINISHED_HOURS="${CCWATCH_UNFINISHED_HOURS:-24}"
# How old a statusline report can be before its context reading is dropped.
# Generous relative to a 10s refreshInterval, because a session sitting idle
# still repaints; a reading older than this means the session is gone from the
# status line entirely, and a frozen gauge that looks live is worse than none.
CCWATCH_CTX_STALE="${CCWATCH_CTX_STALE:-120}"
# How old a usage reading may be before its NUMBERS are withheld.
#
# ⚠️ Generous next to a 10s statusline refresh, and deliberately not unlimited.
# An hour-old rate-limit percentage is not a slightly-stale fact, it is a wrong
# one: the five-hour window has moved and possibly reset underneath it. The
# first version rendered any reading with an "[1h old]" note beside it, and a
# test fixture from an earlier session sat on the dashboard reading 52% while
# the real figure was 7% — a monitoring tool showing a confidently wrong number
# is worse than one showing none.
CCWATCH_USAGE_STALE="${CCWATCH_USAGE_STALE:-600}"
# How long `ccwatch send` waits to OBSERVE its message in the target's
# transcript before reporting it as merely queued. Writing to the socket is not
# evidence of delivery — that was proven the hard way, see cmd_send.
CCWATCH_SEND_VERIFY="${CCWATCH_SEND_VERIFY:-10}"
# How injected messages identify themselves in the receiver's transcript. Left
# as "ccwatch" so that "who told that agent to do that" is answerable from the
# receiving side alone, not only from this machine's event log.
CCWATCH_SEND_AS="${CCWATCH_SEND_AS:-ccwatch}"
# Deploy watching. `gh` is a network call, so it is cached — polling it on every
# 2s repaint would rate-limit you and make the table stutter.
CCWATCH_DEPLOY_TTL="${CCWATCH_DEPLOY_TTL:-60}"
# Which workflows count as a deploy. A CI run on every push is noise; a
# production deploy is not. Matched case-insensitively against the workflow name.
CCWATCH_DEPLOY_PATTERN="${CCWATCH_DEPLOY_PATTERN:-deploy|release|rollback|publish|promote}"
CCWATCH_DEPLOY_LIMIT="${CCWATCH_DEPLOY_LIMIT:-20}"

need() { command -v "$1" >/dev/null 2>&1 || die "ccwatch needs '$1' on PATH" "${2:-}"; }

# CCWATCH_PROFILE=1 prints per-stage timings to stderr. Added because the first
# round of "optimisation" here was guesswork: the fork overhead that looked
# obvious turned out to be a fraction of the cost, and the real expense was
# filesystem traversal of a 1.7GB transcript tree. Measure, then change.
_prof_t0=0
prof() { # prof <stage-label>
  [ -n "${CCWATCH_PROFILE:-}" ] || return 0
  local now
  now=$(perl -MTime::HiRes -e 'print int(Time::HiRes::time()*1000)' 2>/dev/null) || now=0
  [ "$_prof_t0" -ne 0 ] && printf '  %-22s %6sms\n' "$1" "$((now - _prof_t0))" >&2
  _prof_t0=$now
}

# The one testing seam. Liveness and CPU both come from `ps`, and a fabricated
# pid is never live, so without a way to substitute that output every fixture
# row would be filtered out before it reached the classification — which is the
# part most worth testing. Set CCWATCH_FAKE_PS to a file holding what
# `ps -o pid=,lstart=,time=` would have printed.
ps_out() {
  if [ -n "${CCWATCH_FAKE_PS:-}" ]; then
    cat "$CCWATCH_FAKE_PS" 2>/dev/null
  else
    ps -o pid=,lstart=,time=,rss= -p "$1" 2>/dev/null
  fi
}

# resolved_self — this script's real path, with symlinks followed.
#
# ⚠️ Load-bearing for `serve`, which finds web/ relative to bin/. The documented
# install is a SYMLINK into /usr/local/bin so that `git pull` upgrades the tool,
# and `${BASH_SOURCE[0]}` is then the symlink — so the naive dirname put the web
# root at /usr/local and `serve` died for everyone who followed the README.
#
# A loop rather than `readlink -f`: the BSD readlink macOS shipped for years has
# no -f, and a chain of symlinks (Homebrew, a dotfiles repo, /usr/local itself)
# is the normal case, not an exotic one.
resolved_self() {
  local p=${BASH_SOURCE[0]} d n=0
  while [ -L "$p" ]; do
    n=$((n + 1)); [ "$n" -gt 40 ] && break     # a symlink cycle must not hang
    d=$(cd -- "$(dirname -- "$p")" && pwd)
    p=$(readlink -- "$p")
    case "$p" in /*) ;; *) p="$d/$p";; esac    # a link target may be relative
  done
  printf '%s/%s\n' "$(cd -- "$(dirname -- "$p")" && pwd)" "$(basename -- "$p")"
}

TMP=""
cleanup() { [ -n "$TMP" ] && rm -rf "$TMP"; }
trap cleanup EXIT

# ============================================================== collection ===

# collect_sessions — the live registry, one JSON object on stdout:
# {"rows": [...], "parse_failed": N}.
#
# Each file is parsed on its own rather than with a single `jq -s`, because a
# session that is mid-write would otherwise take the whole table down with it.
# One unreadable file costs one row, and parse_failed records how many so that
# `ccwatch doctor` can report it instead of quietly showing a short list.
# The count travels inside the returned object rather than a global, because a
# global written from inside `$(...)` never survives the subshell back to the
# caller — see research.md D6 for the entry this fixed.
collect_sessions() {
  local f n=0 fast count
  [ -d "$SESS_DIR" ] || { printf '{"rows":[],"parse_failed":0}'; return 0; }
  n=$(find "$SESS_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | wc -l | tr -d ' ')
  [ "${n:-0}" -gt 0 ] || { printf '{"rows":[],"parse_failed":0}'; return 0; }

  # Fast path: ONE jq over every file at once. Registry files are single-line
  # JSON, so `fromjson? // empty` per line both parses them and tolerates a
  # file caught mid-write. This replaced a jq process per file, which cost
  # ~1.1s of pure fork overhead on 19 sessions — the single largest slice of a
  # snapshot that needs to complete inside a 2s repaint.
  fast=$(cat "$SESS_DIR"/*.json 2>/dev/null \
         | jq -c -R 'fromjson? // empty | select(type == "object")' 2>/dev/null | jq -s '.')
  count=$(printf '%s' "$fast" | jq 'length' 2>/dev/null) || count=0

  if [ "${count:-0}" -eq "$n" ]; then
    jq -cn --argjson rows "$fast" '{rows: $rows, parse_failed: 0}'
    return 0
  fi

  # Slow path, taken only when the fast one came up short. Parsing each file on
  # its own is how the count gets accurate — and an accurate count is the
  # point, because `ccwatch doctor` reports it. Guessing "n - count" would also
  # be wrong for a pretty-printed file, which the fast path splits across lines
  # and drops entirely. The loop runs in the function's own shell (no pipeline
  # stage, no subshell) so the accumulated rows and the failure count both
  # reach the return value.
  local -a rows_arr=()
  local pf=0 line
  for f in "$SESS_DIR"/*.json; do
    [ -f "$f" ] || continue
    line=$(jq -c '. as $o | if ($o|type) == "object" then $o else empty end' "$f" 2>/dev/null)
    if [ -n "$line" ]; then
      rows_arr+=("$line")
    else
      pf=$((pf + 1))
    fi
  done
  if [ ${#rows_arr[@]} -gt 0 ]; then
    printf '%s\n' "${rows_arr[@]}" | jq -cs --argjson pf "$pf" '{rows: ., parse_failed: $pf}'
  else
    jq -cn --argjson pf "$pf" '{rows: [], parse_failed: $pf}'
  fi
}

# collect_live — {pid, start, cpu} for every registry pid still running.
#
# `kill -0` alone is not enough: PIDs are recycled, and a stale registry file
# whose number now belongs to an unrelated process would show as a live Claude
# session. So the process's real start time is compared against the session's
# own `startedAt`. A mismatch means the file outlived its process and the number
# was reused — that session is gone, whatever the file says.
#
# Note the trap for anyone extending this: the registry's `procStart` string is
# UTC while `ps -o lstart=` prints local time, so comparing those two strings
# directly marks every session an impostor. Comparing epochs sidesteps it.
#
# `cpu` is cumulative CPU seconds, and it is the second independent progress
# signal. It matters because it is the only one that works for EVERY session:
# an embedded-SDK session writes no transcript and publishes no status, so
# without this there would be a whole class of session about which ccwatch could
# say nothing at all. Between two frames, CPU that moved means the process is
# doing work; CPU that did not, alongside a transcript that did not grow, is
# what turns a guess about a hang into two agreeing measurements.
collect_live() {
  local pids sessions="$1"
  pids=$(printf '%s' "$sessions" | jq -r '[.[].pid // empty] | join(",")')
  [ -n "$pids" ] || { printf '[]'; return 0; }
  # ps, plus all the parsing, in ONE process. The first version forked `date -j`
  # once per pid to convert lstart and `awk` once per pid to convert the CPU
  # clock — ~1.7s of fork overhead on 19 sessions, inside a loop that is
  # supposed to repaint every 2s.
  ps_out "$pids" | python3 -c '
import calendar, json, sys, time

MONTHS = {m: i + 1 for i, m in enumerate(
    ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"])}

def epoch(dow, mon, day, clock, year):
    # `ps -o lstart=` prints LOCAL time. The registry stores procStart in UTC,
    # which is why these are compared as epochs and never as strings — doing
    # the latter marks every session a pid-reuse impostor.
    h, m, sec = (int(x) for x in clock.split(":"))
    st = (int(year), MONTHS[mon], int(day), h, m, sec, 0, 0, -1)
    return int(time.mktime(st))

def cpu(clock):
    # macOS prints MM:SS.ss and lets the minutes run past 60; HH:MM:SS also
    # occurs. Handle both rather than mis-scaling a long-lived session.
    parts = clock.split(":")
    try:
        if len(parts) == 3:
            return float(parts[0]) * 3600 + float(parts[1]) * 60 + float(parts[2])
        if len(parts) == 2:
            return float(parts[0]) * 60 + float(parts[1])
    except ValueError:
        pass
    return 0.0

out = []
for line in sys.stdin:
    f = line.split()
    if len(f) < 7:
        continue
    try:
        rec = {"pid": int(f[0]),
               "start": epoch(f[1], f[2], f[3], f[4], f[5]),
               "cpu": cpu(f[6])}
        # Resident size, when ps was asked for it. Absent in the test fixtures,
        # which supply only the columns they care about, so it is optional
        # rather than required — a missing figure must not drop the row.
        if len(f) >= 8:
            rec["rss_mb"] = round(int(f[7]) / 1024)
        out.append(rec)
    except (ValueError, KeyError, OverflowError):
        # A row we cannot parse is skipped, not guessed at: a wrong start time
        # would make the pid-reuse guard reject a live session.
        continue
print(json.dumps(out))
' 2>/dev/null || printf '[]'
}

# CPU is only meaningful as a delta, which needs a previous sample.
#
# ⚠️ Three things this has to get right, all learned the hard way.
#
# 1. It is keyed by the config directory being observed. The first version used
#    one global path, so a `ccwatch serve` polling the real registry every two
#    seconds silently overwrote the samples belonging to a run against a
#    different CLAUDE_CONFIG_DIR. Both processes then reported no CPU movement
#    and flagged healthy sessions as hung.
# 2. Samples carry their own timestamp, so the delta is measured over the
#    interval that actually elapsed rather than over an assumed "last frame".
#    Two watchers on the same machine then cooperate — either one's sample is a
#    valid baseline for the other — instead of fighting.
# 3. A sample less than CCWATCH_CPU_MIN_GAP old yields null, not zero. Sub-second
#    gaps measure nothing, and "measured no progress" is the claim that escalates
#    a quiet session to HUNG. Getting this wrong invents hangs.
#
# In $TMPDIR rather than CCWATCH_HOME because it is worthless across a reboot —
# the very event that invalidates every pid in it.
CPU_CACHE="${TMPDIR:-/tmp}/ccwatch-cpu-$(id -u)-$(printf '%s' "$CLAUDE_HOME" | cksum | cut -d' ' -f1).json"
CCWATCH_CPU_MIN_GAP="${CCWATCH_CPU_MIN_GAP:-1.5}"

# collect_transcripts — {sid, mtime} for the given session ids.
#
# Globbed by session id rather than by reconstructing the escaped-cwd directory
# name, because that escaping is lossy (both `/` and `.` collapse to `-`) and
# guessing it wrong would silently report "no transcript" for a healthy session
# — precisely the class of quiet mistake this tool exists to prevent.
collect_transcripts() { # collect_transcripts <sid>...
  [ -d "$PROJ_DIR" ] || { printf '[]'; return 0; }
  [ $# -gt 0 ] || { printf '[]'; return 0; }
  # ONE traversal of the transcript tree, filtered afterwards, rather than a
  # glob per session id. The previous version expanded
  # "$PROJ_DIR"/*/<sid>.jsonl once per live session — 17 globs across 94
  # project directories over a 1.7GB tree — and the directory walking, not the
  # process count, was where the seconds went.
  #
  # Session transcripts sit at depth 2. Subagent sidechains live deeper and are
  # deliberately out of scope: they are not sessions and have no registry entry.
  printf '%s\n' "$@" | python3 -c '
import json, os, sys

proj = sys.argv[1]
wanted = {line.strip() for line in sys.stdin if line.strip()}
out = []
try:
    for project in os.scandir(proj):
        if not project.is_dir():
            continue
        try:
            entries = os.scandir(project.path)
        except OSError:
            continue
        with entries:
            for e in entries:
                if not e.name.endswith(".jsonl"):
                    continue
                sid = e.name[:-6]
                if sid not in wanted:
                    continue
                try:
                    out.append({"sid": sid, "mtime": int(e.stat().st_mtime)})
                except OSError:
                    continue
except OSError:
    pass
print(json.dumps(out))
' "$PROJ_DIR" 2>/dev/null || printf '[]'
}

# collect_pipelines — spec-run's own record, for each distinct working directory.
#
# Emits every phase, not a pre-chosen one, because the choice of which phase
# matters depends on WHICH SESSION is asking: a phase records the session id of
# the `claude -p` process that ran it, so a phase can be attached to the exact
# session that owns it rather than to every session that happens to share a
# directory. Attaching by directory was the first thing tried here and it lied —
# four sessions in one repo all claimed the same run.
collect_pipelines() {
  local cwd
  local -a states=()
  for cwd in "$@"; do
    # Every state file in the repo, not just the newest: an abandoned run in an
    # older feature is exactly the debris worth reporting.
    for state in "$cwd"/specs/*/.pipeline/state.json; do
      [ -f "$state" ] && states+=("$state")
    done
  done
  [ ${#states[@]} -gt 0 ] || { printf '[]'; return 0; }

  # ONE jq for all of them. The previous version forked a jq per state file;
  # with ~70 files across six repos that was ~5 seconds — measured with
  # CCWATCH_PROFILE=1, and by far the largest slice of the snapshot.
  #
  # `input_filename` is what makes this possible: it identifies which file the
  # current input came from, so the repo path can still be derived per state
  # file without passing it in as an argument.
  jq -c '
    ( input_filename | sub("/specs/[^/]+/\\.pipeline/state\\.json$"; "") ) as $cwd
    | { cwd: $cwd,
        feature: ((.feature_dir // "") | split("/") | last),
        branch:  (.branch // ""),
        cost:    ([ (.phases // {}) | .[].cost_usd // 0 ] | add // 0),
        phases: [ ( .phases // {} ) | to_entries[]
                  | { name: .key,
                      status: (.value.status // ""),
                      model:  (.value.model // ""),
                      cost:   (.value.cost_usd // 0),
                      # The runner pid is the whole game for a `running` phase:
                      # spec-run records it, and a `running` phase whose runner
                      # is gone is a crash — not an opinion, a fact. spec-run
                      # reconciles that to `interrupted` on its next
                      # invocation, but that could be days away, and until then
                      # this is the only place it shows.
                      runner_pid: (.value.runner_pid // null),
                      started_at: (.value.started_at // null),
                      # Both keys: older runs recorded a single session_id,
                      # chunked phases record a list. Missing either way would
                      # silently break the attach.
                      sids: ( [ .value.session_id // empty ]
                              + ( .value.sessions // [] ) | unique ) } ] }
  ' "${states[@]}" 2>/dev/null | jq -s '.'
}

# ============================================================== statusline ===
#
# Where the usage numbers come from, and why this route rather than the API.
#
# Claude Code hands its statusline command a JSON payload on stdin, and that
# payload already contains `rate_limits` (five_hour / seven_day / spend_limit,
# each with a used percentage and a reset time) and `context_window` (per
# session). So the numbers are available WITHOUT touching a credential.
#
# The alternative is `GET /api/oauth/usage`, which is where `/usage` gets the
# same figures — but that needs the OAuth token out of the keychain, and a
# monitoring tool that handles your credential in order to display a percentage
# is a bad trade. This route reads a feed Claude Code is already pushing.
#
# Two consequences worth knowing:
#   - Only sessions with a statusline contribute, which means only interactive
#     ones. Fine for rate limits (account-wide — one reporter is enough), and
#     the reason the context column is blank for headless rows.
#   - The figures are as fresh as your statusline refreshInterval, so the file
#     records when it was written and the table ages it out rather than
#     presenting a stale number as current.

cmd_statusline() {
  # This runs on every statusline repaint, in the critical path of the user's
  # prompt. It must never fail, never be slow, and never print anything to
  # stdout that is not statusline text.
  local exec_cmd=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --exec) exec_cmd="${2:-}"; shift 2 || break;;
      *) shift;;
    esac
  done

  local payload
  payload=$(cat 2>/dev/null) || payload=""

  # Everything in this block is best-effort. A failure here would otherwise
  # break the status line of whichever session happened to be running.
  {
    mkdir -p "$CCWATCH_HOME" "$CTX_DIR" 2>/dev/null

    printf '%s' "$payload" | jq -c --arg at "$(date '+%s')" '
      select(.rate_limits != null)
      | { at: ($at|tonumber),
          session: (.session_id // null),
          five_hour: .rate_limits.five_hour,
          seven_day: .rate_limits.seven_day,
          seven_day_opus: .rate_limits.seven_day_opus,
          spend_limit: .rate_limits.spend_limit }' 2>/dev/null \
      >"$USAGE_FILE.tmp" && [ -s "$USAGE_FILE.tmp" ] && mv "$USAGE_FILE.tmp" "$USAGE_FILE"
    rm -f "$USAGE_FILE.tmp"

    # Per-session, keyed by session id so a row can find its own. The cost
    # figure comes along because it is in the same payload and is the only
    # per-session spend number available for a session that is not a spec-run
    # phase.
    local sid
    sid=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
    if [ -n "$sid" ]; then
      printf '%s' "$payload" | jq -c --arg at "$(date '+%s')" '
        { at: ($at|tonumber),
          used_percentage: (.context_window.used_percentage // null),
          window: (.context_window.context_window_size // null),
          cost_usd: (.cost.total_cost_usd // null),
          model: (.model.display_name // .model.id // null),
          effort: (.effort.level // null) }' 2>/dev/null \
        >"$CTX_DIR/$sid.json.tmp" \
        && [ -s "$CTX_DIR/$sid.json.tmp" ] && mv "$CTX_DIR/$sid.json.tmp" "$CTX_DIR/$sid.json"
      rm -f "$CTX_DIR/$sid.json.tmp"
    fi
  } >/dev/null 2>&1

  # Compose rather than replace. Wrapping an existing statusline means you keep
  # it and gain the feed; replacing it would make adopting ccwatch cost you the
  # status line you already tuned.
  if [ -n "$exec_cmd" ]; then
    printf '%s' "$payload" | eval "$exec_cmd" 2>/dev/null || true
  else
    # Standalone use: something has to be printed, or the status line is blank.
    printf '%s' "$payload" | jq -r '
      def pct(x): if x == null then empty else "\(x.used_percentage | floor)%" end;
      [ (if .rate_limits.five_hour != null then "5h \(pct(.rate_limits.five_hour))" else empty end),
        (if .rate_limits.seven_day != null then "7d \(pct(.rate_limits.seven_day))" else empty end),
        (if .context_window.used_percentage != null
         then "ctx \(.context_window.used_percentage | floor)%" else empty end)
      ] | join("  ")' 2>/dev/null || true
  fi
  exit 0
}

# install-statusline wires the wrapper IN FRONT of whatever is already
# configured, so the existing command keeps running and its output is what you
# still see. It shows the change and asks first, like install-hooks.
cmd_install_statusline() {
  local settings="$CLAUDE_HOME/settings.json"
  local self
  self=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")
  [ -f "$settings" ] || die "no settings file at $settings" \
    "create it first, or point CLAUDE_CONFIG_DIR at the right directory"

  local current proposed
  current=$(jq -r '.statusLine.command // empty' "$settings" 2>/dev/null)

  case "$current" in
    *"ccwatch statusline"*)
      say "Already wired:"
      say "  ${_c_dim}$current${_c_reset}"
      return 0;;
  esac

  if [ -n "$current" ]; then
    say "You already have a statusline command:"
    say "  ${_c_dim}$current${_c_reset}"
    say ""
    say "ccwatch will run ${_c_bold}in front of it${_c_reset} and pass its output through, so"
    say "what you see does not change — it just also records the usage numbers."
    say ""
    proposed=$(jq --arg cmd "$self statusline --exec '$current'" \
      '.statusLine = ((.statusLine // {type:"command"}) | .type = "command" | .command = $cmd)' \
      "$settings") || die "could not compute the settings change" "is $settings valid JSON?"
  else
    proposed=$(jq --arg cmd "$self statusline" \
      '.statusLine = {type:"command", command:$cmd, refreshInterval:10}' \
      "$settings") || die "could not compute the settings change" "is $settings valid JSON?"
  fi

  say "${_c_bold}This will set${_c_reset} .statusLine.command ${_c_bold}in${_c_reset} $settings"
  say ""
  printf '%s' "$proposed" | jq -r '"  " + .statusLine.command'
  say ""
  printf 'Apply? [y/N] '
  local reply=""
  read -r reply
  case "$reply" in
    y|Y|yes|YES) ;;
    *) say "Nothing changed."; return 0;;
  esac

  local backup
  backup="$settings.ccwatch-backup.$(date '+%Y%m%d%H%M%S')"
  cp "$settings" "$backup" || die "could not back up $settings"
  printf '%s\n' "$proposed" >"$settings.ccwatch-tmp" \
    && mv "$settings.ccwatch-tmp" "$settings" \
    || die "could not write $settings" "your original is at $backup"
  mkdir -p "$CCWATCH_HOME" "$CTX_DIR"
  say "${_c_green}Wired.${_c_reset} Previous settings saved to $backup"
  say "${_c_dim}Existing sessions pick it up on their next repaint.${_c_reset}"
}

# collect_usage / collect_context — read the feed back.
#
# Both report their own age. A percentage with no timestamp is the same failure
# this whole tool exists to avoid: a number presented as current when nobody
# knows whether it is.
collect_usage() {
  [ -f "$USAGE_FILE" ] || { printf 'null'; return 0; }
  jq -c --argjson now "$(date '+%s')" --argjson stale "$CCWATCH_USAGE_STALE" \
    '. + { age: ($now - .at), stale_after: $stale }' "$USAGE_FILE" 2>/dev/null \
    || printf 'null'
}

collect_context() { # collect_context <sid>...
  local sid
  [ -d "$CTX_DIR" ] || { printf '[]'; return 0; }
  {
    for sid in "$@"; do
      [ -f "$CTX_DIR/$sid.json" ] || continue
      jq -c --arg sid "$sid" --argjson now "$(date '+%s')" \
        '. + { sid: $sid, age: ($now - .at) }' "$CTX_DIR/$sid.json" 2>/dev/null
    done
  } | jq -s '.'
}

# ============================================================== the join =====

# snapshot — one JSON array, one object per live session, fully classified.
#
# All the judgement lives in this jq program so that `ccwatch`, `ccwatch --json` and
# the watch loop can never disagree about what a session's status is.
# pids_alive — of the pids given, which are still running. Used for spec-run's
# recorded runner pids, which are not Claude processes and so never appear in
# the session registry.
pids_alive() {
  local csv
  csv=$(printf '%s' "$1" | tr ' ' ',' | sed 's/^,*//; s/,*$//')
  [ -n "$csv" ] || { printf '[]'; return 0; }
  ps_out "$csv" | awk '{print $1}' | jq -R 'select(length>0) | tonumber' | jq -s '.'
}

# require_json — a collector's output really is JSON, or say which one failed.
#
# ⚠️ An empty collector output must never reach `jq --argjson`. jq dies with
# "invalid JSON text passed to --argjson", which names no stage and reads like
# a bug in ccwatch rather than what it is: a collector that returned nothing.
# Found when the host ran out of memory mid-snapshot — `ccwatch kill` then
# reported the resulting failure as an ambiguous name match, so the visible
# symptom pointed at the wrong thing entirely.
#
# Defaulting an empty producer to `[]` or `{}` would be worse than the crash.
# A collector that failed would be presented as a host with nothing to show,
# which is the single thing this tool exists not to do.
# ⚠️ The check is `jq empty`, which asks only "does this parse". `jq -e .` looks
# equivalent and is not: it exits 1 for `null` and `false`, and `null` is a
# legitimate value here — `collect_usage` returns it when no statusline has ever
# reported, and `host` is passed as `${host:-null}`. Using `-e` made a machine
# with no usage feed report "collect_usage produced no usable JSON", turning a
# normal condition into a failure, which is the same mistake in the opposite
# direction as the bug this function exists to fix.
require_json() { # require_json <stage> <value>
  if [ -n "$2" ] && printf '%s' "$2" | jq empty >/dev/null 2>&1; then
    return 0
  fi
  err "snapshot: $1 produced no usable JSON — it failed or was killed"
  printf '  %s\n' "if the host is under memory pressure, the OS may have killed it mid-run" >&2
  return 1
}

snapshot() {
  local sessions_obj sessions parse_failed live transcripts pipelines sids cwds now
  now=$(date '+%s')
  prof start
  sessions_obj=$(collect_sessions)
  require_json collect_sessions "$sessions_obj" || return 1
  sessions=$(printf '%s' "$sessions_obj" | jq -c '.rows')
  parse_failed=$(printf '%s' "$sessions_obj" | jq -r '.parse_failed // 0')
  prof collect_sessions

  live=$(collect_live "$sessions")
  require_json collect_live "$live" || return 1
  prof collect_live

  # Only live sessions are worth gathering the expensive signals for. A dead
  # registry file is `ccwatch resume`'s business, not the table's.
  local live_sessions
  live_sessions=$(printf '%s' "$sessions" | jq -c \
    --argjson live "$live" --argjson tol 300 '
      ( $live | map({ key: (.pid|tostring), value: .start }) | from_entries ) as $L
      | [ .[]
          | select(.pid != null)
          | . as $s
          | ($L[.pid|tostring]) as $ps
          | select($ps != null)
          # PID reuse guard: the process running under this number must have
          # started when this session did, within a few minutes of slack.
          | select( $ps == 0 or (($ps - (($s.startedAt // 0) / 1000)) | fabs) <= $tol )
        ]')

  sids=$(printf '%s' "$live_sessions" | jq -r '[.[].sessionId // empty] | .[]')
  cwds=$(printf '%s' "$live_sessions" | jq -r '[.[].cwd // empty] | unique | .[]')

  # shellcheck disable=SC2086
  transcripts=$(collect_transcripts $sids)
  require_json collect_transcripts "$transcripts" || return 1
  prof collect_transcripts
  local ctx usage
  # shellcheck disable=SC2086
  ctx=$(collect_context $sids)
  require_json collect_context "$ctx" || return 1
  usage=$(collect_usage)
  require_json collect_usage "$usage" || return 1
  local host
  host=$(collect_host)
  prof collect_host
  pipelines='[]'
  if [ -n "$cwds" ]; then
    local -a cwda=()
    while IFS= read -r c; do [ -n "$c" ] && cwda+=("$c"); done <<<"$cwds"
    [ ${#cwda[@]} -gt 0 ] && pipelines=$(collect_pipelines "${cwda[@]}")
  fi
  prof collect_pipelines

  # What the blocked sessions are actually asking. Only for sessions the
  # registry says are waiting — normally none or one — so this is not a
  # transcript read per session.
  local waiting_sids asks
  waiting_sids=$(printf '%s' "$live_sessions" | jq -r '.[] | select(.status == "waiting") | .sessionId // empty')
  asks='{}'
  if [ -n "$waiting_sids" ]; then
    # shellcheck disable=SC2086
    asks=$(collect_asks $waiting_sids)
  fi
  prof collect_asks

  # Which repository each directory actually belongs to. Needed by both the
  # session rows and the unfinished-run rows, so it covers both sets of cwds.
  local repos allcwds
  allcwds=$( { printf '%s\n' "$cwds"
               printf '%s' "$pipelines" | jq -r '.[].cwd // empty'; } | sort -u )
  local -a rcwda=()
  while IFS= read -r c; do [ -n "$c" ] && rcwda+=("$c"); done <<<"$allcwds"
  if [ ${#rcwda[@]} -gt 0 ]; then repos=$(collect_repos "${rcwda[@]}"); else repos='{}'; fi
  prof collect_repos

  # Which of spec-run's recorded runner pids are still up.
  local runners runners_alive
  runners=$(printf '%s' "$pipelines" | jq -r '[.[].phases[].runner_pid // empty] | unique | join(" ")')
  runners_alive=$(pids_alive "$runners")

  # The previous samples, and the merged write-back. Merging rather than
  # replacing is what lets two watchers share the file without destroying each
  # other's baselines.
  local prev='{}' nowf
  nowf=$(perl -MTime::HiRes -e 'print Time::HiRes::time()' 2>/dev/null) || nowf="$now"
  if [ -f "$CPU_CACHE" ]; then
    prev=$(jq -c 'if type == "object" then . else {} end' "$CPU_CACHE" 2>/dev/null) || prev='{}'
    [ -n "$prev" ] || prev='{}'
  fi
  printf '%s' "$live" | jq -c --argjson prev "$prev" --argjson at "$nowf" \
    --argjson gap "$CCWATCH_CPU_MIN_GAP" '
    # Keep a previous sample when it is still too fresh to have produced a
    # usable gap: overwriting it would reset the baseline on every repaint and
    # make the delta permanently unmeasurable at a fast refresh rate.
    reduce .[] as $s ($prev;
      ($s.pid|tostring) as $k
      | if (.[$k] != null) and (($at - .[$k].at) < $gap) then .
        else .[$k] = { cpu: $s.cpu, at: $at } end)' \
    >"$CPU_CACHE.tmp" 2>/dev/null && mv "$CPU_CACHE.tmp" "$CPU_CACHE" 2>/dev/null || true

  printf '%s' "$live_sessions" | jq \
    --argjson parse_failed "$parse_failed" \
    --argjson t "$transcripts" \
    --argjson p "$pipelines" \
    --argjson live "$live" \
    --argjson prev "$prev" \
    --argjson nowf "$nowf" \
    --argjson cpu_gap "$CCWATCH_CPU_MIN_GAP" \
    --argjson runners "$runners_alive" \
    --argjson now "$now" \
    --argjson busy_stale "$CCWATCH_BUSY_STALE" \
    --argjson sdk_stale "$CCWATCH_SDK_STALE" \
    --argjson unfinished_hours "$CCWATCH_UNFINISHED_HOURS" \
    --argjson ctx "$ctx" \
    --argjson usage "$usage" \
    --argjson host "${host:-null}" \
    --argjson swap_warn "$CCWATCH_SWAP_WARN" \
    --argjson ctx_stale "$CCWATCH_CTX_STALE" \
    --argjson repos "$repos" \
    --argjson asks "${asks:-\{\}}" '
    # Shared by session rows and unfinished-run rows, and derived from the git
    # REMOTE rather than the path — see collect_repos for why the path version
    # was wrong three different ways.
    #
    # A directory with no remote (a scratch dir, /tmp) falls back to its
    # basename and is marked so, rather than being silently lumped in with a
    # real repository.
    def repo_of(cwd): ($repos[cwd // ""] // {});
    def project(cwd):
      (repo_of(cwd)) as $r
      | if ($r.slug // "") != "" then ($r.slug | split("/") | last)
        else ((cwd // "?") | split("/") | last | if . == "" then "/" else . end)
        end;
    ( $t | map({ key: .sid, value: .mtime }) | from_entries ) as $T
    # One entry per session id that spec-run recorded, so a phase can be
    # attached to the session that actually ran it. `crashed` is decided once,
    # here, against the live runner pids.
    | ( [ $p[]
          | .feature as $f | .cwd as $c | .cost as $rc
          | .phases[]
          | . as $ph
          | ( $ph.status == "running"
              and $ph.runner_pid != null
              and ($runners | index($ph.runner_pid)) == null ) as $crashed
          | $ph.sids[]
          | { key: .,
              value: { feature: $f, cwd: $c, phase: $ph.name,
                       status: $ph.status, model: $ph.model,
                       # The run total, not this phase alone — a phase still
                       # running has spent nothing yet, and "$0" under a live
                       # run reads as a broken number rather than a true one.
                       cost: $rc,
                       runner_pid: $ph.runner_pid, started_at: $ph.started_at,
                       crashed: $crashed } } ]
        | from_entries ) as $P
    | ( $live | map({ key: (.pid|tostring), value: .cpu }) | from_entries ) as $C
    | ( $live | map({ key: (.pid|tostring), value: .rss_mb }) | from_entries ) as $M
    | $prev as $PC
    | ( $ctx | map({ key: .sid, value: . }) | from_entries ) as $X
    | [ .[]
        | . as $s
        | ($s.sessionId // "") as $sid
        | ($T[$sid]) as $mtime
        # quiet: seconds since the transcript last grew. null means there is no
        # transcript to read at all, which is itself reported rather than
        # silently treated as fresh.
        # Clamped at zero. `$now` is captured at the start of the snapshot and
        # the transcript is stat-ed after, so a session writing right now has an
        # mtime a second or two AHEAD of it — which rendered as "-2s ago".
        | (if $mtime == null then null else ([$now - $mtime, 0] | max) end) as $quiet
        | ($s.status) as $st
        # Two very different kinds of statusless session, and conflating them
        # produces a false alarm on every one of the second kind:
        #   sdk-cli  `claude -p` — what spec-run spawns. Writes a transcript,
        #            so transcript silence is a real signal.
        #   sdk-ts   the TypeScript SDK embedded in another program. Writes NO
        #            transcript, ever. Silence there measures nothing, so it is
        #            never reported as a hang — only CPU can speak for these.
        | (($s.entrypoint // "") == "sdk-cli") as $is_sdk_cli
        | (($s.entrypoint // "") | startswith("sdk")) as $is_sdk
        | ($C[$s.pid|tostring]) as $cpu
        # null = no previous frame yet. Distinct from 0, which means measured
        # and did not move. The classification below never treats the first as
        # if it were the second.
        | ($PC[$s.pid|tostring]) as $psample
        | (if $psample == null or $cpu == null
                or (($nowf - $psample.at) < $cpu_gap) then null
           else ($cpu - $psample.cpu) end) as $cpud
        | ($cpud != null and $cpud > 0.05) as $cpu_moved
        | (if   $st == "waiting" then
               { sev: 4, token: "waiting", note: ($s.waitingFor // "input needed") }

           # --- interactive, claims to be working ---------------------------
           # A transcript that has gone quiet is suspicion, not proof: one Bash
           # call running a long test suite is legitimately silent. So CPU gets
           # a vote. Quiet AND no CPU is two signals agreeing. Quiet WITH CPU
           # is a session that is genuinely working, and saying HUNG there
           # would be the cry-wolf that stops you reading the column at all.
           elif $st == "busy" and $quiet == null and $cpu_moved then
               { sev: 2, token: "busy", note: "no transcript; cpu moving" }
           elif $st == "busy" and $quiet == null then
               { sev: 3, token: "NO TRANSCRIPT", note: "cannot verify progress" }
           elif $st == "busy" and $quiet > $busy_stale and $cpu_moved then
               { sev: 2, token: "busy", note: "quiet but cpu moving" }
           elif $st == "busy" and $quiet > ($busy_stale * 3) then
               { sev: 3, token: "HUNG!!", note: "quiet" }
           elif $st == "busy" and $quiet > $busy_stale then
               { sev: 3, token: "HUNG?", note: "quiet" }
           elif $st == "busy"  then { sev: 2, token: "busy",  note: "" }
           elif $st == "shell" then { sev: 1, token: "shell", note: "" }
           elif $st == "idle"  then { sev: 0, token: "idle",  note: "" }

           # --- headless `claude -p`: transcript is trustworthy here ---------
           elif $is_sdk_cli and $quiet == null then
               { sev: 3, token: "NO TRANSCRIPT", note: "headless, cannot verify" }
           elif $is_sdk_cli and $quiet > $sdk_stale and $cpu_moved then
               { sev: 2, token: "sdk", note: "quiet but cpu moving" }
           elif $is_sdk_cli and $quiet > $sdk_stale then
               { sev: 3, token: "SDK STALE?", note: "quiet" }
           elif $is_sdk_cli then { sev: 2, token: "sdk", note: "no status published" }

           # --- embedded SDK: only the process itself is observable ----------
           # Deliberately never escalated to a hang. An embedded session
           # waiting on its host program is quiet and idle by design, and
           # ccwatch has no way to tell that from wedged. It says so.
           elif $is_sdk and $cpu_moved then
               { sev: 2, token: "sdk-ts", note: "cpu moving" }
           elif $is_sdk and $cpud == null then
               { sev: 1, token: "sdk-ts", note: "no status or transcript — liveness only" }
           elif $is_sdk then
               { sev: 1, token: "sdk-ts", note: "alive, no cpu since last frame" }

           # Status absent on a non-SDK session means an older Claude Code that
           # predates the field. Say so; do not imply health we did not measure.
           else { sev: 1, token: "unknown", note: "no status published" }
           end) as $c
        # Keyed by session id, not by directory: the phase that shows here is
        # the one this very session ran.
        | ($P[$sid]) as $pl
        | { sid: $sid,
            pid: $s.pid,
            name: ($s.name // ""),
            cwd:  ($s.cwd // "?"),
            # The basename of a worktree is the branch, useless without
            # the repo it belongs to — show both.
            project: project($s.cwd),
            # The full owner/name, which is what `gh` returns for a deploy, so
            # the two can be matched exactly instead of by a guessed leaf name.
            repo: ((repo_of($s.cwd).slug) | if (. // "") == "" then null else . end),
            # What distinguishes two sessions in different worktrees of one
            # repository. The repo alone cannot.
            branch: ((repo_of($s.cwd).branch) | if (. // "") == "" then null else . end),
            entrypoint: ($s.entrypoint // ""),
            version: ($s.version // ""),
            status_raw: ($st // null),
            token: $c.token, sev: $c.sev, note: $c.note,
            age: ([($now - (($s.startedAt // 0) / 1000)), 0] | max | floor),
            quiet: $quiet,
            cpu: $cpu,
            cpu_delta: $cpud,
            rss_mb: ($M[$s.pid|tostring]),
            # Only from a statusline that is still reporting. A session whose
            # last report is older than the threshold has its context reading
            # dropped rather than shown — a context gauge frozen at the value it
            # had an hour ago is worse than no gauge, because it looks live.
            context: ( ($X[$sid]) as $c
                       | if $c == null or $c.age > $ctx_stale then null
                         else { used_percentage: $c.used_percentage,
                                window: $c.window, cost_usd: $c.cost_usd,
                                model: $c.model, effort: $c.effort,
                                age: $c.age } end ),
            # For a waiting session the number you want is not transcript
            # silence but how long it has been blocked on you.
            # The question itself, when there is one. `waitingFor` only ever
            # gives a label; this is what it wants.
            questions: ($asks[$sid] // null),
            waited: (if $st == "waiting" and ($s.statusUpdatedAt // 0) > 0
                     then ([($now - ($s.statusUpdatedAt / 1000)), 0] | max | floor)
                     else null end),
            pipeline: $pl }
      ]
    # Pipeline severity is kept SEPARATE from session severity, because they are
    # different claims about different things. A session can be honestly `idle`
    # while the run it belongs to has crashed; collapsing those into one number
    # produced rows reading "! idle", which is not a sentence.
    #
    # `needs_input` is the record spec-run keeps when a phase stopped to ask you
    # something, so it ranks with a session that is waiting: both mean the run
    # goes nowhere until you look at it.
    | map(. + { psev:
        (if   (.pipeline.status // "") == "needs_input" then 4
         elif (.pipeline.crashed // false) then 3
         elif ((.pipeline.status // "") | test("^(interrupted|failed)$")) then 3
         else 0 end) })
    # Sorted on whichever claim is louder, so nothing urgent can sort below a
    # row that merely looks busy.
    | sort_by(-([.sev, .psev] | max), -(.waited // .quiet // 0))
    | { sessions: .,
        parse_failed: $parse_failed,
        usage: $usage,
        host: (if $host == null then null
               else $host + { pressure: (($host.swap_used_pct // 0) >= $swap_warn),
                              # What the sessions themselves account for, so
                              # "would killing agents help" has a number rather
                              # than an intuition behind it.
                              sessions_mb: ([ .[] | .rss_mb // 0 ] | add),
                              idle_mb: ([ .[] | select(.sev <= 1) | .rss_mb // 0 ] | add) } end),
        # Runs that stopped and whose session is already gone. These are the
        # ones nothing else reports: no live session carries them, so without
        # this block a crashed phase from yesterday is invisible until the next
        # spec-run invocation stumbles over it.
        unfinished: [ . as $rows
                      | $p[]
                      | .feature as $f | .cwd as $c | .cost as $rc
                      | .phases[]
                      | . as $ph
                      | select( $ph.status == "interrupted"
                                or $ph.status == "failed"
                                or $ph.status == "needs_input"
                                or ( $ph.status == "running"
                                     and $ph.runner_pid != null
                                     and ($runners | index($ph.runner_pid)) == null ) )
                      # Anything a live row already shows is not repeated here.
                      | select( [ $ph.sids[] ] - [ $rows[].sid ] | length > 0
                                or ($ph.sids | length) == 0 )
                      | { feature: $f, cwd: $c, project: project($c),
                          repo: ((repo_of($c).slug)
                                 | if (. // "") == "" then null else . end),
                          phase: $ph.name,
                          status: (if $ph.status == "running" then "CRASHED" else $ph.status end),
                          model: $ph.model, cost: $rc,
                          started_at: $ph.started_at,
                          sid: ($ph.sids[0] // null),
                          age: (if $ph.started_at == null then null
                                else ($now - ($ph.started_at|fromdate)) end) } ]
          | unique_by([.cwd, .feature, .phase])
          | sort_by(.age // 9e18) }
    | .unfinished_old = ([ .unfinished[] | select((.age // 9e18) > ($unfinished_hours * 3600)) ] | length)
    | .unfinished = [ .unfinished[] | select((.age // 9e18) <= ($unfinished_hours * 3600)) ]'
}

# ============================================================== rendering ====

# write_roster — remember what was live. Called from the places that take a
# snapshot for display, not from snapshot() itself, so that a --json consumer
# reading the state does not rewrite history as a side effect.
write_roster() { # write_roster <snapshot-json>
  mkdir -p "$CCWATCH_HOME" 2>/dev/null || return 0
  printf '%s' "$1" | jq -c --argjson at "$(date '+%s')" '
    { at: $at,
      sessions: [ .sessions[]
                  | { sid, name, project, repo, branch, cwd, token, note,
                      sev, age, cost: (.context.cost_usd // null),
                      pipeline: (if .pipeline == null then null
                                 else {feature: .pipeline.feature, phase: .pipeline.phase,
                                       status: .pipeline.status, cost: .pipeline.cost} end) } ] }'     >"$ROSTER.tmp" 2>/dev/null && mv "$ROSTER.tmp" "$ROSTER" 2>/dev/null
  return 0
}

render() {
  local snap="$1"
  write_roster "$snap"
  local count
  count=$(printf '%s' "$snap" | jq '.sessions | length')

  # Account-wide usage, above the table because it is the one fact that is not
  # about any single row. Absent until `ccwatch install-statusline` is wired,
  # and it says which rather than showing nothing.
  printf '%s' "$snap" | jq -r --argjson now "$(date '+%s')" \
    --arg d "$_c_dim" --arg b "$_c_bold" --arg y "$_c_yellow" --arg r "$_c_red" --arg z "$_c_reset" \
    --argjson usage_stale "$CCWATCH_USAGE_STALE" '
    def dur(s): if s == null then "?"
      elif s < 60    then "\(s|floor)s"
      elif s < 3600  then "\((s/60)|floor)m"
      elif s < 86400 then "\((s/3600)|floor)h"
      else                "\((s/86400)|floor)d" end;
    # A percentage is coloured by how close it is to the limit, not decoratively.
    def band(p): if p >= 90 then $r elif p >= 70 then $y else $z end;
    def gauge(nm; x):
      if x == null then empty
      else "\($d)\(nm)\($z) \(band(x.used_percentage))\($b)\(x.used_percentage|floor)%\($z)"
           + ( if x.resets_at == null then ""
               else " \($d)(resets \(dur(x.resets_at - $now)))\($z)" end )
      end;
    if .usage == null then
      "\($d)usage: not reporting — run: ccwatch install-statusline\($z)"
    elif (.usage.age // 0) > $usage_stale then
      # The numbers are withheld, not annotated. A percentage on screen is read
      # as current no matter what is printed next to it.
      "\($y)usage: last reading is \(dur(.usage.age)) old — not shown\($z)"
      + " \($d)(is the statusline still running? ccwatch doctor)\($z)"
    else
      ( [ gauge("5h"; .usage.five_hour),
          gauge("7d"; .usage.seven_day),
          gauge("7d-opus"; .usage.seven_day_opus) ] | join("  ") )
      # The reading has an age, and past a minute it is stated rather than
      # presented as current.
      + ( if .usage.age > 60 then "  \($d)[\(dur(.usage.age)) old]\($z)" else "" end )
    end' || say "${_c_red}x${_c_reset} usage header failed to render — run: ccwatch doctor"

  # Only shown under pressure. A monitoring tool that reports normal conditions
  # on every refresh trains you to skip the line that eventually is not normal.
  #
  # Placed above the "no live sessions" return on purpose: an empty session list
  # is exactly the situation where the reason matters most.
  printf '%s' "$snap" | jq -r --arg r "$_c_red" --arg d "$_c_dim" --arg z "$_c_reset" '
    if (.host // null) == null or ((.host.pressure // false) | not) then empty
    else "\($r)! host under memory pressure\($z) \($d)swap \(.host.swap_used_pct)% used"
         + " (\(.host.swap_used_mb)/\(.host.swap_total_mb)MB), \(.host.ram_free_mb)MB RAM free"
         + " — the OS may kill sessions, and a killed session looks exactly"
         + " like a clean exit\($z)"
    end' || true
  say ""

  if [ "$count" -eq 0 ]; then
    say "${_c_dim}No live Claude Code sessions.${_c_reset}"
    say "${_c_dim}Reboot or crash? ${_c_reset}ccwatch resume${_c_dim} rebuilds the list from transcripts.${_c_reset}"
    return 0
  fi

  printf '%s' "$snap" | jq -r --argjson now "$(date '+%s')" '
    def dur(s): if s == null then "-"
      elif s < 60      then "\(s|floor)s"
      elif s < 3600    then "\((s/60)|floor)m"
      elif s < 86400   then "\((s/3600)|floor)h"
      else                  "\((s/86400)|floor)d" end;
    .sessions[] |
    [ .sev, .name, .project, .token,
      dur(.age),
      # Blank rather than a guess: only sessions with a statusline report this,
      # so headless rows legitimately have nothing here.
      ( if .context == null or .context.used_percentage == null then ""
        else "\(.context.used_percentage|floor)%" end ),
      # The LAST column carries the reason a row is flagged, so that the verdict
      # is never asserted without the measurement that produced it.
      ( if .waited != null then "\(.note) \(dur(.waited))"
        elif .note == "quiet" then "quiet \(dur(.quiet))"
        elif .note != "" then .note
        elif .quiet != null then "\(dur(.quiet)) ago"
        else "-" end ),
      # The pipeline sub-row carries its OWN severity, so an idle session above
      # a crashed run reads as two separate true statements instead of one
      # muddled one.
      ( if .pipeline == null then ""
        else [ .psev,
               .pipeline.feature,
               "\(.pipeline.phase)/\(if .pipeline.crashed then "CRASHED" else .pipeline.status end)",
               (.pipeline.model // ""),
               (.pipeline.cost | .*100 | round | ./100 | tostring),
               ( if .pipeline.crashed and .pipeline.started_at != null
                 then "started \(dur($now - (.pipeline.started_at|fromdate))) ago — needs a rerun"
                 elif .pipeline.status == "needs_input" then "the phase stopped to ask you something"
                 elif .pipeline.crashed then "needs a rerun"
                 else "" end ) ] | join("|")
        end )
    ] | @tsv' | awk -F'\t' \
      -v red="$_c_red" -v yel="$_c_yellow" -v grn="$_c_green" -v cyn="$_c_cyan" \
      -v dim="$_c_dim" -v bold="$_c_bold" -v mag="$_c_magenta" -v rst="$_c_reset" '
    { sev[NR]=$1; name[NR]=$2; proj[NR]=$3; tok[NR]=$4; age[NR]=$5; ctx[NR]=$6; last[NR]=$7; pipe[NR]=$8
      if (length($2)>w1) w1=length($2)
      if (length($3)>w2) w2=length($3)
      if (length($4)>w3) w3=length($4)
      if (length($5)>w4) w4=length($5)
      if (length($6)>w5) w5=length($6)
      n=NR
    }
    function glyph(s) { return (s==4) ? "*" : (s==3) ? "!" : (s==2) ? "+" : (s==1) ? "~" : "-" }
    function colour(s) { return (s==4) ? mag : (s==3) ? red : (s==2) ? grn : (s==1) ? cyn : dim }
    END {
      if (w1<4) w1=4; if (w2<7) w2=7; if (w3<6) w3=6; if (w4<3) w4=3; if (w5<3) w5=3
      printf "%s%-*s  %-*s  %-*s  %-*s  %*s  %s%s\n", bold, w1,"NAME", w2,"PROJECT", w3+2,"STATUS", w4,"AGE", w5,"CTX", "LAST", rst
      for (i=1;i<=n;i++) {
        s=sev[i]+0
        # A context window past 80% is worth seeing before the session
        # compacts under you mid-task.
        cc = dim
        if (ctx[i] != "") { v = ctx[i]+0; cc = (v>=80) ? red : (v>=60) ? yel : dim }
        printf "%-*s  %-*s  %s%s %-*s%s  %-*s  %s%*s%s  %s%s%s\n", \
          w1,name[i], w2,proj[i], colour(s),glyph(s), w3,tok[i], rst, w4,age[i], \
          cc,w5,ctx[i],rst, dim,last[i],rst
        if (pipe[i] != "") {
          split(pipe[i], p, "|")
          ps = p[1]+0
          printf "  %s%s\\_%s %s%s%s  %s%s%s  %s%s $%s%s", \
            dim, colour(ps), rst, dim,p[2],rst, colour(ps),p[3],rst, dim,p[4],p[5],rst
          if (p[6] != "") printf "  %s%s%s", colour(ps), p[6], rst
          printf "\n"
        }
      }
    }'

  # Runs that stopped with nobody left holding them. Printed above the footer
  # because it is the one section that reports work already lost, rather than
  # work in progress.
  if [ "$(printf '%s' "$snap" | jq '.unfinished | length')" -gt 0 ]; then
    say ""
    say "${_c_bold}UNFINISHED RUNS${_c_reset} ${_c_dim}— stopped in the last ${CCWATCH_UNFINISHED_HOURS}h, and no live session is holding them${_c_reset}"
    printf '%s' "$snap" | jq -r '
      def dur(s): if s == null then "?"
        elif s < 3600  then "\((s/60)|floor)m"
        elif s < 86400 then "\((s/3600)|floor)h"
        else                "\((s/86400)|floor)d" end;
      .unfinished[]
      | [ "\(.project) \(.feature)", "\(.phase)/\(.status)", (.model // ""),
          .cost,
          (if .age == null then "" else "\(dur(.age)) ago" end),
          (.sid // ""), .cwd ] | @tsv' \
    | awk -F'\t' -v red="$_c_red" -v mag="$_c_magenta" -v cyn="$_c_cyan" \
                 -v dim="$_c_dim" -v rst="$_c_reset" '
      { c = ($2 ~ /needs_input/) ? mag : red
        # Project first, then feature: the project is what you scan for.
        n = split($1, pf, " ")
        printf "  %s%-22s%s  %s%-16s%s %s%-30s%s  %s%-7s $%.2f%s\n", \
          c,$2,rst, "",pf[1],"", dim,pf[2],rst, dim,$3, $4,rst
        if ($5 != "") printf "      %s%s%s", dim,$5,rst
        if ($6 != "") printf "  %sclaude --resume %s%s", cyn,$6,rst
        if ($5 != "" || $6 != "") printf "\n"
      }'
    local older
    older=$(printf '%s' "$snap" | jq '.unfinished_old')
    [ "${older:-0}" -gt 0 ] && say "  ${_c_dim}(+$older older — see: ccwatch resume)${_c_reset}"
  fi

  # The footer is the part you read from across the room.
  printf '%s' "$snap" | jq -r '
    [ (.sessions | length),
      ([ .sessions[] | select(.sev == 4) ] | length),
      ([ .sessions[] | select(.sev == 3) ] | length),
      ([ .sessions[] | select(.psev == 4) ] | length),
      (.unfinished | length),
      (.parse_failed // 0) ] | @tsv' | awk -F'\t' \
      -v mag="$_c_magenta" -v red="$_c_red" -v dim="$_c_dim" -v bold="$_c_bold" -v rst="$_c_reset" '
    { out = sprintf("%d live", $1)
      if ($2>0) out = out sprintf(" %s· %d waiting on you%s", mag bold, $2, rst)
      if ($4>0) out = out sprintf(" %s· %d phase(s) asking you something%s", mag bold, $4, rst)
      if ($3>0) out = out sprintf(" %s· %d suspect%s", red bold, $3, rst)
      if ($5>0) out = out sprintf(" %s· %d unfinished run(s)%s", red, $5, rst)
      if ($6>0) out = out sprintf(" %s· %d unreadable registry file(s) — run: ccwatch doctor%s", red, $6, rst)
      printf "\n%s%s\n", out, rst
    }'
}

# ============================================================== resume =======
#
# The registry cannot help here. It is a directory of pid-named files and every
# one of them is gone after a restart — which is the exact moment you need the
# list. Transcripts are what survive: append-only, one file per session, and
# every line carries its own cwd, branch and session id. So the resume list is
# rebuilt from those, and cross-referenced against the live registry only to
# drop the sessions that are already running.

cmd_resume() {
  local limit=20 with_cd=0 all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--limit) limit="${2:-20}"; shift 2 || exit 3;;
      --cd)       with_cd=1; shift;;
      --all)      all=1; shift;;
      *) die "resume: unrecognised argument '$1'" "try: ccwatch resume [-n N] [--cd] [--all]";;
    esac
  done

  [ -d "$PROJ_DIR" ] || die "no transcript directory at $PROJ_DIR" \
    "nothing to resume from — has Claude Code ever run as this user?"

  TMP=$(mktemp -d) || die "could not create a temp directory"

  # Live sessions are excluded: resuming one that is already running is how you
  # end up with two processes on one conversation. This read has to be `.sessions`
  # — when it was `.[]` jq errored on every invocation, the exclusion list came
  # out empty, and resume cheerfully offered to reopen sessions that were still
  # running. The error went to stderr under a heading that looked fine.
  local snap
  snap=$(snapshot)
  printf '%s' "$snap" | jq -r '.sessions[].sid' | sort >"$TMP/live.txt"

  # What was live the last time anything looked. After a reboot the registry is
  # empty and transcripts alone cannot tell you which sessions were open
  # TOGETHER, what each was called, or what it was doing when everything
  # stopped. That is the part you would otherwise reconstruct from memory.
  if [ -f "$ROSTER" ]; then
    local rage rn
    rage=$(jq -r --argjson now "$(date '+%s')" '($now - (.at // 0))' "$ROSTER" 2>/dev/null) || rage=""
    rn=$(jq -r '.sessions | length' "$ROSTER" 2>/dev/null) || rn=0
    if [ -n "$rage" ] && [ "${rn:-0}" -gt 0 ]; then
      local gone
      gone=$(jq -c --slurpfile live <(printf '%s' "$snap" | jq -c '[.sessions[].sid]') '
        ( $live[0] // [] ) as $l
        | [ .sessions[] | select( ([.sid] | inside($l)) | not ) ]' "$ROSTER" 2>/dev/null)
      if [ "$(printf '%s' "${gone:-[]}" | jq 'length')" -gt 0 ]; then
        say "${_c_bold}LAST KNOWN ROSTER${_c_reset} ${_c_dim}— $rn session(s) were live $(
          awk -v s="$rage" 'BEGIN{ if (s<60) printf "%ds", s; else if (s<3600) printf "%dm", s/60;
            else if (s<86400) printf "%dh", s/3600; else printf "%dd", s/86400 }'
        ) ago; these are not running now${_c_reset}"
        say ""
        printf '%s' "$gone" | jq -r --arg c "$_c_cyan" --arg d "$_c_dim" \
            --arg m "$_c_magenta" --arg r "$_c_red" --arg z "$_c_reset" '
          .[]
          | ( if .sev == 4 then $m elif .sev == 3 then $r else $d end ) as $col
          | "  \($col)\(.name)\($z) \($d)\(.project // "?")\($z)"
            + " \($col)\(.token // "?")\($z)"
            + (if .note != null and .note != "" then " \($d)(\(.note))\($z)" else "" end)
            + (if .pipeline != null then
                 " \($d)· \(.pipeline.feature) \(.pipeline.phase)/\(.pipeline.status)\($z)"
               else "" end)
            + "
      \($c)claude --resume \(.sid)\($z)  \($d)(\(.cwd))\($z)"'
        say ""
      fi
    fi
  fi

  local window=()
  [ "$all" -eq 1 ] || window=(-mtime "-$CCWATCH_RESUME_DAYS")

  # Newest first, and only as many as asked for — tailing 1200 transcripts to
  # print 20 rows is waste the user pays for in latency.
  #
  # -maxdepth 2 is load-bearing. Subagent transcripts live one level deeper, at
  # <sessionId>/subagents/agent-*.jsonl, and recursing into them offered
  # `claude --resume agent-a9cec8c7fe67e1238` — a task id, not a session id, so
  # the command could not have worked. 131 of them on this machine, crowding out
  # the real sessions.
  find "$PROJ_DIR" -maxdepth 2 -name '*.jsonl' -type f "${window[@]}" -print0 2>/dev/null \
    | xargs -0 stat -f '%m %N' 2>/dev/null \
    | sort -rn >"$TMP/all.txt"

  local shown=0 mtime path sid last cwd branch state
  say "${_c_bold}RESUMABLE${_c_reset} ${_c_dim}— not currently running, newest first${_c_reset}"
  say ""
  while read -r mtime path; do
    [ "$shown" -ge "$limit" ] && break
    sid=$(basename "$path" .jsonl)
    grep -qxF "$sid" "$TMP/live.txt" && continue

    # ⚠️ The last line with a CWD, not simply the last line.
    #
    # A transcript can end with metadata records that carry no cwd —
    # `last-prompt`, `mode`, `pr-link` and others are written after the
    # conversation. The first version read `tail -1`, found a null cwd, and
    # skipped the session entirely: a session killed moments earlier was
    # missing from its own recovery list, which is precisely the case this
    # command exists for. Found by killing a session and looking for it.
    last=$(tail -40 "$path" 2>/dev/null \
           | jq -R -c 'fromjson? // empty | select(.cwd != null)' 2>/dev/null | tail -1)
    cwd=$(printf '%s' "$last" | jq -r '.cwd // empty' 2>/dev/null)
    branch=$(printf '%s' "$last" | jq -r '.gitBranch // empty' 2>/dev/null)
    [ -n "$cwd" ] || continue
    # A sidechain is a subagent's transcript, not a conversation you can reopen.
    # Checked as well as the depth limit above, because the two failures are
    # independent: one guards the path, this guards the content.
    [ "$(printf '%s' "$last" | jq -r '.isSidechain // false' 2>/dev/null)" = "true" ] && continue
    # The id comes from INSIDE the transcript, not from the filename. That makes
    # the printed `--resume` correct by construction rather than by the
    # filename happening to be a session id.
    local realsid
    realsid=$(printf '%s' "$last" | jq -r '.sessionId // empty' 2>/dev/null)
    [ -n "$realsid" ] && sid="$realsid"
    # A session whose directory is gone cannot be resumed there; say so rather
    # than handing over a command that will fail.
    local gone=""
    [ -d "$cwd" ] || gone=" ${_c_red}(directory is gone)${_c_reset}"

    local ago
    ago=$(awk -v s="$(( $(date '+%s') - mtime ))" 'BEGIN{
      if (s<60) printf "%ds", s; else if (s<3600) printf "%dm", s/60;
      else if (s<86400) printf "%dh", s/3600; else printf "%dd", s/86400 }')

    printf '%s%-22s%s %s%-10s%s %s%s%s%s\n' \
      "$_c_bold" "$(basename "$cwd")" "$_c_reset" \
      "$_c_dim" "$ago ago" "$_c_reset" \
      "$_c_dim" "${branch:+branch $branch}" "$_c_reset" "$gone"

    # If this session was a spec-run phase, whether that phase finished is the
    # single most important thing to know before resuming — it says whether the
    # run needs a rerun or just a reattach.
    #
    # Matched on THIS session's id, across every state file in the repo. The
    # first version took the newest state file in the directory and reported
    # whatever phase it found unfinished, which attached a stranger's crash to
    # an unrelated session.
    for state in "$cwd"/specs/*/.pipeline/state.json; do
      [ -f "$state" ] || continue
      jq -r --arg sid "$sid" --arg d "$_c_dim" --arg r "$_c_red" --arg z "$_c_reset" '
        ( .phases // {} ) | to_entries
        | [ .[] | select( ( [ .value.session_id // empty ] + (.value.sessions // []) )
                          | index($sid) ) ]
        | if length == 0 then empty
          else .[-1] as $p
            | ( if ($p.value.status | . == "running" or . == "interrupted" or . == "failed")
                then " — needs a rerun"
                elif $p.value.status == "needs_input" then " — it stopped to ask you something"
                else "" end ) as $verdict
            # A phase that finished is reported too, without an alarm: knowing
            # this session already did its job is also worth knowing.
            | "  \($d)\\_ pipeline:\($z) \(if $verdict == "" then $d else $r end)\($p.key)/\($p.value.status)\($z) \($d)\($p.value.model // "?")\($verdict)\($z)"
          end' "$state" 2>/dev/null
    done

    if [ "$with_cd" -eq 1 ]; then
      printf '  %scd %s && claude --resume %s%s\n' "$_c_cyan" "$cwd" "$sid" "$_c_reset"
    else
      printf '  %sclaude --resume %s%s  %s(%s)%s\n' "$_c_cyan" "$sid" "$_c_reset" "$_c_dim" "$cwd" "$_c_reset"
    fi
    say ""
    shown=$((shown + 1))
  done <"$TMP/all.txt"

  if [ "$shown" -eq 0 ]; then
    say "${_c_dim}Nothing resumable in the last $CCWATCH_RESUME_DAYS days.${_c_reset}"
    say "${_c_dim}Widen the window with ${_c_reset}ccwatch resume --all${_c_dim}.${_c_reset}"
  fi
}

# ============================================================== events ======
#
# Polling can miss a transition that opens and closes between two ticks. Hooks
# cannot: Claude Code fires them synchronously. So the hook log is the durable,
# gap-free record — it answers "did anything need me while I was away", which no
# amount of polling can reconstruct after the fact.

cmd_hook() {
  local event="${1:-unknown}"
  # A hook that fails must never break the session that called it. Everything
  # here is best-effort and always exits 0.
  mkdir -p "$CCWATCH_HOME" 2>/dev/null || exit 0
  local payload
  payload=$(cat 2>/dev/null) || payload=""
  printf '%s' "$payload" | jq -c --arg e "$event" --arg t "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" '
    { at: $t, event: $e,
      session_id: (.session_id // .sessionId // null),
      cwd: (.cwd // null),
      message: (.message // .notification // null),
      title: (.title // null) }' >>"$EVENTS" 2>/dev/null \
    || printf '{"at":"%s","event":"%s","note":"unparseable hook payload"}\n' \
         "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$event" >>"$EVENTS" 2>/dev/null
  exit 0
}

cmd_log() {
  local limit="${1:-30}"
  [ -f "$EVENTS" ] || die "no event log at $EVENTS" \
    "the hooks are not installed yet — run: ccwatch install-hooks"
  tail -"$limit" "$EVENTS" | jq -r --arg d "$_c_dim" --arg m "$_c_magenta" --arg z "$_c_reset" '
    "\($d)\(.at)\($z)  " +
    (if .event == "Notification" then "\($m)\(.event)\($z)" else .event end) +
    "  \($d)\((.cwd // "?") | split("/") | last)\($z)" +
    (if .message then "  \(.message)" else "" end)' 2>/dev/null
}

# install-hooks writes to the user'"'"'s settings.json, so it shows the exact change
# and asks first. It is also idempotent: re-running it after an upgrade repairs
# the entries rather than appending a second copy.
cmd_install_hooks() {
  local settings="$CLAUDE_HOME/settings.json"
  local self
  self=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/$(basename -- "${BASH_SOURCE[0]}")
  [ -f "$settings" ] || die "no settings file at $settings" \
    "create it first, or point CLAUDE_CONFIG_DIR at the right directory"

  need jq

  local proposed
  proposed=$(jq --arg self "$self" '
    def entry($event): {
      matcher: "",
      hooks: [ { type: "command", command: "\($self) hook \($event)", timeout: 5 } ]
    };
    # Notification is the one that matters: it fires when Claude needs you.
    # The lifecycle three make the log reconstructable after a crash.
    reduce ["Notification","SessionStart","SessionEnd","Stop"][] as $e
      ( .;
        .hooks[$e] = ( [ ( .hooks[$e] // [] )[]
                         | select( [ .hooks[]?.command? ]
                                   | map(. // "" | contains("ccwatch hook")) | any | not ) ]
                       + [ entry($e) ] ) )
  ' "$settings") || die "could not compute the settings change" "is $settings valid JSON?"

  say "${_c_bold}This will add four hooks to${_c_reset} $settings"
  say ""
  printf '%s' "$proposed" | jq '.hooks' | sed 's/^/  /'
  say ""
  say "${_c_dim}Events will be appended to $EVENTS${_c_reset}"
  say ""
  printf 'Apply? [y/N] '
  local reply=""
  read -r reply
  case "$reply" in
    y|Y|yes|YES) ;;
    *) say "Nothing changed."; return 0;;
  esac

  # Backup first, and write via a temp file so an interrupted write cannot
  # leave a truncated settings.json behind.
  local backup
  backup="$settings.ccwatch-backup.$(date '+%Y%m%d%H%M%S')"
  cp "$settings" "$backup" || die "could not back up $settings"
  printf '%s\n' "$proposed" >"$settings.ccwatch-tmp" \
    && mv "$settings.ccwatch-tmp" "$settings" \
    || die "could not write $settings" "your original is at $backup"
  mkdir -p "$CCWATCH_HOME"
  say "${_c_green}Installed.${_c_reset} Previous settings saved to $backup"
  say "${_c_dim}New sessions pick the hooks up; existing ones need a restart.${_c_reset}"
}



# ============================================================ transcript ====
#
# The recent conversation for one session, so you can see what an agent is
# actually doing before deciding what to say to it.
#
# ⚠️ Transcripts contain entire tool outputs and file contents. Reading one
# whole and shipping it to a browser would mean megabytes per poll and would
# put whatever those files contain on a socket. So:
#   - only the tail of the file is read, by bytes, never the whole thing
#   - assistant text and user turns are kept in full-ish (truncated)
#   - tool USE is reduced to the tool name and a short argument summary
#   - tool RESULTS are reduced to a size, not the content
# What survives is enough to see what is going on and nothing more.
CCWATCH_TAIL_BYTES="${CCWATCH_TAIL_BYTES:-400000}"
CCWATCH_TAIL_TEXT="${CCWATCH_TAIL_TEXT:-1200}"

transcript_path() { # transcript_path <sid>
  ls -t "$PROJ_DIR"/*/"$1".jsonl 2>/dev/null | head -1
}

cmd_convo() {
  local as_json=0 n=25 target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1; shift;;
      -n)     n="${2:-25}"; shift 2 || exit 3;;
      -*) die "convo: unrecognised option '$1'" "usage: ccwatch convo [-n N] [--json] <name|session-id|pid>";;
      *) target="$1"; shift;;
    esac
  done
  [ -n "$target" ] || die "convo: no session given" \
    "usage: ccwatch convo [-n N] <name|session-id|pid>"

  local t sid name file
  # A session id is accepted directly so an exited session can still be read —
  # resolve_target only knows about live ones.
  if [ -f "$(transcript_path "$target")" ]; then
    sid="$target"; name="$target"
  else
    t=$(resolve_target "$target") || exit 1
    sid=$(printf '%s' "$t" | jq -r .sid)
    name=$(printf '%s' "$t" | jq -r .name)
  fi
  file=$(transcript_path "$sid")
  [ -n "$file" ] || die "no transcript for $name" \
    "the session may be too new to have written one, or an embedded-SDK session, which never does"

  local turns
  # -R with fromjson?, not plain jq. A byte-tail starts mid-line, so the first
  # line is invalid JSON — and parsing the stream as JSON makes jq abort the
  # WHOLE thing on it. The comment about this was here before the code was.
  turns=$(tail -c "$CCWATCH_TAIL_BYTES" "$file" \
    | jq -R -c --argjson lim "$CCWATCH_TAIL_TEXT" '
        (fromjson? // empty)
        | select(.type == "user" or .type == "assistant")
        | { at: .timestamp,
            role: .type,
            origin: (.origin.kind // null),
            from: (.origin.from // null),
            # A tool result arrives as a user-role turn. It is not something
            # the user said, and showing it as one is actively misleading.
            # A user-role turn is not necessarily something the user SAID. Tool
            # results, task notifications and system reminders all arrive that
            # way, and labelling them "you" misattributes machine output to the
            # person — which matters most in exactly the situation you opened
            # this view for.
            kind: (( [ (.message.content
                        | if type == "string" then [{type:"text", text:.}] else . end)[]?
                       | select(.type == "text") | .text ] | first // "") as $first
                   | if .toolUseResult != null then "tool_result"
                     elif .type != "user" then "assistant"
                     # Origin first. A message from another session is a peer
                     # message whatever else is true of the record — checking
                     # the system heuristics ahead of this relabelled real
                     # agent-to-agent traffic as "system", which hides exactly
                     # the thing the peer graph exists to surface.
                     elif (.origin.kind == "peer") then "said"
                     elif ($first | startswith("<task-notification>")) then "system"
                     elif ($first | startswith("<system-reminder>")) then "system"
                     elif ($first | startswith("<local-command")) then "system"
                     elif (.isMeta // false) then "system"
                     else "said" end),
            text: ( [ (.message.content
                       | if type == "string" then [{type:"text", text:.}] else . end)[]?
                      | if .type == "text" then .text
                        elif .type == "tool_use" then
                          "→ \(.name)" +
                          ( (.input // {}) | if type == "object" then
                              ( [ .command?, .file_path?, .path?, .pattern?, .description? ]
                                | map(select(. != null) | tostring) | first
                                | if . == null then "" else ": \(.[0:120])" end )
                            else "" end )
                        elif .type == "tool_result" then
                          "  ← \((.content // "" | tostring | length)) bytes"
                        elif .type == "thinking" then "· thinking"
                        else "· \(.type)" end ] | join("\n") | .[0:$lim] ) }' \
    2>/dev/null | jq -s --argjson n "$n" '.[-$n:]')

  # `from` on a peer message is a socket path like uds:/tmp/cc-socks/74260.sock.
  # The pid in it is the only useful part, so it is resolved to the name you
  # know that session by. Cheap: the registry is one jq now.
  local names
  names=$(collect_sessions | jq -c '[ .rows[] | {key: (.pid|tostring), value: .name} ] | from_entries')
  turns=$(printf '%s' "${turns:-[]}" | jq -c --argjson names "${names:-\{\}}" '
    map(if .from == null then .
        else .from = ( (.from | capture("(?<pid>[0-9]+)\\.sock$") | .pid) as $pid
                       | $names[$pid] // ("pid " + $pid) ) end)' 2>/dev/null)     || turns="${turns:-[]}"

  if [ "$as_json" -eq 1 ]; then
    jq -cn --arg sid "$sid" --arg name "$name" --argjson turns "${turns:-[]}" \
      '{session_id: $sid, name: $name, turns: $turns}'
    return 0
  fi

  say "${_c_bold}$name${_c_reset} ${_c_dim}${sid:0:8} — last $(printf '%s' "${turns:-[]}" | jq 'length') turns${_c_reset}"
  say ""
  printf '%s' "${turns:-[]}" | jq -r --arg d "$_c_dim" --arg c "$_c_cyan" \
      --arg g "$_c_green" --arg m "$_c_magenta" --arg z "$_c_reset" '
    .[]
    | ( if .kind == "said" then
            (if .origin == "peer" then $m + "peer(" + (.from // "?") + ")" else $c + "you" end)
        elif .kind == "system" then $d + "system"
        elif .kind == "tool_result" then $d + "result"
        else $g + "claude" end ) as $who
    | "\($d)\(.at[11:19])\($z) \($who)\($z)  "
      + ((.text // "") | gsub("\n"; "\n                   ") )'
}




# ================================================================== kill ====
#
# The one destructive thing this tool does, so it is the most careful.
#
# What survives a kill: the transcript. It is append-only and flushed as the
# session runs, so the conversation is kept and `claude --resume <sid>` reopens
# it — the same guarantee `claude stop` gives for a background session. That is
# what makes this recoverable rather than a deletion, and it is printed every
# time so the operator does not have to remember it.
#
# What does NOT survive: whatever was in flight. A tool call mid-execution, an
# unwritten file, a spec-run phase halfway through a paid model call. So the
# cases where that matters are refused by default rather than warned about,
# because a warning in a list of nineteen rows is a warning nobody reads.
CCWATCH_KILL_GRACE="${CCWATCH_KILL_GRACE:-8}"

cmd_kill() {
  local force=0 yes=0 target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1; shift;;
      -y|--yes) yes=1; shift;;
      -*) die "kill: unrecognised option '$1'" \
              "usage: ccwatch kill [--force] [-y] <name|session-id|pid>";;
      *) target="$1"; shift;;
    esac
  done
  [ -n "$target" ] || die "kill: no session given" \
    "usage: ccwatch kill [--force] [-y] <name|session-id|pid>"

  local t
  t=$(resolve_target "$target") || exit 1

  local name sid pid kindv rss tok phase pstatus prunner
  name=$(printf '%s' "$t" | jq -r '.name')
  sid=$(printf '%s' "$t" | jq -r '.sid')
  pid=$(printf '%s' "$t" | jq -r '.pid')
  rss=$(printf '%s' "$t" | jq -r '.rss_mb // "?"')
  tok=$(printf '%s' "$t" | jq -r '.token')
  pstatus=$(printf '%s' "$t" | jq -r '.pipeline.status // ""')
  phase=$(printf '%s' "$t" | jq -r '.pipeline.phase // ""')
  prunner=$(printf '%s' "$t" | jq -r '.pipeline.runner_pid // ""')
  kindv=$(jq -r '.kind // "interactive"' "$SESS_DIR/$pid.json" 2>/dev/null) || kindv="interactive"

  # --- the refusals ---------------------------------------------------------
  # A spec-run phase that is genuinely running is a paid model call in flight.
  # Killing it wastes what has been spent and leaves the pipeline recording a
  # crash. Refused, not warned.
  if [ "$pstatus" = "running" ] && [ -n "$prunner" ] && [ "$force" -eq 0 ]; then
    if kill -0 "$prunner" 2>/dev/null; then
      err "$name is running spec-run phase '$phase' right now"
      say "  ${_c_dim}Killing it aborts a paid model call mid-flight and leaves the"
      say "  pipeline recording a crash. Let it finish, or:${_c_reset} ccwatch kill --force $target"
      exit 1
    fi
  fi
  # Mid-turn means a tool call may be part-applied. The transcript survives
  # either way, but the working tree might be left half-edited.
  if [ "$tok" = "busy" ] && [ "$force" -eq 0 ]; then
    err "$name is mid-turn (busy)"
    say "  ${_c_dim}A tool call may be part-way through, so the working tree could be"
    say "  left half-edited. Wait for it to go idle, or:${_c_reset} ccwatch kill --force $target"
    exit 1
  fi

  say "${_c_bold}Kill $name${_c_reset} ${_c_dim}($tok, ${rss}MB, pid $pid)${_c_reset}"
  say "  ${_c_dim}The conversation is kept. Reopen it with:${_c_reset}"
  say "  ${_c_cyan}claude --resume $sid${_c_reset}"
  [ "$tok" = "waiting" ] && \
    say "  ${_c_yellow}!${_c_reset} ${_c_dim}This session is waiting on you — whatever it asked will be lost from the dialog.${_c_reset}"
  if [ "$yes" -eq 0 ]; then
    printf 'Kill it? [y/N] '
    local reply=""
    read -r reply
    case "$reply" in y|Y|yes|YES) ;; *) say "Nothing killed."; return 0;; esac
  fi

  # --- graceful first -------------------------------------------------------
  # A background session has a supported command for this, which does the
  # bookkeeping ccwatch would otherwise have to guess at. Use it.
  local method=""
  if [ "$kindv" = "bg" ] && command -v claude >/dev/null 2>&1; then
    method="claude stop"
    claude stop "${sid:0:8}" >/dev/null 2>&1 || method="TERM"
  else
    method="TERM"
  fi
  # SIGTERM, never SIGKILL: a terminated session gets to flush. Escalation is
  # not offered, because a session that ignores TERM is doing something and
  # the right answer is to look at it rather than to insist.
  [ "$method" = "TERM" ] && kill -TERM "$pid" 2>/dev/null

  local waited=0
  while [ "$waited" -lt "$CCWATCH_KILL_GRACE" ]; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
    waited=$((waited + 1))
  done

  if kill -0 "$pid" 2>/dev/null; then
    warn "$name is still running after ${CCWATCH_KILL_GRACE}s (sent $method)"
    say "  ${_c_dim}It may be finishing a tool call. Look at it before insisting:${_c_reset}"
    say "  ${_c_cyan}ccwatch convo $sid${_c_reset}"
    kill_record "$t" "$method" "still-running"
    exit 1
  fi

  say "${_c_green}killed${_c_reset} $name ${_c_dim}— ${rss}MB released, conversation kept${_c_reset}"
  kill_record "$t" "$method" "killed"
}

# Every kill is recorded. "Who stopped that agent, and why is it not running"
# needs an answer afterwards, and a monitoring tool that can destroy without
# leaving a trace is one you cannot audit.
kill_record() { # kill_record <target-json> <method> <outcome>
  mkdir -p "$CCWATCH_HOME" 2>/dev/null || return 0
  jq -cn --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
         --arg sid "$(printf '%s' "$1" | jq -r .sid)" \
         --arg name "$(printf '%s' "$1" | jq -r .name)" \
         --arg cwd "$(printf '%s' "$1" | jq -r .cwd)" \
         --argjson rss "$(printf '%s' "$1" | jq '.rss_mb // 0')" \
         --arg method "$2" --arg outcome "$3" \
    '{at:$at, event:"ccwatch.kill", session_id:$sid, target:$name, cwd:$cwd,
      rss_mb:$rss, method:$method, outcome:$outcome}' >>"$EVENTS" 2>/dev/null || true
  return 0
}

# ================================================================= host =====
#
# Why an agent died, when it died for a reason that had nothing to do with
# Claude.
#
# A session killed by the OS under memory pressure leaves exactly the same
# trace as one that exited cleanly: its registry file disappears. ccwatch can
# say the session is gone; without this it cannot say the machine was out of
# swap when it went. That turns "it died mysteriously" — the original complaint
# this tool was built for — into a cause.
#
# Measured on the machine this was written on: 26.3GB of 27.6GB swap in use and
# 59MB of free RAM, with nineteen sessions running and no single large
# consumer. The OS was reaping background tasks at the time.
CCWATCH_SWAP_WARN="${CCWATCH_SWAP_WARN:-80}"

collect_host() {
  python3 -c '
import json, re, subprocess

def sh(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""

out = {}

# Free RAM, from vm_stat. "Free" alone is misleading on macOS — the compressor
# is holding real pages that the system has already had to squeeze — so both
# are reported.
vm = sh("vm_stat")
m = re.search(r"page size of (\d+)", vm)
page = int(m.group(1)) if m else 4096
def pages(label):
    mm = re.search(label + r":\s+(\d+)", vm)
    return int(mm.group(1)) if mm else 0
if vm:
    out["ram_free_mb"] = round(pages("Pages free") * page / 1048576)
    out["compressed_mb"] = round(pages("Pages occupied by compressor") * page / 1048576)

# Swap. This is the number that actually predicts a kill.
sw = sh("sysctl", "-n", "vm.swapusage")
m = re.search(r"total = ([\d.]+)M\s+used = ([\d.]+)M", sw)
if m:
    total, used = float(m.group(1)), float(m.group(2))
    out["swap_total_mb"] = round(total)
    out["swap_used_mb"] = round(used)
    out["swap_used_pct"] = round(used / total * 100) if total else None

la = sh("sysctl", "-n", "vm.loadavg")
m = re.search(r"([\d.]+)", la)
if m:
    out["load1"] = float(m.group(1))

print(json.dumps(out) if out else "null")
' 2>/dev/null || printf 'null'
}

# ============================================================ pending asks ==
#
# WHAT a blocked session is asking, not merely that it is blocked.
#
# `waitingFor` in the registry gives a label ("input needed"). The actual
# question — its text, and every option with its description — is in the
# transcript, as the input to an `AskUserQuestion` tool call. It is the single
# most valuable thing this tool can show: a session has stopped, and here is
# exactly what it wants.
#
# The pending one is the tool_use with NO matching tool_result. An answered
# question has a result referencing its id, so "unanswered" is a fact in the
# file rather than a guess from position or recency.
CCWATCH_ASK_BYTES="${CCWATCH_ASK_BYTES:-600000}"

# collect_asks — pending questions for the given session ids.
#
# Only called for sessions the registry says are waiting, so this is normally
# zero or one file reads, not one per session.
collect_asks() { # collect_asks <sid>...
  local sid file
  [ $# -gt 0 ] || { printf '{}'; return 0; }
  {
    for sid in "$@"; do
      file=$(transcript_path "$sid")
      [ -n "$file" ] || continue
      # ⚠️ Seeks to the LAST AskUserQuestion by byte offset rather than reading
      # a fixed-size tail.
      #
      # A fixed tail is wrong in both directions. Too small and a pending
      # question just outside the window is missed — measured on a real 4.9MB
      # transcript whose last question sat 850KB from the end. Too small the
      # other way and a tool_result can fall outside the window while its
      # tool_use is inside it, which makes an ANSWERED question look pending.
      #
      # A result always appears after its call, so reading from the last call
      # to EOF is both sufficient and bounded, whatever the file size.
      python3 -c '
import json, sys

path, sid = sys.argv[1], sys.argv[2]
try:
    with open(path, "rb") as fh:
        data = fh.read()
except OSError:
    sys.exit(0)

i = data.rfind(b"\"AskUserQuestion\"")
if i < 0:
    sys.exit(0)
# Back up to the start of that line so the record parses.
start = data.rfind(b"\n", 0, i) + 1

asked_id = None
asked_input = None
answered = set()
for line in data[start:].split(b"\n"):
    if not line.strip():
        continue
    try:
        rec = json.loads(line)
    except ValueError:
        continue
    msg = rec.get("message") or {}
    content = msg.get("content")
    if not isinstance(content, list):
        continue
    for block in content:
        if not isinstance(block, dict):
            continue
        if (block.get("type") == "tool_use"
                and block.get("name") == "AskUserQuestion"
                and asked_id is None):
            asked_id = block.get("id")
            asked_input = block.get("input") or {}
        elif block.get("type") == "tool_result" and block.get("tool_use_id"):
            answered.add(block["tool_use_id"])

if asked_id is None or asked_id in answered:
    sys.exit(0)

qs = []
for q in (asked_input.get("questions") or []):
    qs.append({
        "question": q.get("question"),
        "header": q.get("header"),
        "options": [{"label": o.get("label"), "description": o.get("description")}
                    for o in (q.get("options") or [])],
    })
if qs:
    print(json.dumps({"key": sid, "value": qs}))
' "$file" "$sid" 2>/dev/null
    done
  } | jq -s 'from_entries'
}

cmd_ask() {
  local as_json=0 target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) as_json=1; shift;;
      -*) die "ask: unrecognised option '$1'" "usage: ccwatch ask [--json] [<name|session-id>]";;
      *) target="$1"; shift;;
    esac
  done

  local snap waiting
  snap=$(snapshot)
  if [ -n "$target" ]; then
    local t
    t=$(resolve_target "$target") || exit 1
    waiting=$(printf '%s' "$t" | jq -c '[.]')
  else
    # No target: everything currently blocked on you, which is the question you
    # are actually asking when you run this.
    waiting=$(printf '%s' "$snap" | jq -c '[ .sessions[] | select(.sev == 4) ]')
  fi

  local n
  n=$(printf '%s' "$waiting" | jq 'length')
  if [ "${n:-0}" -eq 0 ]; then
    say "${_c_dim}Nothing is waiting on you.${_c_reset}"
    return 0
  fi

  local sids asks
  sids=$(printf '%s' "$waiting" | jq -r '.[].sid')
  # shellcheck disable=SC2086
  asks=$(collect_asks $sids)

  if [ "$as_json" -eq 1 ]; then
    jq -cn --argjson w "$waiting" --argjson a "${asks:-\{\}}" \
      '[ $w[] | . + {questions: ($a[.sid] // null)} ]'
    return 0
  fi

  printf '%s' "$waiting" | jq -r --argjson a "${asks:-\{\}}" \
      --arg b "$_c_bold" --arg m "$_c_magenta" --arg c "$_c_cyan" \
      --arg d "$_c_dim" --arg z "$_c_reset" '
    .[]
    | ($a[.sid]) as $qs
    | "\($m)\($b)\(.name)\($z) \($d)\(.project // "?")\($z)"
      + " \($d)waiting \(if .waited == null then "" else "\(.waited | floor)s" end) — \(.note // "input needed")\($z)"
      + ( if $qs == null then
            # A permission prompt is not an AskUserQuestion and has no options
            # in the transcript. Saying so beats printing nothing.
            "\n  \($d)(no question recorded — this is a dialog, e.g. a permission"
            + " prompt. Its label is above.)\($z)"
          else
            ( $qs | to_entries | map(
                "\n  \($b)\(.value.question)\($z)"
                + ( .value.options | to_entries
                    | map("\n    \($c)\(.key + 1).\($z) \(.value.label)"
                          + (if (.value.description // "") == "" then ""
                             else "\n       \($d)\(.value.description)\($z)" end))
                    | join("") )
              ) | join("\n") )
          end )
      + "\n"'
  [ -z "$target" ] && say "${_c_dim}Answer with:${_c_reset} ccwatch send <name> \"<your answer>\""
  return 0
}

# ============================================================ send ==========
#
# Injecting a message into a session that is ALREADY RUNNING, rather than
# resuming a copy of its conversation.
#
# Claude Code listens on a per-session Unix socket — the `messagingSocketPath`
# already in the registry — and documents the wire format in its own debug log:
#
#   { echo '{"type":"auth","token":"..."}'
#     echo '{"type":"user","message":{"role":"user","content":"hello"}}'
#   } | socat - UNIX-CONNECT:/tmp/cc-socks/<pid>.sock
#
# Newline-delimited JSON, an auth line first. The token is the `peerToken` in
# ~/.claude/sessions/<pid>.<hash>.key, whose other two fields (`procStart`,
# `pidDomain`) are the same PID-reuse guard used for liveness above.
#
# ⚠️ This is the least stable thing ccwatch does. The registry and the
# transcripts are at least stable file formats; this is a protocol, and a
# version bump could change the frames. `ccwatch doctor` probes it, and
# `--dry-run` prints exactly what would be sent so the frames can be checked by
# eye against a newer Claude Code before trusting them.

# resolve_target — a name, a session id, or a pid, to one live session.
#
# Refuses an ambiguous match rather than picking one. Sending a message to the
# wrong agent is not recoverable by the tool: it has already been said.
# ⚠️ This returns a STATUS; it does not exit. It is called in a command
# substitution, and `exit` inside `$( )` kills only the subshell — so the first
# version printed "matches 2 live sessions", then carried on with an empty
# target and exited 0. The refusal was real; the enforcement was not. Caught
# only because an assertion checked the exit code as well as the message.
resolve_target() { # resolve_target <needle>  -> JSON on stdout, non-zero on failure
  local needle="$1" snap matches n
  # A non-zero snapshot and an empty snapshot are the same fact here, and both
  # go through require_json so the reason is always printed. `|| return 1` on
  # the assignment alone returned silently, which is a refusal with no reason.
  snap=$(snapshot) || snap=""
  # ⚠️ A failed snapshot is its own fact, not an ambiguous match. Without this,
  # an empty `$snap` gave an empty `$matches`, `jq length` printed nothing, `$n`
  # was the empty string, and the `case` below fell through to its `*)` arm —
  # so `ccwatch kill` reported "'<pid>' matches  live sessions — be specific:"
  # with a blank where the count belongs, and listed nothing. Observed for real
  # while the host was out of memory: eight kills, five of them refused with a
  # message that described a completely different problem.
  require_json snapshot "$snap" || return 1
  matches=$(printf '%s' "$snap" | jq -c --arg n "$needle" '
    [ .sessions[]
      | select( .name == $n
                or .sid == $n
                or (.pid|tostring) == $n
                # A prefix is allowed for session ids only, because they are
                # long and always pasted. Names are matched whole: a prefix
                # match on `agents` would hit five different sessions.
                or (($n | length) >= 8 and (.sid | startswith($n))) ) ]')
  n=$(printf '%s' "$matches" | jq 'length')
  case "$n" in
    # An unreadable count is a failure of the match itself, and is never
    # allowed to fall through to the ambiguity arm below and be described as
    # a count of sessions that was never obtained (constitution V).
    ''|*[!0-9]*)
       err "could not match '$needle' against the live sessions"
       printf '  %s\n' "the session list could not be read; 'ccwatch doctor' reports why" >&2
       return 1;;
    0) err "no live session matches '$needle'"
       printf '  %s\n' "run 'ccwatch once' for the names, or 'ccwatch resume' if it has exited" >&2
       return 1;;
    1) printf '%s' "$matches" | jq -c '.[0]'; return 0;;
    # Sending to the wrong agent is not recoverable by the tool: it has already
    # been said. So an ambiguous needle is refused, never resolved by picking.
    *) err "'$needle' matches $n live sessions — be specific:"
       printf '%s' "$matches" | jq -r '.[] | "    \(.name)  pid \(.pid)  \(.sid)"' >&2
       return 1;;
  esac
}

# session_token — the peerToken for a pid, with the PID-reuse guard applied.
#
# The key file is named <pid>.<hash>.key and carries `procStart`. If that does
# not match the process now running under the pid, the file outlived its
# session and the token is not for the process we are about to talk to.
session_token() { # session_token <pid>
  local pid="$1" f
  for f in "$SESS_DIR/$pid".*.key; do
    [ -f "$f" ] || continue
    jq -r '.peerToken // empty' "$f" 2>/dev/null
    return 0
  done
  return 1
}

# uds_send — newline-delimited JSON to a Unix socket.
#
# python3 only, deliberately. The first version tried `nc -U` first and fell
# back to python, but the nc path needs a half-close to tell the peer the
# frames are finished and a timeout so an unresponsive session cannot hang the
# monitor, and nc does neither portably. Two code paths where one is subtly
# wrong is worse than one that is right; python3 ships with macOS and does both
# correctly.
uds_send() { # uds_send <socket>, frames on stdin
  # ⚠️ The program is passed with -c, NOT on stdin. `python3 - "$sock" <<EOF`
  # looks equivalent and is not: python then reads its PROGRAM from stdin, so
  # the heredoc consumes the very stdin the frames arrive on and
  # sys.stdin.read() returns empty. The frames never left the shell, the socket
  # write "succeeded", and ccwatch reported "sent". Found only because delivery
  # is verified in the receiver's transcript rather than assumed.
  #
  # python3 rather than nc because the exchange needs a half-close (to tell the
  # peer the frames are complete) and a timeout (so an unresponsive session
  # cannot hang the monitor), and nc does neither portably.
  python3 -c '
import socket, sys
sock = sys.argv[1]
data = sys.stdin.buffer.read()
if not data:
    sys.stderr.write("nothing to send: no frames arrived on stdin\n")
    sys.exit(1)
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(5)
try:
    s.connect(sock)
    s.sendall(data)
    s.shutdown(socket.SHUT_WR)
    try:
        reply = s.recv(4096)
        if reply:
            sys.stdout.write(reply.decode("utf-8", "replace"))
    except socket.timeout:
        pass
except OSError as e:
    sys.stderr.write("socket error: %s\n" % e)
    sys.exit(1)
finally:
    s.close()
' "$1"
}

cmd_send() {
  local dry=0 target="" msg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift;;
      -*) die "send: unrecognised option '$1'" "usage: ccwatch send [--dry-run] <name|session-id|pid> <message>";;
      *) if [ -z "$target" ]; then target="$1"; else msg="${msg:+$msg }$1"; fi; shift;;
    esac
  done
  [ -n "$target" ] || die "send: no target" "usage: ccwatch send <name|session-id|pid> <message>"
  [ -n "$msg" ] || die "send: no message" "usage: ccwatch send <name|session-id|pid> <message>"

  local t pid sock token
  # The status is checked here, in the main shell, which is the only place it
  # can actually stop the command.
  t=$(resolve_target "$target") || exit 1
  pid=$(printf '%s' "$t" | jq -r '.pid')
  sock="/tmp/cc-socks/$pid.sock"
  [ -S "$sock" ] || sock=$(jq -r --arg p "$pid" 'select(.pid|tostring == $p) | .messagingSocketPath // empty' \
                             "$SESS_DIR/$pid.json" 2>/dev/null)
  # A real send needs the socket. A dry-run does NOT: reporting that the socket
  # is missing is one of the things you run a dry-run to find out, and aborting
  # instead means the preview cannot tell you what it would have sent.
  local sock_ok=1
  [ -n "$sock" ] && [ -S "$sock" ] || sock_ok=0
  if [ "$sock_ok" -eq 0 ] && [ "$dry" -eq 0 ]; then
    die "session $(printf '%s' "$t" | jq -r .name) has no messaging socket" \
        "it may predate peer messaging, or the socket directory has been cleaned"
  fi

  token=$(session_token "$pid") || token=""

  local frames
  # `from` is a top-level field on the user frame and IS honoured — it lands in
  # the receiver as origin.from, so an injected message is attributable in the
  # transcript instead of showing as "unknown". Tested: `fromName` and
  # `from_name` are ignored, only `from` works.
  frames=$(jq -cn --arg tok "$token" --arg body "$msg" --arg from "${CCWATCH_SEND_AS:-ccwatch}" '
    ( if $tok == "" then empty else {type:"auth", token:$tok} end ),
    {type:"user", from:$from, message:{role:"user", content:$body}}')

  if [ "$dry" -eq 1 ]; then
    say "${_c_bold}Would send to${_c_reset} $(printf '%s' "$t" | jq -r '"\(.name)  pid \(.pid)  \(.sid)"')"
    if [ "$sock_ok" -eq 1 ]; then
      say "${_c_dim}socket:${_c_reset} $sock"
    else
      say "${_c_dim}socket:${_c_reset} ${sock:-<none recorded>} ${_c_red}MISSING — a real send would fail${_c_reset}"
    fi
    say "${_c_dim}auth:${_c_reset}   $([ -n "$token" ] && echo "peerToken from ${SESS_DIR/#$HOME/~}/$pid.<hash>.key (not shown)" || echo "none found — will try without")"
    say ""
    # The token is redacted. Printing it would put a live credential into
    # whatever scrollback or CI log this ran in.
    printf '%s\n' "$frames" | jq -c 'if .type == "auth" then .token = "<redacted>" else . end'
    return 0
  fi

  # The transcript position BEFORE sending, so a new arrival is distinguishable
  # from an identical message sent earlier. Counting lines is enough: the
  # transcript is append-only.
  local tfile before=0
  tfile=$(ls -t "$PROJ_DIR"/*/"$(printf '%s' "$t" | jq -r .sid)".jsonl 2>/dev/null | head -1)
  [ -n "$tfile" ] && before=$(wc -l <"$tfile" | tr -d ' ')

  local reply
  if ! reply=$(printf '%s\n' "$frames" | uds_send "$sock" 2>&1); then
    die "could not deliver to $(printf '%s' "$t" | jq -r .name)" "$reply"
  fi
  case "$reply" in
    *'"dropped"'*|*'"refused"'*)
      err "the session REFUSED or DROPPED the message"
      printf '  %s\n' "$reply" >&2
      exit 1;;
  esac

  # ⚠️ Writing to the socket is NOT evidence of delivery. The first version
  # printed "sent" here and stopped, and the first real test proved it a liar:
  # the write succeeded, nothing arrived, and the tool reported success. The
  # server accepts a connection, parses lines, and can drop one silently.
  #
  # So delivery is now OBSERVED, in the receiver's own transcript. A message
  # that arrives shows up as a user entry with origin.kind == "peer" — that is
  # how Claude Code records a message from another session.
  local waited=0 name
  name=$(printf '%s' "$t" | jq -r .name)
  if [ -z "$tfile" ]; then
    warn "delivered to the socket, but $name has no transcript to confirm it in"
    say "${_c_dim}the write succeeded; whether the session acted on it is unobservable here${_c_reset}"
  else
    while [ "$waited" -lt "$CCWATCH_SEND_VERIFY" ]; do
      if [ "$(wc -l <"$tfile" | tr -d ' ')" -gt "$before" ] \
         && tail -n "+$((before + 1))" "$tfile" \
            | jq -e --arg m "${msg:0:40}" 'select(.type == "user")
                | select(.origin.kind == "peer")
                | select((.message.content | if type == "string" then . else (.[0].text // "") end)
                         | contains($m))' >/dev/null 2>&1; then
        say "${_c_green}delivered${_c_reset} to $name ${_c_dim}(confirmed in its transcript after ${waited}s)${_c_reset}"
        record_send "$t" "$msg" "delivered"
        return 0
      fi
      sleep 1
      waited=$((waited + 1))
    done
    # Queued-but-unprocessed is the normal case for a busy session, and it is a
    # different fact from "not delivered". Said as such.
    warn "queued for $name, but not in its transcript after ${CCWATCH_SEND_VERIFY}s"
    say "${_c_dim}normal if it is mid-turn — the queue is drained between turns.${_c_reset}"
    say "${_c_dim}check later with:${_c_reset} ccwatch peers --session $(printf '%s' "$t" | jq -r '.sid[0:8]')"
  fi
  record_send "$t" "$msg" "queued"
}

# Recorded in the same log as the hooks, so "who told that agent to do that"
# has an answer afterwards.
record_send() { # record_send <target-json> <message> <outcome>
  mkdir -p "$CCWATCH_HOME" 2>/dev/null || return 0
  jq -cn --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
         --arg sid "$(printf '%s' "$1" | jq -r .sid)" \
         --arg cwd "$(printf '%s' "$1" | jq -r .cwd)" \
         --arg name "$(printf '%s' "$1" | jq -r .name)" \
         --arg body "$2" --arg outcome "$3" \
    '{at:$at, event:"ccwatch.send", session_id:$sid, cwd:$cwd,
      target:$name, outcome:$outcome, message:$body}' \
    >>"$EVENTS" 2>/dev/null || true
}


# ============================================================== deploys =====
#
# The queue of things you are waiting on that are not sessions, and the answer
# to "can the agents subscribe to those".
#
# They can, and they do it themselves. Claude Code exports
# CLAUDE_CODE_SESSION_ID into the environment of every tool call, so an agent
# that runs `ccwatch subscribe deploy-production` identifies itself with no
# ceremony and no plumbing. ccwatch records the subscription, watches, and
# messages the session back over the socket when a matching run finishes. The
# agent does not poll and does not hold a connection open — which is the only
# design that survives the agent being mid-turn, compacting, or restarted.

# cwd -> repo identity. Cached because it needs two git subprocesses per
# directory and the answer essentially never changes.
REPO_CACHE="$CCWATCH_HOME/repos.json"
CCWATCH_REPO_TTL="${CCWATCH_REPO_TTL:-21600}"

# What was live, last time anything looked.
#
# This is the answer to "if the machine restarts, can I get back quickly".
# Transcripts survive and are the resume AUTHORITY, but they do not record
# which sessions were open together, what each was named, or what it was doing
# at the moment everything stopped — and that is the part you have to
# reconstruct from memory otherwise. So every snapshot writes the roster down.
ROSTER="$CCWATCH_HOME/roster.json"

SUBS="$CCWATCH_HOME/subscriptions.jsonl"
DEPLOY_CACHE="$CCWATCH_HOME/deploys.json"
DEPLOY_SEEN="$CCWATCH_HOME/deploys-seen.json"


# collect_repos — which repository each working directory actually belongs to.
#
# ⚠️ NOT the directory basename. That was the first version and it was wrong in
# three ways at once, all visible on one real machine:
#
#   ~/code/platform                    is acme/checkout-api, so a territory
#                                      labelled "platform" named nothing that
#                                      exists on GitHub.
#   ~/code/platform/.claude/worktrees/X  is the SAME repo as above, but was
#                                      shown as a separate project "platform:X".
#   .../worktrees/X/services/pricing   is a DIFFERENT repo nested inside that
#                                      worktree, and was grouped under the
#                                      outer one — merging two repositories.
#
# It also broke deploys silently: runs come back from `gh` keyed by owner/name,
# so a deploy on checkout-api could never match a territory called "platform",
# and those badges simply never appeared.
#
# The remote is the identity. The branch is carried separately, because that is
# what distinguishes two worktrees of one repo.
collect_repos() { # collect_repos <cwd>...
  local cwd cached fresh now
  now=$(date '+%s')
  mkdir -p "$CCWATCH_HOME" 2>/dev/null

  cached='{}'
  if [ -f "$REPO_CACHE" ]; then
    cached=$(jq -c --argjson now "$now" --argjson ttl "$CCWATCH_REPO_TTL" \
      'if type == "object" then with_entries(select(($now - (.value.at // 0)) < $ttl)) else {} end' \
      "$REPO_CACHE" 2>/dev/null) || cached='{}'
    [ -n "$cached" ] || cached='{}'
  fi

  fresh=$( for cwd in "$@"; do
      [ -n "$cwd" ] || continue
      # Already known and still fresh: no subprocess at all.
      printf '%s' "$cached" | jq -e --arg c "$cwd" 'has($c)' >/dev/null 2>&1 && continue
      local slug branch root
      root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || root=""
      slug=$(git -C "$cwd" remote get-url origin 2>/dev/null \
             | sed -E 's#^git@[^:]+:##; s#^ssh://[^/]+/##; s#^https?://[^/]+/##; s#\.git$##') || slug=""
      branch=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
      jq -cn --arg c "$cwd" --arg slug "$slug" --arg branch "$branch" \
             --arg root "$root" --argjson at "$now" \
        '{key: $c, value: {slug: $slug, branch: $branch, root: $root, at: $at}}'
    done | jq -s 'from_entries' )

  jq -cn --argjson a "$cached" --argjson b "${fresh:-\{\}}" '$a + $b' >"$REPO_CACHE.tmp" 2>/dev/null \
    && mv "$REPO_CACHE.tmp" "$REPO_CACHE" 2>/dev/null
  jq -c '.' "$REPO_CACHE" 2>/dev/null || printf '{}'
}

# repo_slug — owner/name for a working directory, or nothing.
#
# Reads the git remote rather than guessing from the path: a worktree under
# .claude/worktrees/ has a directory name that is a branch, not a repo.
repo_slug() { # repo_slug <cwd>
  local url
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
  printf '%s' "$url" | sed -E 's#^git@[^:]+:##; s#^https?://[^/]+/##; s#\.git$##'
}

# collect_deploys — recent runs for every repo a live session sits in.
#
# Cached with a TTL. The cache records when it was taken so the table can age
# it, and a `gh` failure leaves the previous cache in place rather than
# replacing it with an empty list — an empty deploy list and a failed lookup
# must not look the same.
collect_deploys() { # collect_deploys <cwd>...
  local now age
  now=$(date '+%s')
  if [ -f "$DEPLOY_CACHE" ]; then
    age=$(jq -r --argjson now "$now" '($now - (.at // 0))' "$DEPLOY_CACHE" 2>/dev/null) || age=99999
    if [ "${age:-99999}" -lt "$CCWATCH_DEPLOY_TTL" ]; then
      jq -c --argjson now "$now" '. + { age: ($now - .at) }' "$DEPLOY_CACHE" 2>/dev/null && return 0
    fi
  fi

  command -v gh >/dev/null 2>&1 || { printf '{"at":%s,"age":0,"runs":[],"error":"gh not on PATH"}' "$now"; return 0; }

  local cwd slug slugs="" runs
  for cwd in "$@"; do
    slug=$(repo_slug "$cwd") || continue
    [ -n "$slug" ] || continue
    case " $slugs " in *" $slug "*) continue;; esac
    slugs="$slugs $slug"
  done
  [ -n "$slugs" ] || { printf '{"at":%s,"age":0,"runs":[],"error":"no git remotes found"}' "$now"; return 0; }

  # gh's stderr is CAPTURED, not discarded. The first version sent it to
  # /dev/null and reported "gh returned nothing", which is true and useless:
  # the actual message was `HTTP 401: Bad credentials`, and no amount of staring
  # at an empty deploy list would have suggested an auth problem.
  local failed="" errs="" out
  runs=$( for slug in $slugs; do
            out=$(gh run list --repo "$slug" --limit "$CCWATCH_DEPLOY_LIMIT" \
                    --json databaseId,workflowName,status,conclusion,headBranch,createdAt,updatedAt,url,event \
                    2>&1) && printf '%s' "$out" \
                  | jq -c --arg slug "$slug" '.[] | . + {repo: $slug}' 2>/dev/null \
              || printf '%s\n' "$out" >&2
          done 2>"$DEPLOY_CACHE.err" | jq -s '.' )
  if [ -s "$DEPLOY_CACHE.err" ]; then
    errs=$(head -3 "$DEPLOY_CACHE.err" | tr '\n' ' ')
    failed="gh failed: $errs"
  fi
  rm -f "$DEPLOY_CACHE.err"

  jq -cn --argjson now "$now" --argjson runs "$runs" --arg err "$failed" \
    '{at: $now, age: 0, runs: $runs} + (if $err == "" then {} else {error: $err} end)' \
    >"$DEPLOY_CACHE.tmp" 2>/dev/null \
    && mv "$DEPLOY_CACHE.tmp" "$DEPLOY_CACHE" 2>/dev/null
  jq -c '. + {age: 0}' "$DEPLOY_CACHE" 2>/dev/null || printf '{"at":%s,"age":0,"runs":[]}' "$now"
}

# deploys_of_interest — in-flight runs, plus ones that ended recently.
#
# A deploy that succeeded three days ago is not something you are waiting on.
deploys_filter() {
  jq -c --arg pat "$CCWATCH_DEPLOY_PATTERN" --argjson now "$(date '+%s')" '
    .runs
    | map(select(.workflowName | test($pat; "i")))
    | map(. + { ended: ((.updatedAt // .createdAt) | fromdate),
                live: (.status != "completed") })
    | map(select(.live or (($now - .ended) < 86400)))
    | sort_by(if .live then 0 else 1 end, -.ended)'
}

cmd_deploys() {
  local as_json=0
  [ "${1:-}" = "--json" ] && as_json=1
  local snap cwds
  snap=$(snapshot)
  cwds=$(printf '%s' "$snap" | jq -r '[.sessions[].cwd] | unique | .[]')
  local -a cwda=()
  while IFS= read -r c; do [ -n "$c" ] && cwda+=("$c"); done <<<"$cwds"
  local d
  if [ ${#cwda[@]} -gt 0 ]; then d=$(collect_deploys "${cwda[@]}"); else d='{"runs":[],"age":0}'; fi

  if [ "$as_json" -eq 1 ]; then
    printf '%s' "$d" | jq -c --arg pat "$CCWATCH_DEPLOY_PATTERN" --argjson now "$(date '+%s')" '
      { at: .at, age: .age, error: (.error // null),
        runs: ( .runs | map(select(.workflowName | test($pat; "i")))
                | map(. + { ended: ((.updatedAt // .createdAt) | fromdate),
                            live: (.status != "completed") })
                | map(select(.live or (($now - .ended) < 86400)))
                | sort_by(if .live then 0 else 1 end, -.ended) ) }'
    return 0
  fi
  local errmsg
  errmsg=$(printf '%s' "$d" | jq -r '.error // empty')
  [ -n "$errmsg" ] && warn "$errmsg"

  local filtered
  filtered=$(printf '%s' "$d" | deploys_filter)
  if [ "$(printf '%s' "$filtered" | jq 'length')" -eq 0 ]; then
    say "${_c_dim}No deploy-shaped runs in the last 24h for the repos you have sessions in.${_c_reset}"
    say "${_c_dim}Matching on:${_c_reset} $CCWATCH_DEPLOY_PATTERN ${_c_dim}(set CCWATCH_DEPLOY_PATTERN to widen)${_c_reset}"
    return 0
  fi
  render_deploys "$filtered" "$(printf '%s' "$d" | jq -r '.age')"
}

render_deploys() { # render_deploys <filtered-json> <cache-age>
  say "${_c_bold}DEPLOYS${_c_reset} ${_c_dim}— in flight, and concluded in the last 24h${_c_reset}${_c_dim}$([ "${2:-0}" -gt 5 ] && printf ' [%ss old]' "$2")${_c_reset}"
  printf '%s' "$1" | jq -r --argjson now "$(date '+%s')" '
    def dur(s): if s < 60 then "\(s|floor)s" elif s < 3600 then "\((s/60)|floor)m"
      elif s < 86400 then "\((s/3600)|floor)h" else "\((s/86400)|floor)d" end;
    .[] | [ (if .live then "RUNNING" else (.conclusion // "?" | ascii_upcase) end),
            .workflowName, .repo, .headBranch,
            (if .live then "started \(dur($now - (.createdAt|fromdate))) ago"
             else "\(dur($now - .ended)) ago" end),
            .url ] | @tsv' \
  | awk -F'\t' -v grn="$_c_green" -v red="$_c_red" -v yel="$_c_yellow" \
               -v cyn="$_c_cyan" -v dim="$_c_dim" -v rst="$_c_reset" '
    { c = ($1=="SUCCESS") ? grn : ($1=="RUNNING") ? yel : red
      printf "  %s%-9s%s %s%-22s%s %s%-26s%s %s%-18s%s %s%s%s\n", \
        c,$1,rst, "",$2,"", dim,$3,rst, dim,$4,rst, dim,$5,rst
      if ($1 != "SUCCESS") printf "      %s%s%s\n", cyn,$6,rst
    }'
}

# --------------------------------------------------------- subscriptions -----

cmd_subscribe() {
  local pattern="" sid="${CLAUDE_CODE_SESSION_ID:-}" once=0 repo=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) sid="${2:-}"; shift 2 || exit 3;;
      --repo)    repo="${2:-}"; shift 2 || exit 3;;
      --once)    once=1; shift;;
      -*) die "subscribe: unrecognised option '$1'" \
              "usage: ccwatch subscribe [--once] [--repo owner/name] <workflow-pattern>";;
      *) pattern="${pattern:+$pattern|}$1"; shift;;
    esac
  done
  [ -n "$pattern" ] || die "subscribe: no workflow pattern" \
    "e.g. ccwatch subscribe deploy-production"
  # An agent running this from inside a session needs no arguments beyond the
  # pattern: Claude Code puts its own session id in the environment.
  [ -n "$sid" ] || die "subscribe: no session to subscribe" \
    "run this from inside a Claude Code session, or pass --session <id>"

  [ -z "$repo" ] && repo=$(repo_slug "$PWD" 2>/dev/null || true)

  mkdir -p "$CCWATCH_HOME"
  jq -cn --arg sid "$sid" --arg pat "$pattern" --arg repo "$repo" \
         --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" --argjson once "$once" \
    '{session_id:$sid, pattern:$pat, repo:$repo, once:($once == 1), at:$at}' >>"$SUBS"
  say "${_c_green}subscribed${_c_reset} ${sid:0:8} to ${_c_bold}$pattern${_c_reset}${repo:+ in $repo}"
  say "${_c_dim}ccwatch will message this session when a matching run finishes.${_c_reset}"
  say "${_c_dim}Needs a watcher running:${_c_reset} ccwatch daemon"
}

cmd_unsubscribe() {
  local sid="${1:-${CLAUDE_CODE_SESSION_ID:-}}"
  [ -n "$sid" ] || die "unsubscribe: no session given" "pass a session id, or run from inside a session"
  [ -f "$SUBS" ] || { say "nothing subscribed"; return 0; }
  local kept
  kept=$(jq -c --arg sid "$sid" 'select(.session_id != $sid)' "$SUBS" 2>/dev/null)
  printf '%s\n' "$kept" | sed '/^$/d' >"$SUBS.tmp" && mv "$SUBS.tmp" "$SUBS"
  say "unsubscribed ${sid:0:8}"
}

cmd_subs() {
  [ -f "$SUBS" ] || { say "${_c_dim}No subscriptions.${_c_reset}"; return 0; }
  local live
  live=$(snapshot | jq -c '[.sessions[] | {sid, name}]')
  say "${_c_bold}SUBSCRIPTIONS${_c_reset}"
  jq -s -c --argjson live "$live" '
    ( $live | map({key: .sid, value: .name}) | from_entries ) as $L
    | unique_by([.session_id, .pattern, .repo])
    | .[] | . + { name: ($L[.session_id] // null) }' "$SUBS" 2>/dev/null \
  | jq -r --arg d "$_c_dim" --arg r "$_c_red" --arg z "$_c_reset" '
      "  \(.pattern)\($d) → \(.name // "(session has exited)")\($z)"
      + (if .repo == "" then "" else " \($d)[\(.repo)]\($z)" end)
      + (if .name == null then " \($r)stale\($z)" else "" end)'
}

# --------------------------------------------------------------- daemon ------
#
# One watcher, N subscribers. The agents do not poll; this does, and messages
# them. Deliberately a separate command rather than folded into the live table,
# because the whole point is that it keeps working while you are away from the
# terminal.
cmd_daemon() {
  local interval="${CCWATCH_DEPLOY_TTL}"
  say "${_c_bold}ccwatch daemon${_c_reset} ${_c_dim}— polling deploys every ${interval}s, notifying subscribers${_c_reset}"
  say "${_c_dim}Ctrl-C to stop. Subscriptions: ${SUBS/#$HOME/~}${_c_reset}"
  [ -f "$DEPLOY_SEEN" ] || printf '{}' >"$DEPLOY_SEEN"
  while :; do
    daemon_tick
    sleep "$interval"
  done
}

# One pass. Factored out so it can be run once, and tested.
daemon_tick() {
  local snap cwds
  snap=$(snapshot)
  cwds=$(printf '%s' "$snap" | jq -r '[.sessions[].cwd] | unique | .[]')
  local -a cwda=()
  while IFS= read -r c; do [ -n "$c" ] && cwda+=("$c"); done <<<"$cwds"
  [ ${#cwda[@]} -gt 0 ] || return 0

  local d finished
  d=$(collect_deploys "${cwda[@]}")
  # Only runs that have CONCLUDED, and only ones not already notified. The seen
  # file is what stops a subscriber being told about the same deploy on every
  # tick — the failure mode that would make the whole feature unusable.
  finished=$(printf '%s' "$d" | jq -c --arg pat "$CCWATCH_DEPLOY_PATTERN" '
    .runs | map(select(.status == "completed"))
          | map(select(.workflowName | test($pat; "i")))')

  [ -f "$SUBS" ] || return 0
  local seen
  seen=$(cat "$DEPLOY_SEEN" 2>/dev/null); [ -n "$seen" ] || seen='{}'

  local pending
  pending=$(jq -s -c --argjson runs "$finished" --argjson seen "$seen" '
    unique_by([.session_id, .pattern, .repo]) as $subs
    | [ $subs[] as $sub
        | $runs[]
        | select(.workflowName | test($sub.pattern; "i"))
        | select($sub.repo == "" or .repo == $sub.repo)
        | ("\($sub.session_id):\(.databaseId)") as $key
        | select($seen[$key] == null)
        | { key: $key, session_id: $sub.session_id, run: . } ]' "$SUBS" 2>/dev/null)

  local n
  n=$(printf '%s' "$pending" | jq 'length' 2>/dev/null) || n=0
  [ "${n:-0}" -gt 0 ] || return 0

  local i=0 sid msg key
  while [ "$i" -lt "$n" ]; do
    sid=$(printf '%s' "$pending" | jq -r --argjson i "$i" '.[$i].session_id')
    key=$(printf '%s' "$pending" | jq -r --argjson i "$i" '.[$i].key')
    # Built with a single-quoted jq program and an index argument. Interpolating
    # the index into a double-quoted program meant escaping jq string quotes
    # through the shell, which does not survive.
    msg=$(printf '%s' "$pending" | jq -r --argjson i "$i" '
      .[$i].run
      | "Deploy update from ccwatch: \(.workflowName) on \(.repo)@\(.headBranch) "
        + "finished with \(.conclusion // "unknown"). \(.url)"')
    # A subscription whose session has exited is dropped rather than retried
    # forever. Marking it seen first means a send that fails for any other
    # reason also does not loop.
    seen=$(printf '%s' "$seen" | jq -c --arg k "$key" --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" '. + {($k): $at}')
    printf '%s' "$seen" >"$DEPLOY_SEEN.tmp" && mv "$DEPLOY_SEEN.tmp" "$DEPLOY_SEEN"
    # ⚠️ A SUBSHELL, deliberately. cmd_send uses `die` for an unreachable
    # target, and `die` exits — which in an `if` condition exits the whole
    # process, not the condition. So the first subscriber whose session had
    # gone away killed the daemon outright: the watcher died silently and
    # nothing was notified again, which is precisely the failure mode this
    # tool exists to catch. One subscriber's problem must not be the
    # watcher's.
    if ( cmd_send "$sid" "$msg" >/dev/null 2>&1 ); then
      say "${_c_green}notified${_c_reset} ${sid:0:8} ${_c_dim}$(printf '%s' "$msg" | head -c 80)${_c_reset}"
    else
      warn "could not notify ${sid:0:8} — session gone? drop it with: ccwatch unsubscribe $sid"
    fi
    i=$((i + 1))
  done
}


# ================================================================ peers =====
#
# Which sessions have been talking to each other.
#
# A message from another session is recorded in the RECEIVER's transcript as a
# user entry with origin.kind == "peer", carrying:
#   .origin.from             the sender's declared name ("unknown" if it did not
#                            declare one; ccwatch declares "ccwatch")
#   .origin.verifiedPeerPid  the pid of the connecting process, verified by the
#                            server from the socket's peer credentials — so it
#                            cannot be spoofed by the frame
#   .origin.hopChain         for a relayed message, the full path it took, so
#                            A→B→C reconstructs as a path and not as two
#                            unrelated edges
#
# The receiver's transcript is the only place this is written, which is why the
# graph is built by scanning transcripts rather than by watching traffic: it
# works retrospectively, and it survives a reboot.

cmd_peers() {
  local days="$CCWATCH_RESUME_DAYS" only="" as_json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --days)    days="${2:-14}"; shift 2 || exit 3;;
      --session) only="${2:-}"; shift 2 || exit 3;;
      --json)    as_json=1; shift;;
      *) die "peers: unrecognised argument '$1'" "usage: ccwatch peers [--days N] [--session <id>] [--json]";;
    esac
  done
  [ -d "$PROJ_DIR" ] || die "no transcript directory at $PROJ_DIR" "nothing to read"

  TMP=$(mktemp -d) || die "could not create a temp directory"

  # Live names, so a pid or a session id can be shown as the name you know it by.
  snapshot | jq -c '[.sessions[] | {sid, pid, name}]' >"$TMP/live.json"

  # -maxdepth 2 for the same reason as resume: subagent sidechains live deeper
  # and are not sessions.
  local f edges=0 sid
  : >"$TMP/edges.jsonl"
  # ONE grep over every candidate file, not one grep per file. The first
  # version spawned a process per transcript — 700 of them across 1.7GB — and
  # took 56 seconds, which timed out the web refresher at 90s. Batching through
  # xargs brings it to a couple of seconds: grep -l stops reading a file at its
  # first match, and the files without a match are the ones worth scanning fast.
  find "$PROJ_DIR" -maxdepth 2 -name '*.jsonl' -type f -mtime "-$days" -print0 2>/dev/null \
  | xargs -0 grep -l '"kind":"peer"' 2>/dev/null >"$TMP/candidates.txt" || true

  while IFS= read -r f; do
    [ -f "$f" ] || continue
    sid=$(basename "$f" .jsonl)
    [ -n "$only" ] && case "$sid" in "$only"*) ;; *) continue;; esac
    jq -c --arg to "$sid" '
      select(.type == "user" and .origin.kind == "peer")
      | { to: $to,
          from: (.origin.from // "unknown"),
          from_pid: (.origin.verifiedPeerPid // null),
          from_session: (.origin.fromSession // null),
          hops: (.origin.hopChain // null),
          at: .timestamp,
          cwd: (.cwd // null),
          text: ((.message.content
                  | if type == "string" then . else (.[0].text // "") end)
                 | gsub("\n"; " ") | .[0:100]) }' "$f" 2>/dev/null >>"$TMP/edges.jsonl"
  done <"$TMP/candidates.txt"

  edges=$(wc -l <"$TMP/edges.jsonl" | tr -d ' ')
  if [ "$as_json" -eq 1 ]; then
    peers_graph "$TMP/edges.jsonl" "$TMP/live.json"
    return 0
  fi
  if [ "${edges:-0}" -eq 0 ]; then
    say "${_c_dim}No peer messages in the last $days days.${_c_reset}"
    say ""
    say "${_c_dim}Nothing has been sent between sessions yet. This populates when a${_c_reset}"
    say "${_c_dim}session uses SendMessage, or when ccwatch does — try:${_c_reset}"
    say "  ccwatch send <name> \"hello\""
    return 0
  fi

  say "${_c_bold}PEER MESSAGES${_c_reset} ${_c_dim}— last $days days, $edges message(s)${_c_reset}"
  say ""
  peers_graph "$TMP/edges.jsonl" "$TMP/live.json" \
  | jq -r --arg c "$_c_cyan" --arg b "$_c_bold" --arg d "$_c_dim" --arg z "$_c_reset" '
      .edges[] | "  \($b)\(.from)\($z) \($c)\(.count > 1 | if . then "==>" else "-->" end)\($z) \($b)\(.to)\($z)"
            + "  \($d)\(.count) msg\(if .count == 1 then "" else "s" end), last \(.last[0:16])Z\($z)"
            + "\n      \($d)\(.sample)\($z)"'
}

# peers_graph — edges grouped into a directed graph, as JSON.
#
# Shared by the table and by --json on purpose: two renderings that derive the
# graph separately will eventually disagree about who talked to whom, and the
# one you are not looking at is the one that is wrong.
peers_graph() { # peers_graph <edges.jsonl> <live.json>
  jq -s -c --slurpfile live "$2" '
    ( $live[0] | map({key: .sid, value: .name}) | from_entries ) as $BYSID
    | ( $live[0] | map({key: (.pid|tostring), value: .name}) | from_entries ) as $BYPID
    | map( . + { to_name: ($BYSID[.to] // (.to[0:8])),
                 # The verified pid is preferred over the declared name: the
                 # server checked the pid against the socket peer credentials,
                 # whereas the name was merely asserted by the sender.
                 from_name: ( if .from_pid != null and $BYPID[(.from_pid|tostring)] != null
                              then $BYPID[(.from_pid|tostring)]
                              elif (.from // "unknown") != "unknown" then .from
                              elif .from_pid != null then "pid \(.from_pid) (exited)"
                              else "unknown" end ) } ) as $all
    | { messages: ($all | length),
        nodes: ( [ $all[].from_name ] + [ $all[].to_name ] | unique
                 | map({ id: ., live: ($BYSID | to_entries | map(.value) | index(.) != null) }) ),
        edges: ( $all | group_by([.from_name, .to_name])
                 | map({ from: .[0].from_name, to: .[0].to_name, count: length,
                         last: (max_by(.at) | .at),
                         sample: (max_by(.at) | .text) })
                 | sort_by(-.count) ) }' "$1"
}


# ================================================================ serve =====
#
# The same data as the table, in a browser, for when you want it on a second
# monitor rather than in a terminal you are also typing in.
#
# Deliberately a thin shell around the existing commands: /api/state runs
# `ccwatch --json`, `deploys --json` and `peers --json` and concatenates them.
# Nothing is derived twice. A dashboard that computes its own version of the
# status is a dashboard that will eventually disagree with the terminal, and
# you would have no way to tell which one was lying.
#
# Binds to loopback only. This exposes which repositories you are working in
# and fragments of peer messages; that is not something to serve on 0.0.0.0.
cmd_serve() {
  local port="${CCWATCH_PORT:-8787}" open=0 readonly=0 allowkill=0
  local idle_grace="${CCWATCH_IDLE_GRACE:-15}" snapshot_timeout="${CCWATCH_SNAPSHOT_TIMEOUT:-90}"
  local snapshot_cadence="${CCWATCH_SNAPSHOT_CADENCE:-2}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)      port="${2:-8787}"; shift 2 || exit 3;;
      --open)      open=1; shift;;
      --read-only) readonly=1; shift;;
      --allow-kill) allowkill=1; shift;;
      *) die "serve: unrecognised argument '$1'" \
             "usage: ccwatch serve [--port N] [--open] [--read-only] [--allow-kill]";;
    esac
  done

  # ⚠️ Sending from the browser is a real capability, so it is gated.
  #
  # Binding to loopback is NOT sufficient on its own: any page open in your
  # browser can POST to 127.0.0.1, so without a gate a random site could
  # inject prompts into every agent you have running. Two checks close that:
  #
  #   1. A per-run token, generated here and embedded in the page ccwatch
  #      itself serves. A drive-by request cannot read it (same-origin policy
  #      keeps another page from fetching our HTML).
  #   2. An Origin check. Browsers attach Origin to cross-origin POSTs, so one
  #      that does not match this server is refused.
  #
  # --read-only drops the endpoint entirely for anyone who would rather not
  # have it at all.
  local send_token=""
  if [ "$readonly" -eq 0 ]; then
    send_token=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n') \
      || die "could not generate a session token" "is /dev/urandom readable?"
  fi

  local root
  root=$(cd -- "$(dirname -- "$(resolved_self)")/.." && pwd)
  [ -f "$root/web/index.html" ] || die "cannot find web/index.html under $root" \
    "the web assets ship alongside bin/ — has the checkout been split up?"

  need python3
  say "${_c_bold}ccwatch serve${_c_reset} ${_c_dim}on${_c_reset} http://127.0.0.1:$port"
  if [ "$readonly" -eq 1 ]; then
    say "${_c_dim}loopback only, read-only. Ctrl-C to stop.${_c_reset}"
  else
    say "${_c_dim}loopback only. Replies from the page are enabled (token-gated).${_c_reset}"
    if [ "$allowkill" -eq 1 ]; then
      say "${_c_yellow}!${_c_reset} ${_c_dim}Killing from the page is ENABLED (--allow-kill).${_c_reset}"
    else
      say "${_c_dim}Killing is disabled; pass --allow-kill to enable it.${_c_reset}"
    fi
    say "${_c_dim}Use --read-only to disable writes entirely. Ctrl-C to stop.${_c_reset}"
  fi
  [ "$open" -eq 1 ] && command -v open >/dev/null 2>&1 && open "http://127.0.0.1:$port" 2>/dev/null

  local srv_pid=""
  # shellcheck disable=SC2064
  trap 'if [ -n "$srv_pid" ]; then kill "$srv_pid" 2>/dev/null; wait "$srv_pid" 2>/dev/null; fi' \
    EXIT INT TERM

  # ⚠️ CCWATCH_WEB is an override, not a fixed path, so `verify-ui` can serve a
  # directory holding the real pages PLUS its own harness. The harness has to
  # be same-origin with /map to reach into an iframe of it, and copying the
  # pages somewhere writable is the only way to get that without putting test
  # scaffolding in web/.
  CCWATCH_SELF="$root/bin/ccwatch" CCWATCH_WEB="${CCWATCH_WEB:-$root/web}" CCWATCH_BIND_PORT="$port" \
  CCWATCH_SEND_TOKEN="$send_token" CCWATCH_ALLOW_KILL="$allowkill" \
  CCWATCH_IDLE_GRACE="$idle_grace" CCWATCH_SNAPSHOT_TIMEOUT="$snapshot_timeout" \
  CCWATCH_SNAPSHOT_CADENCE="$snapshot_cadence" \
  python3 -c '
import hashlib, http.server, json, os, socketserver, subprocess, sys, threading, time

SELF = os.environ["CCWATCH_SELF"]
WEB  = os.environ["CCWATCH_WEB"]
PORT = int(os.environ["CCWATCH_BIND_PORT"])
SEND_TOKEN = os.environ.get("CCWATCH_SEND_TOKEN", "")
# ⚠️ Killing from a browser is OFF unless asked for. Sending a message to the
# wrong agent is embarrassing; killing the wrong one costs work in flight. A
# monitoring tool should not be able to destroy by default, so this needs
# --allow-kill in addition to the token every other write already requires.
ALLOW_KILL = os.environ.get("CCWATCH_ALLOW_KILL", "0") == "1" and bool(SEND_TOKEN)
ALLOWED_ORIGINS = {"http://127.0.0.1:%d" % PORT, "http://localhost:%d" % PORT}
MAX_MESSAGE = 4000

# ⚠️ The state is refreshed by ONE background thread and served from memory.
#
# The first version ran `ccwatch --json` inside the request handler. Each call
# takes seconds (it shells out to ps, stats hundreds of files, and runs jq
# repeatedly), the page polls every 3 seconds, and the requests piled up
# without a single one completing — eleven concurrent snapshots and an empty
# dashboard. Chrome showed every request as `pending`, which is how it was
# found.
#
# So: one refresher, N readers. The handler never blocks, and the page gets a
# `stale` age it can display rather than silently showing old numbers.
#
# "warming" is derived from STATE["snapshot_at"] being unset, not stored as
# its own flag — a flag can be left stale by a code path that forgets to
# clear it; a timestamp cannot.
STATE = {}
LOCK = threading.Lock()
LAST_READ = time.monotonic()
GRACE = float(os.environ.get("CCWATCH_IDLE_GRACE", "15"))

def run(args, timeout):
    try:
        out = subprocess.run([SELF] + args, capture_output=True, text=True,
                             timeout=timeout, env={**os.environ, "NO_COLOR": "1"})
        if out.returncode != 0 and not out.stdout.strip():
            return {"error": "%s exited %d: %s" % (" ".join(args), out.returncode,
                                                   out.stderr.strip()[:200])}
        return json.loads(out.stdout) if out.stdout.strip() else None
    except Exception as e:
        # Surfaced to the page. A panel that is empty because a command failed
        # must not look like a panel that is empty because there is nothing to
        # show.
        return {"error": "%s: %s" % (" ".join(args), e)}

# THREE independent refreshers, not one loop.
#
# The first version refreshed everything in one pass, so the session table —
# which is the whole point and takes ~1s — was gated on the deploy check (a
# network call to gh) and the peer scan (hundreds of files). One pass took 14
# seconds, and when gh hung the sessions panel went stale with it. Measured
# with CCWATCH_PROFILE=1; found because Chrome showed every /api/state request
# as `pending`.
#
# Each refresher owns one key and writes it under the lock. A slow one can only
# make its own panel stale, and the page shows the age of each panel.
#
# Each loop holds its own `next_due` and checks two gates before doing any
# work: idle (nobody has read /api/state within GRACE) and not-yet-due. Idle
# does NOT advance next_due, so a collector that idled through several of its
# own cadences fires on the very first tick after a reader returns rather than
# leaving its panel stale for up to `every` more seconds. A collection already
# in flight is never interrupted — the gate is only checked before starting.
TICK = 0.25
def refresh_loop(key, args, timeout, every, transform=None):
    def loop():
        next_due = 0.0
        while True:
            now = time.monotonic()
            if now - LAST_READ > GRACE:
                time.sleep(TICK)
                continue
            if now < next_due:
                time.sleep(TICK)
                continue
            val = run(args, timeout)
            if transform:
                val = transform(val)
            with LOCK:
                if key == "snapshot":
                    # A failed or timed-out collection must not overwrite a
                    # retained good snapshot with an empty one -- that is
                    # indistinguishable from a host with no sessions
                    # (Constitution IV). Leave snapshot/snapshot_at
                    # untouched on failure so the retained panels age keeps
                    # growing truthfully; record the failure alongside it.
                    if isinstance(val, dict) and "sessions" in val:
                        STATE["snapshot"] = val
                        STATE["snapshot_at"] = time.time()
                        STATE["snapshot_ok"] = True
                        STATE["snapshot_error"] = None
                    else:
                        STATE["snapshot_ok"] = False
                        STATE["snapshot_error"] = (
                            (val or {}).get("error", "snapshot failed")
                            if isinstance(val, dict) else "snapshot failed")
                else:
                    STATE[key] = val
                    STATE[key + "_at"] = time.time()
                refresh_etag()
            next_due = time.monotonic() + every
    return loop

def build_canonical():
    # Assumes LOCK held. Same shape as the /api/state payload minus
    # `ages`/`stale`/`feed` — those are recomputed per request, never
    # published, so they must never affect the ETag (a 304 must guarantee
    # every MEASURED number is unchanged, not merely that time passed).
    snap = dict(STATE.get("snapshot") or {})
    body = dict(snap)
    body["warming"] = STATE.get("snapshot_at") is None
    if body["warming"]:
        # No snapshot has ever succeeded — `null`, never a fabricated `[]`,
        # so a genuinely empty host and a never-succeeded one cannot be
        # confused by inspection of the payload alone.
        body["sessions"] = None
        body["unfinished"] = None
    body["deploys"] = STATE.get("deploys")
    body["peers"] = STATE.get("peers")
    body["can_kill"] = ALLOW_KILL
    body["snapshot_ok"] = STATE.get("snapshot_ok", True)
    body["snapshot_error"] = STATE.get("snapshot_error")
    if body["snapshot_error"]:
        # Mirrored into the existing top-level `error` key so the table
        # views footer surfaces a failed collection without a page change.
        body["error"] = body["snapshot_error"]
    body["collected_at"] = {
        k: STATE.get(k + "_at") for k in ("snapshot", "deploys", "peers")}
    return body

def refresh_etag():
    # Assumes LOCK held. Computed once per publish, not per request, so
    # concurrent readers see the same validator without re-hashing the
    # payload on every /api/state hit.
    canon = json.dumps(build_canonical(), sort_keys=True, separators=(",", ":"))
    STATE["etag"] = hashlib.sha256(canon.encode()).hexdigest()[:16]

class H(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *a, **kw):
        super().__init__(*a, directory=WEB, **kw)

    def serve_page(self, name):
        # The token is injected into the page ccwatch serves, which is what
        # makes it a secret a drive-by page cannot obtain: same-origin policy
        # stops another site reading this HTML.
        try:
            with open(os.path.join(WEB, name), "rb") as fh:
                body = fh.read()
        except OSError:
            self.send_error(404)
            return
        body = body.replace(b"__CCWATCH_SEND_TOKEN__", SEND_TOKEN.encode())
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def reply_json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        if not (self.path.startswith("/api/send") or self.path.startswith("/api/kill")):
            self.send_error(404)
            return
        if not SEND_TOKEN:
            self.reply_json(403, {"error": "this server was started --read-only"})
            return
        # Both checks, not either: the token stops a page that cannot read our
        # HTML, and the Origin check stops one that somehow could.
        origin = self.headers.get("Origin")
        if origin is not None and origin not in ALLOWED_ORIGINS:
            self.reply_json(403, {"error": "refused: unexpected Origin %s" % origin})
            return
        if self.headers.get("X-CCWatch-Token", "") != SEND_TOKEN:
            self.reply_json(403, {"error": "refused: bad or missing token"})
            return
        # Two separate limits, and they have to give separate reasons. The byte
        # cap exists so an unbounded body is never read at all; the message cap
        # is about content. The first version let the byte cap fire first and
        # report "bad request", so an oversized message got a reason that did
        # not mention size — the caller could not tell what to shorten.
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            self.reply_json(400, {"error": "bad request: unreadable Content-Length"})
            return
        if length <= 0:
            self.reply_json(400, {"error": "bad request: empty body"})
            return
        if length > MAX_MESSAGE + 512:
            self.reply_json(413, {"error": "message too long (limit %d characters)" % MAX_MESSAGE})
            return
        try:
            req = json.loads(self.rfile.read(length))
            target = str(req["target"]).strip()
            message = str(req.get("message") or "").strip()
        except Exception as e:
            self.reply_json(400, {"error": "bad request: %s" % e})
            return
        if self.path.startswith("/api/kill"):
            if not ALLOW_KILL:
                self.reply_json(403, {"error": "killing is disabled — start with: "
                                               "ccwatch serve --allow-kill"})
                return
            if not target:
                self.reply_json(400, {"error": "target is required"})
                return
            args = [SELF, "kill", "-y"]
            if req.get("force"):
                args.append("--force")
            args.append(target)
            try:
                out = subprocess.run(args, capture_output=True, text=True, timeout=40,
                                     env={**os.environ, "NO_COLOR": "1"})
                text = (out.stdout + out.stderr).strip()
                # The refusals are the useful part of the reply: the page shows
                # them verbatim rather than reducing everything to "failed".
                state = ("killed" if "killed" in out.stdout
                         else "refused" if out.returncode != 0 else "unknown")
                self.reply_json(200 if state == "killed" else 409,
                                {"state": state, "detail": text})
            except Exception as e:
                self.reply_json(504, {"state": "failed", "detail": str(e)})
            return

        if not target or not message:
            self.reply_json(400, {"error": "target and message are both required"})
            return
        if len(message) > MAX_MESSAGE:
            self.reply_json(413, {"error": "message too long (limit %d characters)" % MAX_MESSAGE})
            return

        # `ccwatch send` waits to SEE the message land in the receiver, so the
        # page gets the same three honest outcomes the terminal does rather
        # than an optimistic "sent".
        try:
            out = subprocess.run([SELF, "send", target, message],
                                 capture_output=True, text=True, timeout=45,
                                 env={**os.environ, "NO_COLOR": "1"})
            text = (out.stdout + out.stderr).strip()
            state = ("delivered" if "delivered" in out.stdout
                     else "queued" if "queued" in text
                     else "failed")
            self.reply_json(200 if out.returncode == 0 else 502,
                            {"state": state, "detail": text})
        except Exception as e:
            self.reply_json(504, {"state": "failed", "detail": str(e)})

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            return self.serve_page("index.html")
        if self.path in ("/map", "/map.html"):
            return self.serve_page("map.html")
        if self.path.startswith("/api/transcript"):
            from urllib.parse import urlparse, parse_qs
            q = parse_qs(urlparse(self.path).query)
            sid = (q.get("sid") or [""])[0]
            n = (q.get("n") or ["30"])[0]
            # Fetched on demand rather than folded into /api/state: it is only
            # wanted for the one session you clicked, and putting every
            # transcript in the polled payload would ship megabytes of tool
            # output every three seconds.
            if not sid or not all(c in "0123456789abcdef-" for c in sid.lower()):
                self.reply_json(400, {"error": "sid must be a session id"})
                return
            try:
                nn = max(1, min(200, int(n)))
            except ValueError:
                nn = 30
            out = subprocess.run([SELF, "convo", "-n", str(nn), "--json", sid],
                                 capture_output=True, text=True, timeout=30,
                                 env={**os.environ, "NO_COLOR": "1"})
            if out.returncode != 0 or not out.stdout.strip():
                self.reply_json(404, {"error": (out.stderr or "no transcript").strip()[:300]})
                return
            try:
                self.reply_json(200, json.loads(out.stdout))
            except ValueError as e:
                self.reply_json(500, {"error": "unparseable transcript: %s" % e})
            return
        if self.path.startswith("/api/state"):
            global LAST_READ
            prev_read = LAST_READ
            LAST_READ = time.monotonic()
            now = time.time()
            with LOCK:
                payload = build_canonical()
                etag = STATE.get("etag")
                # Every panel carries its OWN age, so one slow collector cannot
                # make the whole dashboard look stale — or worse, make a stale
                # panel look current.
                payload["ages"] = {
                    k: (now - STATE[k + "_at"]) if STATE.get(k + "_at") else None
                    for k in ("snapshot", "deploys", "peers")}
            payload["stale"] = payload["ages"].get("snapshot")
            # Derived per request, never stored: "warming" if no snapshot has
            # ever succeeded, else "idle" if the read that preceded THIS one
            # (before the stamp above overwrote it) was more than GRACE ago,
            # else "collecting".
            payload["feed"] = ("warming" if STATE.get("snapshot_at") is None
                                else "idle" if (LAST_READ - prev_read) > GRACE
                                else "collecting")
            quoted_etag = ("\"%s\"" % etag) if etag else None
            inm = self.headers.get("If-None-Match")
            # A comma-separated list of validators, each optionally quoted;
            # "*" matches whatever the server currently holds. Absent, stale
            # or unparseable ⇒ fall through to a full 200 (FR-011).
            if quoted_etag and inm and (
                    "*" in inm or quoted_etag in [t.strip() for t in inm.split(",")]):
                self.send_response(304)
                self.send_header("ETag", quoted_etag)
                self.send_header("Cache-Control", "no-cache, private")
                self.end_headers()
                return
            body = json.dumps(payload).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            if quoted_etag:
                self.send_header("ETag", quoted_etag)
            self.send_header("Cache-Control", "no-cache, private")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        return super().do_GET()

    def log_message(self, fmt, *args):
        pass  # the access log is noise; failures surface in the page

class S(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True

SNAPSHOT_TIMEOUT = float(os.environ.get("CCWATCH_SNAPSHOT_TIMEOUT", "90"))
# ⚠️ Settable so a test can make the snapshot cadence longer than the exchange
# it is measuring. The ETag assertions compare two reads that must not have a
# collection between them; at the 2s default on a loaded machine each `curl`
# takes longer than the cadence, so a collection ALWAYS lands in between and
# the assertion fails for a reason that has nothing to do with the validator.
# Retrying could not fix that — the race was not unlucky, it was certain — so
# the cadence is a knob and the test removes the race instead of re-rolling it.
SNAPSHOT_CADENCE = float(os.environ.get("CCWATCH_SNAPSHOT_CADENCE", "2"))
# ⚠️ The cadence raises a FLOOR under all three refreshers, not just the
# snapshot. The ETag covers the whole published payload — deploys and peers
# included — and `refresh_etag` runs on every publish, so a deploys refresh at
# 60s or a peers refresh at 45s changes the validator just as a snapshot does.
# Slowing only the snapshot left the ETag assertions comparing two reads that a
# peers publish could still slip between, and they failed intermittently for a
# reason that had nothing to do with the snapshot they were pinning. At the
# default of 2 the floor is below both, so production cadences are unchanged.
for _key, _args, _to, _every, _tf in (
        ("snapshot", ["--json"], SNAPSHOT_TIMEOUT, SNAPSHOT_CADENCE, None),
        ("deploys",  ["deploys", "--json"], 120, max(60, SNAPSHOT_CADENCE), None),
        ("peers",    ["peers", "--days", "2", "--json"], 120, max(45, SNAPSHOT_CADENCE), None)):
    threading.Thread(target=refresh_loop(_key, _args, _to, _every, _tf), daemon=True).start()
try:
    with S(("127.0.0.1", PORT), H) as httpd:
        httpd.serve_forever()
except KeyboardInterrupt:
    pass
except OSError as e:
    sys.stderr.write("could not bind 127.0.0.1:%d — %s\n" % (PORT, e))
    sys.exit(1)
' &
  srv_pid=$!
  wait "$srv_pid"
}

# =========================================================== verify-ui ======
#
# ⚠️ This exists because 567 assertions passed while the map showed nothing.
#
# All of them check structure — a role attribute, which node a handler is bound
# to, what a module function returns — and none renders the page and looks at
# it. So a roster whose rows collapsed into a four-character ribbon, a map that
# opened on a zoom level where figures are `display:none`, a drag that selected
# text instead of panning, and 258px of page scroll with an unreachable panel
# below the fold were all green at once. Every one was found in the first ten
# minutes of a person opening the page, which is the single thing the suite
# could not do.
#
# The checks are those bugs restated as numbers a script can read. None of them
# is clever; they did not exist because the suite is entirely browserless, so
# nobody reached for a browser.
CHROME_CANDIDATES='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
/Applications/Chromium.app/Contents/MacOS/Chromium
/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge'

find_chrome() {
  if [ -n "${CCWATCH_CHROME:-}" ] && [ -x "${CCWATCH_CHROME}" ]; then
    printf '%s' "$CCWATCH_CHROME"; return 0
  fi
  printf '%s\n' "$CHROME_CANDIDATES" | while IFS= read -r c; do
    if [ -x "$c" ]; then printf '%s' "$c"; break; fi
  done
}

free_verify_port() {
  python3 -c 'import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()'
}

# The harness page. It lives in a COPIED web directory, never in web/ itself:
# a production page does not carry its own test scaffolding. Serving it from
# the same origin as /map is what lets it reach into an iframe of the real
# page, dispatch genuine pointer and wheel events at it, and read computed
# styles and rendered boxes back out.
write_verify_harness() {
  cat > "$1" <<'CCWATCH_HARNESS_EOF'
<!doctype html>
<meta charset="utf-8">
<title>ccwatch . verify-ui</title>
<style>
  html, body { margin:0; background:#111; }
  /* A fixed frame size, so a proportion check means the same thing on every
     machine that runs this. */
  #frame { width:1180px; height:760px; border:0; display:block; }
  #verify-out { color:#ddd; font:12px monospace; white-space:pre-wrap; }
</style>
<iframe id="frame" src="/map"></iframe>
<pre id="verify-out"></pre>
<script>
var out = [];
function ok(name)          { out.push("PASS|" + name + "|"); }
function bad(name, detail) { out.push("FAIL|" + name + "|" + String(detail)); }
function check(name, cond, detail) { if (cond) { ok(name); } else { bad(name, detail); } }
function done() { document.getElementById("verify-out").textContent = out.join("\n"); }

function boxOf(el) {
  var r = el.getBoundingClientRect();
  return {t: r.top, l: r.left, b: r.bottom, r: r.right, w: r.width, h: r.height};
}
function onScreen(b, vw, vh) {
  return b.r > 0 && b.l < vw && b.b > 0 && b.t < vh && b.w > 0 && b.h > 0;
}

function run(doc, win) {
  var de = doc.documentElement;
  var vw = de.clientWidth, vh = de.clientHeight;
  var world = doc.getElementById("world");
  var cam = doc.getElementById("camera");

  // 1 - "just two empty squares". A default view that draws no agent answers
  // no question, and it was empty by construction: fit-to-world always landed
  // on a zoom level whose level-of-detail sets display:none on the figures.
  var agents = [].slice.call(doc.querySelectorAll("#camera .agent[data-sid]"));
  var shown = agents.filter(function (a) { return onScreen(boxOf(a), vw, vh); });
  check("an agent is visible in the default view", shown.length > 0,
        agents.length + " in the DOM, " + shown.length + " rendered on screen");

  // 2 - "I can still scroll down on the map page".
  check("the page does not scroll", de.scrollHeight - de.clientHeight === 0,
        "overflows by " + (de.scrollHeight - de.clientHeight) + "px");

  // 3 - the map, not the chrome, gets the leftover height.
  var wh = world ? boxOf(world).h : 0;
  check("the map takes most of the viewport height", wh > vh * 0.55,
        Math.round(wh) + "px of " + vh + "px");

  // 4 - "an agent chat window below the map that I can't interact with": an
  // unconditional display:flex overrode the UA's dialog:not([open]) rule.
  var ghosts = [].slice.call(doc.querySelectorAll("dialog")).filter(function (d) {
    return !d.open && boxOf(d).h > 0;
  });
  check("no closed dialog is rendered", ghosts.length === 0,
        ghosts.map(function (d) { return "#" + d.id; }).join(", "));

  // 5 - the roster ribbon: six fields in a flex ROW gave .rname width 0, and
  // every field then wrapped into a four-character column.
  // ⚠️ Skip anything deliberately hidden. `.rsel` carries the word "selected"
  // and is display:none until its row is selected, so a naive "has text but
  // zero width" test reported it seven times on the first run. A check that
  // cries wolf is a check people stop reading.
  var collapsed = [].slice.call(doc.querySelectorAll("#rosterlist [role=option] > *"))
    .filter(function (el) {
      if ((el.textContent || "").trim() === "") { return false; }
      if (win.getComputedStyle(el).display === "none") { return false; }
      return el.getBoundingClientRect().width === 0;
    });
  check("no roster field with text collapses to zero width", collapsed.length === 0,
        collapsed.map(function (e) { return "." + e.className; }).join(", "));

  // 6 - a drag beginning on a label selected text instead of panning.
  check("the map suppresses text selection",
        win.getComputedStyle(world).userSelect === "none",
        win.getComputedStyle(world).userSelect);

  // 7 - the world is mostly content, not void. Districts were 192x192 around
  // one 54x78 building, and hash placement left 612 units between two orgs.
  var camBB = cam.getBBox();
  var area = 0;
  [].slice.call(doc.querySelectorAll("#camera .building")).forEach(function (b) {
    var r = b.getBBox();
    area += r.width * r.height;
  });
  var span = camBB.width * camBB.height;
  var fill = span > 0 ? area / span : 0;
  check("buildings fill a real share of the world", fill > 0.06,
        (fill * 100).toFixed(1) + "% of " + Math.round(camBB.width) + "x" + Math.round(camBB.height));

  // 8 - a zone label sat exactly where its own figures were drawn.
  // ⚠️ getBoundingClientRect, not getBBox. getBBox returns a box in the
  // element's OWN user space, ignoring the transforms of its ancestors — so
  // every zone label and every figure measured from near (0,0) and the naive
  // version reported 14 overlaps on a map that had none. Screen space is the
  // only space in which "do these two things visually collide" is a question
  // with an answer.
  var overlaps = 0;
  var figRects = [].slice.call(doc.querySelectorAll("#camera .agent"))
    .map(function (a) { return a.getBoundingClientRect(); })
    .filter(function (r) { return r.width > 0 && r.height > 0; });
  [].slice.call(doc.querySelectorAll("#camera .zone")).forEach(function (z) {
    var lbl = z.querySelector("text");
    if (!lbl) { return; }
    var lb = lbl.getBoundingClientRect();
    if (lb.width === 0 || lb.height === 0) { return; }
    figRects.forEach(function (ab) {
      if (lb.left < ab.right && lb.right > ab.left &&
          lb.top < ab.bottom && lb.bottom > ab.top) { overlaps++; }
    });
  });
  check("no zone label overlaps a figure", overlaps === 0, overlaps + " overlapping pairs");

  // 9 - pinch zoom leapt through 1.5x-2x rungs, because 100px of delta banked
  // up and then moved a whole rung. Smooth means monotonic, with no single
  // event moving the scale by more than a fifth.
  var scales = [];
  var rect = world.getBoundingClientRect();
  var i;
  for (i = 0; i < 10; i++) {
    world.dispatchEvent(new win.WheelEvent("wheel", {
      deltaY: -12, deltaMode: 0, ctrlKey: true, bubbles: true, cancelable: true,
      clientX: rect.left + rect.width / 2, clientY: rect.top + rect.height / 2
    }));
    var m = /scale\(([\d.]+)\)/.exec(cam.getAttribute("transform") || "");
    scales.push(m ? parseFloat(m[1]) : 0);
  }
  var worst = 1, monotonic = true;
  for (i = 1; i < scales.length; i++) {
    if (scales[i] < scales[i - 1]) { monotonic = false; }
    if (scales[i - 1] > 0) { worst = Math.max(worst, scales[i] / scales[i - 1]); }
  }
  check("a pinch zooms smoothly rather than in leaps", monotonic && worst < 1.2,
        "largest single step " + worst.toFixed(3) + "x, monotonic=" + monotonic);

  // 10 - and the drag it lost to text selection actually pans.
  var lbl2 = doc.querySelector("#camera text");
  if (lbl2) {
    var before = cam.getAttribute("transform");
    var lr = lbl2.getBoundingClientRect();
    var sx = lr.left + lr.width / 2, sy = lr.top + lr.height / 2;
    world.dispatchEvent(new win.PointerEvent("pointerdown", {
      pointerId: 77, button: 0, buttons: 1, clientX: sx, clientY: sy,
      bubbles: true, cancelable: true, isPrimary: true}));
    [30, 90, 150].forEach(function (d) {
      world.dispatchEvent(new win.PointerEvent("pointermove", {
        pointerId: 77, buttons: 1, clientX: sx - d, clientY: sy,
        bubbles: true, cancelable: true, isPrimary: true}));
    });
    world.dispatchEvent(new win.PointerEvent("pointerup", {
      pointerId: 77, buttons: 0, clientX: sx - 150, clientY: sy,
      bubbles: true, cancelable: true, isPrimary: true}));
    check("a drag starting on a label pans the map",
          cam.getAttribute("transform") !== before, "transform unchanged");
    check("and selects no text", String(win.getSelection()) === "",
          "selected: " + String(win.getSelection()).slice(0, 40));
  }

  // 11 - the key is reachable, and named rather than identified by a glyph.
  var keyBtn = doc.getElementById("keyhelp");
  check("the map key is behind a named control",
        !!keyBtn && !!keyBtn.getAttribute("aria-label"),
        keyBtn ? "no aria-label" : "#keyhelp missing");
  if (keyBtn) {
    keyBtn.click();
    var km = doc.getElementById("keymodal");
    check("and it opens on demand", !!km && km.open,
          km ? "did not open" : "#keymodal missing");
    if (km && km.open) { km.close(); }
  }

  done();
}

document.getElementById("frame").addEventListener("load", function () {
  var f = document.getElementById("frame");
  var doc = f.contentDocument, win = f.contentWindow;
  // The server has already published a snapshot, but the roster and the camera
  // settle over a frame or two. A figure existing is the signal; the timeout is
  // the honest failure if it never arrives, rather than a set of checks that
  // quietly measure an empty page and pass.
  var waited = 0;
  (function settle() {
    var list = doc.getElementById("rosterlist");
    var ready = doc.querySelector("#camera .agent[data-sid]") && list && list.children.length > 0;
    if (ready || waited > 8000) {
      if (!ready) { bad("the map rendered at all", "no figures after 8s - see the server log"); }
      try { run(doc, win); } catch (e) { bad("the harness ran without throwing", e && e.message); done(); }
      return;
    }
    waited += 250;
    setTimeout(settle, 250);
  })();
});
</script>
CCWATCH_HARNESS_EOF
}

cmd_verify_ui() {
  local port="" shots="" keep=0 vw=1280 vh=900
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)  port="${2:-}"; shift 2 || exit 3;;
      --shots) shots="${2:-}"; shift 2 || exit 3;;
      --size)  vw="${2%%x*}"; vh="${2##*x}"; shift 2 || exit 3;;
      --keep)  keep=1; shift;;
      -h|--help)
        say "usage: ccwatch verify-ui [--port N] [--shots DIR] [--size WxH] [--keep]"
        return 0;;
      *) err "unknown option: $1"; return 3;;
    esac
  done

  local chrome
  chrome=$(find_chrome)
  if [ -z "$chrome" ]; then
    # A host that cannot supply what a check needs is skipped with the reason,
    # never failed. A red result meaning "this machine has no Chrome" costs the
    # same attention as a real regression.
    say "${_c_yellow}-${_c_reset} verify-ui skipped: no Chrome or Chromium found"
    printf '  %s\n' "set CCWATCH_CHROME=/path/to/chrome to point at one" >&2
    return 0
  fi

  local root work
  root=$(cd -- "$(dirname -- "$(resolved_self)")/.." && pwd)
  work=$(mktemp -d "${TMPDIR:-/tmp}/ccwatch-verify.XXXXXX") || { err "mktemp failed"; return 1; }
  # ⚠️ NOT a local. The trap body is evaluated when the trap fires, which for
  # EXIT is after this function has already returned — a local is gone by then,
  # and under `set -u` the trap died with "vport: unbound variable" instead of
  # reaping the server it exists to reap. A cleanup that fails silently at the
  # moment it is needed is worse than none, because the leak it was meant to
  # prevent is the thing that then goes unnoticed.
  VERIFY_PORT=""
  # Reaped on every exit path including interruption: a leaked server holds a
  # port a later run may pick, which cost 1686 orphaned processes once already.
  # shellcheck disable=SC2064
  trap "if [ -n \"\${VERIFY_PORT:-}\" ]; then pkill -f \"ccwatch serve --port \${VERIFY_PORT}\" 2>/dev/null; fi; if [ $keep -eq 0 ]; then rm -rf '$work'; fi" EXIT INT TERM HUP

  mkdir -p "$work/web" "$work/profile"
  cp "$root/web/"*.html "$work/web/" 2>/dev/null || true
  cp "$root/web/"*.js "$work/web/" 2>/dev/null || true
  write_verify_harness "$work/web/verify.html" || { err "could not write the harness"; return 1; }

  VERIFY_PORT="${port:-$(free_verify_port)}"
  [ -n "$VERIFY_PORT" ] || { err "no free port for the verification server"; return 1; }

  CCWATCH_WEB="$work/web" "$root/bin/ccwatch" serve --port "$VERIFY_PORT" >"$work/serve.log" 2>&1 &
  local i=0 ready=""
  while [ "$i" -lt 90 ]; do
    ready=$(curl -s --max-time 3 "http://127.0.0.1:$VERIFY_PORT/api/state" 2>/dev/null \
            | jq -r '[.warming == false, (.collected_at.snapshot != null)] | all' 2>/dev/null)
    [ "$ready" = "true" ] && break
    sleep 1; i=$((i + 1))
  done
  if [ "$ready" != "true" ]; then
    err "the verification server never published a snapshot"
    printf '  %s\n' "see $work/serve.log" >&2
    return 1
  fi

  say "${_c_bold}verify-ui${_c_reset} ${_c_dim}— ${vw}x${vh}, 127.0.0.1:$VERIFY_PORT${_c_reset}"

  # ⚠️ Chrome writes the DOM and then does NOT exit — `--headless=new` with a
  # `--user-data-dir` lingers, and the first run of this command hung for
  # minutes with a complete dom.html already on disk. macOS has no `timeout`,
  # so the wait is explicit: run it in the background, wait for the harness's
  # closing tag to appear, then reap it. A bounded wait that fails loudly beats
  # an unbounded one that looks like work.
  "$chrome" --headless=new --disable-gpu --no-first-run --no-default-browser-check \
    --user-data-dir="$work/profile" --window-size="$vw,$vh" \
    --virtual-time-budget=20000 --dump-dom \
    "http://127.0.0.1:$VERIFY_PORT/verify.html" >"$work/dom.html" 2>/dev/null &
  local chrome_pid=$! waited=0
  while [ "$waited" -lt 60 ]; do
    grep -q '</pre>' "$work/dom.html" 2>/dev/null && break
    kill -0 "$chrome_pid" 2>/dev/null || break
    sleep 1; waited=$((waited + 1))
  done
  kill "$chrome_pid" 2>/dev/null
  wait "$chrome_pid" 2>/dev/null || true

  local results
  results=$(python3 -c 'import io, re, sys, html
raw = io.open(sys.argv[1], encoding="utf-8", errors="replace").read()
m = re.search(r"<pre id=\"verify-out\">(.*?)</pre>", raw, re.S)
sys.stdout.write(html.unescape(m.group(1)) if m else "")' "$work/dom.html")

  if [ -z "$results" ]; then
    err "the harness produced no results — the page never ran"
    printf '  %s\n' "re-run with --keep and open $work/web/verify.html by hand" >&2
    return 1
  fi

  local pass=0 fail=0 line name detail
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    name=${line#*|}; name=${name%%|*}
    detail=${line##*|}
    case "$line" in
      PASS\|*) pass=$((pass + 1)); say "  ${_c_green}✓${_c_reset} $name";;
      FAIL\|*) fail=$((fail + 1))
               say "  ${_c_red}✗${_c_reset} $name"
               [ -n "$detail" ] && printf '      %s\n' "$detail" >&2;;
      *)       fail=$((fail + 1)); say "  ${_c_yellow}?${_c_reset} unparsed: $line";;
    esac
  done <<EOF
$results
EOF

  # ⚠️ Screenshots are written every run, not on request, and that is the point:
  # a change under web/ that nobody looked at leaves a stale image next to a
  # newer page, which is visible. The suite checks their freshness.
  if [ -n "$shots" ]; then
    mkdir -p "$shots"
    local p
    for p in map ""; do
      "$chrome" --headless=new --disable-gpu --no-first-run --no-default-browser-check \
        --user-data-dir="$work/profile" --window-size="$vw,$vh" \
        --virtual-time-budget=12000 --hide-scrollbars \
        --screenshot="$shots/${p:-table}.png" \
        "http://127.0.0.1:$VERIFY_PORT/$p" >/dev/null 2>&1 &
      local shot_pid=$! sw=0
      while [ "$sw" -lt 45 ]; do
        [ -s "$shots/${p:-table}.png" ] && break
        kill -0 "$shot_pid" 2>/dev/null || break
        sleep 1; sw=$((sw + 1))
      done
      kill "$shot_pid" 2>/dev/null
      wait "$shot_pid" 2>/dev/null || true
    done
    say "${_c_dim}screenshots: $shots${_c_reset}"
  fi

  printf '\n%s checked, %s failed\n' "$((pass + fail))" "$fail"
  [ "$fail" -eq 0 ] || return 1
  return 0
}

# ============================================================== doctor ======
#
# This is the load-bearing command for the "nothing fails silently" promise.
# ccwatch reads an internal file layout, so a Claude Code upgrade could change it
# under us. The failure mode that must never happen is an EMPTY, CONFIDENT table
# — so doctor cross-checks our own parse against the supported `claude agents
# --json` and reports disagreement as a defect in ccwatch, not in your sessions.

cmd_doctor() {
  local problems=0
  ok()   { printf '  %s+%s %s\n' "$_c_green" "$_c_reset" "$*"; }
  bad()  { printf '  %sx%s %s\n' "$_c_red" "$_c_reset" "$*"; problems=$((problems + 1)); }
  meh()  { printf '  %s~%s %s\n' "$_c_yellow" "$_c_reset" "$*"; }

  say "${_c_bold}ccwatch doctor${_c_reset} ${_c_dim}(ccwatch v$CCWATCH_VERSION)${_c_reset}"
  say ""

  for t in jq awk ps date stat find; do
    command -v "$t" >/dev/null 2>&1 && ok "$t found" || bad "$t is missing — ccwatch cannot run"
  done

  say ""
  if [ -d "$SESS_DIR" ]; then
    local nfiles
    nfiles=$(find "$SESS_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | wc -l | tr -d ' ')
    ok "registry at $SESS_DIR ($nfiles file(s))"
  else
    bad "no registry at $SESS_DIR — is this the right CLAUDE_CONFIG_DIR?"
  fi
  [ -d "$PROJ_DIR" ] && ok "transcripts at $PROJ_DIR" \
    || bad "no transcripts at $PROJ_DIR — resume cannot work"

  # Schema check. Missing keys mean our reader has drifted from the format.
  say ""
  local sessions_obj sessions probe pf
  sessions_obj=$(collect_sessions)
  sessions=$(printf '%s' "$sessions_obj" | jq -c '.rows')
  pf=$(printf '%s' "$sessions_obj" | jq -r '.parse_failed // 0')
  [ "$pf" -gt 0 ] && meh "$pf registry file(s) would not parse (a session mid-write does this; persistent means trouble)"
  # The union of keys across all sessions, not the keys of one: most fields are
  # optional per session (an SDK session has no `status`), so testing a single
  # entry reports absences that are not defects.
  probe=$(printf '%s' "$sessions" | jq -r '
    if length == 0 then "empty"
    else ( ["pid","cwd","sessionId","startedAt"] - ([ .[] | keys[] ] | unique) | join(",") )
    end' 2>/dev/null)
  if [ "$probe" = "empty" ]; then
    meh "registry parsed to zero sessions — expected if no Claude Code is running"
  elif [ -n "$probe" ]; then
    bad "registry is missing expected field(s): $probe — ccwatch needs updating"
  else
    ok "registry schema looks right (pid, cwd, sessionId, startedAt)"
  fi
  local unknown
  unknown=$(printf '%s' "$sessions" | jq -r '
    [ .[].status // empty ] | map(select(. as $s | ["busy","shell","idle","waiting"] | index($s) | not))
    | unique | join(",")')
  [ -n "$unknown" ] \
    && bad "unrecognised status value(s): $unknown — ccwatch does not know how to classify these" \
    || ok "all status values are ones ccwatch understands"

  # The cross-check. Two independent readers of the same truth must agree.
  say ""
  if command -v claude >/dev/null 2>&1; then
    local theirs ours
    theirs=$(claude agents --json 2>/dev/null | jq -r '[.[].sessionId] | sort | join(",")' 2>/dev/null)
    ours=$(snapshot | jq -r '[.sessions[].sid] | sort | join(",")')
    if [ -z "$theirs" ] && [ -z "$ours" ]; then
      meh "both ccwatch and 'claude agents --json' see no live sessions"
    elif [ "$theirs" = "$ours" ]; then
      ok "agrees with 'claude agents --json' exactly"
    else
      bad "DISAGREES with 'claude agents --json' — ccwatch's view is not trustworthy"
      printf '      %sonly claude sees:%s %s\n' "$_c_dim" "$_c_reset" \
        "$(comm -13 <(tr ',' '\n' <<<"$ours" | sort) <(tr ',' '\n' <<<"$theirs" | sort) | tr '\n' ' ')"
      printf '      %sonly ccwatch sees:%s  %s\n' "$_c_dim" "$_c_reset" \
        "$(comm -23 <(tr ',' '\n' <<<"$ours" | sort) <(tr ',' '\n' <<<"$theirs" | sort) | tr '\n' ' ')"
    fi
  else
    meh "'claude' not on PATH — skipping the cross-check that would catch a format change"
  fi

  # Hooks: without them, a prompt that opens and closes between polls is lost.
  say ""
  local hp
  hp=$(collect_host | jq -r 'if . == null then "?" else "\(.swap_used_pct)|\(.ram_free_mb)" end' 2>/dev/null)
  case "$hp" in
    "?"|"") meh "could not read host memory state";;
    *) local swp="${hp%%|*}" freem="${hp##*|}"
       if [ "${swp:-0}" -ge "$CCWATCH_SWAP_WARN" ]; then
         bad "host under memory pressure — swap ${swp}% used, ${freem}MB RAM free"
         printf '      %sthe OS kills processes in this state, and a killed session%s\n' "$_c_dim" "$_c_reset"
         printf '      %slooks identical to a clean exit. Check: ccwatch resume%s\n' "$_c_dim" "$_c_reset"
       else
         ok "host memory is fine (swap ${swp}% used, ${freem}MB RAM free)"
       fi;;
  esac

  say ""
  if [ -f "$USAGE_FILE" ]; then
    local uage
    uage=$(jq -r --argjson now "$(date '+%s')" '($now - (.at // 0))' "$USAGE_FILE" 2>/dev/null) || uage=999999
    if [ "${uage:-999999}" -le "$CCWATCH_USAGE_STALE" ]; then
      ok "usage feed is live (${uage}s old)"
    else
      meh "usage feed has not reported in ${uage}s — the numbers are being withheld"
      printf '      %sis your statusline still running? re-run: ccwatch install-statusline%s\n' \
        "$_c_cyan" "$_c_reset"
    fi
  else
    meh "no usage feed — run: ccwatch install-statusline (rate limits and context will be blank)"
  fi

  say ""
  if [ -f "$CLAUDE_HOME/settings.json" ] \
     && jq -e '[ .hooks // {} | .[]? | .[]? | .hooks[]?.command? // "" ] | map(contains("ccwatch hook")) | any' \
        "$CLAUDE_HOME/settings.json" >/dev/null 2>&1; then
    ok "hooks installed"
    if [ -f "$EVENTS" ]; then
      ok "event log has $(wc -l <"$EVENTS" | tr -d ' ') entr(ies)"
    else
      meh "no events recorded yet — hooks apply to sessions started after install"
    fi
  else
    meh "hooks NOT installed — a prompt that opens and closes between polls will be missed"
    printf '      %srun: ccwatch install-hooks%s\n' "$_c_cyan" "$_c_reset"
  fi

  say ""
  [ "$problems" -eq 0 ] \
    && say "${_c_green}No problems found.${_c_reset}" \
    || { say "${_c_red}$problems problem(s) found.${_c_reset}"; return 1; }
}

# ============================================================== watch =======

cmd_watch() {
  # Without a TTY there is nothing to repaint, so print once and exit. That
  # makes `ccwatch` safe in a pipe, a cron job or a status bar.
  if [ ! -t 1 ]; then
    render "$(snapshot)"
    return 0
  fi
  local hide_cursor=$'\033[?25l' show_cursor=$'\033[?25h'
  # shellcheck disable=SC2064
  trap "printf '%s' '$show_cursor'; cleanup; exit 0" INT TERM
  printf '%s' "$hide_cursor"
  while :; do
    local snap out
    snap=$(snapshot)
    out=$(render "$snap")
    # Painted in one write after the frame is fully built, so the table never
    # flickers half-drawn.
    printf '\033[H\033[2J%s\n%s\n' "$out" \
      "${_c_dim}$(date '+%H:%M:%S') · every ${CCWATCH_REFRESH}s · q/Ctrl-C to quit${_c_reset}"
    # read -t doubles as the sleep and as the keypress check, so quitting is
    # instant rather than up to one refresh away.
    local key=""
    if read -r -t "$CCWATCH_REFRESH" -n 1 key 2>/dev/null; then
      case "$key" in
        q|Q) break;;
      esac
    fi
  done
  printf '%s' "$show_cursor"
}

# ============================================================== usage =======

usage() {
  cat <<'EOF'
ccwatch — every Claude Code session on this machine, and which one is stuck

USAGE
  ccwatch                    live table, refreshed until you quit (q / Ctrl-C)
  ccwatch once               draw the table once and exit
  ccwatch --json             the same data as JSON, for scripting

  ccwatch ask [<who>]        what each blocked session is actually asking —
                           the question and every option, from its transcript
  ccwatch convo [-n N] <who>  the recent conversation of one session. Tool
                           results are reduced to a size, never their contents.

  ccwatch send <who> <msg>   put a message into a session that is ALREADY
                           running, and watch its transcript to confirm arrival
        --dry-run          print the exact frames instead of sending them
  ccwatch peers [--days N]   which sessions have been talking to each other

  ccwatch serve              table + map in a browser (127.0.0.1 only)
        --open             open it once it is up
        --port N           default 8787
        --read-only        drop the send endpoint and serve no token

  ccwatch resume [-n N]      what to reopen after a crash or reboot, plus the
                           last known roster of what was live
        --cd               print a `cd <dir> && claude --resume` you can paste
        --all              ignore the recency window

  ccwatch deploys            deploy runs in flight, and concluded in the last 24h
  ccwatch subscribe <wf>     (run BY an agent, in its own session) tell me when
                           a matching deploy finishes
  ccwatch unsubscribe <wf>   the reverse
  ccwatch subs               current subscriptions
  ccwatch daemon             watch deploys and notify subscribers while you are
                           away

  ccwatch log [N]            recent hook events (needs install-hooks)
  ccwatch install-hooks      record "needs your input" events, so a prompt that
                           opens and closes between polls is never lost
  ccwatch install-statusline  wrap your statusline to report rate limits and
                           context fill. Wraps, does not replace.
  ccwatch doctor             check that ccwatch's own view is trustworthy
  ccwatch verify-ui          render the pages in a browser and check what they look like
  ccwatch -h | --version

  <who> is a session name, a session id, or a pid. Names must match whole; a
  session id may be given as a prefix of 8 or more characters. Anything that
  matches more than one live session is refused with the candidates listed,
  never resolved by picking — the wrong agent has already been told.

STATUS COLUMN
  * waiting        blocked on you. LAST says on what, and for how long.
  ! HUNG?          says busy, but its transcript has stopped growing.
  ! HUNG!!         the same, past 3x the threshold.
  ! SDK STALE?     headless session, publishes no status, gone quiet.
  ! NO TRANSCRIPT  claims to be working with nothing to corroborate it.
  + busy / sdk     working, and the transcript proves it.
  ~ sdk-ts         an embedded-SDK session. Publishes no status and writes no
                   transcript, so only CPU can speak for it — deliberately
                   never escalated to a hang, because a session waiting on its
                   host program is quiet by design.
  ~ shell          dropped to a shell.
  - idle           waiting for a prompt, nothing pending.

  A `busy` row is never trusted on its own: the LAST column always shows the
  measurement behind the verdict, because one long-running Bash call is
  legitimately silent and only you can tell those apart.

PIPELINE SUB-ROWS
  Under a session that ran a spec-run phase: which feature, which phase, on
  what model, and what the run has cost. Attached by session id, so it names
  the run this session actually drove rather than every run in the directory.

    plan/CRASHED     the phase is still marked `running` but its runner is
                     gone. Lost work, and nothing else reports it until the
                     next spec-run invocation reconciles the state file.
    plan/needs_input the phase stopped to ask you something.

  A session's own status and its run's status are kept separate on purpose: a
  session can be honestly idle while the run it drove has crashed.

ENVIRONMENT
  CCWATCH_BUSY_STALE   seconds of transcript silence before `busy` is
                     suspect (default 600)
  CCWATCH_SDK_STALE    the same for headless sessions (default 900)
  CCWATCH_REFRESH      seconds between repaints (default 2)
  CCWATCH_RESUME_DAYS  how far back `ccwatch resume` looks (default 14)
  CCWATCH_UNFINISHED_HOURS
                     how recent an unfinished run must be to appear in the
                     live table (default 24) — older ones are counted, and
                     listed by `ccwatch resume`
  CCWATCH_HOME         where the event log lives (default ~/.claude/ccwatch)
  CLAUDE_CONFIG_DIR  which Claude Code config directory to read
  NO_COLOR           set to disable colour
EOF
}

# ============================================================== dispatch ====

need jq "install with: brew install jq"
need awk

case "${1:-}" in
  ''|watch)        cmd_watch;;
  once)            render "$(snapshot)";;
  --json)          snapshot;;
  resume)          shift; cmd_resume "$@";;
  hook)            shift; cmd_hook "$@";;
  log)             shift; cmd_log "${1:-30}";;
  install-hooks)   cmd_install_hooks;;
  statusline)      shift; cmd_statusline "$@";;
  install-statusline) cmd_install_statusline;;
  send)            shift; cmd_send "$@";;
  kill)            shift; cmd_kill "$@";;
  deploys)         shift; cmd_deploys "$@";;
  subscribe)       shift; cmd_subscribe "$@";;
  unsubscribe)     shift; cmd_unsubscribe "$@";;
  subs)            cmd_subs;;
  peers)           shift; cmd_peers "$@";;
  convo)           shift; cmd_convo "$@";;
  ask)             shift; cmd_ask "$@";;
  serve)           shift; cmd_serve "$@";;
  daemon)          cmd_daemon;;
  tick)            daemon_tick;;
  verify-ui)       shift; cmd_verify_ui "$@";;
  doctor)          cmd_doctor;;
  -h|--help|help)  usage;;
  --version)       say "ccwatch $CCWATCH_VERSION";;
  *) die "unrecognised command '$1'" "try: ccwatch --help";;
esac
