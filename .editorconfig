root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing whitespace is not meaningful here, but the prose is hard-wrapped and
# reflowing it produces diffs that hide the actual change.
trim_trailing_whitespace = false
max_line_length = 80
